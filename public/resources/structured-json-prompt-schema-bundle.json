{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuredOutputBundle",
  "description": "Production JSON schemas for structured LLM API responses",
  "schemas": {
    "TechnicalArticle": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "metaDescription": { "type": "string" },
        "keyTakeaways": {
          "type": "array",
          "items": { "type": "string" }
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" }
            },
            "required": ["question", "answer"]
          }
        }
      },
      "required": ["title", "metaDescription", "keyTakeaways", "faq"]
    }
  }
}
