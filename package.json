{
  "name": "static-ai-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "postbuild": "pagefind --site dist && npx tsx scripts/run-internal-linker.ts && npx tsx scripts/generate-image-sitemap.ts && npx tsx scripts/generate-video-sitemap.ts && npx tsx scripts/generate-llms-txt.ts && npx tsx scripts/format-sitemap.ts && npx tsx scripts/ping-indexnow.ts && node -e \"if(require('fs').existsSync('dist/pagefind')) try { require('fs').cpSync('dist/pagefind', 'public/pagefind', { recursive: true, force: true }); } catch(_){}\" && npx tsx scripts/verify-links.ts",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/tailwind": "^5.0.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/js-yaml": "^4.0.9",
    "astro": "^5.0.0",
    "change-case": "^5.4.4",
    "cron-parser": "^5.7.0",
    "cronstrue": "^3.24.0",
    "date-fns": "^4.4.0",
    "gpt-tokenizer": "^3.4.0",
    "js-yaml": "^5.2.3",
    "jsonpath-plus": "^10.4.0",
    "jsonrepair": "^3.15.0",
    "llama3-tokenizer-js": "^1.2.0",
    "pagefind": "^1.1.0",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.10",
    "sharp": "^0.35.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
