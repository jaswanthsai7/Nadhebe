---
import BaseLayout from '../../layouts/BaseLayout.astro';

import FeedList from '../../components/FeedList.astro';
import { getAllArticles } from '../../utils/content';
export async function getStaticPaths() {
  const allArticles = await getAllArticles();
  const tagMap = new Map<string, { tagName: string; posts: any[] }>();
  
  allArticles.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => {
        const slug = tag.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-').replace(/-+/g, '-');
        if (!tagMap.has(slug)) {
          tagMap.set(slug, { tagName: tag, posts: [] });
        }
        tagMap.get(slug)!.posts.push(post);
      });
    }
    if (post.data.topic) {
      const slug = post.data.topic.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-').replace(/-+/g, '-');
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { tagName: post.data.topic, posts: [] });
      }
      if (!tagMap.get(slug)!.posts.some(p => p.slug === post.slug)) {
        tagMap.get(slug)!.posts.push(post);
      }
    }
  });

  return Array.from(tagMap.entries()).map(([slug, { tagName, posts }]) => ({
    params: { tag: slug },
    props: { tagName, posts },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout
  title={`Articles on ${tagName}`}
  description={`Browse technical articles, tools comparisons, reviews and prompts for ${tagName}.`}
  noindex={true}
>
  <div class="mx-auto max-w-6xl px-16 sm:px-24 py-48 sm:py-64">
    <div class="glass-panel border border-border dark:border-border-dark rounded-24 p-24 sm:p-32 md:p-40 shadow-medium">

    <div class="border-b border-border dark:border-border-dark pb-16 mb-24">
      <p class="text-meta font-sans font-semibold text-accent dark:text-accent-dark uppercase tracking-wider mb-8">Tag Hub</p>
      <h1 class="font-display text-h1 sm:text-display font-bold text-ink dark:text-ink-dark leading-tight">Topic: {tagName}</h1>
      <p class="text-body text-ink2 dark:text-ink2-dark mt-16 max-w-md">
        Explore all our posts matching the keyword or topic cluster: <code class="bg-code dark:bg-code-dark px-8 py-2 rounded font-mono text-meta text-ink dark:text-ink-dark">{tagName}</code>.
      </p>
    </div>

    <FeedList posts={posts} />
  
    </div>
    <!-- Standalone floating footer pill -->
    <div class="mt-32 flex justify-center" data-reveal>
      <div class="inline-flex items-center gap-12 px-32 py-16 rounded-2xl border border-border/40 dark:border-border-dark/40 bg-surface/85 dark:bg-surface-dark/85 text-body font-sans font-semibold text-ink2 dark:text-ink2-dark select-none shadow-medium backdrop-blur-md hover:scale-[1.03] transition-all duration-300 hover:shadow-large cursor-default">
        That's all, Love <span class="text-accent dark:text-accent-dark inline-block hover:scale-120 transition-transform duration-150 cursor-default">🧡</span>
      </div>
    </div>
  </div>
</BaseLayout>
