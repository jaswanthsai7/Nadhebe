---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you requested could not be found."
>
  <div class="mx-auto max-w-content px-16 sm:px-24 py-48 sm:py-64">
    <div class="glass-panel border border-border dark:border-border-dark rounded-24 p-24 sm:p-40 md:p-48 shadow-medium">
      <div class="flex flex-col lg:flex-row items-center gap-32 sm:gap-48">
        
        <!-- Left Side: Funny Editorial Image -->
        <div class="w-full lg:w-1/2 shrink-0">
          <div class="overflow-hidden rounded-20 border border-border dark:border-border-dark bg-surface2 dark:bg-surface2-dark shadow-medium">
            <img
              src="/images/404-hero.png"
              alt="Funny 404 Error AI Detective illustration"
              width="600"
              height="600"
              class="w-full h-auto aspect-square object-cover"
            />
          </div>
        </div>

        <!-- Right Side: Copy & Actions -->
        <div class="flex-1 text-left">
          <span class="inline-flex items-center gap-8 rounded-pill bg-accent/15 px-12 py-6 text-xs font-mono font-bold text-accent dark:bg-accent-dark/20 dark:text-accent-dark uppercase tracking-widest">
            <span class="h-8 w-8 rounded-full bg-accent animate-ping dark:bg-accent-dark"></span>
            Error 404 · Null Pointer Exception
          </span>

          <h1 class="mt-16 font-display text-h1 sm:text-display font-bold tracking-tight text-ink dark:text-ink-dark leading-tight">
            Lost in the AI Matrix
          </h1>

          <p class="mt-16 text-body-large text-ink2 dark:text-ink2-dark leading-relaxed">
            Our AI agent searched high and low through the codebase, but this page seems to have escaped into a parallel context window. The URL might be wrong or the document was moved.
          </p>

          <!-- Action Buttons -->
          <div class="mt-32 flex flex-wrap items-center gap-16">
            <a href="/" class="btn-primary flex items-center gap-8">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Return Home
            </a>

            <a href="/tutorials" class="btn-secondary flex items-center gap-8">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              Browse Tutorials
            </a>
          </div>

          <!-- Quick Search Prompt -->
          <div class="mt-32 pt-24 border-t border-border dark:border-border-dark flex items-center justify-between gap-16">
            <p class="text-caption font-sans text-muted dark:text-muted-dark">
              Looking for something specific? Press <kbd class="rounded-4 border border-border bg-surface2 px-6 py-2 text-xs font-mono text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark">⌘K</kbd> to search the publication.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>