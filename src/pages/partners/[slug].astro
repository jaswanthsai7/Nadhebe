---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import FAQSection from '@/components/FAQSection.astro';
import ProsCons from '@/components/ProsCons.astro';
import PartnerIcon from '@/components/PartnerIcon.astro';
import { getAllActiveAffiliates, buildUtmUrl, type AffiliateProgram } from '@/config/affiliates';
import { getArticleUrl } from '@/utils/content';

export async function getStaticPaths() {
  const activePrograms = getAllActiveAffiliates();
  return activePrograms.map((program) => ({
    params: { slug: program.id },
    props: { program },
  }));
}

interface Props {
  program: AffiliateProgram;
}

const { program } = Astro.props;

// Fetch related tutorials and videos
const allTutorials = await getCollection('tutorials');
const allVideos = await getCollection('youtube-articles');
const allArticles = [...allTutorials, ...allVideos];

const targetTopics = (program as any).targetTopics || [program.name, program.id, program.category];
const relatedGuides = allArticles
  .filter((article) => {
    const text = (
      article.data.title +
      ' ' +
      article.data.description +
      ' ' +
      (article.data.topic || '') +
      ' ' +
      (article.data.tags || []).join(' ')
    ).toLowerCase();

    return targetTopics.some((topic: string) => text.includes(topic.toLowerCase()));
  })
  .slice(0, 4);

const pageTitle = `${program.name} Review, Setup & Alternatives — Nadhebe`;
const pageDescription = `In-depth developer review of ${program.name}. Explore features, setup guides, real-world usage, pricing breakdown, alternatives comparison, and FAQs.`;
const canonicalUrl = new URL(`/partners/${program.id}/`, Astro.site || Astro.url.origin).toString();
const utmUrl = buildUtmUrl(program.affiliateUrl || (program as any).url || '', `partner-page-${program.id}`);

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Partners', href: '/partners/' },
  { name: program.name, href: `/partners/${program.id}/` },
];

// SoftwareApplication / Product JSON-LD Schema
const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: program.name,
  operatingSystem: 'All',
  applicationCategory: program.category === 'cloud-gpu' ? 'DeveloperApplication' : 'MultimediaApplication',
  description: program.description,
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'PriceSpecification',
      description: program.pricingSummary,
    },
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: (program.ratingValue || 4.8).toString(),
    ratingCount: (program.ratingCount || 150).toString(),
    bestRating: '5',
    worstRating: '1',
  },
};

const faqSchema = program.faq && program.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: program.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const jsonLd = [softwareAppSchema, faqSchema].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <main class="mx-auto max-w-screen-xl px-12 sm:px-24 py-32 sm:py-64" data-reveal>
    <Breadcrumb items={breadcrumbItems} />

    {/* Hero Section */}
    <header class="mt-16 sm:mt-24 mb-32 sm:mb-48 rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-48 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-accent/0 via-accent to-accent/0 dark:from-accent-dark/0 dark:via-accent-dark dark:to-accent-dark/0"></div>
      
      <div class="flex flex-wrap items-center justify-between gap-16 mb-24">
        <div class="flex flex-wrap items-center gap-12">
          <span class="badge uppercase tracking-wider text-[11px] font-semibold">{program.category}</span>
          <span class="inline-flex items-center gap-6 rounded-pill bg-success/10 px-12 py-4 text-xs font-medium text-success dark:bg-success-dark/15 dark:text-success-dark border border-success/20 dark:border-success-dark/20">
            {program.trustSignal}
          </span>
          <span class="inline-flex items-center gap-6 rounded-pill bg-accent/10 px-12 py-4 text-xs font-medium text-accent dark:bg-accent-dark/15 dark:text-accent-dark border border-accent/20 dark:border-accent-dark/20">
            {program.qualitativeBadge || 'Editor Choice'}
          </span>
        </div>

        <a href="/partners/" class="text-xs font-sans font-medium text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark transition-colors flex items-center gap-4">
          <span>← Browse All Partners</span>
        </a>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-20">
        <PartnerIcon slug={program.id} size={48} class="shadow-md" />
        <div>
          <h1 class="font-display text-display font-bold text-ink dark:text-ink-dark leading-tight">
            {program.name} Review & Developer Guide
          </h1>
          <p class="mt-12 text-body-large text-ink2 dark:text-ink2-dark max-w-2xl leading-relaxed">
            {program.description}
          </p>
        </div>
      </div>

      <div class="mt-32 pt-24 border-t border-border/50 dark:border-border-dark/50 flex flex-wrap items-center justify-between gap-20">
        <a
          href={utmUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="group inline-flex items-center gap-10 rounded-12 bg-ink px-28 py-14 text-body-small font-bold text-surface transition-all duration-200 hover:bg-ink2 dark:bg-ink-dark dark:text-surface-dark dark:hover:bg-ink2-dark shadow-md"
        >
          <span>{(program as any).buttonLabel || `Get Started with ${program.name}`}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16 shrink-0 transition-transform duration-200 group-hover:translate-x-1" style="width:16px;height:16px;">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>

        <div class="flex items-center gap-16">
          <div class="rounded-10 bg-surface2/80 dark:bg-surface2-dark/80 border border-border dark:border-border-dark px-16 py-10 text-xs font-mono text-ink2 dark:text-ink2-dark">
            Pricing: <strong class="text-ink dark:text-ink-dark">{program.pricingSummary}</strong>
          </div>
          <div class="text-xs font-sans text-amber-500 flex items-center gap-4 font-bold">
            ★ {program.ratingValue || 4.8} / 5.0 ({program.ratingCount || 150} reviews)
          </div>
        </div>
      </div>
    </header>

    {/* Who Should Use Section */}
    {program.targetAudience && program.targetAudience.length > 0 && (
      <section class="mb-48 rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-40">
        <div class="flex items-center gap-12 mb-20">
          <div class="flex h-36 w-36 items-center justify-center rounded-8 bg-accent/15 dark:bg-accent-dark/20 text-accent dark:text-accent-dark">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-20 w-20" style="width:20px;height:20px;">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark">
            Who Should Use {program.name}?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-20">
          {program.targetAudience.map((audience) => (
            <div class="rounded-12 border border-border/70 dark:border-border-dark/70 bg-surface/60 dark:bg-surface-dark/60 p-20 shadow-sm">
              <div class="text-accent dark:text-accent-dark mb-10">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-18 w-18" style="width:18px;height:18px;">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </div>
              <p class="text-body-small font-sans text-ink dark:text-ink-dark leading-relaxed font-medium">
                {audience}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Editorial Deep Dive Content */}
    <section class="mb-48 rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-40">
      <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark mb-20">
        In-Depth Analysis & Real-World Usage
      </h2>
      <div class="space-y-20 text-body text-ink2 dark:text-ink2-dark leading-relaxed">
        <p class="font-medium text-ink dark:text-ink-dark">
          {program.whyRecommend}
        </p>
        {program.deepDiveText && program.deepDiveText.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    {/* Alternatives & Competitive Comparison */}
    {program.alternatives && program.alternatives.length > 0 && (
      <section class="mb-48 rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-40">
        <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark mb-12">
          {program.name} Alternatives & Comparison
        </h2>
        <p class="text-caption text-muted dark:text-muted-dark mb-24">
          How {program.name} stacks up against top competitors in performance, pricing, and suitability:
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-border dark:border-border-dark text-xs uppercase tracking-wider font-sans text-muted dark:text-muted-dark">
                <th class="py-12 px-16">Alternative</th>
                <th class="py-12 px-16">Comparison Breakdown</th>
                <th class="py-12 px-16">Pricing</th>
                <th class="py-12 px-16">Best For</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/50 dark:divide-border-dark/50 text-body-small">
              <tr class="bg-accent/5 dark:bg-accent-dark/5 font-semibold">
                <td class="py-16 px-16 text-ink dark:text-ink-dark">{program.name} (Current)</td>
                <td class="py-16 px-16 text-ink2 dark:text-ink2-dark">{program.description}</td>
                <td class="py-16 px-16 text-ink dark:text-ink-dark">{program.pricingSummary}</td>
                <td class="py-16 px-16 text-accent dark:text-accent-dark">{program.qualitativeBadge}</td>
              </tr>
              {program.alternatives.map((alt) => (
                <tr>
                  <td class="py-16 px-16 font-bold text-ink dark:text-ink-dark">{alt.name}</td>
                  <td class="py-16 px-16 text-ink2 dark:text-ink2-dark">{alt.comparison}</td>
                  <td class="py-16 px-16 font-mono text-ink dark:text-ink-dark">{alt.pricing}</td>
                  <td class="py-16 px-16 text-ink2 dark:text-ink2-dark">{alt.bestFor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* Pricing Breakdown Section */}
    {program.pricingDetails && program.pricingDetails.length > 0 && (
      <section class="mb-48 rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-40">
        <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark mb-24">
          Detailed Pricing & Plan Breakdown
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-20">
          {program.pricingDetails.map((plan) => (
            <div class="rounded-12 border border-border dark:border-border-dark bg-surface2/60 dark:bg-surface2-dark/60 p-24">
              <span class="badge mb-8 inline-block">{plan.plan}</span>
              <div class="font-display text-h3 font-bold text-ink dark:text-ink-dark mb-12">
                {plan.price}
              </div>
              <p class="text-xs font-sans text-ink2 dark:text-ink2-dark">
                {plan.features}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Key Capabilities & Pros/Cons */}
    <section class="mb-64 grid grid-cols-1 md:grid-cols-2 gap-32">
      <div class="rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-32">
        <div class="flex items-center gap-12 mb-20">
          <PartnerIcon slug={program.id} size={24} />
          <h3 class="font-display text-h3 font-bold text-ink dark:text-ink-dark">
            Key Capabilities
          </h3>
        </div>
        <ul class="space-y-16">
          {((program as any).features || program.pros || []).map((feat: string) => (
            <li class="flex items-start gap-12 text-body-small text-ink2 dark:text-ink2-dark">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-3 h-16 w-16 shrink-0 text-success dark:text-success-dark" style="width:16px;height:16px;">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{feat}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-h3 font-bold text-ink dark:text-ink-dark mb-20">
          Pros & Trade-offs
        </h3>
        <ProsCons pros={program.pros || []} cons={program.cons || []} />
      </div>
    </section>

    {/* Related Tutorials */}
    {relatedGuides.length > 0 && (
      <section class="mb-64 border-t border-border dark:border-border-dark pt-48">
        <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark mb-12">
          Related Guides & Tutorials
        </h2>
        <p class="text-caption text-muted dark:text-muted-dark mb-24">
          Practical step-by-step guides using {program.name} in production:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-20">
          {relatedGuides.map((guide) => (
            <a href={getArticleUrl(guide)} class="card p-24 block group">
              <span class="badge mb-8">{guide.collection}</span>
              <h3 class="font-display text-h4 font-bold text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors duration-150 mb-8">
                {guide.data.title}
              </h3>
              <p class="text-xs font-sans text-muted dark:text-muted-dark line-clamp-2">
                {guide.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* FAQ */}
    {program.faq && program.faq.length > 0 && (
      <section class="mb-64 glass-panel rounded-16 p-24 sm:p-32 border border-border dark:border-border-dark">
        <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark mb-24">
          Frequently Asked Questions
        </h2>
        <FAQSection items={program.faq} />
      </section>
    )}

    {/* Bottom CTA Card */}
    <section class="rounded-16 bg-surface2 dark:bg-surface2-dark border border-border dark:border-border-dark p-32 sm:p-48 text-center relative overflow-hidden">
      <div class="mx-auto max-w-xl">
        <div class="mx-auto mb-16 flex justify-center">
          <PartnerIcon slug={program.id} size={48} />
        </div>
        <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark mb-12">
          Ready to try {program.name}?
        </h2>
        <p class="text-body-small text-ink2 dark:text-ink2-dark mb-24">
          Explore official documentation and claim available developer credits or free tiers.
        </p>
        <a
          href={utmUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="group inline-flex items-center gap-10 rounded-12 bg-ink px-32 py-16 text-body-small font-bold text-surface transition-all duration-200 hover:bg-ink2 dark:bg-ink-dark dark:text-surface-dark dark:hover:bg-ink2-dark shadow-md"
        >
          <span>Visit {program.name}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16 shrink-0 transition-transform duration-200 group-hover:translate-x-1" style="width:16px;height:16px;">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
