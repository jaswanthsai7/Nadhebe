---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Newsletter from '@/components/Newsletter.astro';
import { ARCHIVED_ISSUES, type NewsletterIssue } from '@/config/newsletter';
import { getArticleUrl } from '@/utils/content';

export async function getStaticPaths() {
  return ARCHIVED_ISSUES.map((issue) => ({
    params: { slug: issue.slug },
    props: { issue },
  }));
}

interface Props {
  issue: NewsletterIssue;
}

const { issue } = Astro.props;

// Fetch related tutorials
const allTutorials = await getCollection('tutorials');
const relatedTutorials = allTutorials.filter((t) =>
  issue.relatedTutorialSlugs?.includes(t.slug)
);

const pageTitle = `${issue.title} — Nadhebe Weekly Briefing`;
const pageDescription = issue.summary;
const canonicalUrl = new URL(`/newsletter/archive/${issue.slug}`, Astro.site || Astro.url.origin).toString();

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Newsletter', href: '/newsletter' },
  { name: 'Archive', href: '/newsletter/archive' },
  { name: `Brief #${issue.issueNumber}`, href: `/newsletter/archive/${issue.slug}` },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <main class="mx-auto max-w-article px-12 sm:px-24 py-32 sm:py-64" data-reveal>
    <Breadcrumb items={breadcrumbItems} />

    <header class="mt-16 sm:mt-24 mb-32 rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-40">
      <div class="flex items-center gap-12 mb-16">
        <span class="badge">Brief #{issue.issueNumber}</span>
        <time class="font-mono text-meta text-muted dark:text-muted-dark">{issue.pubDate}</time>
      </div>

      <h1 class="font-display text-h1 font-bold text-ink dark:text-ink-dark leading-tight">
        {issue.title}
      </h1>

      <p class="mt-16 text-body-large text-ink2 dark:text-ink2-dark leading-relaxed">
        {issue.summary}
      </p>

      <div class="mt-20 flex flex-wrap gap-8">
        {issue.topics.map((topic) => (
          <span class="rounded-pill bg-accent/10 px-10 py-4 text-xs font-semibold text-accent dark:bg-accent-dark/15 dark:text-accent-dark border border-accent/20 dark:border-accent-dark/20">
            {topic}
          </span>
        ))}
      </div>
    </header>

    {/* Key Takeaways */}
    <section class="mb-48 rounded-16 border border-border bg-surface p-24 sm:p-32 dark:border-border-dark dark:bg-surface-dark shadow-sm">
      <h2 class="font-display text-h3 font-bold text-ink dark:text-ink-dark mb-16">
        Key Issue Takeaways
      </h2>
      <ul class="space-y-12">
        {issue.takeaways.map((takeaway) => (
          <li class="flex items-start gap-12 text-caption text-ink2 dark:text-ink2-dark">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-2 h-16 w-16 shrink-0 text-success dark:text-success-dark" style="width:16px;height:16px;">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span class="leading-relaxed font-medium">{takeaway}</span>
          </li>
        ))}
      </ul>
    </section>

    {/* Related Tutorials */}
    {relatedTutorials.length > 0 && (
      <section class="mb-48 border-t border-border dark:border-border-dark pt-32">
        <h2 class="font-display text-h3 font-bold text-ink dark:text-ink-dark mb-16">
          Related Step-by-Step Tutorials
        </h2>
        <div class="space-y-16">
          {relatedTutorials.map((tut) => (
            <a href={getArticleUrl(tut)} class="card p-20 block group">
              <span class="badge mb-6">{tut.collection}</span>
              <h3 class="font-display text-h4 font-bold text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors mb-4">
                {tut.data.title}
              </h3>
              <p class="text-xs font-sans text-muted dark:text-muted-dark line-clamp-2">
                {tut.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Inline Newsletter Capture */}
    <div class="mt-64">
      <Newsletter showPreferences={true} source="archive_issue_page" />
    </div>
  </main>
</BaseLayout>
