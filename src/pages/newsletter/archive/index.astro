---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { ARCHIVED_ISSUES } from '@/config/newsletter';

const pageTitle = 'Weekly AI Engineering Brief Archive — Nadhebe';
const pageDescription = 'Explore past issues of Nadhebe Weekly AI Engineering Briefing. Practical deep dives into Claude, MCP, vLLM, and open-source AI.';
const canonicalUrl = new URL('/newsletter/archive', Astro.site || Astro.url.origin).toString();

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Newsletter', href: '/newsletter' },
  { name: 'Archive', href: '/newsletter/archive' },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <main class="mx-auto max-w-screen-xl px-12 sm:px-24 py-32 sm:py-64" data-reveal>
    <Breadcrumb items={breadcrumbItems} />

    <header class="mt-16 sm:mt-24 mb-32 sm:mb-48">
      <span class="badge mb-16 inline-block">Public Archive</span>
      <h1 class="font-display text-display font-bold text-ink dark:text-ink-dark leading-tight">
        Weekly AI Engineering Brief Archive
      </h1>
      <p class="mt-12 text-body-large text-ink2 dark:text-ink2-dark max-w-2xl leading-relaxed">
        Read previous editions online. Every issue contains technical breakdowns, benchmark analysis, and production code snippets.
      </p>
    </header>

    <div class="space-y-24 max-w-4xl">
      {ARCHIVED_ISSUES.map((issue) => (
        <article class="rounded-16 glass-panel border border-border dark:border-border-dark p-24 sm:p-32 transition-all hover:border-accent/30 dark:hover:border-accent-dark/30 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-12 mb-12">
            <div class="flex items-center gap-12">
              <span class="badge">Brief #{issue.issueNumber}</span>
              <time class="font-mono text-meta text-muted dark:text-muted-dark">{issue.pubDate}</time>
            </div>
            <div class="flex flex-wrap gap-6">
              {issue.topics.map((topic) => (
                <span class="rounded-pill bg-surface2 px-8 py-2 text-[0.65rem] font-semibold text-muted dark:bg-surface2-dark dark:text-muted-dark border border-border/40 dark:border-border-dark/40">
                  {topic}
                </span>
              ))}
            </div>
          </div>

          <h2 class="font-display text-h3 font-bold text-ink dark:text-ink-dark mb-12">
            <a href={`/newsletter/archive/${issue.slug}`} class="hover:text-accent dark:hover:text-accent-dark transition-colors">
              {issue.title}
            </a>
          </h2>

          <p class="text-caption text-ink2 dark:text-ink2-dark mb-16 leading-relaxed">
            {issue.summary}
          </p>

          {issue.takeaways.length > 0 && (
            <div class="mb-20 rounded-10 bg-surface2/60 p-16 dark:bg-surface2-dark/60 border border-border/40 dark:border-border-dark/40">
              <p class="text-xs font-sans font-bold uppercase tracking-wider text-muted dark:text-muted-dark mb-8">
                Key Takeaways:
              </p>
              <ul class="space-y-6">
                {issue.takeaways.map((takeaway) => (
                  <li class="flex items-start gap-8 text-xs font-sans text-ink2 dark:text-ink2-dark">
                    <span class="text-accent dark:text-accent-dark font-bold">▪</span>
                    <span>{takeaway}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <a href={`/newsletter/archive/${issue.slug}`} class="inline-flex items-center gap-6 text-xs font-bold text-accent dark:text-accent-dark hover:underline">
            <span>Read full brief online</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-12 w-12 shrink-0" style="width:12px;height:12px;">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
