---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Compound Interest & Investment Growth Calculator | Nadhebe';
const h1 = 'Compound Interest & Investment Growth Calculator';
const description = 'Calculate compound interest growth, annual compounding returns, and recurring monthly contributions client-side for financial planning.';

const faq = [
  {
    question: 'What is Compound Interest?',
    answer: 'Compound interest is interest calculated on the initial principal balance plus all of the accumulated interest from previous periods.',
  },
  {
    question: 'What is the Compound Interest formula?',
    answer: '`A = P(1 + r/n)^(nt)` where `P` is principal, `r` is annual interest rate, `n` is compounding frequency per year, and `t` is time in years.',
  },
  {
    question: 'How do monthly recurring contributions affect investment growth?',
    answer: 'Adding monthly deposits compounds exponential growth significantly faster over long time horizons (10-30 years) due to dollar-cost averaging.',
  },
  {
    question: 'Is my financial data uploaded to external servers?',
    answer: '100% private. All financial calculations run locally in your web browser.',
  },
  {
    question: 'What compounding frequencies are supported?',
    answer: 'Supports Annual, Semi-Annual, Quarterly, Monthly, and Daily compounding schedules.',
  },
];
---

<ToolLayout
  toolId="compound-interest"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="ci-calculator-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="INVESTMENT PARAMETERS">
        <div class="space-y-16">
          <div>
            <label for="ci-input-principal" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Initial Investment Principal ($)</label>
            <input
              id="ci-input-principal"
              type="number"
              min="0"
              step="1000"
              value="10000"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="ci-input-monthly" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Monthly Recurring Deposit ($)</label>
            <input
              id="ci-input-monthly"
              type="number"
              min="0"
              step="100"
              value="500"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="ci-input-rate" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Estimated Annual Interest Rate (%)</label>
            <input
              id="ci-input-rate"
              type="number"
              min="0.1"
              max="30"
              step="0.5"
              value="8.0"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="ci-input-years" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Investment Horizon (Years)</label>
            <input
              id="ci-input-years"
              type="number"
              min="1"
              max="50"
              step="1"
              value="20"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <button
            type="button"
            id="btn-calc-ci"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Calculate Growth Balance
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="FUTURE INVESTMENT BALANCE">
        <div class="space-y-20">
          
          <div class="grid grid-cols-2 gap-12 font-mono text-center">
            <div class="rounded-12 border border-emerald-500/30 bg-emerald-500/10 p-16">
              <div id="stat-ci-total" class="text-h2 font-bold text-emerald-800 dark:text-emerald-300">$346,038</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Total Future Balance</div>
            </div>
            <div class="rounded-12 border border-border bg-surface2/60 p-16 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-ci-interest" class="text-h2 font-bold text-accent dark:text-accent-dark">$216,038</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Total Interest Earned</div>
            </div>
          </div>

          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Total Out-of-Pocket Deposits:</span>
              <span id="stat-ci-deposits" class="font-bold text-ink dark:text-ink-dark">$130,000</span>
            </div>
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Interest Earned Multiplier:</span>
              <span id="stat-ci-mult" class="font-bold text-emerald-600 dark:text-emerald-400">2.66x Total Principal</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <span>Effective APY (Monthly Compound):</span>
              <span id="stat-ci-apy" class="font-bold text-ink dark:text-ink-dark">8.30% APY</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Exponential Growth & Compound Interest Guide</h2>
    <p>
      The Rule of 72 and monthly compounding illustrate how early investments snowball over time. Consistent recurring monthly deposits turn modest savings into substantial wealth.
    </p>

    <h3>Mathematical Formulation</h3>
    <ul>
      <li><strong>Principal Growth Formula</strong>: P * (1 + r/n)^(nt)</li>
      <li><strong>Future Value of Recurring Series</strong>: PMT * [((1 + r/n)^(nt) - 1) / (r/n)]</li>
    </ul>

    <h3>Related Financial Calculators</h3>
    <p>
      Calculate SaaS metrics with the <a href="/tools/cac-payback/">CAC Payback Calculator</a>, calculate profit margins with the <a href="/tools/profit-margin-calculator/">Profit Margin Calculator</a>, or estimate AI API costs with the <a href="/tools/openai-cost-estimator/">OpenAI Cost Estimator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputPrincipal = document.getElementById('ci-input-principal');
    const inputMonthly = document.getElementById('ci-input-monthly');
    const inputRate = document.getElementById('ci-input-rate');
    const inputYears = document.getElementById('ci-input-years');
    const btnCalc = document.getElementById('btn-calc-ci');

    const statTotal = document.getElementById('stat-ci-total');
    const statInterest = document.getElementById('stat-ci-interest');
    const statDeposits = document.getElementById('stat-ci-deposits');
    const statMult = document.getElementById('stat-ci-mult');
    const statApy = document.getElementById('stat-ci-apy');

    function calculate() {
      const P = parseFloat(inputPrincipal?.value || '10000');
      const PMT = parseFloat(inputMonthly?.value || '500');
      const r = parseFloat(inputRate?.value || '8.0') / 100;
      const t = parseFloat(inputYears?.value || '20');
      const n = 12; // monthly

      const ratePerPeriod = r / n;
      const totalPeriods = n * t;

      const fvPrincipal = P * Math.pow(1 + ratePerPeriod, totalPeriods);
      const fvSeries = PMT * ((Math.pow(1 + ratePerPeriod, totalPeriods) - 1) / ratePerPeriod);

      const totalFV = fvPrincipal + fvSeries;
      const totalDeposits = P + (PMT * totalPeriods);
      const totalInterest = totalFV - totalDeposits;

      const mult = totalDeposits > 0 ? (totalFV / totalDeposits) : 0;
      const apy = (Math.pow(1 + ratePerPeriod, 12) - 1) * 100;

      if (statTotal) statTotal.textContent = `$${Math.round(totalFV).toLocaleString()}`;
      if (statInterest) statInterest.textContent = `$${Math.round(totalInterest).toLocaleString()}`;
      if (statDeposits) statDeposits.textContent = `$${Math.round(totalDeposits).toLocaleString()}`;
      if (statMult) statMult.textContent = `${mult.toFixed(2)}x Total Principal`;
      if (statApy) statApy.textContent = `${apy.toFixed(2)}% APY`;
    }

    btnCalc?.addEventListener('click', calculate);
    [inputPrincipal, inputMonthly, inputRate, inputYears].forEach(el => {
      el?.addEventListener('input', calculate);
    });

    calculate();
  })();
</script>
