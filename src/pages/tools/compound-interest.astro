---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'compound-interest');
if (!platformTool) throw new Error('Tool not found');

const faq = [
  {
    question: 'What is compound interest?',
    answer: 'Compound interest is the interest on a loan or deposit calculated based on both the initial principal and the accumulated interest from previous periods. It essentially means you earn "interest on your interest," which makes your money grow faster over time.',
  },
  {
    question: 'How does compounding frequency affect my returns?',
    answer: 'The more frequently interest is compounded, the faster your money grows. For example, monthly compounding will yield slightly higher returns than annual compounding at the same interest rate, because the interest is added to your principal more often.',
  }
];
---

<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} faq={faq} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="max-w-4xl mx-auto py-16 space-y-16">
    <div class="glass-panel p-24 md:p-32 rounded-24 border border-border bg-surface/95 shadow-large dark:border-border-dark dark:bg-surface-dark/95">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-32">
        
        <!-- Input Form -->
        <div class="space-y-24">
          <h3 class="text-lg font-bold text-ink dark:text-ink-dark font-sans tracking-tight">Investment Details</h3>
          
          <div class="space-y-16">
            <div class="space-y-8 relative">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Initial Investment ($)</label>
              <input type="number" id="principal" value="10000" class="w-full p-12 pl-32 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all" />
              <span class="absolute left-12 top-[34px] font-mono text-muted dark:text-muted-dark font-bold">$</span>
            </div>

            <div class="space-y-8 relative">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Monthly Contribution ($)</label>
              <input type="number" id="contribution" value="500" class="w-full p-12 pl-32 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all" />
              <span class="absolute left-12 top-[34px] font-mono text-muted dark:text-muted-dark font-bold">$</span>
            </div>

            <div class="grid grid-cols-2 gap-16">
              <div class="space-y-8 relative">
                <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Years</label>
                <input type="number" id="years" value="10" min="1" max="100" class="w-full p-12 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all" />
              </div>
              <div class="space-y-8 relative">
                <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Interest Rate (%)</label>
                <input type="number" id="rate" value="7" step="0.1" class="w-full p-12 pr-32 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all" />
                <span class="absolute right-12 top-[34px] font-mono text-muted dark:text-muted-dark font-bold">%</span>
              </div>
            </div>

            <div class="space-y-8">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Compound Frequency</label>
              <select id="frequency" class="w-full p-12 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-sans text-sm font-semibold text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all appearance-none cursor-pointer">
                <option value="1">Annually (1/yr)</option>
                <option value="2">Semi-Annually (2/yr)</option>
                <option value="4">Quarterly (4/yr)</option>
                <option value="12" selected>Monthly (12/yr)</option>
                <option value="365">Daily (365/yr)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Output Results -->
        <div class="flex flex-col justify-center space-y-24 bg-surface2/50 dark:bg-surface2-dark/50 p-24 md:p-32 rounded-24 border border-border/50 dark:border-border-dark/50">
          <div class="space-y-8 text-center">
            <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Future Balance</h3>
            <div id="total-balance" class="text-4xl md:text-5xl font-black text-emerald-600 dark:text-emerald-400 tracking-tight">
              $0.00
            </div>
          </div>

          <div class="h-px w-full bg-border/50 dark:bg-border-dark/50"></div>

          <div class="space-y-16">
            <div class="flex justify-between items-center">
              <span class="text-sm font-semibold text-ink2 dark:text-ink2-dark">Total Principal</span>
              <span id="total-principal" class="font-mono font-bold text-ink dark:text-ink-dark">$0.00</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm font-semibold text-ink2 dark:text-ink2-dark">Total Contributions</span>
              <span id="total-contributions" class="font-mono font-bold text-ink dark:text-ink-dark">$0.00</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm font-semibold text-ink2 dark:text-ink2-dark">Total Interest Earned</span>
              <span id="total-interest" class="font-mono font-bold text-emerald-600 dark:text-emerald-400">$0.00</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div slot="content">
    <h2>Calculate Your Investment Growth</h2>
    <p>Compound interest is often referred to as the eighth wonder of the world. By reinvesting the interest you earn, your wealth grows exponentially over time. Use this calculator to model different investment scenarios, from a simple savings account to long-term stock market investments.</p>
  </div>
</ToolLayout>

<script>
  function setupCompoundInterest() {
    const inputPrincipal = document.getElementById('principal') as HTMLInputElement;
    const inputContribution = document.getElementById('contribution') as HTMLInputElement;
    const inputYears = document.getElementById('years') as HTMLInputElement;
    const inputRate = document.getElementById('rate') as HTMLInputElement;
    const selectFreq = document.getElementById('frequency') as HTMLSelectElement;

    const outTotal = document.getElementById('total-balance');
    const outPrincipal = document.getElementById('total-principal');
    const outContributions = document.getElementById('total-contributions');
    const outInterest = document.getElementById('total-interest');

    const formatter = new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
    });

    function calculate() {
      if (!inputPrincipal || !outTotal) return;

      const P = parseFloat(inputPrincipal.value) || 0;
      const PMT = parseFloat(inputContribution.value) || 0;
      const t = parseFloat(inputYears.value) || 0;
      const r = (parseFloat(inputRate.value) || 0) / 100;
      const n = parseInt(selectFreq.value) || 12;

      // Compound interest for principal: P(1 + r/n)^(nt)
      const compoundPrincipal = P * Math.pow(1 + r/n, n*t);

      // Future value of a series (contributions made at the END of each period)
      // If contributions are monthly but compounding is different, the math gets complicated.
      // Standard assumption: PMT frequency matches compounding frequency.
      // If PMT is monthly, let's adjust it to match the compound frequency for a simplified model,
      // or we just calculate it properly. To keep it standard: assume PMT is made at the compound frequency.
      // E.g. if Monthly contribution is $500, annual contribution is $6000.
      
      const pmtFreqAdj = PMT * (12 / n); // Convert monthly PMT to period PMT
      
      let compoundContributions = 0;
      if (r === 0) {
        compoundContributions = pmtFreqAdj * (n * t);
      } else {
        compoundContributions = pmtFreqAdj * ((Math.pow(1 + r/n, n*t) - 1) / (r/n));
      }

      const A = compoundPrincipal + compoundContributions;
      const totalContributionsMade = PMT * 12 * t;
      const totalInterest = A - P - totalContributionsMade;

      if (outTotal) outTotal.textContent = formatter.format(A);
      if (outPrincipal) outPrincipal.textContent = formatter.format(P);
      if (outContributions) outContributions.textContent = formatter.format(totalContributionsMade);
      if (outInterest) outInterest.textContent = formatter.format(totalInterest);
    }

    const inputs = [inputPrincipal, inputContribution, inputYears, inputRate, selectFreq];
    inputs.forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    calculate();
  }

  setupCompoundInterest();
</script>
