            <div class="flex items-center gap-8">
              <span class="w-24 h-24 rounded-8 bg-emerald-500 text-white flex items-center justify-center text-xs font-bold">🛡️</span>
              <span class="text-caption font-bold text-ink dark:text-ink-dark">Extension Popup</span>
            </div>
            <span id="popup-status-badge" class="px-8 py-3 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
              ACTIVE
            </span>
          </div>

          <!-- TOTAL BLOCKED STAT -->
          <div class="p-16 rounded-16 bg-surface2 dark:bg-surface2-dark border border-border dark:border-border-dark text-center space-y-4">
            <span class="text-xs font-mono text-muted dark:text-muted-dark uppercase tracking-wider">Total Blocked on Page</span>
            <div id="sim-blocked-count" class="text-4xl font-display font-bold text-rose-500 dark:text-rose-400">
              4
            </div>
            <p class="text-[11px] text-muted dark:text-muted-dark">Zero layout shift • Inpainted smoothly</p>
          </div>

          <!-- BLOCKED ITEMS BREAKDOWN -->
          <div class="space-y-8">
            <div class="flex items-center justify-between text-xs font-bold text-muted dark:text-muted-dark">
              <span>BLOCKED ADS &amp; PROMOS</span>
              <span id="sim-item-count-text">4 detected</span>
            </div>

            <div id="sim-blocked-ledger" class="space-y-6 max-h-56 overflow-y-auto pr-4">
              <!-- Dynamically rendered by JS -->
            </div>
          </div>

          <div class="pt-8 border-t border-border dark:border-border-dark">
            <a
              href="https://chromewebstore.google.com/detail/oiopppgakilklffapfngfckonijjkggf?utm_source=item-share-cb"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-10 rounded-10 bg-accent hover:opacity-90 text-white text-caption font-bold flex items-center justify-center gap-8 transition-opacity shadow-subtle"
            >
              <svg class="w-16 h-16 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.897-2.492L1.931 5.47zm13.435 6.007a5.455 5.455 0 0 1-1.321 6.993L10.092 24H12c6.627 0 12-5.373 12-12 0-.337-.015-.67-.043-1h-7.907a5.454 5.454 0 0 1-.776.477zM12 7.636a4.364 4.364 0 1 0 0 8.728 4.364 4.364 0 0 0 0-8.728z"/>
              </svg>
              <span>Install to Block on ChatGPT (v1.1.0)</span>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- SECTION 2: CUSTOM AD BLOCKER RULE BUILDER & GENERATOR -->
    <div id="customizer-section" class="glass-panel rounded-24 border border-border dark:border-border-dark p-20 sm:p-32 bg-surface/60 dark:bg-surface-dark/60 shadow-soft space-y-24">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-16 border-b border-border/80 dark:border-border-dark/80 pb-20">
        <div>
          <div class="flex items-center gap-8">
            <span class="text-xl">🛠️</span>
            <h2 class="text-h3 font-display font-bold text-ink dark:text-ink-dark m-0">
              Custom Rule Generator &amp; Extension Packager
            </h2>
          </div>
          <p class="text-caption sm:text-body text-muted dark:text-muted-dark mt-4 m-0">
            Customize which phrases, partner brands, and CSS selectors to filter. Export a customized ZIP package instantly!
          </p>
        </div>

        <div class="flex items-center gap-8">
          <button
            type="button"
            id="btn-export-custom-zip"
            class="inline-flex items-center gap-8 px-18 py-10 rounded-10 font-sans text-caption font-bold text-white bg-emerald-600 hover:bg-emerald-500 transition-colors shadow-subtle cursor-pointer"
          >
            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span id="custom-zip-btn-text">Generate &amp; Download Custom ZIP</span>
