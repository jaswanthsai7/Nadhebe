---
import ToolLayout from '@/components/tools/ToolLayout.astro';

const title = 'ChatGPT Ad Blocker - Remove Upsells, Promos & Partner Ads | Nadhebe';
const h1 = 'ChatGPT Ad & Promo Blocker';
const description = 'Block ChatGPT Plus/Pro upgrade banners, partner app suggestions, and sponsored ads with a free, private Manifest V3 Chrome extension & custom rule generator.';
const canonicalUrl = 'https://nadhebe.com/tools/chatgpt-ad-blocker/';

const faq = [
  {
    question: 'How does the ChatGPT Ad Blocker work without breaking the chat interface?',
    answer: 'The ChatGPT Ad Blocker uses a dual-engine approach: (1) declarative CSS injected at document_start to instantly hide known data-testid and aria-label ad containers with zero layout flash, and (2) a MutationObserver combined with a lightweight TreeWalker in JavaScript that scans new dynamic React DOM nodes for promo phrases and partner brand cards, climbing only to the nearest card container without affecting chat message threads.',
  },
  {
    question: 'Is the ChatGPT Ad Blocker extension safe and private?',
    answer: 'Yes, 100%. The extension is open source, operates entirely locally in your browser memory, requests only minimal required permissions (storage and chatgpt.com host permissions), and executes zero telemetry, external network requests, or analytics calls.',
  },
  {
    question: 'Why do standard ad blockers like uBlock Origin miss some ChatGPT promo cards?',
    answer: 'ChatGPT is a dynamic Single Page Application (SPA) built with React and Tailwind-like compiled utility classes that change across deployments. Native partner integrations (such as Canva or Monday.com cards) and inline upgrade prompts are rendered dynamically inside the message stream rather than fetched from traditional advertising third-party domains, making domain-based network filters ineffective.',
  },
  {
    question: 'Can I install this extension on Brave, Microsoft Edge, Arc, and Opera?',
    answer: 'Yes. Because all these browsers are built on the Chromium engine and support Manifest V3, you can load the unpacked extension in developer mode on Google Chrome, Brave, Microsoft Edge, Arc Browser, Opera, and Vivaldi.',
  },
  {
    question: 'Can I add my own custom keywords or brand cards to block?',
    answer: 'Yes. Use the interactive Custom Rule Generator on this page to add your own promo keywords, select partner brands, and export a custom-built ZIP package or copy updated blocker.js scripts directly.',
  },
];
---

<ToolLayout
  toolId="chatgpt-ad-blocker"
  title={title}
  h1={h1}
  description={description}
  canonicalUrl={canonicalUrl}
  faq={faq}
>
  <div slot="calculator" class="w-full space-y-32" id="chatgpt-adblock-app">
    
    <!-- HERO / DOWNLOAD CARD -->
    <div class="glass-panel rounded-24 border border-border dark:border-border-dark p-24 sm:p-36 bg-surface/80 dark:bg-surface-dark/80 shadow-medium relative overflow-hidden">
      <div class="absolute -right-32 -top-32 w-96 h-96 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-24 relative z-10">
        <div class="space-y-12 max-w-2xl">
          <div class="flex flex-wrap items-center gap-8">
            <span class="inline-flex items-center gap-6 px-12 py-5 rounded-full text-caption font-mono font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
              <span class="w-8 h-8 rounded-full bg-emerald-500 animate-pulse"></span>
              MANIFEST V3 READY
            </span>
            <span class="px-10 py-4 rounded-full text-caption font-mono text-muted dark:text-muted-dark bg-surface2 dark:bg-surface2-dark border border-border dark:border-border-dark">
              100% PRIVATE • ZERO TELEMETRY
            </span>
            <span class="px-10 py-4 rounded-full text-caption font-mono text-accent dark:text-accent-dark bg-accent/10 border border-accent/20">
              v1.1.0 • CHROME • BRAVE • EDGE • ARC
            </span>
          </div>
          <h2 class="text-h2 sm:text-display font-display font-bold text-ink dark:text-ink-dark tracking-tight m-0">
            Clean, Ad-Free ChatGPT in One Click
          </h2>
          <p class="text-body text-muted dark:text-muted-dark leading-relaxed m-0">
            Block ChatGPT Plus/Pro upgrade banners, intrusive partner recommendation cards (Canva, Monday, Zillow), and sponsored badges. Install the verified Chrome extension, test live in our interactive sandbox, or customize detection rules below.
          </p>
        </div>

        <!-- QUICK ACTION BUTTONS -->
        <div class="w-full lg:w-auto shrink-0">
          <a
            href="https://chromewebstore.google.com/detail/oiopppgakilklffapfngfckonijjkggf?utm_source=item-share-cb"
            target="_blank"
            rel="noopener noreferrer"
            id="hero-cws-install-btn"
            class="inline-flex items-center justify-center gap-10 px-28 py-16 rounded-14 font-sans text-body font-bold text-white bg-accent hover:opacity-95 active:scale-98 transition-all shadow-medium hover:shadow-glow cursor-pointer group w-full sm:w-auto"
          >
            <!-- Chrome Icon -->
            <svg class="w-22 h-22 fill-current group-hover:scale-105 transition-transform" viewBox="0 0 24 24">
              <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.897-2.492L1.931 5.47zm13.435 6.007a5.455 5.455 0 0 1-1.321 6.993L10.092 24H12c6.627 0 12-5.373 12-12 0-.337-.015-.67-.043-1h-7.907a5.454 5.454 0 0 1-.776.477zM12 7.636a4.364 4.364 0 1 0 0 8.728 4.364 4.364 0 0 0 0-8.728z"/>
            </svg>
            <span>Add to Chrome (Free)</span>
            <span class="text-xs bg-white/20 px-8 py-2 rounded-full font-mono">v1.1.0 • 5.0 ★</span>
          </a>
        </div>
      </div>
    </div>

    <!-- SECTION 1: INTERACTIVE SANDBOX SIMULATOR -->
    <div id="sandbox-section" class="glass-panel rounded-24 border border-border dark:border-border-dark p-20 sm:p-32 bg-surface/60 dark:bg-surface-dark/60 shadow-soft space-y-24">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-16 border-b border-border/80 dark:border-border-dark/80 pb-20">
        <div>
          <div class="flex items-center gap-8">
            <span class="text-xl">🧪</span>
            <h2 class="text-h3 font-display font-bold text-ink dark:text-ink-dark m-0">
              Interactive ChatGPT Ad Blocker Simulator
            </h2>
          </div>
          <p class="text-caption sm:text-body text-muted dark:text-muted-dark mt-4 m-0">
            Test the live blocking algorithm against real simulated ChatGPT promo cards, partner widgets, and upsell banners.
          </p>
        </div>

        <!-- MASTER TOGGLE & STATS -->
        <div class="flex items-center gap-16 bg-surface2 dark:bg-surface2-dark p-8 px-16 rounded-16 border border-border dark:border-border-dark shrink-0">
          <div class="flex flex-col">
            <span class="text-xs font-mono text-muted dark:text-muted-dark uppercase tracking-wider">Status</span>
            <span id="sim-status-badge" class="text-caption font-bold text-emerald-600 dark:text-emerald-400">
              Active (Blocking)
            </span>
          </div>
          <label class="relative inline-flex items-center cursor-pointer" for="sim-master-toggle" aria-label="Toggle ChatGPT Blocker">
            <input type="checkbox" id="sim-master-toggle" class="sr-only peer" checked />
            <div class="w-48 h-26 bg-slate-300 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[3px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-22 after:w-22 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
      </div>

      <!-- SIMULATOR CONTROL BAR -->
      <div class="flex flex-wrap items-center justify-between gap-12 bg-surface2/60 dark:bg-surface2-dark/60 p-12 sm:p-16 rounded-16 border border-border/60 dark:border-border-dark/60">
        <div class="flex flex-wrap items-center gap-16 text-caption">
          <span class="font-bold text-ink dark:text-ink-dark">Active Filters:</span>
          <label class="inline-flex items-center gap-6 cursor-pointer text-ink dark:text-ink-dark">
            <input type="checkbox" id="filter-promos" checked class="w-16 h-16 rounded border-border text-accent focus:ring-accent" />
            <span>Upgrade Promos</span>
          </label>
          <label class="inline-flex items-center gap-6 cursor-pointer text-ink dark:text-ink-dark">
            <input type="checkbox" id="filter-partners" checked class="w-16 h-16 rounded border-border text-accent focus:ring-accent" />
            <span>Partner App Cards</span>
          </label>
          <label class="inline-flex items-center gap-6 cursor-pointer text-ink dark:text-ink-dark">
            <input type="checkbox" id="filter-sponsored" checked class="w-16 h-16 rounded border-border text-accent focus:ring-accent" />
            <span>Sponsored Ads</span>
          </label>
          <label class="inline-flex items-center gap-6 cursor-pointer text-ink dark:text-ink-dark">
            <input type="checkbox" id="filter-sidebar" checked class="w-16 h-16 rounded border-border text-accent focus:ring-accent" />
            <span>Sidebar Upsell</span>
          </label>
        </div>

        <button
          type="button"
          id="btn-sim-reset"
          class="px-12 py-6 rounded-8 text-xs font-semibold bg-surface dark:bg-surface-dark border border-border dark:border-border-dark hover:border-accent text-muted dark:text-muted-dark hover:text-ink transition-colors cursor-pointer"
        >
          🔄 Reset Simulation
        </button>
      </div>

      <!-- SIMULATED CHATGPT INTERFACE CONTAINER -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-20 items-start">
        
        <!-- MOCK CHATGPT WINDOW -->
        <div class="lg:col-span-8 rounded-20 border border-slate-700/40 bg-[#212121] text-slate-100 shadow-xl overflow-hidden font-sans">
          
          <!-- CHATGPT APP HEADER -->
          <div class="flex items-center justify-between px-16 py-12 border-b border-slate-800 bg-[#181818]">
            <div class="flex items-center gap-10">
              <span class="w-12 h-12 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-12 h-12 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-12 h-12 rounded-full bg-green-500/80 inline-block"></span>
              <span class="ml-8 text-xs font-mono text-slate-400">chatgpt.com</span>
            </div>
            <div class="flex items-center gap-8 text-xs font-semibold text-slate-300 bg-slate-800/80 px-10 py-4 rounded-8 border border-slate-700/60">
              <span>ChatGPT 4o</span>
              <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row min-h-[460px]">
            
            <!-- CHATGPT MOCK SIDEBAR -->
            <div class="w-full sm:w-56 bg-[#171717] p-12 border-r border-slate-800/80 flex flex-col justify-between shrink-0">
              <div class="space-y-8">
                <div class="flex items-center justify-between text-xs font-bold text-slate-400 px-8 py-6">
                  <span>Recent Chats</span>
                  <svg class="w-14 h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </div>
                <div class="px-8 py-6 rounded-8 bg-slate-800/50 text-xs text-slate-200 truncate">
                  🚀 Project Architecture Review
                </div>
                <div class="px-8 py-6 rounded-8 hover:bg-slate-800/30 text-xs text-slate-400 truncate">
                  📊 Astro SEO Strategy
                </div>
                <div class="px-8 py-6 rounded-8 hover:bg-slate-800/30 text-xs text-slate-400 truncate">
                  ⚡ Manifest V3 Service Worker
                </div>
              </div>

              <!-- SIDEBAR UPGRADE BANNER (SIMULATED AD ELEMENT #1) -->
              <div id="sim-ad-sidebar" class="transition-all duration-300 ease-in-out p-10 rounded-10 bg-gradient-to-r from-purple-900/40 to-pink-900/40 border border-purple-500/30 mt-16 space-y-6">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-purple-300">Upgrade plan</span>
                  <span class="text-[9px] font-mono px-4 py-1 rounded bg-purple-500/20 text-purple-200">PROMO</span>
                </div>
                <p class="text-[11px] text-slate-300 leading-tight">Get GPT-5 Turbo, DALL-E 3 & higher limits.</p>
                <button type="button" class="w-full py-4 text-center rounded-6 bg-purple-600 hover:bg-purple-500 text-white text-[11px] font-bold">
                  Upgrade to Plus
                </button>
              </div>
            </div>

            <!-- CHATGPT MOCK CONVERSATION VIEW -->
            <div class="flex-1 p-16 sm:p-24 space-y-20 bg-[#212121] overflow-y-auto">
              
              <!-- USER MESSAGE -->
              <div class="flex items-start gap-12 max-w-xl">
                <div class="w-28 h-28 rounded-full bg-slate-600 flex items-center justify-center text-xs font-bold shrink-0">
                  U
                </div>
                <div class="space-y-4">
                  <div class="text-xs font-bold text-slate-400">You</div>
                  <div class="text-xs text-slate-100 bg-slate-800 p-12 rounded-14 rounded-tl-none leading-relaxed">
                    Can you help me design a quarterly marketing campaign dashboard and project schedule?
                  </div>
                </div>
              </div>

              <!-- INLINE UPSELL PROMO (SIMULATED AD ELEMENT #2) -->
              <div id="sim-ad-upsell" class="transition-all duration-300 ease-in-out p-12 rounded-12 bg-amber-950/40 border border-amber-500/40 text-amber-200 flex items-center justify-between gap-12">
                <div class="flex items-center gap-10">
                  <span class="text-lg">⭐</span>
                  <div>
                    <div class="text-xs font-bold text-amber-300">Unlock GPT-5 Advanced Reasoning</div>
                    <div class="text-[11px] text-slate-300">Upgrade your plan for unlimited deep analysis & custom agents.</div>
                  </div>
                </div>
                <button type="button" class="px-10 py-5 rounded-8 bg-amber-500 text-slate-950 text-xs font-bold hover:bg-amber-400 shrink-0">
                  Try Plus
                </button>
              </div>

              <!-- ASSISTANT MESSAGE -->
              <div class="flex items-start gap-12 max-w-2xl">
                <div class="w-28 h-28 rounded-full bg-emerald-600 flex items-center justify-center text-xs font-bold text-white shrink-0">
                  AI
                </div>
                <div class="space-y-16 flex-1">
                  <div class="text-xs font-bold text-slate-400">ChatGPT</div>
                  <p class="text-xs text-slate-200 leading-relaxed">
                    Here is a structured framework for your quarterly marketing campaign:
                  </p>
                  
                  <div class="bg-slate-900/60 p-12 rounded-10 border border-slate-800 text-xs space-y-6 text-slate-300">
                    <div>1. <strong>Phase 1 (Weeks 1-3):</strong> Research, Audience Segmentation & Creative Assets</div>
                    <div>2. <strong>Phase 2 (Weeks 4-8):</strong> Multi-channel Launch, A/B Testing & Paid Acquisition</div>
                    <div>3. <strong>Phase 3 (Weeks 9-12):</strong> Retargeting, Optimization & ROI Synthesis</div>
                  </div>

                  <!-- PARTNER APP CARD 1: CANVA (SIMULATED AD ELEMENT #3) -->
                  <div id="sim-ad-canva" class="transition-all duration-300 ease-in-out p-14 rounded-14 bg-slate-900 border border-slate-700/80 hover:border-slate-600 space-y-8">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-8">
                        <div class="w-20 h-20 rounded-4 bg-[#00c4cc] flex items-center justify-center text-[10px] font-bold text-white">C</div>
                        <span class="text-xs font-bold text-slate-100">Canva</span>
                      </div>
                      <span class="text-[10px] font-mono uppercase px-6 py-2 rounded bg-slate-800 text-slate-400">Partner App</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-normal">
                      Turn this campaign schedule into polished visual presentations and social banners in Canva.
                    </p>
                    <button type="button" class="w-full py-6 rounded-8 bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 border border-slate-700 flex items-center justify-center gap-6">
                      <span>Open in Canva</span>
                      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </button>
                  </div>

                  <!-- SPONSORED AD CARD: MONDAY.COM (SIMULATED AD ELEMENT #4) -->
                  <div id="sim-ad-monday" class="transition-all duration-300 ease-in-out p-14 rounded-14 bg-slate-900 border border-blue-500/30 hover:border-blue-500/50 space-y-8" data-testid="sponsored-card">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-8">
                        <div class="w-20 h-20 rounded-4 bg-blue-600 flex items-center justify-center text-[10px] font-bold text-white">M</div>
                        <span class="text-xs font-bold text-slate-100">Monday.com</span>
                      </div>
                      <span class="text-[10px] font-bold uppercase px-6 py-2 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30">Ad • Sponsored</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-normal">
                      Automate workflows and track your marketing sprints with Monday Work OS templates.
                    </p>
                    <button type="button" class="w-full py-6 rounded-8 bg-blue-600 hover:bg-blue-500 text-xs font-bold text-white">
                      Try Monday Free
                    </button>
                  </div>

                </div>
              </div>

            </div>

          </div>

        </div>

        <!-- SIMULATED EXTENSION POPUP WIDGET -->
