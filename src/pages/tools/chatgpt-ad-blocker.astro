        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-24">
        
        <!-- LEFT: RULE CONTROLS -->
        <div class="lg:col-span-6 space-y-20">
          
          <!-- BLOCKED PHRASES -->
          <div class="p-16 rounded-16 bg-surface2/60 dark:bg-surface2-dark/60 border border-border dark:border-border-dark space-y-10">
            <div class="flex items-center justify-between">
              <label for="custom-phrases-input" class="text-caption font-bold text-ink dark:text-ink-dark">
                1. Blocked Promo Text Phrases (comma-separated)
              </label>
              <span class="text-xs font-mono text-muted dark:text-muted-dark">Scanned via TreeWalker</span>
            </div>
            <textarea
              id="custom-phrases-input"
              rows="4"
