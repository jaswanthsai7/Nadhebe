---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';
import VisualizerCanvas from '@/components/tools/VisualizerCanvas.astro';
import CodeSnippet from '@/components/tools/CodeSnippet.astro';

const title = 'Pixels to Megapixels Calculator – Convert Dimensions to MP | Nadhebe';
const h1 = 'Pixels to Megapixels Calculator';
const description = 'Convert width × height pixel dimensions or total raw pixel count into megapixels (MP) instantly with camera sensor classifications.';

const faq = [
  {
    question: 'How many pixels are in 1 megapixel?',
    answer: 'One megapixel equals exactly 1,000,000 (one million) pixels. A 24 MP image contains 24,000,000 individual pixels. Megapixels are calculated by multiplying width by height and dividing by 1,000,000.',
  },
  {
    question: 'How do you convert resolution dimensions to megapixels?',
    answer: 'Multiply pixel width by pixel height, then divide by 1,000,000. Example: 6000 × 4000 = 24,000,000 pixels / 1,000,000 = 24 MP. Formula: MP = (Width × Height) / 1,000,000.',
  },
  {
    question: 'Is more megapixels always better?',
    answer: 'Not always. More megapixels produce larger files and require faster processing. For social media, even 4 MP is sufficient. For large-format prints, 24+ MP is beneficial. Megapixels are one of many sensor quality factors — sensor size, aperture, and ISO performance matter equally.',
  },
  {
    question: 'How many megapixels is a 4K video frame?',
    answer: '4K UHD (3840×2160) = 8,294,400 pixels = 8.3 MP per frame. Cinema 4K (4096×2160) = 8.85 MP. 8K UHD (7680×4320) = 33.2 MP.',
  },
  {
    question: 'What is a good megapixel count for a portrait photo shoot?',
    answer: 'For commercial portrait photography printed at standard sizes (5×7 to 8×10"), 12 MP is sufficient. For retouching head shots at full resolution in Photoshop or requiring tight crops, 24 MP provides a comfortable margin. Studio photographers often use 45–61 MP for maximum flexibility.',
  },
];
---

<ToolLayout
  toolId="pixels-to-megapixels-calculator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24">
    <!-- Presets -->
    <div class="flex flex-wrap items-center gap-8 rounded-16 border border-border/80 bg-surface/80 p-16 dark:border-border-dark/80 dark:bg-surface-dark/80" data-reveal>
      <span class="text-caption font-mono uppercase text-muted dark:text-muted-dark mr-8">Camera Presets:</span>
      <button type="button" data-preset="6000,4000" class="mp-preset-btn rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">24 MP (6000×4000)</button>
      <button type="button" data-preset="8256,5504" class="mp-preset-btn rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">45 MP (8256×5504)</button>
      <button type="button" data-preset="4032,3024" class="mp-preset-btn rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">12 MP Mobile (4032×3024)</button>
      <button type="button" data-preset="3840,2160" class="mp-preset-btn rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">4K UHD (3840×2160)</button>
      <button type="button" data-preset="1920,1080" class="mp-preset-btn rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">1080p Full HD (1920×1080)</button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-24 items-start">
      <!-- Calculator Inputs & Code Snippets (Left Column) -->
      <div class="lg:col-span-6 space-y-24">
        <CalculatorCard title="Input Width & Height or Raw Pixels">
          <div class="space-y-20">
            <div class="grid grid-cols-2 gap-16">
              <div>
                <label for="mp-w" class="block text-caption font-sans font-medium text-ink dark:text-ink-dark mb-6">Width (px)</label>
                <input
                  type="number"
                  id="mp-w"
                  value="6000"
                  min="1"
                  max="100000"
                  step="1"
                  class="w-full rounded-12 border border-border bg-surface px-16 py-12 text-h3 font-mono font-bold text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark dark:focus:border-accent-dark transition-all"
                />
              </div>
              <div>
                <label for="mp-h" class="block text-caption font-sans font-medium text-ink dark:text-ink-dark mb-6">Height (px)</label>
                <input
                  type="number"
                  id="mp-h"
                  value="4000"
                  min="1"
                  max="100000"
                  step="1"
                  class="w-full rounded-12 border border-border bg-surface px-16 py-12 text-h3 font-mono font-bold text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark dark:focus:border-accent-dark transition-all"
                />
              </div>
            </div>

            <div class="pt-16 border-t border-border/60 dark:border-border-dark/60">
              <label for="raw-px" class="block text-caption font-mono uppercase text-muted dark:text-muted-dark mb-6">OR Enter Total Raw Pixels Direct</label>
              <input
                type="number"
                id="raw-px"
                placeholder="e.g. 24000000"
                min="1"
                max="100000000000"
                maxlength="12"
                step="1"
                class="w-full rounded-12 border border-border bg-surface px-16 py-12 text-h3 font-mono text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark dark:focus:border-accent-dark transition-all"
              />
            </div>
          </div>
        </CalculatorCard>

        <CodeSnippet
          title="Megapixel Math & Formulas"
          cssSnippet="Megapixels = (Width * Height) / 1,000,000;"
          tailwindSnippet="24 MP = 6000 x 4000 px"
          htmlSnippet='<img src="photo.jpg" width="6000" height="4000" alt="24MP Image">'
          id="code-mp"
        />
      </div>

      <!-- Visualizer & Results (Right Column) -->
      <div class="lg:col-span-6 space-y-24">
        <VisualizerCanvas width={6000} height={4000} ratioLabel="3:2 Sensor" id="viz-mp" />

        <CalculatorCard title="Megapixel Output">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-16 mb-20">
            <ResultCard label="Megapixels" value="24 MP" id="res-mp" accent copyable />
            <ResultCard label="Total Pixels" value="24,000,000" id="res-total-px" copyable />
            <ResultCard label="Aspect Ratio" value="3:2" id="res-mp-ratio" copyable={false} />
            <ResultCard label="Classification" value="Full-Frame Sensor" id="res-mp-class" copyable={false} />
          </div>
        </CalculatorCard>
      </div>
    </div>
  </div>

  <div slot="content">
    <h2>Pixels to Megapixels — Formula, Reference Table & Use Cases</h2>
    <p>
      A <strong>megapixel (MP)</strong> represents one million pixels. Digital camera specifications, smartphone sensor marketing, and photo print size planning all use megapixels as a shorthand for image resolution.
    </p>

    <h3>When to use this calculator</h3>
    <ul>
      <li>Convert a camera sensor's native width×height spec to its megapixel count</li>
      <li>Check how many megapixels a video resolution represents (4K = 8.3 MP)</li>
      <li>Compare the effective resolution of two cameras with different sensor sizes</li>
      <li>Verify that an image export has the required megapixel count for a client or print job</li>
      <li>Calculate the file size implications of different MP counts before shooting</li>
    </ul>

    <h3>Formula</h3>
    <pre><code>Total Pixels = Width × Height
Megapixels   = Total Pixels / 1,000,000</code></pre>

    <h3>Megapixel classification guide</h3>
    <ul>
      <li><strong>&lt; 8 MP</strong> — Web and social media. Not suitable for print larger than 4×6".</li>
      <li><strong>8–16 MP</strong> — Versatile everyday photography. A4 prints at 300 DPI.</li>
      <li><strong>16–32 MP</strong> — Professional DSLR range. A3 and A2 prints. Cropping flexibility.</li>
      <li><strong>32–61 MP</strong> — High-resolution mirrorless. Billboard and fine art printing.</li>
      <li><strong>61+ MP</strong> — Medium-format studio. Extreme detail for fashion and product photography.</li>
    </ul>

    <h3>Related tools</h3>
    <p>For the reverse calculation (MP to pixel dimensions), use <a href="/tools/megapixels-to-resolution-calculator/">Megapixels to Resolution Calculator</a>. To check how many megapixels you need for a specific print size, use the <a href="/tools/dpi-print-size-calculator/">DPI Print Size Calculator</a>.</p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const mpW = document.getElementById('mp-w');
    const mpH = document.getElementById('mp-h');
    const rawPx = document.getElementById('raw-px');
    const presets = document.querySelectorAll('.mp-preset-btn');

    const resMp = document.getElementById('res-mp');
    const resTotalPx = document.getElementById('res-total-px');
    const resMpRatio = document.getElementById('res-mp-ratio');
    const resMpClass = document.getElementById('res-mp-class');

    function gcd(a, b) {
      a = Math.abs(Math.round(a)); b = Math.abs(Math.round(b));
      while (b) { let t = b; b = a % b; a = t; }
      return a || 1;
    }

    function calculate(source) {
      let w = Math.min(Math.abs(parseFloat(mpW?.value || '0')), 100000);
      let h = Math.min(Math.abs(parseFloat(mpH?.value || '0')), 100000);
      let raw = Math.min(Math.abs(parseFloat(rawPx?.value || '0')), 1000000000000);
      let total = 0;

      if (source === 'raw' && raw > 0) {
        total = raw;
      } else if (w > 0 && h > 0) {
        total = w * h;
      }

      if (total <= 0) return;

      let mpText = '';
      if (total >= 10000000000) {
        mpText = `${(total / 1000000000).toFixed(2)}B MP`;
      } else {
        const mp = (total / 1000000).toFixed(2);
        mpText = `${mp} MP`;
      }

      if (resMp) resMp.textContent = mpText;
      if (resTotalPx) resTotalPx.textContent = total.toLocaleString('en-US');

      let ratioStr = 'N/A';
      if (w > 0 && h > 0) {
        const div = gcd(w, h);
        ratioStr = `${w / div}:${h / div}`;
        if (resMpRatio) resMpRatio.textContent = ratioStr;
      } else {
        if (resMpRatio) resMpRatio.textContent = 'N/A';
      }

      let category = 'Standard Photo';
      const mpNum = total / 1000000;
      if (mpNum >= 100) category = 'Ultra-High Res';
      else if (mpNum >= 45) category = 'Studio / Commercial';
      else if (mpNum >= 24) category = 'Full-Frame Sensor';
      else if (mpNum >= 12) category = 'Smartphone Camera';
      else if (mpNum >= 2) category = 'Full HD Display';
      else category = 'Web Thumbnail';

      if (resMpClass) resMpClass.textContent = category;

      // Update right VisualizerCanvas dynamically
      const vizDims = document.getElementById('viz-mp-dims-label');
      const vizBadge = document.getElementById('viz-mp-badge');
      const vizText = document.getElementById('viz-mp-text');
      const vizRect = document.getElementById('viz-mp-rect');

      if (vizDims) vizDims.textContent = w > 0 && h > 0 ? `${w} × ${h}` : `${mpText}`;
      if (vizBadge) vizBadge.textContent = ratioStr !== 'N/A' ? `${ratioStr} (${mpText})` : mpText;
      if (vizText) vizText.textContent = ratioStr !== 'N/A' ? ratioStr : mpText;

      if (vizRect && w > 0 && h > 0) {
        const maxW = 260;
        const maxH = 200;
        const scale = Math.min(maxW / w, maxH / h);
        const boxW = Math.max(50, Math.round(w * scale));
        const boxH = Math.max(50, Math.round(h * scale));
        vizRect.style.width = `${boxW}px`;
        vizRect.style.height = `${boxH}px`;
      }
    }

    mpW?.addEventListener('input', () => { if (rawPx) rawPx.value = ''; calculate('dim'); });
    mpH?.addEventListener('input', () => { if (rawPx) rawPx.value = ''; calculate('dim'); });
    rawPx?.addEventListener('input', () => calculate('raw'));

    presets.forEach(btn => {
      btn.addEventListener('click', () => {
        const [pw, ph] = (btn.getAttribute('data-preset') || '6000,4000').split(',');
        if (mpW) mpW.value = pw;
        if (mpH) mpH.value = ph;
        if (rawPx) rawPx.value = '';
        calculate('dim');
      });
    });

    calculate('dim');
  })();
</script>
