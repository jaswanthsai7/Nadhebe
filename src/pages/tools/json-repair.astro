---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'JSON Repair & Malformed Syntax Fixer | Nadhebe';
const h1 = 'JSON Repair & Malformed Syntax Fixer';
const description = 'Repair malformed JSON strings automatically client-side. Fix unquoted keys, trailing commas, single quotes, and missing brackets from LLM outputs.';

const faq = [
  {
    question: 'How does the JSON Repair tool work?',
    answer: 'The tool uses deterministic string transformation rules to automatically convert unquoted keys (`{name: "val"}`), single quotes (`{\'key\': \'val\'}`), trailing commas (`[1, 2,]`), and missing closing brackets into valid JSON.',
  },
  {
    question: 'Why do LLM API outputs frequently contain broken JSON?',
    answer: 'LLMs streaming responses may truncate near token limits or output Python-like syntax (single quotes, `None` instead of `null`, `True` instead of `true`), breaking standard `JSON.parse()`.',
  },
  {
    question: 'Does this tool support repairing truncated JSON arrays?',
    answer: 'Yes! The repair engine detects missing closing brackets `]` and braces `}` and appends them to form valid JSON.',
  },
  {
    question: 'Is my JSON data kept private?',
    answer: '100% private. All repair operations run locally in your browser using client-side JavaScript.',
  },
  {
    question: 'Can I copy the repaired JSON output?',
    answer: 'Yes! Click the "Copy Repaired JSON" button to copy clean, formatted JSON directly to your clipboard.',
  },
];
---

<ToolLayout
  toolId="json-repair"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="json-repair-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="MALFORMED JSON INPUT">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="jr-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">Broken / LLM Output JSON</label>
              <button type="button" id="btn-load-sample-jr" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample Broken JSON</button>
            </div>
            <textarea
              id="jr-input-raw"
              rows="12"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <button
            type="button"
            id="btn-repair-jr"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Repair & Fix JSON Syntax
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="REPAIRED VALID JSON">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Valid Repaired Output</span>
            <button type="button" id="btn-copy-jr" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Repaired JSON</button>
          </div>

          <pre id="jr-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[300px] leading-relaxed whitespace-pre-wrap"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>JSON Syntax Repair Guide — Fixing Truncated LLM Outputs</h2>
    <p>
      JSON (JavaScript Object Notation) requires strict formatting rules. Malformed JSON payloads cause server parsers to throw runtime syntax errors. This tool automatically cleans and repairs invalid JSON structure.
    </p>

    <h3>Common Syntax Errors Repaired</h3>
    <ul>
      <li><strong>Single Quotes to Double Quotes</strong>: <code>&#123;'key': 'val'&#125;</code> → <code>&#123;"key": "val"&#125;</code></li>
      <li><strong>Unquoted Object Keys</strong>: <code>&#123;name: "John"&#125;</code> → <code>&#123;"name": "John"&#125;</code></li>
      <li><strong>Trailing Commas</strong>: <code>[1, 2, 3,]</code> → <code>[1, 2, 3]</code></li>
      <li><strong>Python Literals</strong>: <code>None</code> → <code>null</code>, <code>True</code> → <code>true</code>, <code>False</code> → <code>false</code></li>
    </ul>

    <h3>Related Developer Tools</h3>
    <p>
      Validate JSON schemas with the <a href="/tools/json-schema-validator/">JSON Schema Validator</a>, format JSON payloads using the <a href="/tools/json-formatter/">JSON Formatter</a>, or convert JSON to TypeScript interfaces with the <a href="/tools/json-to-typescript/">JSON to TypeScript Generator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputRaw = document.getElementById('jr-input-raw');
    const btnRepair = document.getElementById('btn-repair-jr');
    const btnSample = document.getElementById('btn-load-sample-jr');

    const outputText = document.getElementById('jr-output-text');
    const btnCopy = document.getElementById('btn-copy-jr');

    const defaultBroken = `{
  name: 'Nadhebe AI',
  status: True,
  items: [1, 2, 3,],
  metadata: None,
}`;

    function repairJSON(raw) {
      let str = raw.trim();

      // Replace Python/JS keywords
      str = str.replace(/\bTrue\b/g, 'true')
               .replace(/\bFalse\b/g, 'false')
               .replace(/\bNone\b/g, 'null')
               .replace(/\bundefined\b/g, 'null');

      // Replace single quotes with double quotes around strings
      str = str.replace(/'([^'\\]*(\\.[^'\\]*)*)'/g, '"$1"');

      // Add double quotes around unquoted object keys
      str = str.replace(/([{,]\s*)([a-zA-Z0-9_$]+)\s*:/g, '$1"$2":');

      // Remove trailing commas before closing braces or brackets
      str = str.replace(/,\s*([}\]])/g, '$1');

      // Balance missing closing brackets
      let openBraces = (str.match(/\{/g) || []).length - (str.match(/\}/g) || []).length;
      let openBrackets = (str.match(/\[/g) || []).length - (str.match(/\]/g) || []).length;

      while (openBrackets > 0) { str += ']'; openBrackets--; }
      while (openBraces > 0) { str += '}'; openBraces--; }

      try {
        const parsed = JSON.parse(str);
        return JSON.stringify(parsed, null, 2);
      } catch(e) {
        return `// Attempted Repair Result:\n${str}\n\n// Error: ${e.message}`;
      }
    }

    function repair() {
      const raw = inputRaw?.value || defaultBroken;
      const fixed = repairJSON(raw);
      if (outputText) outputText.textContent = fixed;
    }

    btnRepair?.addEventListener('click', repair);
    inputRaw?.addEventListener('input', repair);

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = defaultBroken;
      repair();
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = defaultBroken;

    repair();
  })();
</script>
