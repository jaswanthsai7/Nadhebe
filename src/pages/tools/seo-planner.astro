---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Topical SEO Cluster & Content Roadmap Planner | Nadhebe';
const h1 = 'Topical SEO Cluster & Content Roadmap Planner';
const description = 'Plan topical authority clusters, map pillar pages and subtopic articles, design contextual internal linking structures, and build SEO editorial calendars.';

const faq = [
  {
    question: 'What is a topical SEO content cluster?',
    answer: 'A content cluster consists of a high-level pillar page surrounded by multiple dedicated subtopic articles that internally link back to the pillar page, signaling complete domain expertise to search engines.',
  },
  {
    question: 'Why are content clusters more effective than isolated keywords?',
    answer: 'Search algorithms evaluate domain topical depth rather than isolated keywords. A structured cluster establishes complete coverage of a domain, boosting rankings across all cluster URLs.',
  },
  {
    question: 'What is the role of internal links in a content cluster?',
    answer: 'Internal links pass page rank equity and convey semantic relationships between pillar pages and supporting cluster articles, helping Googlebot discover and crawl subtopics quickly.',
  },
  {
    question: 'How many subtopic articles should a pillar page have?',
    answer: 'A comprehensive topic cluster typically features 1 main pillar page supported by 5 to 12 detailed subtopic guides, tutorials, or comparison articles.',
  },
  {
    question: 'How does Nadhebe SEO Planner calculate Topical Authority Score?',
    answer: 'Topical Authority Score evaluates subtopic coverage completeness (60%), internal link coverage density (25%), and search intent variation across informational vs transactional queries (15%).',
  },
];
---

<ToolLayout
  toolId="seo-planner"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="seo-planner-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="PILLAR TOPIC & CLUSTER ARTICLES">
        <div class="space-y-16">
          <div>
            <label for="plan-input-pillar" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Pillar Page Title</label>
            <input
              id="plan-input-pillar"
              type="text"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-sans"
              value="Complete Guide to Web Application Security & Headers"
            />
          </div>

          <div>
            <label for="plan-input-keyword" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Core Target Keyword</label>
            <input
              id="plan-input-keyword"
              type="text"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-sans"
              value="web application security"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="plan-input-subtopics" class="block text-caption font-semibold text-ink dark:text-ink-dark">Supporting Subtopic Articles (Line per Article)</label>
              <button type="button" id="btn-load-sample-cluster" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample Cluster</button>
            </div>
            <textarea
              id="plan-input-subtopics"
              rows="6"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            >{`What is Content Security Policy (CSP)?
How to Implement HSTS and X-Frame-Options
Cross-Site Scripting (XSS) Prevention Guide
CORS Security Best Practices for Developers
OWASP Top 10 Web Application Security Audit`}</textarea>
          </div>

          <button
            type="button"
            id="btn-generate-cluster"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Generate Content Cluster Map
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="TOPICAL CLUSTER MAP & AUTHORITY SCORE">
        <div class="space-y-20">
          
          <!-- Score Banner -->
          <div id="plan-result-banner" class="rounded-16 border p-20 shadow-soft font-sans transition-all border-emerald-500/30 bg-emerald-500/10 text-emerald-900 dark:text-emerald-200">
            <div class="flex items-center justify-between mb-8">
              <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Topical Depth Score</span>
              <span id="plan-score-badge" class="rounded-pill bg-emerald-500/20 px-10 py-3 font-mono text-xs font-semibold text-emerald-700 dark:text-emerald-300">92 / 100</span>
            </div>
            <h3 id="plan-status-headline" class="text-h3 font-bold mb-4 text-emerald-800 dark:text-emerald-300">Strong Topical Authority Cluster</h3>
            <p id="plan-status-sub" class="text-caption text-ink2 dark:text-ink2-dark">
              Pillar page supported by 5 contextual subtopic articles with bi-directional internal linking.
            </p>
          </div>

          <!-- Cluster Architecture Visualization -->
          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark font-mono text-xs space-y-10">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Cluster Architecture Visualization</span>
            
            <!-- Pillar Box -->
            <div class="p-10 rounded-8 bg-accent/15 border border-accent/30 text-ink dark:text-ink-dark font-semibold">
              📌 Pillar: <span id="viz-pillar-title">Complete Guide to Web Application Security & Headers</span>
            </div>

            <!-- Subtopics List -->
            <div id="viz-subtopics-list" class="pl-16 space-y-6 border-l-2 border-accent/40">
              <!-- Rendered by JS -->
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Topical Authority & Content Cluster Strategy — Dominate Search Engine Results</h2>
    <p>
      Building topical authority is the single most effective long-term strategy for SEO growth. Rather than publishing isolated articles on unrelated subjects, structured **content clusters** demonstrate to search algorithms that your website is an authoritative source across an entire domain.
    </p>

    <h3>The 3 Layers of a Content Cluster</h3>
    <ol>
      <li><strong>Pillar Page</strong>: High-level comprehensive guide covering a broad topic (e.g. <em>Complete Guide to Technical SEO</em>).</li>
      <li><strong>Cluster Articles</strong>: Dedicated subtopic pages answering specific long-tail questions (e.g. <em>How to Fix 301 Redirect Chains</em>).</li>
      <li><strong>Internal Links</strong>: Contextual anchor links connecting every subtopic article back to the main pillar page and sister articles.</li>
    </ol>

    <h3>Related SEO Tools</h3>
    <p>
      Find uncovered topic opportunities using <a href="/tools/opportunity-radar/">Nadhebe Opportunity Radar</a>, audit meta tags with the <a href="/tools/meta-tag-analyzer/">OpenGraph & Meta Tag Checker</a>, or optimize search snippets with our <a href="/tools/serp-preview/">SERP Snippet Simulator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputPillar = document.getElementById('plan-input-pillar');
    const inputKeyword = document.getElementById('plan-input-keyword');
    const inputSubtopics = document.getElementById('plan-input-subtopics');

    const btnGenerate = document.getElementById('btn-generate-cluster');
    const btnSample = document.getElementById('btn-load-sample-cluster');

    const resultBanner = document.getElementById('plan-result-banner');
    const scoreBadge = document.getElementById('plan-score-badge');
    const statusHeadline = document.getElementById('plan-status-headline');
    const statusSub = document.getElementById('plan-status-sub');

    const vizPillar = document.getElementById('viz-pillar-title');
    const vizSubtopics = document.getElementById('viz-subtopics-list');

    function update() {
      const pillarText = inputPillar?.value || 'Pillar Title';
      const subtopicsRaw = inputSubtopics?.value || '';

      const lines = subtopicsRaw.split('\n').map(l => l.trim()).filter(Boolean);
      const subCount = lines.length;

      if (vizPillar) vizPillar.textContent = pillarText;

      if (vizSubtopics) {
        vizSubtopics.innerHTML = '';
        if (subCount === 0) {
          vizSubtopics.innerHTML = '<div class="text-amber-600 dark:text-amber-400 p-4">Add subtopic articles above to map cluster.</div>';
        } else {
          lines.forEach((sub, i) => {
            const div = document.createElement('div');
            div.className = 'flex items-center justify-between p-6 rounded-6 bg-surface2 dark:bg-surface2-dark text-ink dark:text-ink-dark truncate';
            div.innerHTML = `<span class="truncate">🔗 Subtopic ${i + 1}: ${sub}</span><span class="text-emerald-600 dark:text-emerald-400 font-bold ml-8 shrink-0">→ Pillar Link</span>`;
            vizSubtopics.appendChild(div);
          });
        }
      }

      let score = Math.min(100, Math.round(subCount * 18));
      if (scoreBadge) scoreBadge.textContent = `${score} / 100`;

      if (resultBanner && statusHeadline && statusSub) {
        if (score >= 80) {
          resultBanner.className = 'rounded-16 border border-emerald-500/30 bg-emerald-500/10 p-20 shadow-soft font-sans text-emerald-900 dark:text-emerald-200';
          statusHeadline.textContent = 'Strong Topical Authority Cluster ✓';
          statusHeadline.className = 'text-h3 font-bold mb-4 text-emerald-800 dark:text-emerald-300';
          statusSub.textContent = `Pillar page supported by ${subCount} contextual subtopic articles.`;
        } else if (score >= 40) {
          resultBanner.className = 'rounded-16 border border-amber-500/30 bg-amber-500/10 p-20 shadow-soft font-sans text-amber-900 dark:text-amber-200';
          statusHeadline.textContent = 'Partial Content Cluster ⚠';
          statusHeadline.className = 'text-h3 font-bold mb-4 text-amber-800 dark:text-amber-300';
          statusSub.textContent = 'Add at least 5 supporting subtopic articles to establish authority.';
        } else {
          resultBanner.className = 'rounded-16 border border-danger/30 bg-danger/10 p-20 shadow-soft font-sans text-danger';
          statusHeadline.textContent = 'Incomplete Cluster ✕';
          statusHeadline.className = 'text-h3 font-bold mb-4 text-danger';
          statusSub.textContent = 'Pillar page requires supporting subtopic articles.';
        }
      }
    }

    btnGenerate?.addEventListener('click', update);
    [inputPillar, inputKeyword, inputSubtopics].forEach(el => {
      el?.addEventListener('input', update);
    });

    btnSample?.addEventListener('click', () => {
      if (inputPillar) inputPillar.value = 'Complete Guide to Web Application Security & Headers';
      if (inputKeyword) inputKeyword.value = 'web application security';
      if (inputSubtopics) {
        inputSubtopics.value = `What is Content Security Policy (CSP)?
How to Implement HSTS and X-Frame-Options
Cross-Site Scripting (XSS) Prevention Guide
CORS Security Best Practices for Developers
OWASP Top 10 Web Application Security Audit`;
      }
      update();
    });

    update();
  })();
</script>
