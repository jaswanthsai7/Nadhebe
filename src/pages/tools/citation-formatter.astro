---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'APA, MLA, IEEE & BibTeX Citation Formatter | Nadhebe';
const h1 = 'Technical Citation Formatter';
const description = 'Format technical citations in APA 7th, MLA 9th, IEEE, Chicago, and LaTeX BibTeX formats for research papers and developer blogs.';

const faq = [
  {
    question: 'Which citation styles are supported?',
    answer: 'APA 7th Edition, MLA 9th Edition, IEEE, Chicago Manual of Style 17th, and BibTeX (.bib) entry syntax.'
  },
  {
    question: 'Is my reference data sent to any server?',
    answer: 'No, all citation string building runs 100% locally in your web browser.'
  }
];
---

<ToolLayout
  toolId="citation-formatter"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="citation-formatter-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- Input Controls -->
      <CalculatorCard title="PAPER & ARTICLE METADATA">
        <div class="space-y-16 font-mono text-caption">
          
          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Target Citation Style</label>
            <select id="cit-style" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 font-bold text-accent dark:border-border-dark dark:bg-surface2-dark">
              <option value="apa">APA 7th Edition</option>
              <option value="ieee">IEEE Format</option>
              <option value="bibtex">BibTeX (.bib Entry)</option>
              <option value="mla">MLA 9th Edition</option>
              <option value="chicago">Chicago 17th Edition</option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Author(s) (Last, F. M.)</label>
            <input id="cit-authors" type="text" value="Vaswani, A., Shazeer, N., Parmar, N., Uszkoreit, J." class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark" />
          </div>

          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Paper / Article Title</label>
            <input id="cit-title" type="text" value="Attention Is All You Need" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark" />
          </div>

          <div class="grid grid-cols-2 gap-12">
            <div>
              <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Journal / Venue</label>
              <input id="cit-venue" type="text" value="NeurIPS 2017" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark" />
            </div>
            <div>
              <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Year</label>
              <input id="cit-year" type="text" value="2017" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 font-bold text-accent dark:border-border-dark dark:bg-surface2-dark" />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">DOI or URL Link</label>
            <input id="cit-doi" type="text" value="https://arxiv.org/abs/1706.03762" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark" />
          </div>

        </div>
      </CalculatorCard>

      <!-- Citation Output -->
      <ResultCard title="FORMATTED TECHNICAL CITATION">
        <div class="space-y-16 font-mono text-caption">
          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Formatted Reference Text</label>
            <textarea id="cit-output" rows="12" readonly class="w-full min-h-[300px] rounded-8 border border-border bg-surface px-12 py-8 text-caption font-mono text-ink dark:text-ink-dark focus:outline-none dark:border-border-dark dark:bg-surface-dark font-semibold"></textarea>
          </div>
        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Technical Citation Best Practices for Academic & Engineering Publications</h2>
    <p>
      Accurate citation of research papers, AI model architecture specs, and open-source software libraries ensures academic integrity and gives credit to primary authors.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const styleEl = document.getElementById('cit-style');
    const authorsEl = document.getElementById('cit-authors');
    const titleEl = document.getElementById('cit-title');
    const venueEl = document.getElementById('cit-venue');
    const yearEl = document.getElementById('cit-year');
    const doiEl = document.getElementById('cit-doi');

    const outputEl = document.getElementById('cit-output');

    function render() {
      const style = styleEl?.value || 'apa';
      const authors = (authorsEl?.value || '').trim();
      const paperTitle = (titleEl?.value || '').trim();
      const venue = (venueEl?.value || '').trim();
      const year = (yearEl?.value || '').trim();
      const doi = (doiEl?.value || '').trim();

      let result = '';

      if (style === 'apa') {
        result = `${authors} (${year}). ${paperTitle}. ${venue}. ${doi}`.trim();
      } else if (style === 'ieee') {
        result = `${authors}, "${paperTitle}," ${venue}, ${year}. [Online]. Available: ${doi}`.trim();
      } else if (style === 'mla') {
        result = `${authors}. "${paperTitle}." ${venue}, ${year}, ${doi}.`.trim();
      } else if (style === 'chicago') {
        result = `${authors}. "${paperTitle}." ${venue} (${year}). ${doi}.`.trim();
      } else if (style === 'bibtex') {
        const citeKey = (authors.split(',')[0] || 'author').toLowerCase() + year + paperTitle.split(/\s+/)[0].toLowerCase();
        result = `@article{${citeKey},\n  author = {${authors}},\n  title = {${paperTitle}},\n  journal = {${venue}},\n  year = {${year}},\n  url = {${doi}}\n}`;
      }

      if (outputEl) outputEl.value = result;
    }

    [styleEl, authorsEl, titleEl, venueEl, yearEl, doiEl].forEach(el => {
      el?.addEventListener('input', render);
      el?.addEventListener('change', render);
    });

    render();
  })();
</script>
