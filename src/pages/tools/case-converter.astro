---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import DeveloperWorkbench from '@/components/tools/DeveloperWorkbench.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'case-converter');
if (!platformTool) throw new Error('Tool not found');

const initialCode = `convert this string into something else!
IT MIGHT EVEN HAVE multiple lines.`;

const faq = [
  {
    question: 'What cases are supported?',
    answer: 'We support Camel Case, Pascal Case, Snake Case, Kebab Case, Constant Case, Header Case, Sentence Case, lowercase, and UPPERCASE.',
  },
  {
    question: 'Is my data sent to a server?',
    answer: 'No. The text formatting is executed entirely in your browser. No data is ever uploaded or stored.',
  }
];
---

<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} faq={faq} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="space-y-16">
    <div class="flex items-center justify-between px-8 text-xs font-mono text-muted dark:text-muted-dark">
      <span class="inline-flex items-center gap-6 rounded-pill bg-emerald-500/10 px-12 py-4 font-semibold text-emerald-700 dark:text-emerald-300">
        ✓ Runs locally in your browser
      </span>
    </div>

    <!-- Case Selector Toolbar -->
    <div class="glass-panel p-16 rounded-16 border border-border bg-surface/95 dark:border-border-dark dark:bg-surface-dark/95 shadow-medium relative z-20 flex flex-wrap gap-8 justify-center">
       <button data-case="camel" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">camelCase</button>
       <button data-case="pascal" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">PascalCase</button>
       <button data-case="snake" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">snake_case</button>
       <button data-case="kebab" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">kebab-case</button>
       <button data-case="constant" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">CONSTANT_CASE</button>
       <button data-case="lower" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">lowercase</button>
       <button data-case="upper" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">UPPERCASE</button>
       <button data-case="sentence" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">Sentence case</button>
       <button data-case="capital" class="case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all">Capital Case</button>
    </div>

    <!-- Standard workbench with our new base64 mode -->
    <DeveloperWorkbench initialCode={initialCode} toolMode="case-converter" />
  </div>

  <div slot="content">
    <h2>Instantly Convert Text Case</h2>
    <p>Developers frequently need to convert text between different casing conventions. For example, converting a database column name (<code>user_first_name</code>) into a JavaScript variable (<code>userFirstName</code>). This tool makes that process instantaneous.</p>
  </div>
</ToolLayout>

<script>
  import * as changeCase from "change-case";

  function setupCaseConverter() {
    const inputArea = document.getElementById('wb-input-textarea') as HTMLTextAreaElement;
    const outputPre = document.getElementById('wb-output-pre');
    const statusBadge = document.getElementById('wb-status-badge');
    const outputGutter = document.getElementById('wb-output-gutter');
    
    const btnFormat = document.getElementById('wb-btn-format');
    const btnMinify = document.getElementById('wb-btn-minify');
    
    // Hide standard JSON buttons
    if (btnFormat) btnFormat.style.display = 'none';
    if (btnMinify) btnMinify.style.display = 'none';

    let currentCase = 'camel';
    const caseBtns = document.querySelectorAll('.case-btn');
    
    function setActiveButton() {
      caseBtns.forEach(btn => {
        if (btn.getAttribute('data-case') === currentCase) {
          btn.className = 'case-btn px-12 py-6 rounded-8 text-xs font-mono font-bold border border-transparent bg-accent text-white shadow-soft transition-all';
        } else {
          btn.className = 'case-btn px-12 py-6 rounded-8 text-xs font-mono font-medium border border-border bg-surface2 hover:bg-surface text-ink dark:text-ink-dark dark:border-border-dark dark:bg-surface2-dark dark:hover:bg-surface-dark transition-all';
        }
      });
    }

    caseBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        currentCase = target.getAttribute('data-case') || 'camel';
        setActiveButton();
        processCase();
      });
    });

    function processCase() {
      if (!inputArea || !outputPre) return;
      const raw = inputArea.value;
      
      if (!raw) {
        outputPre.textContent = '';
        if (outputGutter) outputGutter.innerHTML = '1<br/>';
        if (statusBadge) {
          statusBadge.textContent = 'Waiting for input';
          statusBadge.className = 'inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-muted bg-surface2 dark:text-muted-dark dark:bg-surface2-dark';
        }
        return;
      }

      try {
        const lines = raw.split('\\n');
        const convertedLines = lines.map(line => {
          if (!line.trim()) return line;
          switch (currentCase) {
            case 'camel': return changeCase.camelCase(line);
            case 'pascal': return changeCase.pascalCase(line);
            case 'snake': return changeCase.snakeCase(line);
            case 'kebab': return changeCase.kebabCase(line);
            case 'constant': return changeCase.constantCase(line);
            case 'lower': return line.toLowerCase();
            case 'upper': return line.toUpperCase();
            case 'sentence': return changeCase.sentenceCase(line);
            case 'capital': return changeCase.capitalCase(line);
            default: return line;
          }
        });
        
        const result = convertedLines.join('\\n');
        outputPre.textContent = result;
        outputPre.className = 'flex-1 p-12 font-mono text-caption text-emerald-600 dark:text-emerald-400 leading-relaxed whitespace-pre-wrap overflow-y-auto';
        
        if (outputGutter) {
          const outLines = result.split('\\n').length;
          let gutterHTML = '';
          for (let i = 1; i <= outLines; i++) {
            gutterHTML += i + '<br/>';
          }
          outputGutter.innerHTML = gutterHTML;
        }

        if (statusBadge) {
          statusBadge.textContent = '✓ Converted';
          statusBadge.className = 'inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-emerald-600 bg-emerald-500/10 dark:text-emerald-400';
        }
      } catch (err: any) {
        outputPre.textContent = err.message;
        outputPre.className = 'flex-1 p-12 font-mono text-caption text-danger dark:text-danger-dark leading-relaxed whitespace-pre-wrap overflow-y-auto';
        
        if (outputGutter) {
          outputGutter.innerHTML = '1<br/>';
        }

        if (statusBadge) {
          statusBadge.textContent = 'Invalid Input';
          statusBadge.className = 'inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-danger bg-danger/10 dark:text-danger-dark';
        }
      }
    }

    if (inputArea) inputArea.addEventListener('input', processCase);
    
    // Initial run
    setActiveButton();
    setTimeout(processCase, 50);
  }

  setupCaseConverter();
</script>
