---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Date & Time Builder — Format, Convert & Calculate Timestamps | Nadhebe';
const h1 = 'Date & Time Builder & Formatter';
const description = 'Build, format, and convert dates and timestamps client-side. Convert Unix epoch to human-readable dates, format ISO 8601, and calculate day-of-week.';

const faq = [
  {
    question: 'How does the Date & Time Builder work?',
    answer: 'Enter a date/time or Unix epoch timestamp. The tool formats it into ISO 8601, RFC 2822, human-readable, and relative time formats instantly in your browser.'
  },
  {
    question: 'What is a Unix epoch timestamp?',
    answer: 'A Unix timestamp is the number of seconds elapsed since January 1, 1970 00:00:00 UTC (the "Unix epoch"). Used universally in programming for time storage.'
  },
  {
    question: 'What is ISO 8601 date format?',
    answer: 'ISO 8601 is the international date-time standard: `2026-08-07T14:30:00Z`. It ensures unambiguous time representation across time zones and systems.'
  },
  {
    question: 'Can I convert between time zones?',
    answer: 'Yes! Select a target timezone from the dropdown. The tool recalculates and displays the equivalent timestamp in that time zone using the Intl.DateTimeFormat API.'
  },
  {
    question: 'Is my date data sent to any server?',
    answer: '100% private. All date parsing, formatting, and timezone conversions execute locally inside your web browser.'
  }
];
---

<ToolLayout
  toolId="date-and-time-builder"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="datetime-builder-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">

      <!-- INPUT CARD -->
      <CalculatorCard title="DATE & TIME INPUT">
        <div class="space-y-16">

          <!-- Date/Time Input -->
          <div>
            <label for="dt-input-text" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Date, Timestamp, or ISO String</label>
            <input
              id="dt-input-text"
              type="text"
              placeholder="e.g. 2026-08-07, 1754553600, now"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-10 text-caption font-mono font-bold text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark"
            />
          </div>

          <!-- Quick Presets Dropdown -->
          <div>
            <label for="dt-preset-select" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Quick Presets</label>
            <select
              id="dt-preset-select"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
            >
              <option value="now">Now — Current Unix Timestamp</option>
              <option value="start-of-day">Start of Today (00:00:00 UTC)</option>
              <option value="end-of-day">End of Today (23:59:59 UTC)</option>
              <option value="unix-0">Unix Epoch Zero (Jan 1, 1970)</option>
              <option value="y2k">Y2K (Jan 1, 2000 00:00:00 UTC)</option>
            </select>
          </div>

          <!-- Timezone Selector -->
          <div>
            <label for="dt-tz-select" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Output Timezone</label>
            <select id="dt-tz-select" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono">
              <option value="UTC">UTC (Coordinated Universal Time)</option>
              <option value="America/New_York">America/New_York (EST/EDT)</option>
              <option value="America/Los_Angeles">America/Los_Angeles (PST/PDT)</option>
              <option value="America/Chicago">America/Chicago (CST/CDT)</option>
              <option value="Europe/London">Europe/London (GMT/BST)</option>
              <option value="Europe/Paris">Europe/Paris (CET/CEST)</option>
              <option value="Europe/Berlin">Europe/Berlin (CET/CEST)</option>
              <option value="Asia/Kolkata">Asia/Kolkata (IST +5:30)</option>
              <option value="Asia/Tokyo">Asia/Tokyo (JST +9:00)</option>
              <option value="Asia/Shanghai">Asia/Shanghai (CST +8:00)</option>
              <option value="Asia/Dubai">Asia/Dubai (GST +4:00)</option>
              <option value="Australia/Sydney">Australia/Sydney (AEST/AEDT)</option>
            </select>
          </div>

          <button
            type="button"
            id="btn-dt-parse"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Parse & Format Date
          </button>

        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="PARSED DATE & FORMAT OUTPUT">
        <div class="space-y-20">

          <!-- Quick Stats -->
          <div class="grid grid-cols-2 gap-12 text-center font-mono">
            <div class="rounded-12 border border-emerald-500/30 bg-emerald-500/10 p-16">
              <div id="stat-dt-dow" class="text-h3 font-bold text-emerald-800 dark:text-emerald-300">Thursday</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Day of Week</div>
            </div>
            <div class="rounded-12 border border-border bg-surface2/60 p-16 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-dt-epoch" class="text-h3 font-bold text-accent dark:text-accent-dark font-mono">1754553600</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Unix Timestamp</div>
            </div>
          </div>

          <!-- Format Rows Table -->
          <div class="rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark divide-y divide-border/40 dark:divide-border-dark/40 shadow-subtle">

            <div class="flex items-center justify-between px-14 py-10 gap-8">
              <span class="font-mono text-xs font-bold text-muted dark:text-muted-dark w-28 shrink-0">ISO 8601</span>
              <span id="stat-dt-iso" class="font-mono text-xs text-ink dark:text-ink-dark truncate flex-1 text-right">2026-08-07T00:00:00.000Z</span>
              <button data-copy-field="stat-dt-iso" type="button" class="dt-copy-btn shrink-0 rounded-6 border border-border px-8 py-4 font-mono text-xs font-semibold text-muted hover:border-accent hover:text-accent dark:border-border-dark dark:text-muted-dark cursor-pointer transition-colors">Copy</button>
            </div>

            <div class="flex items-center justify-between px-14 py-10 gap-8">
              <span class="font-mono text-xs font-bold text-muted dark:text-muted-dark w-28 shrink-0">RFC 2822</span>
              <span id="stat-dt-rfc" class="font-mono text-xs text-ink dark:text-ink-dark truncate flex-1 text-right">Thu, 07 Aug 2026 +0000</span>
              <button data-copy-field="stat-dt-rfc" type="button" class="dt-copy-btn shrink-0 rounded-6 border border-border px-8 py-4 font-mono text-xs font-semibold text-muted hover:border-accent hover:text-accent dark:border-border-dark dark:text-muted-dark cursor-pointer transition-colors">Copy</button>
            </div>

            <div class="flex items-center justify-between px-14 py-10 gap-8">
              <span class="font-mono text-xs font-bold text-muted dark:text-muted-dark w-28 shrink-0">Local TZ</span>
              <span id="stat-dt-local" class="font-mono text-xs text-ink dark:text-ink-dark truncate flex-1 text-right">Aug 7, 2026, 12:00:00 AM</span>
              <button data-copy-field="stat-dt-local" type="button" class="dt-copy-btn shrink-0 rounded-6 border border-border px-8 py-4 font-mono text-xs font-semibold text-muted hover:border-accent hover:text-accent dark:border-border-dark dark:text-muted-dark cursor-pointer transition-colors">Copy</button>
            </div>

            <div class="flex items-center justify-between px-14 py-10 gap-8">
              <span class="font-mono text-xs font-bold text-muted dark:text-muted-dark w-28 shrink-0">Relative</span>
              <span id="stat-dt-relative" class="font-mono text-xs text-ink dark:text-ink-dark truncate flex-1 text-right">just now</span>
              <button data-copy-field="stat-dt-relative" type="button" class="dt-copy-btn shrink-0 rounded-6 border border-border px-8 py-4 font-mono text-xs font-semibold text-muted hover:border-accent hover:text-accent dark:border-border-dark dark:text-muted-dark cursor-pointer transition-colors">Copy</button>
            </div>

            <div class="flex items-center justify-between px-14 py-10 gap-8">
              <span class="font-mono text-xs font-bold text-muted dark:text-muted-dark w-28 shrink-0">TZ Out</span>
              <span id="stat-dt-tz" class="font-mono text-xs text-ink dark:text-ink-dark truncate flex-1 text-right">Aug 7, 2026, 12:00:00 AM UTC</span>
              <button data-copy-field="stat-dt-tz" type="button" class="dt-copy-btn shrink-0 rounded-6 border border-border px-8 py-4 font-mono text-xs font-semibold text-muted hover:border-accent hover:text-accent dark:border-border-dark dark:text-muted-dark cursor-pointer transition-colors">Copy</button>
            </div>

          </div>

          <div id="dt-error" class="hidden rounded-8 border border-rose-500/30 bg-rose-500/10 px-14 py-10 text-xs font-mono font-bold text-rose-600 dark:text-rose-400 text-center">
            ⚠ Invalid date — please check your input format.
          </div>

        </div>
      </ResultCard>
    </div>
  </div>


  <div slot="content">
    <h2>Date & Time Formatting & Timestamp Conversion Guide</h2>
    <p>
      Dates and timestamps are fundamental to software engineering. Accurate timestamp handling prevents bugs in scheduling, logging, APIs, and database records across time zones.
    </p>

    <h3>Key Date Formats</h3>
    <ul>
      <li><strong>ISO 8601</strong>: <code>2026-08-07T14:30:00Z</code> — International standard. Use for APIs and databases.</li>
      <li><strong>Unix Epoch</strong>: <code>1754553600</code> — Seconds since Jan 1, 1970 UTC. Universal for programming.</li>
      <li><strong>RFC 2822</strong>: <code>Thu, 07 Aug 2026 14:30:00 +0000</code> — Email date format standard.</li>
    </ul>

    <h3>Related Date & Time Tools</h3>
    <p>
      Calculate the difference between two dates with the <a href="/tools/date-difference/">Date Difference Calculator</a>, generate cron schedules with the <a href="/tools/cron-explainer/">Cron Expression Explainer</a>, or format your output slug with the <a href="/tools/slug-generator/">Slug Generator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  function initDateTimeBuilder() {
    var inputText = document.getElementById('dt-input-text');
    var tzSelect = document.getElementById('dt-tz-select');
    var presetSelect = document.getElementById('dt-preset-select');
    var btnParse = document.getElementById('btn-dt-parse');
    var copyBtns = document.querySelectorAll('.dt-copy-btn');

    var statDow = document.getElementById('stat-dt-dow');
    var statEpoch = document.getElementById('stat-dt-epoch');
    var statIso = document.getElementById('stat-dt-iso');
    var statRfc = document.getElementById('stat-dt-rfc');
    var statLocal = document.getElementById('stat-dt-local');
    var statRelative = document.getElementById('stat-dt-relative');
    var statTz = document.getElementById('stat-dt-tz');
    var dtError = document.getElementById('dt-error');

    if (!inputText) return;

    var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function toRfc2822(d) {
      var dow = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getUTCDay()];
      var mon = MONTHS[d.getUTCMonth()];
      return dow + ', ' + pad(d.getUTCDate()) + ' ' + mon + ' ' + d.getUTCFullYear()
        + ' ' + pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()) + ':' + pad(d.getUTCSeconds()) + ' +0000';
    }

    function relativeTime(d) {
      var now = Date.now();
      var diff = Math.round((now - d.getTime()) / 1000);
      var absDiff = Math.abs(diff);
      var suffix = diff >= 0 ? 'ago' : 'from now';
      if (absDiff < 60) return 'just now';
      if (absDiff < 3600) return Math.round(absDiff / 60) + ' minutes ' + suffix;
      if (absDiff < 86400) return Math.round(absDiff / 3600) + ' hours ' + suffix;
      if (absDiff < 604800) return Math.round(absDiff / 86400) + ' days ' + suffix;
      if (absDiff < 2592000) return Math.round(absDiff / 604800) + ' weeks ' + suffix;
      if (absDiff < 31536000) return Math.round(absDiff / 2592000) + ' months ' + suffix;
      return Math.round(absDiff / 31536000) + ' years ' + suffix;
    }

    function parseInput(val) {
      val = val.trim();
      if (!val || val === 'now') return new Date();
      // Pure numeric = Unix epoch
      if (/^\d+$/.test(val)) {
        var n = parseInt(val, 10);
        // If 10 digits → seconds, 13 digits → ms
        return new Date(n < 1e12 ? n * 1000 : n);
      }
      var d = new Date(val);
      return isNaN(d.getTime()) ? null : d;
    }

    function updateOutputs(d) {
      var tz = tzSelect ? tzSelect.value : 'UTC';

      if (!d || isNaN(d.getTime())) {
        if (dtError) dtError.classList.remove('hidden');
        return;
      }
      if (dtError) dtError.classList.add('hidden');

      if (statDow) statDow.textContent = DAYS[d.getUTCDay()];
      if (statEpoch) statEpoch.textContent = Math.floor(d.getTime() / 1000);
      if (statIso) statIso.textContent = d.toISOString();
      if (statRfc) statRfc.textContent = toRfc2822(d);
      if (statRelative) statRelative.textContent = relativeTime(d);

      try {
        var localFmt = new Intl.DateTimeFormat('en-US', {
          year: 'numeric', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          timeZone: 'UTC'
        }).format(d);
        if (statLocal) statLocal.textContent = localFmt;

        var tzFmt = new Intl.DateTimeFormat('en-US', {
          year: 'numeric', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          timeZoneName: 'short',
          timeZone: tz
        }).format(d);
        if (statTz) statTz.textContent = tzFmt;
      } catch(e) {
        if (statLocal) statLocal.textContent = d.toUTCString();
        if (statTz) statTz.textContent = d.toUTCString();
      }
    }

    function parseAndDisplay() {
      var d = parseInput(inputText.value);
      updateOutputs(d);
    }

    if (btnParse) btnParse.addEventListener('click', parseAndDisplay);
    if (inputText) inputText.addEventListener('input', parseAndDisplay);
    if (tzSelect) tzSelect.addEventListener('change', parseAndDisplay);

    if (presetSelect) {
      presetSelect.addEventListener('change', function() {
        var preset = presetSelect.value;
        var now = new Date();
        if (preset === 'now') {
          inputText.value = Math.floor(Date.now() / 1000).toString();
        } else if (preset === 'start-of-day') {
          var sod = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 0, 0, 0));
          inputText.value = Math.floor(sod.getTime() / 1000).toString();
        } else if (preset === 'end-of-day') {
          var eod = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 23, 59, 59));
          inputText.value = Math.floor(eod.getTime() / 1000).toString();
        } else if (preset === 'unix-0') {
          inputText.value = '0';
        } else if (preset === 'y2k') {
          inputText.value = '946684800';
        }
        parseAndDisplay();
        // Reset select back to placeholder feel
        presetSelect.value = 'now';
      });
    }

    copyBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var fieldId = btn.getAttribute('data-copy-field');
        var el = document.getElementById(fieldId);
        if (el) {
          navigator.clipboard.writeText(el.textContent);
          var orig = btn.textContent;
          btn.textContent = '✓';
          setTimeout(function() { btn.textContent = orig; }, 1500);
        }
      });
    });

    // Initialize with current time
    inputText.value = Math.floor(Date.now() / 1000).toString();
    parseAndDisplay();
  }

  document.addEventListener('astro:page-load', initDateTimeBuilder);
  if (document.readyState !== 'loading') {
    initDateTimeBuilder();
  } else {
    document.addEventListener('DOMContentLoaded', initDateTimeBuilder);
  }
</script>
