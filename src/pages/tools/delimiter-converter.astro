---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'CSV & Delimiter Converter (Comma, Tab, Pipe, Semicolon) | Nadhebe';
const h1 = 'CSV & Delimiter Converter';
const description = 'Convert tabular text files between CSV (comma), TSV (tab), Pipe (|), and Semicolon (;) delimiters with quote escaping controls.';

const faq = [
  {
    question: 'What delimiters can I convert between?',
    answer: 'You can convert between Comma (,), Tab (\\t), Pipe (|), Semicolon (;), and Space ( ).'
  },
  {
    question: 'How does quote handling work during conversion?',
    answer: 'Our converter handles embedded quotes properly so values containing the target delimiter are automatically wrapped in double quotes.'
  },
  {
    question: 'Is my data processed locally?',
    answer: 'Yes, 100% of delimiter transformation happens in your browser.'
  }
];
---

<ToolLayout
  toolId="delimiter-converter"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start" id="delimiter-converter-app">
    <!-- Left Column: Input & Controls -->
    <div class="space-y-24">
      <CalculatorCard title="INPUT TABULAR DATA">
      <div class="space-y-16">
        <div class="flex flex-wrap items-center justify-between gap-12">
          <div class="flex items-center gap-8">
            <span class="text-xs font-mono font-bold uppercase text-muted dark:text-muted-dark">Input Delimiter:</span>
            <select id="dc-input-delim" class="rounded-8 border border-border bg-surface px-10 py-4 text-xs font-mono font-bold text-accent dark:border-border-dark dark:bg-surface-dark">
              <option value="auto">Auto-Detect</option>
              <option value=",">Comma (,)</option>
              <option value="&#9;">Tab (\t)</option>
              <option value="|">Pipe (|)</option>
              <option value=";">Semicolon (;)</option>
            </select>
          </div>

          <div class="flex items-center gap-8">
            <button type="button" id="dc-btn-sample-csv" class="rounded-8 border border-border bg-surface2 px-10 py-4 text-xs font-mono font-bold text-accent hover:border-accent dark:border-border-dark dark:bg-surface2-dark transition-all">
              Sample CSV
            </button>
            <button type="button" id="dc-btn-sample-tsv" class="rounded-8 border border-border bg-surface2 px-10 py-4 text-xs font-mono font-bold text-accent hover:border-accent dark:border-border-dark dark:bg-surface2-dark transition-all">
              Sample TSV
            </button>
            <button type="button" id="dc-btn-clear" class="rounded-8 border border-border bg-surface px-10 py-4 text-xs font-mono font-bold text-muted hover:text-danger dark:border-border-dark dark:bg-surface-dark transition-all">
              Clear
            </button>
          </div>
        </div>

        <textarea
          id="dc-input-text"
          rows="5"
          class="w-full rounded-12 border border-border bg-surface2 p-12 font-mono text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark leading-relaxed"
          placeholder="Paste CSV, TSV, or Pipe-delimited data here..."
          spellcheck="false"
        ></textarea>
      </div>
    </CalculatorCard>
    </div>

    <!-- Right Column: Results & Metrics -->
    <div class="space-y-24">
      <CalculatorCard title="TARGET CONVERSION SETTINGS">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-16 font-mono text-xs">
        <div class="space-y-6">
          <label class="block font-bold uppercase text-muted dark:text-muted-dark">Output Delimiter</label>
          <select id="dc-output-delim" class="w-full rounded-8 border border-border bg-surface px-12 py-8 font-bold text-accent dark:border-border-dark dark:bg-surface-dark">
            <option value="&#9;">Tab (\t) — TSV Format</option>
            <option value="|">Pipe (|) — Markdown Table Style</option>
            <option value=";">Semicolon (;) — European CSV Style</option>
            <option value=",">Comma (,) — Standard CSV</option>
            <option value=" ">Space ( ) — Space Separated</option>
          </select>
        </div>

        <div class="space-y-6">
          <label class="block font-bold uppercase text-muted dark:text-muted-dark">Quoting Style</label>
          <select id="dc-quoting-style" class="w-full rounded-8 border border-border bg-surface px-12 py-8 font-bold text-ink dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark">
            <option value="needed">Quote Only When Needed</option>
            <option value="all">Always Quote All Fields ("value")</option>
            <option value="none">Never Quote (Strip Quotes)</option>
          </select>
        </div>
      </div>
    </CalculatorCard>

    <ResultCard title="CONVERTED DELIMITED OUTPUT">
      <div class="space-y-16">
        <div class="flex items-center justify-between">
          <span id="dc-output-stats" class="font-mono text-xs font-bold text-muted dark:text-muted-dark">0 lines converted</span>
          <div class="flex items-center gap-8">
            <button type="button" id="dc-btn-copy" class="rounded-8 border border-border bg-surface px-12 py-4 text-xs font-mono font-bold text-ink hover:border-accent dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark transition-all">
              Copy
            </button>
            <button type="button" id="dc-btn-download" class="rounded-8 border border-border bg-accent px-12 py-6 text-xs font-mono font-bold text-white shadow-soft hover:opacity-90 transition-all">
              Download Output
            </button>
          </div>
        </div>

        <pre id="dc-output-pre" class="w-full min-h-[160px] max-h-[350px] overflow-auto rounded-12 border border-border bg-surface p-12 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-surface-dark dark:text-emerald-400 whitespace-pre-wrap">Converted output will appear here...</pre>
      </div>
    </ResultCard>
    </div>
  </div>

  <div slot="content">
    <h2>Converting Tabular Delimiters Seamlessly</h2>
    <p>
      Different systems require different text separators: Excel in Europe often expects semicolons `;`, command-line tools often require tabs `\t` or spaces, and database import scripts use commas `,` or pipes `|`. Converting delimiters cleanly prevents truncated data or field misalignment.
    </p>
  </div>
</ToolLayout>

<script>
  function initDelimiterConverter() {
    const inputText = document.getElementById('dc-input-text') as HTMLTextAreaElement;
    const inputDelimSelect = document.getElementById('dc-input-delim') as HTMLSelectElement;
    const outputDelimSelect = document.getElementById('dc-output-delim') as HTMLSelectElement;
    const quotingSelect = document.getElementById('dc-quoting-style') as HTMLSelectElement;

    const outputPre = document.getElementById('dc-output-pre');
    const outputStats = document.getElementById('dc-output-stats');

    const btnSampleCsv = document.getElementById('dc-btn-sample-csv');
    const btnSampleTsv = document.getElementById('dc-btn-sample-tsv');
    const btnClear = document.getElementById('dc-btn-clear');
    const btnCopy = document.getElementById('dc-btn-copy');
    const btnDownload = document.getElementById('dc-btn-download');

    const sampleCsv = `id,name,role,location\n101,"Chen, Alice",Lead Architect,"San Francisco, CA"\n102,"Smith, Bob",Senior Engineer,"Austin, TX"`;
    const sampleTsv = `id\tname\trole\tlocation\n101\tAlice Chen\tLead Architect\tSan Francisco, CA\n102\tBob Smith\tSenior Engineer\tAustin, TX`;

    function detectDelimiter(text: string): string {
      const firstLine = text.trim().split(/\r?\n/)[0] || '';
      if (firstLine.includes('\t')) return '\t';
      if (firstLine.includes(';') && !firstLine.includes(',')) return ';';
      if (firstLine.includes('|') && !firstLine.includes(',')) return '|';
      return ',';
    }

    function parseLine(line: string, delim: string): string[] {
      const result: string[] = [];
      let cur = '';
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const c = line[i];
        if (c === '"') {
          inQuotes = !inQuotes;
        } else if (c === delim && !inQuotes) {
          result.push(cur.trim());
          cur = '';
        } else {
          cur += c;
        }
      }
      result.push(cur.trim());
      return result;
    }

    function formatField(val: string, outDelim: string, quoteStyle: string): string {
      let clean = val;
      if (clean.startsWith('"') && clean.endsWith('"')) {
        clean = clean.slice(1, -1).replace(/""/g, '"');
      }

      if (quoteStyle === 'none') {
        return clean.replace(/"/g, '');
      }

      if (quoteStyle === 'all') {
        return `"${clean.replace(/"/g, '""')}"`;
      }

      // Default: quote only when needed
      if (clean.includes(outDelim) || clean.includes('"') || clean.includes('\n')) {
        return `"${clean.replace(/"/g, '""')}"`;
      }

      return clean;
    }

    function convertData() {
      if (!inputText || !outputPre || !outputStats) return;
      const raw = inputText.value.trim();

      if (!raw) {
        outputPre.textContent = 'Converted output will appear here...';
        outputStats.textContent = '0 lines converted';
        return;
      }

      let inDelim = inputDelimSelect?.value || 'auto';
      if (inDelim === 'auto') {
        inDelim = detectDelimiter(raw);
      }

      const outDelim = outputDelimSelect?.value || '\t';
      const quoteStyle = quotingSelect?.value || 'needed';

      const lines = raw.split(/\r?\n/).filter(l => l.trim().length > 0);
      const convertedLines = lines.map(line => {
        const fields = parseLine(line, inDelim);
        return fields.map(f => formatField(f, outDelim, quoteStyle)).join(outDelim);
      });

      const resultText = convertedLines.join('\n');
      outputPre.textContent = resultText;
      outputStats.textContent = `${convertedLines.length} lines converted (${outDelim === '\t' ? 'TSV' : outDelim === '|' ? 'Pipe' : outDelim === ';' ? 'Semicolon' : 'CSV'})`;
    }

    if (inputText) inputText.addEventListener('input', convertData);
    if (inputDelimSelect) inputDelimSelect.addEventListener('change', convertData);
    if (outputDelimSelect) outputDelimSelect.addEventListener('change', convertData);
    if (quotingSelect) quotingSelect.addEventListener('change', convertData);

    btnSampleCsv?.addEventListener('click', () => {
      if (inputText) {
        inputText.value = sampleCsv;
        convertData();
      }
    });

    btnSampleTsv?.addEventListener('click', () => {
      if (inputText) {
        inputText.value = sampleTsv;
        convertData();
      }
    });

    btnClear?.addEventListener('click', () => {
      if (inputText) {
        inputText.value = '';
        convertData();
      }
    });

    btnCopy?.addEventListener('click', () => {
      if (outputPre) {
        navigator.clipboard.writeText(outputPre.textContent || '');
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy'), 1500);
      }
    });

    btnDownload?.addEventListener('click', () => {
      if (!outputPre?.textContent) return;
      const outDelim = outputDelimSelect?.value || '\t';
      const ext = outDelim === '\t' ? 'tsv' : 'csv';
      const blob = new Blob([outputPre.textContent], { type: 'text/plain;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `converted_dataset.${ext}`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial run
    convertData();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDelimiterConverter);
  } else {
    initDelimiterConverter();
  }
</script>
