---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'CSV / TSV / Pipe Delimiter Converter | Nadhebe';
const h1 = 'CSV / TSV / Pipe Delimiter Converter';
const description = 'Convert tabular data between Comma (CSV), Tab (TSV), Pipe (|), and Semicolon (;) delimiters client-side for database import.';

const faq = [
  {
    question: 'How does the Delimiter Converter work?',
    answer: 'Select your input delimiter and desired output delimiter. The converter parses text rows, escapes field values containing special characters, and joins columns with the target delimiter.',
  },
  {
    question: 'What delimiters are supported?',
    answer: 'Supports Comma (`,`), Tab (`\\t`), Pipe (`|`), Semicolon (`;`), and Space delimiters.',
  },
  {
    question: 'Why convert CSV to Pipe-delimited text for databases?',
    answer: 'Pipe-delimited text (`|`) reduces collisions in database ETL pipelines when text columns contain unescaped commas or semicolons.',
  },
  {
    question: 'Is my data payload sent to a remote server?',
    answer: '100% private. All text transformations run locally in your web browser.',
  },
  {
    question: 'Can I copy or download the converted delimited text?',
    answer: 'Yes! Click "Copy Result" or "Download File" to save your converted dataset.',
  },
];
---

<ToolLayout
  toolId="delimiter-converter"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="delim-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="DELIMITED TEXT INPUT">
        <div class="space-y-16">
          <div class="grid grid-cols-2 gap-12">
            <div>
              <label for="delim-select-in" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Input Delimiter</label>
              <select
                id="delim-select-in"
                class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
              >
                <option value="," selected>Comma (,)</option>
                <option value="\t">Tab (\t / TSV)</option>
                <option value="|">Pipe (|)</option>
                <option value=";">Semicolon (;)</option>
              </select>
            </div>
            <div>
              <label for="delim-select-out" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Target Output Delimiter</label>
              <select
                id="delim-select-out"
                class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
              >
                <option value="|">Pipe (|)</option>
                <option value=",">Comma (,)</option>
                <option value="\t">Tab (\t / TSV)</option>
                <option value=";">Semicolon (;)</option>
              </select>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="delim-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">Input Text Dataset</label>
              <button type="button" id="btn-load-sample-delim" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample CSV</button>
            </div>
            <textarea
              id="delim-input-raw"
              rows="10"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <button
            type="button"
            id="btn-convert-delim"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Convert Delimiter Format
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="CONVERTED DELIMITED OUTPUT">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Output Text Result</span>
            <button type="button" id="btn-copy-delim" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Result</button>
          </div>

          <pre id="delim-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[280px] leading-relaxed whitespace-pre-wrap"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Data Delimiter Specification & ETL Standards</h2>
    <p>
      Data pipelines and SQL database loaders (`COPY FROM`, Postgres, Snowflake) require precise delimiter formats to parse data fields accurately.
    </p>

    <h3>Common Delimiter Standards</h3>
    <ul>
      <li><strong>Comma (<code>,</code>)</strong>: Standard RFC 4180 CSV spreadsheets.</li>
      <li><strong>Tab (<code>\t</code>)</strong>: TSV format used by Excel clipboard copy-paste.</li>
      <li><strong>Pipe (<code>|</code>)</strong>: High-reliability delimiter for enterprise ETL pipelines.</li>
    </ul>

    <h3>Related Data Tools</h3>
    <p>
      Convert JSON to CSV with the <a href="/tools/json-to-csv/">JSON to CSV Converter</a>, format SQL queries with the <a href="/tools/sql-formatter/">SQL Formatter</a>, or convert Markdown to HTML with the <a href="/tools/markdown-to-html/">Markdown to HTML Converter</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const selectIn = document.getElementById('delim-select-in');
    const selectOut = document.getElementById('delim-select-out');
    const inputRaw = document.getElementById('delim-input-raw');
    const btnConvert = document.getElementById('btn-convert-delim');
    const btnSample = document.getElementById('btn-load-sample-delim');

    const outputText = document.getElementById('delim-output-text');
    const btnCopy = document.getElementById('btn-copy-delim');

    const defaultCsv = `id,name,role,department
101,Alice Johnson,Software Architect,Engineering
102,Bob Smith,AI Specialist,Research
103,Carol Williams,Security Engineer,DevOps`;

    function getDelimiterChar(val) {
      if (val === '\\t') return '\t';
      return val;
    }

    function convertDelimiters(text, inDelim, outDelim) {
      const charIn = getDelimiterChar(inDelim);
      const charOut = getDelimiterChar(outDelim);

      const lines = text.split('\n');
      const converted = lines.map(line => {
        if (!line.trim()) return '';
        const parts = line.split(charIn);
        return parts.join(charOut);
      });

      return converted.join('\n');
    }

    function convert() {
      const raw = inputRaw?.value || defaultCsv;
      const inVal = selectIn?.value || ',';
      const outVal = selectOut?.value || '|';

      const result = convertDelimiters(raw, inVal, outVal);
      if (outputText) outputText.textContent = result;
    }

    btnConvert?.addEventListener('click', convert);
    [selectIn, selectOut, inputRaw].forEach(el => {
      el?.addEventListener('input', convert);
      el?.addEventListener('change', convert);
    });

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = defaultCsv;
      if (selectIn) selectIn.value = ',';
      if (selectOut) selectOut.value = '|';
      convert();
    });

    btnCopy?.addEventListener('click', () => {
      if (outputText) {
        navigator.clipboard.writeText(outputText.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy Result'), 2000);
      }
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = defaultCsv;

    convert();
  })();
</script>
