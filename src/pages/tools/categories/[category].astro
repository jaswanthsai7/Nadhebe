---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { PLATFORM_CATEGORIES } from '@/config/platform-tools';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const PLATFORM_TOOLS = UNIFIED_TOOLS_REGISTRY;
import { ROADMAP_CATEGORIES, type ToolRoadmapCategory } from '@/config/tools-roadmap';
import { SITE } from '@/config';

export async function getStaticPaths() {
  return ROADMAP_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: ToolRoadmapCategory };
const tools = PLATFORM_TOOLS.filter((tool) => tool.categorySlug === category.slug);
const canonicalUrl = `${SITE.url}/tools/categories/${category.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} Tools`,
  description: category.description,
  url: canonicalUrl,
};
---

<BaseLayout title={`${category.name} Tools — Free Browser Utilities | Nadhebe`} description={category.description} canonicalUrl={canonicalUrl} jsonLd={[schema]}>
  <div class="mx-auto max-w-content px-16 py-32 sm:px-24 sm:py-48">
    <Breadcrumb items={[{ name: 'Home', href: '/' }, { name: 'Tools', href: '/tools/' }, { name: category.name, href: `/tools/categories/${category.slug}/` }]} />

    <header class="glass-panel mb-32 overflow-hidden rounded-24 border border-border p-24 shadow-medium dark:border-border-dark sm:p-40">
      <p class="font-mono text-meta font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">{category.priority} collection</p>
      <h1 class="mt-8 font-display text-h1 font-bold leading-tight text-ink dark:text-ink-dark">{category.name} Tools</h1>
      <p class="mt-12 max-w-3xl text-body-large leading-relaxed text-ink2 dark:text-ink2-dark">{category.description}</p>
      <div class="mt-20 flex flex-wrap gap-8">
        <span class="rounded-pill bg-emerald-500/10 px-10 py-5 font-mono text-xs font-semibold text-emerald-700 dark:text-emerald-300">{tools.length} browser tools</span>
        <span class="rounded-pill bg-surface2 px-10 py-5 font-mono text-xs font-semibold text-ink2 dark:bg-surface2-dark dark:text-ink2-dark">For {category.audience}</span>
      </div>
    </header>

    <div class="mb-20 flex items-center justify-between gap-12">
      <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark">Browse {category.name.toLowerCase()} utilities</h2>
      <a href="/tools/" class="font-mono text-caption font-semibold text-accent hover:underline dark:text-accent-dark">All tools →</a>
    </div>

    <div class="grid grid-cols-1 gap-16 md:grid-cols-2 xl:grid-cols-3">
      {tools.map((tool) => (
        <a href={tool.href} class="category-tool-card group flex min-h-[190px] flex-col rounded-16 border border-border bg-surface/95 p-20 no-underline shadow-soft transition-all duration-200 hover:-translate-y-1 hover:border-accent/60 hover:shadow-medium dark:border-border-dark dark:bg-surface-dark/95">
          <div class="flex items-center justify-between gap-8">
            <span class="rounded-6 bg-surface2 px-8 py-3 font-mono text-[12px] font-semibold text-ink2 dark:bg-surface2-dark dark:text-ink2-dark">{tool.mode}</span>
            {tool.badge && <span class="rounded-pill bg-accent/10 px-8 py-3 font-mono text-[12px] font-semibold text-accent dark:bg-accent-dark/20 dark:text-accent-dark">{tool.badge}</span>}
          </div>
          <h3 class="mt-14 font-display text-h3 font-bold text-ink transition-colors group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">{tool.name}</h3>
          <p class="mt-6 line-clamp-3 text-body-small leading-relaxed text-ink2 dark:text-ink2-dark">{tool.description}</p>
          <span class="mt-auto border-t border-border/60 pt-12 text-caption font-semibold text-accent dark:border-border-dark/60 dark:text-accent-dark">Open utility →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
