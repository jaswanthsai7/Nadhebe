---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Data Analysis Statistical Outlier & Anomaly Checker | Nadhebe';
const h1 = 'Data Analysis Anomaly Checker';
const description = 'Detect statistical outliers, calculate Z-scores, interquartile ranges (IQR), and flag dataset anomalies in real time.';

const faq = [
  {
    question: 'How are statistical outliers detected?',
    answer: 'Outliers are flagged using Z-score thresholding (|Z| > 2.5 or 3.0) and Interquartile Range (IQR) 1.5x whisker bounds.'
  },
  {
    question: 'Is my statistical dataset safe?',
    answer: 'Yes, 100% of statistical computations run locally in your web browser memory.'
  }
];
---

<ToolLayout
  toolId="data-analysis-checker"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="data-analysis-checker-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- Input Controls -->
      <CalculatorCard title="NUMERICAL DATASET & SENSITIVITY">
        <div class="space-y-16 font-mono text-caption">
          
          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Detection Algorithm / Sensitivity</label>
            <select id="dac-method" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 font-bold text-accent dark:border-border-dark dark:bg-surface2-dark">
              <option value="z25">Z-Score (|Z| &gt; 2.5 Std Dev)</option>
              <option value="z30">Z-Score (|Z| &gt; 3.0 Strict)</option>
              <option value="iqr">Tukey IQR (1.5 &times; Interquartile Range)</option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Paste Numerical Data Series (Comma or Newline separated)</label>
            <textarea id="dac-input" rows="12" placeholder="Enter values..." class="w-full min-h-[300px] rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark">142, 145, 148, 141, 144, 146, 143, 498, 142, 145, 147, 139, 141, 12, 144, 146</textarea>
          </div>

        </div>
      </CalculatorCard>

      <!-- Statistical Diagnostics Output -->
      <ResultCard title="ANOMALY DIAGNOSTICS & STATISTICAL SUMMARY">
        <div class="space-y-16 font-mono text-caption">
          
          <div class="grid grid-cols-2 gap-12 text-center">
            <div class="p-12 rounded-10 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark">
              <span class="block text-xs text-muted font-bold uppercase mb-4">Total Anomalies</span>
              <span id="res-outlier-count" class="text-h3 font-bold text-danger">2 Flagged</span>
            </div>
            <div class="p-12 rounded-10 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark">
              <span class="block text-xs text-muted font-bold uppercase mb-4">Sample Mean (&mu;)</span>
              <span id="res-mean-val" class="text-h3 font-bold text-ink dark:text-ink-dark">164.06</span>
            </div>
          </div>

          <div class="p-12 rounded-10 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark space-y-6 text-xs">
            <span class="block font-bold text-ink dark:text-ink-dark uppercase border-b border-border/50 pb-4 dark:border-border-dark/50">Distribution Spread (IQR & Std Dev)</span>
            <div class="flex items-center justify-between">
              <span class="text-muted">Standard Deviation (&sigma;):</span>
              <strong id="res-std-dev" class="text-ink dark:text-ink-dark font-bold">92.41</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">Median (Q2):</span>
              <strong id="res-median" class="text-ink dark:text-ink-dark font-bold">143.50</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">IQR Bounds (1.5x):</span>
              <strong id="res-iqr-bounds" class="text-ink dark:text-ink-dark font-bold">133.50 — 155.00</strong>
            </div>
          </div>

          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Flagged Outlier Value List</label>
            <textarea id="dac-output" rows="6" readonly class="w-full min-h-[140px] rounded-8 border border-border bg-surface px-12 py-8 text-caption font-mono text-danger font-semibold focus:outline-none dark:border-border-dark dark:bg-surface-dark"></textarea>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Statistical Outlier Detection Methods</h2>
    <p>
      Anomalies in datasets skew machine learning models and data visualization metrics. Using Z-score standard deviation thresholds and IQR whisker bounds identifies true data errors versus natural variance.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const methodEl = document.getElementById('dac-method');
    const inputEl = document.getElementById('dac-input');

    const outlierCountEl = document.getElementById('res-outlier-count');
    const meanValEl = document.getElementById('res-mean-val');
    const stdDevEl = document.getElementById('res-std-dev');
    const medianEl = document.getElementById('res-median');
    const iqrBoundsEl = document.getElementById('res-iqr-bounds');
    const outputEl = document.getElementById('dac-output');

    function calculate() {
      const raw = inputEl?.value || '';
      const method = methodEl?.value || 'z25';

      const nums = raw.split(/[\s,]+/).map(Number).filter(n => !isNaN(n));

      if (nums.length === 0) {
        if (outlierCountEl) outlierCountEl.textContent = '0 Flagged';
        if (outputEl) outputEl.value = 'No valid numerical data entered.';
        return;
      }

      const n = nums.length;
      const sum = nums.reduce((a, b) => a + b, 0);
      const mean = sum / n;

      const variance = nums.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / n;
      const stdDev = Math.sqrt(variance);

      // Quantiles
      const sorted = [...nums].sort((a, b) => a - b);
      const getPercentile = (p) => {
        const idx = (sorted.length - 1) * p;
        const base = Math.floor(idx);
        const rest = idx - base;
        if (sorted[base + 1] !== undefined) {
          return sorted[base] + rest * (sorted[base + 1] - sorted[base]);
        }
        return sorted[base];
      };

      const q1 = getPercentile(0.25);
      const q2 = getPercentile(0.50);
      const q3 = getPercentile(0.75);
      const iqr = q3 - q1;
      const lowerIQR = q1 - 1.5 * iqr;
      const upperIQR = q3 + 1.5 * iqr;

      let outliers = [];

      nums.forEach((val, idx) => {
        const z = stdDev > 0 ? (val - mean) / stdDev : 0;
        if (method === 'z25' && Math.abs(z) > 2.5) {
          outliers.push({ val, z: z.toFixed(2), idx: idx + 1 });
        } else if (method === 'z30' && Math.abs(z) > 3.0) {
          outliers.push({ val, z: z.toFixed(2), idx: idx + 1 });
        } else if (method === 'iqr' && (val < lowerIQR || val > upperIQR)) {
          outliers.push({ val, z: z.toFixed(2), idx: idx + 1 });
        }
      });

      if (outlierCountEl) outlierCountEl.textContent = `${outliers.length} Flagged`;
      if (meanValEl) meanValEl.textContent = mean.toFixed(2);
      if (stdDevEl) stdDevEl.textContent = stdDev.toFixed(2);
      if (medianEl) medianEl.textContent = q2.toFixed(2);
      if (iqrBoundsEl) iqrBoundsEl.textContent = `${lowerIQR.toFixed(2)} — ${upperIQR.toFixed(2)}`;

      if (outputEl) {
        if (outliers.length === 0) {
          outputEl.value = '✓ Zero statistical outliers detected in dataset.';
        } else {
          outputEl.value = outliers.map(o => `• Item #${o.idx}: Value = ${o.val} (Z-Score = ${o.z})`).join('\n');
        }
      }
    }

    [methodEl, inputEl].forEach(el => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    calculate();
  })();
</script>
