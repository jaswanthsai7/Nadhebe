---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'average-calculator');
if (!platformTool) throw new Error('Tool not found');

const faq = [
  {
    question: 'How do I enter numbers?',
    answer: 'You can enter numbers separated by commas, spaces, or newlines. The calculator will automatically parse them and ignore any non-numeric characters.',
  },
  {
    question: 'What is the difference between Mean, Median, and Mode?',
    answer: 'Mean is the average (sum divided by count). Median is the middle number when all numbers are sorted. Mode is the number that appears most frequently.',
  }
];
---

<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} faq={faq} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="max-w-5xl mx-auto py-16 space-y-16">
    <div class="glass-panel p-24 md:p-32 rounded-24 border border-border bg-surface/95 shadow-large dark:border-border-dark dark:bg-surface-dark/95">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-32">
        
        <!-- Input Form -->
        <div class="space-y-16 flex flex-col">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-ink dark:text-ink-dark font-sans tracking-tight">Data Set</h3>
            <button id="btn-clear" class="text-xs font-semibold text-danger dark:text-danger-dark hover:underline">Clear All</button>
          </div>
          
          <div class="flex-1 min-h-[300px] relative">
            <textarea id="num-input" class="w-full h-full p-16 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all resize-none leading-relaxed" placeholder="Enter numbers here...&#10;e.g. 85, 90, 78, 92, 88"></textarea>
          </div>
          
          <p class="text-xs text-muted dark:text-muted-dark mt-8 font-medium">Separate numbers by comma, space, or newline.</p>
        </div>

        <!-- Output Results -->
        <div class="flex flex-col space-y-24 bg-surface2/50 dark:bg-surface2-dark/50 p-24 md:p-32 rounded-24 border border-border/50 dark:border-border-dark/50">
          <div class="space-y-8 text-center border-b border-border/50 dark:border-border-dark/50 pb-24">
            <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Mean (Average)</h3>
            <div id="out-mean" class="text-5xl md:text-6xl font-black text-accent dark:text-accent-dark tracking-tight leading-tight">
              0
            </div>
          </div>

          <div class="space-y-12 flex-1">
            <div class="grid grid-cols-2 gap-x-12 gap-y-16">
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Median</div>
                <div id="out-median" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Mode</div>
                <div id="out-mode" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Sum</div>
                <div id="out-sum" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Count</div>
                <div id="out-count" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Minimum</div>
                <div id="out-min" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Maximum</div>
                <div id="out-max" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4 col-span-2">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Range</div>
                <div id="out-range" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div slot="content">
    <h2>Calculate Averages and Statistics Instantly</h2>
    <p>Whether you're calculating grades, analyzing financial data, or finding the middle point of a dataset, our Average Calculator instantly provides all the statistical summaries you need. It calculates the Mean, Median, Mode, Sum, and Range automatically as you type.</p>
  </div>
</ToolLayout>

<script>
  function setupAverageCalculator() {
    const input = document.getElementById('num-input') as HTMLTextAreaElement;
    const btnClear = document.getElementById('btn-clear');
    
    const outMean = document.getElementById('out-mean');
    const outMedian = document.getElementById('out-median');
    const outMode = document.getElementById('out-mode');
    const outSum = document.getElementById('out-sum');
    const outCount = document.getElementById('out-count');
    const outMin = document.getElementById('out-min');
    const outMax = document.getElementById('out-max');
    const outRange = document.getElementById('out-range');

    function calculate() {
      if (!input || !outMean) return;
      
      const raw = input.value;
      // Extract numbers (including negatives and decimals)
      const matches = raw.match(/-?\\d+(\\.\\d+)?/g);
      
      if (!matches || matches.length === 0) {
        outMean.textContent = '0';
        if (outMedian) outMedian.textContent = '0';
        if (outMode) outMode.textContent = '0';
        if (outSum) outSum.textContent = '0';
        if (outCount) outCount.textContent = '0';
        if (outMin) outMin.textContent = '0';
        if (outMax) outMax.textContent = '0';
        if (outRange) outRange.textContent = '0';
        return;
      }
      
      const nums = matches.map(n => parseFloat(n)).filter(n => !isNaN(n));
      if (nums.length === 0) return;
      
      const count = nums.length;
      const sum = nums.reduce((a, b) => a + b, 0);
      const mean = sum / count;
      
      const sorted = [...nums].sort((a, b) => a - b);
      const min = sorted[0];
      const max = sorted[count - 1];
      const range = max - min;
      
      let median = 0;
      if (count % 2 === 0) {
        median = (sorted[count / 2 - 1] + sorted[count / 2]) / 2;
      } else {
        median = sorted[Math.floor(count / 2)];
      }
      
      // Mode
      const counts: Record<string, number> = {};
      let maxCount = 0;
      for (const n of nums) {
        counts[n] = (counts[n] || 0) + 1;
        if (counts[n] > maxCount) {
          maxCount = counts[n];
        }
      }
      
      const modes = [];
      for (const k in counts) {
        if (counts[k] === maxCount) {
          modes.push(k);
        }
      }
      let modeStr = 'None';
      if (maxCount > 1) {
        if (modes.length === count) {
           modeStr = 'None';
        } else {
           modeStr = modes.join(', ');
        }
      }

      const fmt = (n: number) => Number.isInteger(n) ? n.toString() : parseFloat(n.toFixed(6)).toString();

      outMean.textContent = fmt(mean);
      if (outMedian) outMedian.textContent = fmt(median);
      if (outMode) outMode.textContent = modeStr;
      if (outSum) outSum.textContent = fmt(sum);
      if (outCount) outCount.textContent = count.toString();
      if (outMin) outMin.textContent = fmt(min);
      if (outMax) outMax.textContent = fmt(max);
      if (outRange) outRange.textContent = fmt(range);
    }

    if (input) input.addEventListener('input', calculate);
    if (btnClear && input) {
      btnClear.addEventListener('click', () => {
        input.value = '';
        calculate();
      });
    }
    
    // Initial data
    if (input && !input.value) {
       input.value = "10\\n15\\n20\\n15\\n30\\n45";
       calculate();
    }
  }

  setupAverageCalculator();
</script>
