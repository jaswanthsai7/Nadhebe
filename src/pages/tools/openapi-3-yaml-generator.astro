---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'openapi-3-yaml-generator');
if (!platformTool) throw new Error('Tool not found');
---
<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} hideHeader={true} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="space-y-16">
    <!-- Local Privacy Selling Point Badge -->
    <div class="flex items-center justify-between px-8 text-xs font-mono text-muted dark:text-muted-dark">
      <span class="inline-flex items-center gap-6 rounded-pill bg-emerald-500/10 px-12 py-4 font-semibold text-emerald-700 dark:text-emerald-300">
        ✓ Runs locally in your browser — Your data isn't uploaded
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-stretch">
      <!-- LEFT PANE: Form Configuration -->
      <div class="lg:col-span-4 glass-panel flex flex-col rounded-16 border border-border bg-surface/95 overflow-hidden shadow-medium dark:border-border-dark dark:bg-surface-dark/95">
        <div class="flex items-center justify-between border-b border-border/80 bg-surface2/60 px-12 py-12 dark:border-border-dark/80 dark:bg-surface2-dark/60">
          <span class="font-mono text-xs font-bold uppercase text-ink dark:text-ink-dark">Configuration</span>
        </div>
        <div class="p-16 space-y-20 flex-1">
          <div class="space-y-8">
            <label class="block text-xs font-sans font-semibold text-ink2 dark:text-ink2-dark">API Title</label>
            <input type="text" id="oa-title" value="My API" class="w-full p-10 border border-border rounded-8 bg-surface2 focus:ring-2 focus:ring-accent focus:border-accent dark:border-border-dark dark:bg-surface2-dark text-caption font-mono text-ink dark:text-ink-dark transition-all outline-none" placeholder="e.g. Acme API" />
          </div>
          <div class="space-y-8">
            <label class="block text-xs font-sans font-semibold text-ink2 dark:text-ink2-dark">API Version</label>
            <input type="text" id="oa-ver" value="1.0.0" class="w-full p-10 border border-border rounded-8 bg-surface2 focus:ring-2 focus:ring-accent focus:border-accent dark:border-border-dark dark:bg-surface2-dark text-caption font-mono text-ink dark:text-ink-dark transition-all outline-none" placeholder="e.g. 1.0.0" />
          </div>
        </div>
      </div>

      <!-- RIGHT PANE: Output Code -->
      <div class="lg:col-span-8 glass-panel flex flex-col rounded-16 border border-border bg-surface/95 overflow-hidden shadow-medium dark:border-border-dark dark:bg-surface-dark/95 min-h-[500px]">
        <div class="flex items-center justify-between border-b border-border/80 bg-surface2/60 px-12 py-8 dark:border-border-dark/80 dark:bg-surface2-dark/60">
          <div class="flex items-center gap-8">
            <span class="font-mono text-xs font-bold uppercase text-ink dark:text-ink-dark">Generated OpenAPI 3.1 YAML</span>
          </div>
          <button type="button" id="wb-btn-copy-output" class="rounded-6 border border-border bg-surface px-8 py-4 font-sans text-xs font-medium text-ink2 hover:text-ink dark:border-border-dark dark:bg-surface-dark dark:text-ink2-dark dark:hover:text-ink-dark cursor-pointer transition-colors">Copy YAML</button>
        </div>
        
        <div class="relative flex-1 flex overflow-hidden font-mono text-caption bg-code dark:bg-code-dark">
          <div id="wb-output-gutter" aria-hidden="true" class="w-40 select-none border-r border-border/60 bg-surface2/40 py-12 text-right pr-8 text-xs font-mono text-muted dark:border-border-dark/60 dark:bg-surface2-dark/40 dark:text-muted-dark leading-relaxed font-semibold">
          </div>
          <pre id="oa-out" class="flex-1 p-12 font-mono text-caption text-emerald-600 dark:text-emerald-400 leading-relaxed whitespace-pre overflow-x-auto"></pre>
        </div>
        
        <div class="flex items-center justify-between border-t border-border/60 bg-surface2/30 px-12 py-6 font-mono text-xs dark:border-border-dark/60 dark:bg-surface2-dark/30">
          <span class="inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-emerald-600 bg-emerald-500/10 dark:text-emerald-400">
            ✓ Auto-updated
          </span>
        </div>
      </div>
    </div>
  </div>

  <div slot="content">
    <h2>About</h2>
    <p>{platformTool.description}</p>
  </div>
</ToolLayout>

<script>
  function updateGutter(text: string) {
    const gutter = document.getElementById('wb-output-gutter');
    if (!gutter) return;
    const lines = text.split('\n').length;
    let gutterHTML = '';
    for (let i = 1; i <= lines; i++) {
      gutterHTML += i + '<br/>';
    }
    gutter.innerHTML = gutterHTML;
  }

  function gen() {
    const titleEl = document.getElementById('oa-title') as HTMLInputElement;
    const verEl = document.getElementById('oa-ver') as HTMLInputElement;
    if (!titleEl || !verEl) return;
    
    const title = titleEl.value || 'My API';
    const ver = verEl.value || '1.0.0';
    
    const yaml = `openapi: 3.1.0
info:
  title: ${title}
  version: ${ver}
paths:
  /ping:
    get:
      summary: Health check endpoint
      responses:
        '200':
          description: OK`;
          
    const out = document.getElementById('oa-out');
    if (out) {
      out.textContent = yaml;
      updateGutter(yaml);
    }
  }

  document.querySelectorAll('input').forEach(i => i.addEventListener('input', gen));
  gen();

  const copyBtn = document.getElementById('wb-btn-copy-output');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const out = document.getElementById('oa-out');
      if (out && out.textContent) {
        navigator.clipboard.writeText(out.textContent);
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 2000);
      }
    });
  }
</script>