---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'CSV to Excel XLSX & TSV Converter | Nadhebe';
const h1 = 'CSV to Excel XLSX & TSV Converter';
const description = 'Convert CSV files into Excel-compatible TSV spreadsheets, format column data types, and export table files client-side.';

const faq = [
  {
    question: 'How does the CSV to Excel converter work?',
    answer: 'The converter parses CSV rows client-side, normalizes line breaks and delimiter quotes, and formats columns into Tab-Separated Values (TSV) compatible with Microsoft Excel and Google Sheets.',
  },
  {
    question: 'Why does Excel sometimes mangle leading zeros or dates in CSV files?',
    answer: 'Opening CSV files directly in Excel causes automatic type coercion (e.g. `00123` becomes `123`). Converting to TSV preserves string formatting.',
  },
  {
    question: 'Is my CSV data uploaded to external servers?',
    answer: '100% private. All spreadsheet conversions execute locally in your web browser.',
  },
  {
    question: 'Can I copy converted data directly into Microsoft Excel?',
    answer: 'Yes! Copying TSV formatted output and pasting (`Ctrl+V`) into Excel automatically populates grid cells cleanly.',
  },
  {
    question: 'What file size limit applies to client-side conversion?',
    answer: 'Supports CSV files up to several megabytes directly in memory.',
  },
];
---

<ToolLayout
  toolId="csv-to-excel"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="c2e-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="INPUT CSV SPREADSHEET">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="c2e-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">Input CSV Text</label>
              <button type="button" id="btn-load-sample-c2e" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample CSV</button>
            </div>
            <textarea
              id="c2e-input-raw"
              rows="12"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <button
            type="button"
            id="btn-convert-c2e"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Convert to Excel Format
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="EXCEL-COMPATIBLE SPREADSHEET OUTPUT">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">TSV / Excel Clipboard Result</span>
            <div class="flex items-center gap-8">
              <button type="button" id="btn-copy-c2e" class="rounded-6 bg-accent/80 px-10 py-4 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy to Clipboard</button>
              <button type="button" id="btn-dl-c2e" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Download .TSV</button>
            </div>
          </div>

          <pre id="c2e-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[300px] leading-relaxed whitespace-pre-wrap"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>CSV to Excel Conversion & Data Formatting Guide</h2>
    <p>
      Converting CSV datasets into Excel-compatible TSV format ensures clean column parsing without corrupting leading zeros, zip codes, or scientific notation.
    </p>

    <h3>Benefits</h3>
    <ul>
      <li><strong>Clipboard Paste</strong>: Paste TSV directly into Excel cells without wizard prompts.</li>
      <li><strong>Zero Corrupted Zip Codes</strong>: Preserves string format for <code>00501</code> postal codes.</li>
    </ul>

    <h3>Related Spreadsheet Tools</h3>
    <p>
      Convert JSON to CSV with the <a href="/tools/json-to-csv/">JSON to CSV Converter</a>, extract columns with the <a href="/tools/column-extractor/">CSV Column Extractor</a>, or convert delimiters with the <a href="/tools/delimiter-converter/">Delimiter Converter</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputRaw = document.getElementById('c2e-input-raw');
    const btnConvert = document.getElementById('btn-convert-c2e');
    const btnSample = document.getElementById('btn-load-sample-c2e');

    const outputText = document.getElementById('c2e-output-text');
    const btnCopy = document.getElementById('btn-copy-c2e');
    const btnDl = document.getElementById('btn-dl-c2e');

    const defaultCsv = `Product_ID,SKU,Price_USD,Inventory_Count
1001,00123-X,49.99,150
1002,00124-Y,89.50,75
1003,00125-Z,129.00,40`;

    function csvToTsv(csv) {
      const lines = csv.split('\n');
      const tsvLines = lines.map(line => {
        if (!line.trim()) return '';
        const parts = line.split(',');
        return parts.join('\t');
      });
      return tsvLines.join('\n');
    }

    function convert() {
      const raw = inputRaw?.value || defaultCsv;
      const tsv = csvToTsv(raw);
      if (outputText) outputText.textContent = tsv;
    }

    btnConvert?.addEventListener('click', convert);
    inputRaw?.addEventListener('input', convert);

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = defaultCsv;
      convert();
    });

    btnCopy?.addEventListener('click', () => {
      if (outputText) {
        navigator.clipboard.writeText(outputText.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy to Clipboard'), 2000);
      }
    });

    btnDl?.addEventListener('click', () => {
      if (!outputText) return;
      const blob = new Blob([outputText.textContent], { type: 'text/tab-separated-values;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'nadhebe-excel-data.tsv';
      a.click();
      URL.revokeObjectURL(url);
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = defaultCsv;

    convert();
  })();
</script>
