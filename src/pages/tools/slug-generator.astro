---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'URL-Friendly Slug Generator | Nadhebe';
const h1 = 'URL-Friendly Slug Generator';
const description = 'Generate clean, URL-safe slugs for blog posts, products, and landing pages. Strip accents, special characters, and uppercase letters client-side.';

const faq = [
  {
    question: 'What is a URL slug?',
    answer: 'A URL slug is the human-readable portion of an HTTP web address that comes after the domain name (e.g. `nadhebe.com/tools/url-slug-generator/`).',
  },
  {
    question: 'Why are clean URL slugs important for SEO?',
    answer: 'Search engines index readable keywords in URL paths. Clean slugs without special characters, spaces, or query noise increase search CTR and keyword relevance.',
  },
  {
    question: 'How are accented international characters handled in slugs?',
    answer: 'Accented characters (e.g. `é`, `ñ`, `ü`) are normalized into plain ASCII equivalents (`e`, `n`, `u`) to prevent percent-encoding breaks in URLs.',
  },
  {
    question: 'Should stop words (a, the, and) be removed from URL slugs?',
    answer: 'Removing unnecessary stop words keeps slugs concise and focused on high-intent target keywords without diluting URL relevance.',
  },
  {
    question: 'Is my input string transmitted to remote servers?',
    answer: 'No! Slug generation executes 100% locally in your browser using JavaScript string normalization.',
  },
];
---

<ToolLayout
  toolId="slug-generator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="slug-generator-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="ARTICLE TITLE / RAW TEXT INPUT">
        <div class="space-y-16">
          <div>
            <label for="slug-input-title" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Raw Article Title or String</label>
            <input
              id="slug-input-title"
              type="text"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-sans text-sm font-bold"
              value="The Ultimate Guide to AI Prompt Engineering & LLM Tools for 2026!"
            />
          </div>

          <button
            type="button"
            id="btn-gen-slug"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Generate Clean URL Slug
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="GENERATED URL SLUG">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">URL-Safe Slug</span>
            <button type="button" id="btn-copy-slug" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Slug</button>
          </div>

          <pre id="slug-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[60px] leading-relaxed whitespace-pre-wrap break-all"></pre>

          <div>
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Full Preview URL Path</span>
            <pre id="slug-output-url" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed whitespace-pre-wrap break-all"></pre>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>URL Slug Optimization & SEO Best Practices</h2>
    <p>
      Crafting short, descriptive, keyword-rich URL slugs improves click-through rates (CTR) in search engine results and social media shares.
    </p>

    <h3>SEO Slug Best Practices</h3>
    <ul>
      <li><strong>Use Hyphens</strong>: Separate words with hyphens (<code>-</code>) instead of underscores (<code>_</code>) or spaces.</li>
      <li><strong>Lowercase Only</strong>: Convert all characters to lowercase to prevent 404 duplicate content errors on case-sensitive servers.</li>
      <li><strong>Remove Accents & Symbols</strong>: Normalize international characters (e.g. <code>é</code> → <code>e</code>) and strip non-alphanumeric symbols.</li>
    </ul>

    <h3>Related Developer Tools</h3>
    <p>
      Convert string cases with the <a href="/tools/case-converter/">String Case Converter</a>, build meta tags with the <a href="/tools/meta-tag-analyzer/">Meta Tag Analyzer</a>, or audit SERP snippets with the <a href="/tools/serp-preview/">SERP Preview Simulator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputTitle = document.getElementById('slug-input-title');
    const btnGen = document.getElementById('btn-gen-slug');

    const outputText = document.getElementById('slug-output-text');
    const outputUrl = document.getElementById('slug-output-url');
    const btnCopy = document.getElementById('btn-copy-slug');

    function generateSlug(str) {
      return str
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/[\s_]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function generate() {
      const title = inputTitle?.value || 'The Ultimate Guide to AI Prompt Engineering';
      const slug = generateSlug(title);

      if (outputText) outputText.textContent = slug;
      if (outputUrl) outputUrl.textContent = `https://nadhebe.com/tools/${slug}/`;
    }

    btnGen?.addEventListener('click', generate);
    inputTitle?.addEventListener('input', generate);

    btnCopy?.addEventListener('click', () => {
      if (outputText) {
        navigator.clipboard.writeText(outputText.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy Slug'), 2000);
      }
    });

    generate();
  })();
</script>
