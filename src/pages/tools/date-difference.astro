---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Date Difference & Business Days Calculator | Nadhebe';
const h1 = 'Date Difference & Business Days Calculator';
const description = 'Calculate the exact number of days, weeks, months, and working business days between two calendar dates client-side.';

const faq = [
  {
    question: 'How does the Date Difference Calculator work?',
    answer: 'Select a Start Date and End Date. The calculator computes total calendar days, exact weeks, months, years, and working business days (excluding Saturdays and Sundays).',
  },
  {
    question: 'Are leap years accounted for in date calculations?',
    answer: 'Yes! Calendar calculations automatically account for 366-day leap years and varying month lengths.',
  },
  {
    question: 'What constitutes a "Business Day"?',
    answer: 'By default, business days count Monday through Friday, automatically filtering out weekends.',
  },
  {
    question: 'Is my date data kept private?',
    answer: '100% private. All calculations run locally in your web browser.',
  },
  {
    question: 'Can I include or exclude the end date in the total count?',
    answer: 'The calculation includes the exact duration count between dates, with an option to count inclusive days.',
  },
];
---

<ToolLayout
  toolId="date-difference"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="date-diff-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="START & END CALENDAR DATES">
        <div class="space-y-16">
          <div>
            <label for="dd-input-start" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Start Date</label>
            <input
              id="dd-input-start"
              type="date"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
              value="2026-01-01"
            />
          </div>

          <div>
            <label for="dd-input-end" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">End Date</label>
            <input
              id="dd-input-end"
              type="date"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
              value="2026-12-31"
            />
          </div>

          <button
            type="button"
            id="btn-calc-dd"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Calculate Date Duration
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="DURATION & BUSINESS DAYS REPORT">
        <div class="space-y-20">
          
          <div class="grid grid-cols-2 gap-12 font-mono text-center">
            <div class="rounded-12 border border-emerald-500/30 bg-emerald-500/10 p-16">
              <div id="stat-dd-days" class="text-h2 font-bold text-emerald-800 dark:text-emerald-300">364 Days</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Total Calendar Days</div>
            </div>
            <div class="rounded-12 border border-border bg-surface2/60 p-16 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-dd-biz" class="text-h2 font-bold text-accent dark:text-accent-dark">260 Days</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Working Business Days</div>
            </div>
          </div>

          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Weeks & Remaining Days:</span>
              <span id="stat-dd-weeks" class="font-bold text-ink dark:text-ink-dark">52 Weeks, 0 Days</span>
            </div>
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Approximate Months:</span>
              <span id="stat-dd-months" class="font-bold text-ink dark:text-ink-dark">11 Months, 30 Days</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <span>Total Hours & Seconds:</span>
              <span id="stat-dd-hours" class="font-bold text-emerald-600 dark:text-emerald-400">8,736 Hours</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Date Duration & Working Business Days Guide</h2>
    <p>
      Accurately calculating calendar durations and working business days is essential for project management planning, contract deadlines, sprint scheduling, and SLA tracking.
    </p>

    <h3>Calculation Method</h3>
    <ul>
      <li><strong>Calendar Duration</strong>: Exact difference between start and end timestamps.</li>
      <li><strong>Business Days</strong>: Iterates day-by-day excluding Saturdays (6) and Sundays (0).</li>
    </ul>

    <h3>Related Utility Tools</h3>
    <p>
      Generate cron schedules with the <a href="/tools/cron-explainer/">Cron Explainer</a>, convert URL slugs with the <a href="/tools/slug-generator/">Slug Generator</a>, or calculate compound growth with the <a href="/tools/compound-interest/">Compound Interest Calculator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputStart = document.getElementById('dd-input-start');
    const inputEnd = document.getElementById('dd-input-end');
    const btnCalc = document.getElementById('btn-calc-dd');

    const statDays = document.getElementById('stat-dd-days');
    const statBiz = document.getElementById('stat-dd-biz');
    const statWeeks = document.getElementById('stat-dd-weeks');
    const statMonths = document.getElementById('stat-dd-months');
    const statHours = document.getElementById('stat-dd-hours');

    function calculate() {
      const d1 = new Date(inputStart?.value || '2026-01-01');
      const d2 = new Date(inputEnd?.value || '2026-12-31');

      if (isNaN(d1.getTime()) || isNaN(d2.getTime())) return;

      const diffMs = Math.abs(d2.getTime() - d1.getTime());
      const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

      // Calculate business days
      let bizDays = 0;
      let cur = new Date(Math.min(d1.getTime(), d2.getTime()));
      const endMs = Math.max(d1.getTime(), d2.getTime());

      while (cur.getTime() < endMs) {
        const dayOfWeek = cur.getDay();
        if (dayOfWeek !== 0 && dayOfWeek !== 6) {
          bizDays++;
        }
        cur.setDate(cur.getDate() + 1);
      }

      const weeks = Math.floor(totalDays / 7);
      const remDays = totalDays % 7;
      const hours = totalDays * 24;

      if (statDays) statDays.textContent = `${totalDays} Days`;
      if (statBiz) statBiz.textContent = `${bizDays} Days`;
      if (statWeeks) statWeeks.textContent = `${weeks} Weeks, ${remDays} Days`;
      if (statMonths) statMonths.textContent = `~${(totalDays / 30.4375).toFixed(1)} Months`;
      if (statHours) statHours.textContent = `${hours.toLocaleString()} Hours`;
    }

    btnCalc?.addEventListener('click', calculate);
    [inputStart, inputEnd].forEach(el => {
      el?.addEventListener('change', calculate);
    });

    calculate();
  })();
</script>
