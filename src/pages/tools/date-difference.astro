---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'date-difference');
if (!platformTool) throw new Error('Tool not found');

const faq = [
  {
    question: 'Does this calculate the time difference accurately across leap years?',
    answer: 'Yes! We use advanced date math algorithms to properly account for leap years, varying month lengths, and daylight saving time transitions.',
  },
  {
    question: 'Does it count both the start and end date?',
    answer: 'The difference is calculated as the mathematical distance between two points in time. If you input Jan 1st 00:00 and Jan 2nd 00:00, the result is exactly 1 day (24 hours).',
  }
];
---

<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} faq={faq} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="max-w-4xl mx-auto py-16 space-y-16">
    <div class="glass-panel p-24 md:p-32 rounded-24 border border-border bg-surface/95 shadow-large dark:border-border-dark dark:bg-surface-dark/95">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-32">
        
        <!-- Input Form -->
        <div class="space-y-24">
          <h3 class="text-lg font-bold text-ink dark:text-ink-dark font-sans tracking-tight">Select Dates</h3>
          
          <div class="space-y-16">
            <div class="space-y-8">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Start Date</label>
              <input type="datetime-local" id="start-date" class="w-full p-12 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all cursor-pointer" />
            </div>

            <div class="flex items-center justify-center">
              <div class="w-32 h-32 flex items-center justify-center rounded-full bg-surface2 dark:bg-surface2-dark text-muted dark:text-muted-dark opacity-50">
                <svg xmlns="http://www.w3.org/20لها.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
              </div>
            </div>

            <div class="space-y-8">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">End Date</label>
              <input type="datetime-local" id="end-date" class="w-full p-12 rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark font-mono text-ink dark:text-ink-dark focus:border-accent dark:focus:border-accent-dark outline-none transition-all cursor-pointer" />
            </div>
            
            <div class="pt-8">
              <button id="btn-now" class="text-xs font-semibold text-accent dark:text-accent-dark hover:underline">Set End Date to Right Now</button>
            </div>
          </div>
        </div>

        <!-- Output Results -->
        <div class="flex flex-col space-y-24 bg-surface2/50 dark:bg-surface2-dark/50 p-24 md:p-32 rounded-24 border border-border/50 dark:border-border-dark/50">
          <div class="space-y-8 text-center border-b border-border/50 dark:border-border-dark/50 pb-24">
            <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Time Difference</h3>
            <div id="diff-human" class="text-2xl md:text-3xl font-black text-emerald-600 dark:text-emerald-400 tracking-tight leading-tight">
              0 days
            </div>
          </div>

          <div class="space-y-12 flex-1">
            <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark mb-16">Total Conversions</h3>
            
            <div class="grid grid-cols-2 gap-x-12 gap-y-16">
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Total Days</div>
                <div id="out-days" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Total Weeks</div>
                <div id="out-weeks" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Total Hours</div>
                <div id="out-hours" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Total Minutes</div>
                <div id="out-minutes" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
              <div class="space-y-4 col-span-2">
                <div class="text-xs font-semibold text-muted dark:text-muted-dark uppercase">Total Seconds</div>
                <div id="out-seconds" class="font-mono font-bold text-ink dark:text-ink-dark">0</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div slot="content">
    <h2>Calculate the Exact Difference Between Two Dates</h2>
    <p>Calculating the exact time difference between two dates can be surprisingly complex due to leap years, months of different lengths, and timezones. This tool handles all the complexity for you, instantly computing the difference in years, months, days, hours, and down to the second.</p>
  </div>
</ToolLayout>

<script>
  import { intervalToDuration, differenceInDays, differenceInWeeks, differenceInHours, differenceInMinutes, differenceInSeconds } from 'date-fns';

  function setupDateDiff() {
    const startInput = document.getElementById('start-date') as HTMLInputElement;
    const endInput = document.getElementById('end-date') as HTMLInputElement;
    const btnNow = document.getElementById('btn-now');

    const outHuman = document.getElementById('diff-human');
    const outDays = document.getElementById('out-days');
    const outWeeks = document.getElementById('out-weeks');
    const outHours = document.getElementById('out-hours');
    const outMinutes = document.getElementById('out-minutes');
    const outSeconds = document.getElementById('out-seconds');

    // Format for datetime-local: YYYY-MM-DDThh:mm
    function toLocalISO(date: Date) {
      const tzOffset = date.getTimezoneOffset() * 60000; 
      const localISOTime = (new Date(date.getTime() - tzOffset)).toISOString().slice(0,16);
      return localISOTime;
    }

    // Set defaults
    const now = new Date();
    const future = new Date(now.getTime() + (30 * 24 * 60 * 60 * 1000)); // 30 days from now
    
    if (startInput) startInput.value = toLocalISO(now);
    if (endInput) endInput.value = toLocalISO(future);

    if (btnNow && endInput) {
      btnNow.addEventListener('click', () => {
        endInput.value = toLocalISO(new Date());
        calculate();
      });
    }

    function calculate() {
      if (!startInput || !endInput || !outHuman) return;

      const d1 = new Date(startInput.value);
      const d2 = new Date(endInput.value);

      if (isNaN(d1.getTime()) || isNaN(d2.getTime())) {
        outHuman.textContent = 'Invalid Date';
        outHuman.className = 'text-2xl md:text-3xl font-black text-danger dark:text-danger-dark tracking-tight leading-tight';
        return;
      }

      // Check if negative
      const isNegative = d2.getTime() < d1.getTime();
      const start = isNegative ? d2 : d1;
      const end = isNegative ? d1 : d2;

      // Human readable
      const duration = intervalToDuration({ start, end });
      let parts = [];
      if (duration.years) parts.push(duration.years + ' year' + (duration.years > 1 ? 's' : ''));
      if (duration.months) parts.push(duration.months + ' month' + (duration.months > 1 ? 's' : ''));
      if (duration.days) parts.push(duration.days + ' day' + (duration.days > 1 ? 's' : ''));
      if (duration.hours) parts.push(duration.hours + ' hour' + (duration.hours > 1 ? 's' : ''));
      if (duration.minutes) parts.push(duration.minutes + ' minute' + (duration.minutes > 1 ? 's' : ''));
      if (duration.seconds && parts.length === 0) parts.push(duration.seconds + ' second' + (duration.seconds > 1 ? 's' : ''));
      
      let humanStr = parts.join(', ');
      if (!humanStr) humanStr = '0 days (Same exact time)';
      if (isNegative && parts.length > 0) humanStr = '− ' + humanStr;

      outHuman.textContent = humanStr;
      outHuman.className = 'text-2xl md:text-3xl font-black text-emerald-600 dark:text-emerald-400 tracking-tight leading-tight';

      // Totals
      const formatter = new Intl.NumberFormat('en-US');
      
      const totalDays = differenceInDays(end, start) * (isNegative ? -1 : 1);
      const totalWeeks = Math.floor(differenceInDays(end, start) / 7) * (isNegative ? -1 : 1);
      const totalHours = differenceInHours(end, start) * (isNegative ? -1 : 1);
      const totalMinutes = differenceInMinutes(end, start) * (isNegative ? -1 : 1);
      const totalSeconds = differenceInSeconds(end, start) * (isNegative ? -1 : 1);

      if (outDays) outDays.textContent = formatter.format(totalDays);
      if (outWeeks) outWeeks.textContent = formatter.format(totalWeeks);
      if (outHours) outHours.textContent = formatter.format(totalHours);
      if (outMinutes) outMinutes.textContent = formatter.format(totalMinutes);
      if (outSeconds) outSeconds.textContent = formatter.format(totalSeconds);
    }

    if (startInput) startInput.addEventListener('input', calculate);
    if (endInput) endInput.addEventListener('input', calculate);

    calculate();
  }

  setupDateDiff();
</script>
