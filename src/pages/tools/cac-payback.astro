---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'SaaS CAC Payback Period & LTV Calculator | Nadhebe';
const h1 = 'SaaS CAC Payback Period & LTV Calculator';
const description = 'Calculate SaaS Customer Acquisition Cost (CAC) payback period in months, LTV to CAC ratio, and Gross Margin Adjusted payback client-side.';

const faq = [
  {
    question: 'What is SaaS CAC Payback Period?',
    answer: 'CAC Payback Period is the number of months required for a SaaS business to recover the sales and marketing money spent to acquire a single customer.',
  },
  {
    question: 'What is the formula for Gross Margin Adjusted CAC Payback?',
    answer: '`CAC Payback (Months) = CAC / (ARPU * Gross Margin %)` where ARPU is Average Revenue Per User per month.',
  },
  {
    question: 'What is a good CAC Payback Period benchmark for SaaS startups?',
    answer: 'Under 12 months is considered healthy for SMB SaaS. For Enterprise SaaS with multi-year contracts, 18-24 months is standard.',
  },
  {
    question: 'What is the LTV:CAC Ratio?',
    answer: 'Lifetime Value (LTV) divided by CAC. An LTV:CAC ratio of 3.0x or higher indicates strong unit economics.',
  },
  {
    question: 'Is my financial SaaS data kept private?',
    answer: '100% private. All calculations run locally in your web browser.',
  },
];
---

<ToolLayout
  toolId="cac-payback"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="cac-payback-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="SAAS UNIT ECONOMICS PARAMETERS">
        <div class="space-y-16">
          <div>
            <label for="cac-input-cost" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Customer Acquisition Cost (CAC) ($)</label>
            <input
              id="cac-input-cost"
              type="number"
              min="1"
              step="50"
              value="1200"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="cac-input-arpu" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Average Monthly Revenue (ARPU) ($)</label>
            <input
              id="cac-input-arpu"
              type="number"
              min="1"
              step="10"
              value="150"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="cac-input-margin" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Gross Margin (%)</label>
            <input
              id="cac-input-margin"
              type="number"
              min="1"
              max="100"
              step="1"
              value="80"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="cac-input-churn" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Monthly Customer Churn Rate (%)</label>
            <input
              id="cac-input-churn"
              type="number"
              min="0.1"
              max="20"
              step="0.1"
              value="2.5"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <button
            type="button"
            id="btn-calc-cac"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Calculate SaaS Payback
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="PAYBACK & UNIT ECONOMICS METRICS">
        <div class="space-y-20">
          
          <div class="grid grid-cols-2 gap-12 font-mono text-center">
            <div class="rounded-12 border border-emerald-500/30 bg-emerald-500/10 p-16">
              <div id="stat-cac-months" class="text-h2 font-bold text-emerald-800 dark:text-emerald-300">10.0 Mos</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Gross Margin CAC Payback</div>
            </div>
            <div class="rounded-12 border border-border bg-surface2/60 p-16 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-cac-ltv-ratio" class="text-h2 font-bold text-accent dark:text-accent-dark">4.0x</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">LTV : CAC Ratio</div>
            </div>
          </div>

          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Customer Lifetime Value (LTV):</span>
              <span id="stat-cac-ltv" class="font-bold text-ink dark:text-ink-dark">$4,800</span>
            </div>
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Average Customer Lifespan:</span>
              <span id="stat-cac-lifespan" class="font-bold text-ink dark:text-ink-dark">40.0 Months</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <span>Unit Economics Health Rating:</span>
              <span id="stat-cac-rating" class="font-bold text-emerald-600 dark:text-emerald-400">Excellent (&lt;12 Mos Payback) ✓</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>SaaS Unit Economics & Capital Efficiency Guide</h2>
    <p>
      Optimizing CAC payback period and LTV:CAC ratios allows B2B SaaS founders to scale sales and marketing acquisition loops sustainably.
    </p>

    <h3>Benchmark Guidelines</h3>
    <ul>
      <li><strong>Payback &lt; 12 Months</strong>: Top-quartile capital efficiency.</li>
      <li><strong>LTV : CAC &gt; 3.0x</strong>: Healthy scalable SaaS unit economics.</li>
    </ul>

    <h3>Related Financial Tools</h3>
    <p>
      Calculate compound interest with the <a href="/tools/compound-interest/">Compound Interest Calculator</a>, calculate profit margins with the <a href="/tools/profit-margin-calculator/">Profit Margin Calculator</a>, or estimate API costs with the <a href="/tools/claude-cost-estimator/">Claude Cost Estimator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputCost = document.getElementById('cac-input-cost');
    const inputArpu = document.getElementById('cac-input-arpu');
    const inputMargin = document.getElementById('cac-input-margin');
    const inputChurn = document.getElementById('cac-input-churn');
    const btnCalc = document.getElementById('btn-calc-cac');

    const statMonths = document.getElementById('stat-cac-months');
    const statLtvRatio = document.getElementById('stat-cac-ltv-ratio');
    const statLtv = document.getElementById('stat-cac-ltv');
    const statLifespan = document.getElementById('stat-cac-lifespan');
    const statRating = document.getElementById('stat-cac-rating');

    function calculate() {
      const cac = parseFloat(inputCost?.value || '1200');
      const arpu = parseFloat(inputArpu?.value || '150');
      const margin = parseFloat(inputMargin?.value || '80') / 100;
      const churn = parseFloat(inputChurn?.value || '2.5') / 100;

      const monthlyMarginRevenue = arpu * margin;
      const paybackMonths = monthlyMarginRevenue > 0 ? (cac / monthlyMarginRevenue) : 0;

      const lifespanMonths = churn > 0 ? (1 / churn) : 0;
      const ltv = monthlyMarginRevenue * lifespanMonths;
      const ltvRatio = cac > 0 ? (ltv / cac) : 0;

      if (statMonths) statMonths.textContent = `${paybackMonths.toFixed(1)} Mos`;
      if (statLtvRatio) statLtvRatio.textContent = `${ltvRatio.toFixed(1)}x`;
      if (statLtv) statLtv.textContent = `$${Math.round(ltv).toLocaleString()}`;
      if (statLifespan) statLifespan.textContent = `${lifespanMonths.toFixed(1)} Months`;

      if (statRating) {
        if (paybackMonths <= 12 && ltvRatio >= 3) statRating.textContent = 'Excellent (<12 Mos Payback) ✓';
        else if (paybackMonths <= 18) statRating.textContent = 'Good (Healthy SaaS Scaling)';
        else statRating.textContent = 'High Payback Period (>18 Mos)';
      }
    }

    btnCalc?.addEventListener('click', calculate);
    [inputCost, inputArpu, inputMargin, inputChurn].forEach(el => {
      el?.addEventListener('input', calculate);
    });

    calculate();
  })();
</script>
