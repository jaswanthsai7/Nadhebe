---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'JSONPath Evaluator & Key Extractor | Nadhebe';
const h1 = 'JSONPath Evaluator & Key Extractor';
const description = 'Evaluate JSONPath expressions against nested JSON payloads. Extract object properties, filter arrays, and query nested JSON trees client-side.';

const faq = [
  {
    question: 'What is JSONPath?',
    answer: 'JSONPath is a query expression language for JSON (similar to XPath for XML) that allows developers to traverse, extract, and filter properties from complex nested JSON objects.',
  },
  {
    question: 'What is the syntax for root object access in JSONPath?',
    answer: 'The `$` symbol represents the root object. For example, `$.store.book[*].author` extracts author names from all books in the store.',
  },
  {
    question: 'What does the wild-card operator `*` do?',
    answer: 'The `*` operator matches all element names or array elements. For example, `$.users[*].id` returns all user ID values in an array.',
  },
  {
    question: 'Is JSONPath evaluation safe for private data?',
    answer: 'Yes! JSONPath parsing runs 100% locally in your browser without transmitting payloads to remote servers.',
  },
  {
    question: 'How do I access array indices in JSONPath?',
    answer: 'Use bracket notation with zero-based indices (e.g. `$.items[0]` for the first item or `$.items[-1]` for the last item).',
  },
];
---

<ToolLayout
  toolId="json-path-finder"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="jsonpath-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="JSON PAYLOAD & JSONPATH QUERY">
        <div class="space-y-16">
          <div>
            <label for="jp-input-query" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">JSONPath Expression (e.g. $.users[*].name)</label>
            <input
              id="jp-input-query"
              type="text"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-xs font-bold"
              value="$.store.book[*].title"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="jp-input-data" class="block text-caption font-semibold text-ink dark:text-ink-dark">JSON Target Document</label>
              <button type="button" id="btn-load-sample-jp" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample Document</button>
            </div>
            <textarea
              id="jp-input-data"
              rows="10"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <button
            type="button"
            id="btn-eval-jp"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Evaluate JSONPath Query
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="MATCHED JSONPATH RESULT">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Evaluated Output</span>
            <button type="button" id="btn-copy-jp" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Result</button>
          </div>

          <pre id="jp-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[300px] leading-relaxed whitespace-pre-wrap"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>JSONPath Query Traversal Guide</h2>
    <p>
      JSONPath provides standard syntax for querying and filtering nested JSON documents in web applications, log analysis pipelines, and API integrations.
    </p>

    <h3>JSONPath Core Operators</h3>
    <ul>
      <li><code>$</code> — Root object or array.</li>
      <li><code>.key</code> — Child property accessor.</li>
      <li><code>[*]</code> — Wildcard accessor for array elements.</li>
      <li><code>..key</code> — Recursive descent search across all nested levels.</li>
    </ul>

    <h3>Related Developer Tools</h3>
    <p>
      Repair malformed JSON with the <a href="/tools/json-repair/">JSON Repair Tool</a>, format JSON payloads with the <a href="/tools/json-formatter/">JSON Formatter</a>, or validate schemas with the <a href="/tools/json-schema-validator/">JSON Schema Validator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputQuery = document.getElementById('jp-input-query');
    const inputData = document.getElementById('jp-input-data');
    const btnEval = document.getElementById('btn-eval-jp');
    const btnSample = document.getElementById('btn-load-sample-jp');

    const outputText = document.getElementById('jp-output-text');
    const btnCopy = document.getElementById('btn-copy-jp');

    const defaultDoc = `{
  "store": {
    "book": [
      { "category": "fiction", "title": "Dune", "price": 12.99 },
      { "category": "tech", "title": "Designing Data-Intensive Applications", "price": 45.00 },
      { "category": "fiction", "title": "Neuromancer", "price": 14.50 }
    ],
    "owner": "Nadhebe Library"
  }
}`;

    function evaluateJSONPath(doc, query) {
      try {
        const obj = JSON.parse(doc);
        const parts = query.replace(/^\$\.?/, '').split('.').filter(Boolean);

        let current = [obj];

        for (const part of parts) {
          const next = [];
          for (const item of current) {
            if (item === null || typeof item !== 'object') continue;

            if (part.includes('[*]')) {
              const key = part.replace(/\[\*\]/, '');
              const target = key ? item[key] : item;
              if (Array.isArray(target)) {
                next.push(...target);
              }
            } else if (part in item) {
              next.push(item[part]);
            }
          }
          current = next;
        }

        return JSON.stringify(current.length === 1 ? current[0] : current, null, 2);
      } catch(e) {
        return `// JSONPath Evaluation Error: ${e.message}`;
      }
    }

    function evaluate() {
      const query = inputQuery?.value || '$.store.book[*].title';
      const doc = inputData?.value || defaultDoc;
      const result = evaluateJSONPath(doc, query);
      if (outputText) outputText.textContent = result;
    }

    btnEval?.addEventListener('click', evaluate);
    [inputQuery, inputData].forEach(el => {
      el?.addEventListener('input', evaluate);
    });

    btnSample?.addEventListener('click', () => {
      if (inputData) inputData.value = defaultDoc;
      if (inputQuery) inputQuery.value = '$.store.book[*].title';
      evaluate();
    });

    if (inputData && !inputData.value) inputData.value = defaultDoc;

    evaluate();
  })();
</script>
