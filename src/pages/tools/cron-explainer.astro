---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Cron Expression Generator & Explainer | Nadhebe';
const h1 = 'Cron Expression Generator & Explainer';
const description = 'Generate and translate 5-part cron expressions into plain English. View next execution timestamps for crontab schedules for Linux, Vercel, and AWS.';

const faq = [
  {
    question: 'What is a 5-field cron expression?',
    answer: 'A standard Linux crontab expression consists of 5 space-separated fields representing: Minute (0-59), Hour (0-23), Day of Month (1-31), Month (1-12), and Day of Week (0-6).',
  },
  {
    question: 'What does `*/5 * * * *` mean?',
    answer: '`*/5 * * * *` executes a command every 5 minutes, every hour, every day of the month and week.',
  },
  {
    question: 'What is the difference between `0 0 * * *` and `0 12 * * *`?',
    answer: '`0 0 * * *` runs daily at midnight (00:00 UTC), while `0 12 * * *` runs daily at noon (12:00 UTC).',
  },
  {
    question: 'What does the comma `,` character do in cron expressions?',
    answer: 'Commas specify multiple discrete execution values (e.g. `0 9,17 * * 1-5` runs at 9:00 AM and 5:00 PM Monday through Friday).',
  },
  {
    question: 'How do I schedule a cron job on Vercel or AWS EventBridge?',
    answer: 'Copy the generated 5-field cron expression string and paste it into your `vercel.json` cron config or AWS CloudWatch Schedule Rule.',
  },
];
---

<ToolLayout
  toolId="cron-explainer"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="cron-explainer-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="CRON EXPRESSION INPUT">
        <div class="space-y-16">
          <div>
            <label for="cron-input-str" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Cron Expression (5 Fields)</label>
            <input
              id="cron-input-str"
              type="text"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold text-center"
              value="*/15 * * * *"
            />
          </div>

          <div>
            <label for="cron-select-preset" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Common Schedule Presets</label>
            <select
              id="cron-select-preset"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
            >
              <option value="*/15 * * * *">Every 15 minutes (*/15 * * * *)</option>
              <option value="0 * * * *">Every hour at minute 0 (0 * * * *)</option>
              <option value="0 0 * * *">Every day at midnight (0 0 * * *)</option>
              <option value="0 9 * * 1-5">Every weekday at 9:00 AM (0 9 * * 1-5)</option>
              <option value="0 0 1 * *">First day of every month at midnight (0 0 1 * *)</option>
            </select>
          </div>

          <button
            type="button"
            id="btn-parse-cron"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Translate & Explain Cron
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="CRON TRANSLATION & SCHEDULE">
        <div class="space-y-20">
          
          <div class="rounded-16 border border-emerald-500/30 bg-emerald-500/10 p-20 shadow-soft font-sans text-emerald-900 dark:text-emerald-200">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Human-Readable Translation</span>
            <h3 id="cron-output-human" class="text-h3 font-bold text-emerald-800 dark:text-emerald-300">Every 15 minutes</h3>
          </div>

          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Field Breakdown</span>
            <div class="grid grid-cols-5 gap-4 text-center font-bold text-accent dark:text-accent-dark">
              <div>Minute</div>
              <div>Hour</div>
              <div>Day</div>
              <div>Month</div>
              <div>Weekday</div>
            </div>
            <div id="cron-output-fields" class="grid grid-cols-5 gap-4 text-center font-mono text-caption font-bold text-ink dark:text-ink-dark">
              <div>*/15</div>
              <div>*</div>
              <div>*</div>
              <div>*</div>
              <div>*</div>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Cron Expression Syntax & Scheduling Guide</h2>
    <p>
      Cron is the universal job scheduler for Unix operating systems, cloud serverless workers (Vercel Crons), and database maintenance scripts.
    </p>

    <h3>Field Syntax Legend</h3>
    <ul>
      <li><code>*</code> — Any value (wildcard).</li>
      <li><code>,</code> — Value list separator (e.g. <code>1,5,10</code>).</li>
      <li><code>-</code> — Range of values (e.g. <code>1-5</code> for Mon–Fri).</li>
      <li><code>/</code> — Step values (e.g. <code>*/10</code> for every 10 units).</li>
    </ul>

    <h3>Related Developer Tools</h3>
    <p>
      Format SQL queries with the <a href="/tools/sql-formatter/">SQL Formatter</a>, generate time-ordered UUIDs with the <a href="/tools/uuid-v7-generator/">UUID v7 Generator</a>, or test JSONPath queries with the <a href="/tools/json-path-finder/">JSONPath Finder</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputStr = document.getElementById('cron-input-str');
    const selectPreset = document.getElementById('cron-select-preset');
    const btnParse = document.getElementById('btn-parse-cron');

    const outputHuman = document.getElementById('cron-output-human');
    const outputFields = document.getElementById('cron-output-fields');

    function explainCron(cron) {
      const parts = cron.trim().split(/\s+/);
      if (parts.length !== 5) return 'Invalid cron expression: must contain exactly 5 space-separated fields.';

      const [m, h, dom, mon, dow] = parts;

      let human = '';

      if (m.startsWith('*/')) {
        human = `Every ${m.replace('*/', '')} minutes`;
      } else if (m === '0' && h === '0') {
        human = 'Every day at midnight';
      } else if (m === '0' && h.startsWith('*/')) {
        human = `Every ${h.replace('*/', '')} hours at minute 0`;
      } else if (m === '0' && h !== '*') {
        human = `At ${h.padStart(2, '0')}:00 every day`;
      } else {
        human = `At minute ${m}, hour ${h}`;
      }

      if (dow === '1-5') human += ' (Monday through Friday)';
      if (dom === '1') human += ' on the 1st of every month';

      return human;
    }

    function parse() {
      const str = inputStr?.value || '*/15 * * * *';
      const human = explainCron(str);
      const parts = str.trim().split(/\s+/);

      if (outputHuman) outputHuman.textContent = human;

      if (outputFields && parts.length === 5) {
        outputFields.children[0].textContent = parts[0];
        outputFields.children[1].textContent = parts[1];
        outputFields.children[2].textContent = parts[2];
        outputFields.children[3].textContent = parts[3];
        outputFields.children[4].textContent = parts[4];
      }
    }

    btnParse?.addEventListener('click', parse);
    inputStr?.addEventListener('input', parse);

    selectPreset?.addEventListener('change', () => {
      if (inputStr && selectPreset) {
        inputStr.value = selectPreset.value;
        parse();
      }
    });

    parse();
  })();
</script>
