---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedList from '@/components/FeedList.astro';
import InlineToolSearch from '@/components/tools/InlineToolSearch.astro';
import { PLATFORM_CATEGORIES } from '@/config/platform-tools';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const PLATFORM_TOOLS = UNIFIED_TOOLS_REGISTRY;
const PLATFORM_TOOL_TOTAL = PLATFORM_TOOLS.length;
import ToolSearchModal from '@/components/tools/ToolSearchModal.astro';
import { buildSeo } from '@/utils/seo';
import { SITE } from '@/config';

const articlePosts = await getCollection('tools');
const sortedArticles = articlePosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const seo = buildSeo({
  title: 'Free Web Utilities & Developer Tools',
  description: 'Fast, free, 100% client-side web utilities for developers, designers, video creators, and webmasters. No login or database required.',
  slug: '/tools/',
  siteUrl: SITE.url,
  siteName: SITE.name,
  keywords: ['online tools', 'aspect ratio calculator', 'resize dimensions', 'ppi calculator', 'dpi calculator', 'social media image sizes', 'megapixels calculator'],
});

const toolsDirectorySchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemPage',
  name: 'Free Web Utilities & Developer Tools',
  description: 'Directory of fast, client-side developer, media, and designer utilities.',
  url: `${SITE.url}/tools/`,
};
---

<BaseLayout seo={seo} jsonLd={[toolsDirectorySchema]}>
  <div class="mx-auto max-w-content px-16 sm:px-24 py-32 sm:py-48">
    
    <!-- Hero Header -->
    <header class="glass-panel relative overflow-hidden rounded-24 border border-border p-24 sm:p-40 shadow-medium dark:border-border-dark mb-48" data-reveal>
      <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent/15 blur-3xl dark:bg-accent-dark/15"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-8 rounded-pill border border-emerald-500/30 bg-emerald-500/10 px-12 py-4 font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <span class="relative flex h-8 w-8">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-8 w-8 rounded-full bg-emerald-500"></span>
          </span>
          100% Free & Client-Side Utilities
        </div>

        <h1 class="mt-16 font-display text-h1 sm:text-display font-bold leading-tight text-ink dark:text-ink-dark">
          Free Utilities & Developer Tools
        </h1>
        <p class="mt-12 text-body-large text-ink2 dark:text-ink2-dark max-w-3xl leading-relaxed">
          Ultra-fast, browser-based calculators and engineering tools built for designers, video editors, frontend developers, and content creators. Privacy-first with zero tracking of your inputs.
        </p>

        <!-- Metrics bar -->
        <div class="mt-24 grid grid-cols-2 sm:grid-cols-4 gap-12 pt-20 border-t border-border/60 dark:border-border-dark/60">
          <div>
            <span class="text-meta font-mono uppercase text-muted dark:text-muted-dark">Interactive Utilities</span>
            <p class="font-display text-h3 font-bold text-ink dark:text-ink-dark">{PLATFORM_TOOL_TOTAL}+</p>
          </div>
          <div>
            <span class="text-meta font-mono uppercase text-muted dark:text-muted-dark">Privacy</span>
            <p class="font-display text-h3 font-bold text-emerald-600 dark:text-emerald-400">100% Local</p>
          </div>
          <div>
            <span class="text-meta font-mono uppercase text-muted dark:text-muted-dark">Speed</span>
            <p class="font-display text-h3 font-bold text-accent dark:text-accent-dark">Instant (0ms)</p>
          </div>
          <div>
            <span class="text-meta font-mono uppercase text-muted dark:text-muted-dark">Access</span>
            <p class="font-display text-h3 font-bold text-ink dark:text-ink-dark">No Account</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Category Filter Bar & Live Search -->
    <div class="sticky top-72 z-30 mb-32 flex flex-col md:flex-row gap-16 items-center justify-between rounded-20 border border-border/80 bg-surface/95 p-16 shadow-medium backdrop-blur-xl dark:border-border-dark/80 dark:bg-surface-dark/95" data-reveal>
      
      <!-- Custom Dropdown Category Filter -->
      <div class="relative w-full md:w-auto shrink-0" id="category-dropdown-container">
        <!-- Trigger Button -->
        <button
          type="button"
          id="category-dropdown-trigger"
          class="flex w-full sm:w-auto items-center justify-between gap-12 rounded-12 border border-border/80 bg-surface2/60 px-20 py-12 text-[14px] font-sans font-semibold text-ink transition-all duration-200 hover:bg-surface hover:border-border dark:border-border-dark/80 dark:bg-surface2-dark/60 dark:text-ink-dark dark:hover:bg-surface-dark dark:hover:border-border-dark shadow-soft"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="flex items-center gap-8">
            <svg class="h-16 w-16 text-accent dark:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span id="category-dropdown-label" class="whitespace-nowrap">Filter by Category: All Tools ({PLATFORM_TOOL_TOTAL})</span>
          </span>
          <svg class="h-16 w-16 text-muted transition-transform duration-200" id="category-dropdown-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="category-dropdown-menu"
          role="listbox"
          class="absolute left-0 top-[calc(100%+8px)] z-50 hidden max-h-[320px] w-full sm:w-[320px] overflow-y-auto rounded-16 border border-border bg-surface p-8 shadow-large dark:border-border-dark dark:bg-surface-dark custom-scrollbar"
        >
          <button
            type="button"
            role="option"
            aria-selected="true"
            data-category-filter="all"
            data-category-name="All Tools"
            data-category-count={PLATFORM_TOOL_TOTAL}
            class="cat-dropdown-item flex w-full items-center justify-between rounded-8 px-12 py-10 text-left text-[14px] font-medium transition-colors hover:bg-surface2 dark:hover:bg-surface2-dark bg-accent/10 text-accent dark:bg-accent-dark/20 dark:text-accent-dark"
          >
            <span>All Tools</span>
            <span class="rounded-full bg-surface px-6 py-2 text-[12px] dark:bg-surface-dark">{PLATFORM_TOOL_TOTAL}</span>
          </button>
          
          <div class="my-6 h-px w-full bg-border/50 dark:bg-border-dark/50"></div>

          {PLATFORM_CATEGORIES.map((cat) => {
            const count = PLATFORM_TOOLS.filter(t => t.category === cat).length;
            if (count === 0) return null;
            return (
              <button
                type="button"
                role="option"
                aria-selected="false"
                data-category-filter={cat}
                data-category-name={cat}
                data-category-count={count}
                class="cat-dropdown-item flex w-full items-center justify-between rounded-8 px-12 py-10 text-left text-[14px] font-medium text-ink2 transition-colors hover:bg-surface2 hover:text-ink dark:text-ink2-dark dark:hover:bg-surface2-dark dark:hover:text-ink-dark"
              >
                <span>{cat}</span>
                <span class="rounded-full bg-surface2 px-6 py-2 text-[12px] dark:bg-surface2-dark">{count}</span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- Taller & Centered Live Inline Search Input with Dropdown -->
      <div class="w-full flex-1">
        <InlineToolSearch />
      </div>

    </div>

    <!-- Tools Cards Grid -->
    <section class="mb-64" aria-labelledby="tools-directory-heading">
      <div class="mb-16 flex items-end justify-between gap-16 px-4">
        <div>
          <p class="text-meta font-mono font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">Tool directory</p>
          <h2 id="tools-directory-heading" class="mt-4 font-display text-h2 font-bold text-ink dark:text-ink-dark">Pick a utility and get started</h2>
        </div>
        <span class="hidden font-mono text-meta text-muted dark:text-muted-dark sm:block">{PLATFORM_TOOL_TOTAL} browser-based tools</span>
      </div>

      <div class="grid grid-cols-1 gap-16 md:grid-cols-2 xl:grid-cols-3" id="tools-directory-grid">
      {PLATFORM_TOOLS.map((tool) => (
        <a
          href={tool.href}
          data-tool-card
          data-category={tool.category}
          data-search-text={`${tool.name} ${tool.description} ${tool.category} ${tool.tags.join(' ')}`.toLowerCase()}
          class="tool-directory-card group relative flex min-h-[218px] flex-col overflow-hidden rounded-16 border border-border/90 p-20 no-underline transition-all duration-200 dark:border-border-dark/90"
        >
          <div class="relative z-10">
            <div class="flex items-start justify-between gap-12">
              <span class="tool-directory-icon inline-flex h-40 w-40 shrink-0 items-center justify-center rounded-10 border border-border bg-surface2 text-accent dark:border-border-dark dark:bg-surface2-dark dark:text-accent-dark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-20 w-20">
                  <path d="M8 9l-3 3 3 3"></path>
                  <path d="M16 9l3 3-3 3"></path>
                  <path d="M14 5l-4 14"></path>
                </svg>
              </span>
              <div class="flex items-center justify-end gap-6">
                <span class="rounded-6 bg-surface2/90 px-8 py-3 font-mono text-[12px] font-medium text-ink2 dark:bg-surface2-dark/90 dark:text-ink2-dark">
                {tool.category}
                </span>
                {tool.badge && (
                  <span class="rounded-pill bg-accent/10 px-8 py-3 font-mono text-[12px] font-semibold text-accent dark:bg-accent-dark/20 dark:text-accent-dark">
                    {tool.badge}
                  </span>
                )}
              </div>
            </div>

            <h3 class="mt-16 font-display text-[20px] font-bold leading-snug text-ink transition-colors duration-150 group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">
              {tool.name}
            </h3>
            
            <p class="tool-directory-description mt-8 text-body-small leading-relaxed text-ink2 dark:text-ink2-dark">
              {tool.description}
            </p>
          </div>

          <div class="relative z-10 mt-auto flex items-center justify-between border-t border-border/60 pt-14 text-caption dark:border-border-dark/60">
            <span class="inline-flex items-center gap-5 font-mono text-[12px] text-muted dark:text-muted-dark">
              <span class="h-6 w-6 rounded-full bg-emerald-500"></span>
              Runs locally
            </span>
            <span class="inline-flex items-center gap-4 font-semibold text-accent transition-transform duration-150 group-hover:translate-x-1 dark:text-accent-dark">
              Open <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
      </div>
    </section>

    <!-- Empty Filter Search State -->
    <div id="tools-no-match" class="hidden rounded-24 border border-dashed border-border p-48 text-center dark:border-border-dark glass-panel mb-64">
      <h3 class="font-display text-h3 font-semibold text-ink dark:text-ink-dark">No matching tools found</h3>
      <p class="mt-4 text-body-small text-ink2 dark:text-ink2-dark">Try searching for standard keywords like "16:9", "megapixels", "resize", or "PPI".</p>
    </div>

    <!-- Tool Guides & Articles Section (Preserving existing Content Collection Articles) -->
    {sortedArticles.length > 0 && (
      <section class="mt-64 glass-panel rounded-24 border border-border bg-surface/90 p-24 sm:p-40 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/90" data-reveal>
        <div class="mb-24 pb-16 border-b border-border/60 dark:border-border-dark/60">
          <p class="text-meta font-mono font-semibold text-accent dark:text-accent-dark uppercase tracking-wider mb-8">Engineering & Showcase Articles</p>
          <h2 class="font-display text-h2 font-bold text-ink dark:text-ink-dark">Tool Guides & In-Depth Technical Reviews</h2>
        </div>
        <FeedList posts={sortedArticles} />
      </section>
    )}
  </div>
  <ToolSearchModal />
</BaseLayout>

<style>
  .tool-directory-card {
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 24px rgba(20, 32, 46, 0.10);
  }

  .tool-directory-card::before {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0));
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }

  .tool-directory-card:hover {
    border-color: rgba(229, 126, 0, 0.65);
    box-shadow: 0 16px 34px rgba(20, 32, 46, 0.16);
    transform: translateY(-3px);
  }

  .tool-directory-card:hover::before { opacity: 1; }
  .tool-directory-card:hover .tool-directory-icon { border-color: rgba(229, 126, 0, 0.45); }

  .tool-directory-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  :global(.dark) .tool-directory-card {
    background: rgba(12, 16, 22, 0.94);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  :global(.dark) .tool-directory-card::before {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0));
  }

  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(161, 161, 170, 0.3);
    border-radius: 20px;
  }
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(161, 161, 170, 0.2);
  }
</style>

<!-- Client Filtering & Search JavaScript -->
<script is:inline>
  (function() {
    const dropdownItems = document.querySelectorAll('.cat-dropdown-item');
    const toolCards = document.querySelectorAll('[data-tool-card]');
    const noMatch = document.getElementById('tools-no-match');
    
    const triggerBtn = document.getElementById('category-dropdown-trigger');
    const dropdownMenu = document.getElementById('category-dropdown-menu');
    const dropdownIcon = document.getElementById('category-dropdown-icon');
    const dropdownLabel = document.getElementById('category-dropdown-label');

    let activeFilter = 'all';
    let dropdownOpen = false;

    if (triggerBtn && dropdownMenu) {
      triggerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownOpen = !dropdownOpen;
        dropdownMenu.classList.toggle('hidden', !dropdownOpen);
        triggerBtn.setAttribute('aria-expanded', dropdownOpen.toString());
        dropdownIcon.style.transform = dropdownOpen ? 'rotate(180deg)' : '';
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (dropdownOpen && !triggerBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
          dropdownOpen = false;
          dropdownMenu.classList.add('hidden');
          triggerBtn.setAttribute('aria-expanded', 'false');
          dropdownIcon.style.transform = '';
        }
      });
    }

    function filterDirectory() {
      let count = 0;
      toolCards.forEach(card => {
        const cat = card.getAttribute('data-category') || '';

        const matchesCat = (activeFilter === 'all' || cat === activeFilter);

        if (matchesCat) {
          card.style.display = '';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noMatch) {
        noMatch.classList.toggle('hidden', count > 0);
      }
    }

    dropdownItems.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset styles for all items
        dropdownItems.forEach(b => {
          b.setAttribute('aria-selected', 'false');
          b.className = 'cat-dropdown-item flex w-full items-center justify-between rounded-8 px-12 py-10 text-left text-[14px] font-medium text-ink2 transition-colors hover:bg-surface2 hover:text-ink dark:text-ink2-dark dark:hover:bg-surface2-dark dark:hover:text-ink-dark';
          const badge = b.querySelector('span:last-child');
          if(badge) badge.className = 'rounded-full bg-surface2 px-6 py-2 text-[12px] dark:bg-surface2-dark';
        });

        // Set active styles
        btn.setAttribute('aria-selected', 'true');
        btn.className = 'cat-dropdown-item flex w-full items-center justify-between rounded-8 px-12 py-10 text-left text-[14px] font-medium transition-colors hover:bg-surface2 dark:hover:bg-surface2-dark bg-accent/10 text-accent dark:bg-accent-dark/20 dark:text-accent-dark';
        const activeBadge = btn.querySelector('span:last-child');
        if(activeBadge) activeBadge.className = 'rounded-full bg-surface px-6 py-2 text-[12px] dark:bg-surface-dark';
        
        // Update trigger label
        const catName = btn.getAttribute('data-category-name');
        const catCount = btn.getAttribute('data-category-count');
        if (dropdownLabel) dropdownLabel.textContent = `Filter by Category: ${catName} (${catCount})`;

        // Close dropdown
        dropdownOpen = false;
        dropdownMenu.classList.add('hidden');
        if (triggerBtn) {
          triggerBtn.setAttribute('aria-expanded', 'false');
          dropdownIcon.style.transform = '';
        }

        // Filter cards
        activeFilter = btn.getAttribute('data-category-filter') || 'all';
        filterDirectory();
      });
    });
  })();
</script>
