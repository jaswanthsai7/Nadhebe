---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Cumulative Layout Shift (CLS) Audit & Fix Checklist | Nadhebe';
const h1 = 'Cumulative Layout Shift (CLS) Audit & Fix Checklist';
const description = 'Audit Web Vitals Cumulative Layout Shift (CLS) score, identify layout instability causes, and apply CSS width/height fixes for Google PageSpeed.';

const faq = [
  {
    question: 'What is Cumulative Layout Shift (CLS)?',
    answer: 'CLS is a Core Web Vitals metric measuring unexpected visual layout shifts that occur while a page loads (target score is 0.1 or lower).',
  },
  {
    question: 'What causes high CLS scores on web pages?',
    answer: 'Images without explicit `width` and `height` attributes, dynamically injected ads or banners, FOIT web fonts, and CSS animations mutating width/height.',
  },
  {
    question: 'How do explicit width and height attributes prevent CLS?',
    answer: 'Setting `width` and `height` attributes on HTML `<img>` elements allows modern browsers to calculate aspect ratio and reserve layout space before images load.',
  },
  {
    question: 'What is the CSS `font-display: swap` impact on CLS?',
    answer: 'Custom web fonts loaded dynamically cause text layout shifts when fallback system fonts swap to custom fonts. `font-display: optional` eliminates FOIT shifts.',
  },
  {
    question: 'Is my web audit data stored remotely?',
    answer: '100% private. All checklist selections and score calculations run locally in your browser.',
  },
];
---

<ToolLayout
  toolId="cls-checklist"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="cls-checklist-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="CLS OPTIMIZATION AUDIT CHECKLIST">
        <div class="space-y-12" id="cls-items-list">
          
          <label class="flex items-start gap-10 rounded-8 border border-border p-10 bg-surface2 dark:border-border-dark dark:bg-surface2-dark cursor-pointer">
            <input type="checkbox" data-weight="0.04" class="mt-2 rounded border-border focus:ring-accent cls-cb" checked />
            <div class="text-xs">
              <strong class="text-ink dark:text-ink-dark block">Set explicit width & height on all <code>&lt;img&gt;</code> tags</strong>
              <span class="text-muted dark:text-muted-dark">Prevents image layout collapse before asset download.</span>
            </div>
          </label>

          <label class="flex items-start gap-10 rounded-8 border border-border p-10 bg-surface2 dark:border-border-dark dark:bg-surface2-dark cursor-pointer">
            <input type="checkbox" data-weight="0.05" class="mt-2 rounded border-border focus:ring-accent cls-cb" checked />
            <div class="text-xs">
              <strong class="text-ink dark:text-ink-dark block">Reserve DOM container height for dynamic Ads & Banners</strong>
              <span class="text-muted dark:text-muted-dark">Use CSS <code>min-height</code> or <code>aspect-ratio</code> on ad slots.</span>
            </div>
          </label>

          <label class="flex items-start gap-10 rounded-8 border border-border p-10 bg-surface2 dark:border-border-dark dark:bg-surface2-dark cursor-pointer">
            <input type="checkbox" data-weight="0.03" class="mt-2 rounded border-border focus:ring-accent cls-cb" />
            <div class="text-xs">
              <strong class="text-ink dark:text-ink-dark block">Preload key custom web fonts & use <code>font-display: optional</code></strong>
              <span class="text-muted dark:text-muted-dark">Eliminates Flash of Unstyled Text (FOUT) font reflows.</span>
            </div>
          </label>

          <label class="flex items-start gap-10 rounded-8 border border-border p-10 bg-surface2 dark:border-border-dark dark:bg-surface2-dark cursor-pointer">
            <input type="checkbox" data-weight="0.03" class="mt-2 rounded border-border focus:ring-accent cls-cb" checked />
            <div class="text-xs">
              <strong class="text-ink dark:text-ink-dark block">Use CSS <code>transform</code> instead of top/left/height animations</strong>
              <span class="text-muted dark:text-muted-dark">GPU compositor animations do not trigger layout recalculation.</span>
            </div>
          </label>

        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="CLS HEALTH SCORE & AUDIT RATING">
        <div class="space-y-20">
          
          <div class="rounded-16 border border-emerald-500/30 bg-emerald-500/10 p-20 shadow-soft font-sans text-center">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Estimated CLS Score</span>
            <div id="stat-cls-score" class="text-h1 font-bold text-emerald-800 dark:text-emerald-300">0.03</div>
            <p id="stat-cls-rating" class="text-caption text-emerald-700 dark:text-emerald-400 mt-2 font-medium">Good (Passed Core Web Vitals) ✓</p>
          </div>

          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Google PageSpeed Target:</span>
              <span class="font-bold text-ink dark:text-ink-dark">&le; 0.10 CLS</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <span>Checklist Items Passed:</span>
              <span id="stat-cls-passed" class="font-bold text-emerald-600 dark:text-emerald-400">3 / 4 Rules</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Core Web Vitals Cumulative Layout Shift (CLS) Guide</h2>
    <p>
      Optimizing CLS ensures stable visual page rendering, preventing accidental user clicks on moving UI elements and boosting Google Search Page Experience rankings.
    </p>

    <h3>Recommended CSS Rules</h3>
    <pre class="rounded-12 border border-border bg-code p-16 font-mono text-xs text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400">img &#123;
  aspect-ratio: attr(width) / attr(height);
  height: auto;
  max-width: 100%;
&#125;</pre>

    <h3>Related SEO & Performance Tools</h3>
    <p>
      Audit SERP snippets with the <a href="/tools/serp-preview/">SERP Preview Simulator</a>, analyze metadata with the <a href="/tools/meta-tag-analyzer/">Meta Tag Analyzer</a>, or test canonical URLs with the <a href="/tools/canonical-checker/">Canonical Link Auditor</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const list = document.getElementById('cls-items-list');
    const statScore = document.getElementById('stat-cls-score');
    const statRating = document.getElementById('stat-cls-rating');
    const statPassed = document.getElementById('stat-cls-passed');

    function calculate() {
      const checkboxes = list?.querySelectorAll('.cls-cb');
      if (!checkboxes) return;

      let totalPenalty = 0.15; // baseline unoptimized penalty
      let passed = 0;

      checkboxes.forEach(cb => {
        const weight = parseFloat(cb.getAttribute('data-weight') || '0.03');
        if (cb.checked) {
          totalPenalty -= weight;
          passed++;
        }
      });

      const score = Math.max(0.01, totalPenalty).toFixed(2);

      if (statScore) statScore.textContent = score;
      if (statPassed) statPassed.textContent = `${passed} / ${checkboxes.length} Rules`;

      if (statRating) {
        if (score <= 0.10) {
          statRating.textContent = 'Good (Passed Core Web Vitals) ✓';
          statRating.className = 'text-caption text-emerald-700 dark:text-emerald-400 mt-2 font-medium';
        } else if (score <= 0.25) {
          statRating.textContent = 'Needs Improvement';
          statRating.className = 'text-caption text-amber-700 dark:text-amber-400 mt-2 font-medium';
        } else {
          statRating.textContent = 'Poor Layout Instability ✗';
          statRating.className = 'text-caption text-rose-700 dark:text-rose-400 mt-2 font-medium';
        }
      }
    }

    list?.addEventListener('change', calculate);
    calculate();
  })();
</script>
