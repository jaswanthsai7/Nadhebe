---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Multi-File CSV Table Merger & Combiner | Nadhebe';
const h1 = 'Multi-File CSV Table Merger';
const description = 'Merge multiple CSV text blocks into a single consolidated table with automatic header deduplication and column alignment.';

const faq = [
  {
    question: 'How are headers handled when merging multiple CSVs?',
    answer: 'By default, the merger keeps the header row from the first CSV block and strips subsequent duplicate headers from other blocks.'
  },
  {
    question: 'How many CSV blocks can I combine?',
    answer: 'You can combine as many CSV text blocks as your browser memory permits.'
  },
  {
    question: 'Is my data secure?',
    answer: 'Yes. All file merging runs locally inside your browser.'
  }
];
---

<ToolLayout
  toolId="csv-merger"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start" id="csv-merger-app">
    <!-- Left Column: Input & Controls -->
    <div class="space-y-24">
      <CalculatorCard title="CSV DATASET BLOCKS TO MERGE">
      <div class="space-y-16 font-mono text-xs">
        <div class="flex items-center justify-between">
          <span class="text-muted uppercase font-bold">CSV Text Blocks</span>
          <div class="flex items-center gap-8">
            <button type="button" id="cm-btn-sample" class="rounded-8 border border-border bg-surface2 px-10 py-4 font-bold text-accent hover:border-accent dark:border-border-dark dark:bg-surface2-dark transition-all">
              Load Sample CSV Blocks
            </button>
            <button type="button" id="cm-btn-add-block" class="rounded-8 bg-accent px-12 py-4 font-bold text-white shadow-soft hover:opacity-90 transition-all">
              + Add Another CSV Block
            </button>
          </div>
        </div>

        <!-- Dynamic CSV Input Blocks Container -->
        <div id="cm-blocks-container" class="space-y-12">
          <!-- Dynamically populated textareas -->
        </div>
      </div>
    </CalculatorCard>
    </div>

    <!-- Right Column: Results & Metrics -->
    <div class="space-y-24">
      <CalculatorCard title="MERGE OPTIONS">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-16 font-mono text-xs">
        <div class="space-y-6">
          <label class="block font-bold uppercase text-muted dark:text-muted-dark">Header Deduplication</label>
          <select id="cm-header-option" class="w-full rounded-8 border border-border bg-surface px-12 py-8 font-bold text-accent dark:border-border-dark dark:bg-surface-dark">
            <option value="keep_first">Keep Header from Block 1 Only</option>
            <option value="keep_all">Keep All Headers (No Stripping)</option>
          </select>
        </div>

        <div class="space-y-6">
          <label class="block font-bold uppercase text-muted dark:text-muted-dark">Blank Line Stripping</label>
          <select id="cm-blank-option" class="w-full rounded-8 border border-border bg-surface px-12 py-8 font-bold text-ink dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark">
            <option value="strip">Strip Empty Rows</option>
            <option value="keep">Keep Empty Rows</option>
          </select>
        </div>
      </div>
    </CalculatorCard>

    <ResultCard title="CONSOLIDATED MERGED CSV OUTPUT">
      <div class="space-y-16">
        <div class="flex items-center justify-between">
          <span id="cm-output-stats" class="font-mono text-xs font-bold text-muted dark:text-muted-dark">0 total rows merged</span>
          <div class="flex items-center gap-8">
            <button type="button" id="cm-btn-copy" class="rounded-8 border border-border bg-surface px-12 py-4 text-xs font-mono font-bold text-ink hover:border-accent dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark transition-all">
              Copy
            </button>
            <button type="button" id="cm-btn-download" class="rounded-8 border border-border bg-accent px-12 py-6 text-xs font-mono font-bold text-white shadow-soft hover:opacity-90 transition-all">
              Download Merged CSV
            </button>
          </div>
        </div>

        <pre id="cm-output-pre" class="w-full min-h-[160px] max-h-[350px] overflow-auto rounded-12 border border-border bg-surface p-12 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-surface-dark dark:text-emerald-400 whitespace-pre-wrap">Merged CSV output will appear here...</pre>
      </div>
    </ResultCard>
    </div>
  </div>

  <div slot="content">
    <h2>Combine Fragmented Export Files</h2>
    <p>
      Monthly financial statements, multi-region sales reports, or web scraper batches are frequently broken into dozens of separate CSV files. Merging CSV blocks into a single master file with header deduplication prepares datasets for SQL import.
    </p>
  </div>
</ToolLayout>

<script>
  function initCsvMerger() {
    const blocksContainer = document.getElementById('cm-blocks-container');
    const headerOption = document.getElementById('cm-header-option') as HTMLSelectElement;
    const blankOption = document.getElementById('cm-blank-option') as HTMLSelectElement;

    const outputPre = document.getElementById('cm-output-pre');
    const outputStats = document.getElementById('cm-output-stats');

    const btnSample = document.getElementById('cm-btn-sample');
    const btnAddBlock = document.getElementById('cm-btn-add-block');
    const btnCopy = document.getElementById('cm-btn-copy');
    const btnDownload = document.getElementById('cm-btn-download');

    let csvBlocks: string[] = [
      `id,name,email,region\n101,Alice Chen,alice@example.com,US-East\n102,Bob Smith,bob@example.com,US-West`,
      `id,name,email,region\n103,Carol Danvers,carol@example.com,EU-Central\n104,David Lee,david@example.com,APAC`
    ];

    function renderBlocks() {
      if (!blocksContainer) return;

      let html = '';
      csvBlocks.forEach((block, idx) => {
        html += `
          <div class="space-y-6 p-10 rounded-8 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark">
            <div class="flex items-center justify-between font-mono text-xs">
              <span class="font-bold text-accent dark:text-accent-dark">CSV Block ${idx + 1}</span>
              ${csvBlocks.length > 2 ? `<button type="button" class="cm-btn-del-block text-muted hover:text-danger font-bold text-xs" data-idx="${idx}">Remove Block</button>` : ''}
            </div>
            <textarea
              class="cm-block-input w-full rounded-6 border border-border bg-surface2 p-8 font-mono text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark focus:outline-none"
              rows="3"
              data-idx="${idx}"
              placeholder="Paste CSV block ${idx + 1}..."
            >${block}</textarea>
          </div>
        `;
      });

      blocksContainer.innerHTML = html;
      attachBlockListeners();
      mergeCsvs();
    }

    function attachBlockListeners() {
      const inputs = blocksContainer?.querySelectorAll('.cm-block-input') as NodeListOf<HTMLTextAreaElement>;
      inputs?.forEach(inp => {
        inp.addEventListener('input', (e) => {
          const target = e.target as HTMLTextAreaElement;
          const idx = Number(target.getAttribute('data-idx'));
          csvBlocks[idx] = target.value;
          mergeCsvs();
        });
      });

      const delBtns = blocksContainer?.querySelectorAll('.cm-btn-del-block') as NodeListOf<HTMLButtonElement>;
      delBtns?.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const idx = Number(target.getAttribute('data-idx'));
          csvBlocks.splice(idx, 1);
          renderBlocks();
        });
      });
    }

    function mergeCsvs() {
      if (!outputPre || !outputStats) return;

      const stripBlank = blankOption?.value === 'strip';
      const keepFirstHeader = headerOption?.value === 'keep_first';

      let combinedLines: string[] = [];

      csvBlocks.forEach((block, bIdx) => {
        let lines = block.split(/\r?\n/);
        if (stripBlank) {
          lines = lines.filter(l => l.trim().length > 0);
        }

        if (lines.length === 0) return;

        if (bIdx > 0 && keepFirstHeader) {
          // Strip line 1 header from block 2 onwards if matching
          lines = lines.slice(1);
        }

        combinedLines.push(...lines);
      });

      const resultText = combinedLines.join('\n');
      outputPre.textContent = resultText;
      outputStats.textContent = `${combinedLines.length} total rows merged from ${csvBlocks.length} blocks`;
    }

    if (headerOption) headerOption.addEventListener('change', mergeCsvs);
    if (blankOption) blankOption.addEventListener('change', mergeCsvs);

    btnAddBlock?.addEventListener('click', () => {
      csvBlocks.push('');
      renderBlocks();
    });

    btnSample?.addEventListener('click', () => {
      csvBlocks = [
        `id,name,email,region\n101,Alice Chen,alice@example.com,US-East\n102,Bob Smith,bob@example.com,US-West`,
        `id,name,email,region\n103,Carol Danvers,carol@example.com,EU-Central\n104,David Lee,david@example.com,APAC`
      ];
      renderBlocks();
    });

    btnCopy?.addEventListener('click', () => {
      if (outputPre) {
        navigator.clipboard.writeText(outputPre.textContent || '');
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy'), 1500);
      }
    });

    btnDownload?.addEventListener('click', () => {
      if (!outputPre?.textContent) return;
      const blob = new Blob([outputPre.textContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'merged_dataset.csv';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial render
    renderBlocks();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCsvMerger);
  } else {
    initCsvMerger();
  }
</script>
