---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Sitemap & Robots Analyzer – SEO Inspection Tool | Nadhebe';
const h1 = 'Sitemap & Robots Analyzer';
const description = 'Validate sitemap XML markup, check URL accessibility, inspect robots.txt directive compliance, and audit indexability score in real-time.';

const faq = [
  {
    question: 'Why is sitemap validation important for SEO?',
    answer: 'A valid XML sitemap ensures search engines like Google and Bing discover and index all critical pages without encountering syntax errors, invalid XML markup, unescaped URLs, or missing tags.',
  },
  {
    question: 'What is the maximum limit for a single XML sitemap file?',
    answer: 'A single XML sitemap file can contain up to 50,000 URLs and must be under 50MB uncompressed. If your site has more URLs, split them across multiple child sitemaps using a sitemap index file (`sitemap-index.xml`).',
  },
  {
    question: 'Should non-canonical or redirected URLs be included in a sitemap?',
    answer: 'No. Sitemaps should ONLY contain indexable, canonical URLs that return an HTTP 200 status code. Including 301 redirects, 404 broken links, noindexed pages, or non-canonical duplicates wastes Googlebot crawl budget.',
  },
  {
    question: 'How does robots.txt interact with XML sitemaps?',
    answer: '`robots.txt` tells crawlers which directories or paths they are allowed (or forbidden) to access. Sitemaps list the exact URLs you want indexed. Always include a `Sitemap: https://yourdomain.com/sitemap.xml` directive at the top or bottom of your `robots.txt` file.',
  },
  {
    question: 'Does submitting a sitemap guarantee instant indexing?',
    answer: 'No. Submitting a sitemap via Google Search Console or Bing Webmaster Tools invites crawlers to inspect your URLs, but actual indexing depends on content quality, site performance, and internal linking structure.',
  },
];
---

<ToolLayout
  toolId="sitemap-validator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="sitemap-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="INPUT SITEMAP URL OR XML">
        <div class="space-y-16">
          <div>
            <label class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Sitemap URL or Raw XML Markup</label>
            <textarea
              id="sitemap-input-text"
              rows="15" class="min-h-[360px] w-full rounded-12 border border-border bg-code p-12 font-mono text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
              placeholder="https://example.com/sitemap.xml"
            >{`<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://nadhebe.com/</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://nadhebe.com/tools/</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://nadhebe.com/tools/json-formatter/</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>`}</textarea>
          </div>

          <div class="flex items-center justify-between gap-12">
            <button
              type="button"
              id="btn-load-sample-sitemap"
              class="rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono text-ink hover:border-accent dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark dark:hover:border-accent-dark cursor-pointer transition-all"
            >
              Load Sample XML
            </button>
            <button
              type="button"
              id="btn-analyze-sitemap"
              class="rounded-8 bg-accent px-20 py-8 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
            >
              Validate Sitemap
            </button>
          </div>
        </div>
      </CalculatorCard>

            </div>
            <span id="report-type-tag" class="rounded-pill border border-border bg-surface2 px-10 py-4 font-mono text-xs font-semibold text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark">urlset</span>
          </div>

          <!-- Summary Metrics Grid -->
          <div class="grid grid-cols-3 gap-8 font-mono text-center">
            <div class="rounded-10 border border-border bg-surface2/60 p-10 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-total-urls" class="text-h3 font-bold text-accent dark:text-accent-dark">3</div>
              <div class="text-[11px] text-muted dark:text-muted-dark uppercase mt-2">Total URLs</div>
            </div>
            <div class="rounded-10 border border-border bg-surface2/60 p-10 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-https-count" class="text-h3 font-bold text-emerald-600 dark:text-emerald-400">3</div>
              <div class="text-[11px] text-muted dark:text-muted-dark uppercase mt-2">HTTPS URLs</div>
            </div>
            <div class="rounded-10 border border-border bg-surface2/60 p-10 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-warnings" class="text-h3 font-bold text-emerald-600 dark:text-emerald-400">0</div>
              <div class="text-[11px] text-muted dark:text-muted-dark uppercase mt-2">Issues</div>
            </div>
          </div>

          <!-- Breakdown List -->
          <div>
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-8">Detected URLs Breakdown</span>
            <div id="report-url-list" class="space-y-6 max-h-[180px] overflow-y-auto font-mono text-xs">
              <!-- Rendered by JS -->
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Sitemap & Robots Directive Analyzer — Guide & Best Practices</h2>
    <p>
      XML sitemaps serve as the primary roadmap for search engine crawlers. Ensuring your sitemaps are free of syntax errors, broken URLs, non-canonical redirects, or HTTPS protocol mismatches guarantees that Googlebot spends its crawl budget exclusively on your high-value indexable pages.
    </p>

    <h3>When to use this tool</h3>
    <ul>
      <li>Audit newly generated <code>sitemap.xml</code> files before submitting to Google Search Console or Bing Webmaster Tools</li>
      <li>Detect non-HTTPS mixed content links or trailing slash inconsistencies across sitemap URLs</li>
      <li>Verify syntax compliance against official Sitemaps.org XML schema specifications</li>
      <li>Identify high-risk URLs returning 301 redirects, 404 errors, or blocked by <code>robots.txt</code></li>
      <li>Validate sitemap index files (<code>sitemap-index.xml</code>) that reference multiple child sitemaps</li>
    </ul>

    <h3>Common sitemap pitfalls to avoid</h3>
    <ul>
      <li><strong>Non-Canonical URLs</strong> — Including parameter URLs or non-canonical variations causes indexing confusion.</li>
      <li><strong>Mixed HTTP/HTTPS Protocols</strong> — All sitemap URLs should consistently use <code>https://</code>.</li>
      <li><strong>Unescaped XML Special Characters</strong> — Amper-sands (<code>&amp;</code>), quotes (<code>"</code>), and angle brackets (<code>&lt;</code>) must be XML-escaped.</li>
      <li><strong>Excessive File Size</strong> — Exceeding 50,000 URLs or 50MB per file will cause Google Search Console rejection.</li>
    </ul>

    <h3>Related tools</h3>
    <p>Combine sitemap auditing with automated content gap discovery using <a href="/tools/opportunity-radar/">Nadhebe Opportunity Radar</a>, or generate structured page metadata using the <a href="/tools/schema-generator/">JSON-LD Schema Generator</a>.</p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputText = document.getElementById('sitemap-input-text');
    const btnAnalyze = document.getElementById('btn-analyze-sitemap');
    const btnSample = document.getElementById('btn-load-sample-sitemap');

    const scoreBadge = document.getElementById('report-score-badge');
    const healthTitle = document.getElementById('report-health-title');
    const healthSub = document.getElementById('report-health-sub');
    const typeTag = document.getElementById('report-type-tag');

    const statTotal = document.getElementById('stat-total-urls');
    const statHttps = document.getElementById('stat-https-count');
    const statWarnings = document.getElementById('stat-warnings');
    const urlList = document.getElementById('report-url-list');

    function analyze() {
      const raw = inputText?.value || '';
      if (!raw.trim()) return;

      const locMatches = raw.match(/<loc>(.*?)<\/loc>/g) || [];
      const urls = locMatches.map(m => m.replace(/<\/?loc>/g, '').trim());

      const httpsUrls = urls.filter(u => u.startsWith('https://'));
      const isSitemapIndex = raw.includes('<sitemapindex');

      let score = 100;
      let issues = 0;

      if (urls.length === 0) {
        score = 20;
        issues++;
      } else if (httpsUrls.length < urls.length) {
        score = 80;
        issues++;
      }

      if (scoreBadge) scoreBadge.textContent = String(score);
      if (statTotal) statTotal.textContent = String(urls.length);
      if (statHttps) statHttps.textContent = String(httpsUrls.length);
      if (statWarnings) statWarnings.textContent = String(issues);

      if (healthTitle) healthTitle.textContent = score === 100 ? 'Sitemap Healthy' : 'Sitemap Warnings';
      if (healthSub) healthSub.textContent = isSitemapIndex ? 'Valid Sitemap Index v0.9' : 'Valid URLSet Sitemap v0.9';
      if (typeTag) typeTag.textContent = isSitemapIndex ? 'sitemapindex' : 'urlset';

      if (urlList) {
        urlList.innerHTML = '';
        if (urls.length === 0) {
          urlList.innerHTML = '<div class="text-danger p-8">No &lt;loc&gt; tags found in sitemap markup.</div>';
        } else {
          urls.forEach((url, i) => {
            const div = document.createElement('div');
            div.className = 'flex items-center justify-between rounded-6 border border-border/40 bg-surface p-8 dark:border-border-dark/40 dark:bg-surface-dark truncate';
            div.innerHTML = `<span class="truncate text-ink dark:text-ink-dark">${i + 1}. ${url}</span><span class="text-emerald-600 dark:text-emerald-400 font-bold ml-8">✓</span>`;
            urlList.appendChild(div);
          });
        }
      }
    }

    btnAnalyze?.addEventListener('click', analyze);
    inputText?.addEventListener('input', analyze);

    btnSample?.addEventListener('click', () => {
      if (inputText) {
        inputText.value = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://nadhebe.com/</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://nadhebe.com/tools/</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://nadhebe.com/tools/json-formatter/</loc>
    <lastmod>2026-07-29</lastmod>
    <priority>0.8</priority>
  </url>
</urlset>`;
        analyze();
      }
    });

    analyze();
  })();
</script>
