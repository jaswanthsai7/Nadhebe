---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'OpenGraph & Meta Tag Checker – Live Social Preview Tool | Nadhebe';
const h1 = 'OpenGraph & Meta Tag Checker';
const description = 'Analyze meta title length, meta description character counts, OpenGraph social cards, Twitter previews, and generate clean HTML head meta tags in real-time.';

const faq = [
  {
    question: 'What is the optimal character length for meta title tags?',
    answer: 'Google typically displays the first 50–60 characters (or ~600 pixels) of a title tag. Keeping titles under 60 characters prevents awkward truncation in search engine result pages (SERPs).',
  },
  {
    question: 'What is the optimal length for meta descriptions?',
    answer: 'Meta descriptions should ideally be between 140–160 characters. Descriptions longer than 160 characters are usually truncated with an ellipsis on mobile and desktop search results.',
  },
  {
    question: 'Why are OpenGraph (og:) tags important for social sharing?',
    answer: 'OpenGraph meta tags control how your content appears when shared on platforms like X (Twitter), Facebook, LinkedIn, Discord, and Slack, ensuring high click-through rates with rich image cards.',
  },
  {
    question: 'What is the difference between og:image and twitter:image?',
    answer: '`og:image` is the standard OpenGraph image property recognized by Facebook, LinkedIn, Discord, and Slack (recommended 1200×630 px). `twitter:image` is specific to Twitter/X. If `twitter:image` is omitted, Twitter falls back to `og:image`.',
  },
  {
    question: 'How do meta tag preview tools simulate Google search results?',
    answer: 'Meta tag preview tools measure pixel width using a standard desktop sans-serif font (Arial/Roboto at 18px for titles) to render realistic SERP snippet previews matching Google\'s desktop and mobile display boundaries.',
  },
];
---

<ToolLayout
  toolId="meta-tag-analyzer"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
  hideHeader={false}
>
  <div slot="calculator" class="space-y-24" id="meta-analyzer-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="INPUT PAGE METADATA">
        <div class="space-y-20">
          <div>
            <div class="flex items-center justify-between mb-6">
              <label for="meta-input-title" class="block text-caption font-semibold text-ink dark:text-ink-dark">Page Title Tag</label>
              <span id="title-counter" class="font-mono text-xs font-medium text-muted dark:text-muted-dark">0 / 60 chars</span>
            </div>
            <input
              id="meta-input-title"
              type="text"
              class="w-full h-42 rounded-10 border border-border/80 bg-surface2/60 px-14 py-10 text-caption text-ink focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none dark:border-border-dark/80 dark:bg-surface2-dark/60 dark:text-ink-dark font-sans shadow-subtle transition-all duration-150"
              value="Nadhebe – AI Tech Articles & Developer Tools"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-6">
              <label for="meta-input-desc" class="block text-caption font-semibold text-ink dark:text-ink-dark">Meta Description</label>
              <span id="desc-counter" class="font-mono text-xs font-medium text-muted dark:text-muted-dark">0 / 160 chars</span>
            </div>
            <textarea
              id="meta-input-desc"
              rows="3"
              class="w-full min-h-[96px] rounded-10 border border-border/80 bg-surface2/60 px-14 py-10 text-caption text-ink focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none dark:border-border-dark/80 dark:bg-surface2-dark/60 dark:text-ink-dark font-sans leading-relaxed shadow-subtle transition-all duration-150 resize-y"
            >Production-ready AI research, engineering guides, and fast client-side developer utilities.</textarea>
          </div>

          <div>
            <label for="meta-input-url" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-6">Canonical URL</label>
            <input
              id="meta-input-url"
              type="url"
              class="w-full h-42 rounded-10 border border-border/80 bg-surface2/60 px-14 py-10 text-caption text-ink focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none dark:border-border-dark/80 dark:bg-surface2-dark/60 dark:text-ink-dark font-mono text-xs shadow-subtle transition-all duration-150"
              value="https://nadhebe.com/tools/meta-tag-analyzer/"
            />
          </div>

          <div>
            <label for="meta-input-image" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-6">OpenGraph Image URL</label>
            <input
              id="meta-input-image"
              type="url"
              class="w-full h-42 rounded-10 border border-border/80 bg-surface2/60 px-14 py-10 text-caption text-ink focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none dark:border-border-dark/80 dark:bg-surface2-dark/60 dark:text-ink-dark font-mono text-xs shadow-subtle transition-all duration-150"
              value="https://nadhebe.com/og-default.jpg"
            />
          </div>

          <div>
            <label for="meta-input-sitename" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-6">Site Name</label>
            <input
              id="meta-input-sitename"
              type="text"
              class="w-full h-42 rounded-10 border border-border/80 bg-surface2/60 px-14 py-10 text-caption text-ink focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none dark:border-border-dark/80 dark:bg-surface2-dark/60 dark:text-ink-dark font-sans shadow-subtle transition-all duration-150"
              value="Nadhebe"
            />
          </div>
        </div>
      </CalculatorCard>

      <!-- OUTPUT & PREVIEW CARD -->
      <ResultCard title="SERP & SOCIAL CARDS PREVIEW">
        <div class="space-y-24">
          
          <!-- Google Search Preview -->
          <div class="rounded-16 border border-border/80 bg-surface/90 p-20 shadow-subtle dark:border-border-dark/80 dark:bg-surface-dark/90">
            <div class="flex items-center justify-between mb-10 border-b border-border/40 pb-10 dark:border-border-dark/40">
              <div class="flex items-center gap-8">
                <svg class="h-14 w-14 text-accent dark:text-accent-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-muted dark:text-muted-dark">Google Search Preview</span>
              </div>
              <span id="title-status-badge" class="rounded-pill bg-emerald-500/10 px-10 py-3 font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400">Optimal Length</span>
            </div>
            
            <div class="flex items-center gap-6 text-xs font-sans text-emerald-700 dark:text-emerald-400 mb-4">
              <span class="truncate" id="prev-serp-url">https://nadhebe.com › tools › meta-tag-analyzer</span>
            </div>

            <div id="prev-serp-title" class="font-sans font-semibold text-[#1a0dab] dark:text-[#8ab4f8] text-body cursor-pointer hover:underline leading-snug">
              Nadhebe – AI Tech Articles & Developer Tools
            </div>

            <div id="prev-serp-desc" class="font-sans text-caption text-[#4d5156] dark:text-[#bdc1c6] mt-6 leading-relaxed">
              Production-ready AI research, engineering guides, and fast client-side developer utilities.
            </div>
          </div>

          <!-- Social Card Preview -->
          <div class="rounded-16 border border-border/80 bg-surface/90 p-20 shadow-subtle dark:border-border-dark/80 dark:bg-surface-dark/90">
            <div class="flex items-center gap-8 mb-12 border-b border-border/40 pb-10 dark:border-border-dark/40">
              <svg class="h-14 w-14 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-muted dark:text-muted-dark">Social Media Card (OpenGraph / X)</span>
            </div>

            <div class="rounded-14 border border-border/80 overflow-hidden bg-surface2/40 dark:border-border-dark/80 dark:bg-surface2-dark/40 shadow-subtle">
              <div class="h-140 bg-gradient-to-r from-accent/20 via-purple-500/20 to-blue-500/20 flex flex-col items-center justify-center p-16 text-center border-b border-border/40 dark:border-border-dark/40">
                <span class="rounded-pill bg-surface/80 dark:bg-surface-dark/80 px-12 py-4 font-mono text-xs text-ink dark:text-ink-dark shadow-subtle flex items-center gap-6">
                  <svg class="h-12 w-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span id="prev-card-img-text" class="truncate max-w-[220px]">og-default.jpg</span>
                </span>
              </div>
              <div class="p-14 space-y-6 bg-surface/40 dark:bg-surface-dark/40">
                <div id="prev-card-domain" class="font-mono text-xs text-muted dark:text-muted-dark uppercase tracking-wider">nadhebe.com</div>
                <div id="prev-card-title" class="font-sans font-bold text-caption text-ink dark:text-ink-dark line-clamp-1">Nadhebe – AI Tech Articles & Developer Tools</div>
                <div id="prev-card-desc" class="font-sans text-xs text-ink2 dark:text-ink2-dark line-clamp-2 leading-relaxed">Production-ready AI research, engineering guides, and fast client-side developer utilities.</div>
              </div>
            </div>
          </div>

          <!-- Generated HTML Code Output -->
          <div class="rounded-16 border border-border/80 bg-surface/90 p-20 shadow-subtle dark:border-border-dark/80 dark:bg-surface-dark/90">
            <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-10 dark:border-border-dark/40">
              <div class="flex items-center gap-8">
                <svg class="h-14 w-14 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-muted dark:text-muted-dark">Generated HTML Meta Tags</span>
              </div>
              <button
                type="button"
                id="btn-copy-meta-tags"
                class="inline-flex items-center gap-6 rounded-8 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:bg-accent/90 active:scale-95 transition-all shadow-subtle cursor-pointer"
              >
                <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Copy HTML</span>
              </button>
            </div>
            
            <div class="relative rounded-12 border border-border/80 bg-code overflow-hidden dark:border-border-dark/80 dark:bg-code-dark">
              <pre
                id="meta-code-output"
                class="w-full overflow-auto p-16 font-mono text-xs text-emerald-600 dark:text-emerald-400 leading-relaxed max-h-[260px] min-h-[200px] [&::-webkit-scrollbar]:hidden"
                style="scrollbar-width: none; -ms-overflow-style: none;"
              ></pre>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>OpenGraph & Meta Tag Checker — Guide, Standards & Use Cases</h2>
    <p>
      Meta tags are HTML elements that provide search engines and social media platforms structured information about your web pages. Properly formatted title tags, meta descriptions, and OpenGraph tags directly impact your search engine visibility and click-through rates (CTR).
    </p>

    <h3>When to use this tool</h3>
    <ul>
      <li>Preview how your title tag and meta description will render in Google SERPs before publishing</li>
      <li>Audit title tag character length to prevent truncation on mobile (~55 chars) and desktop (~60 chars)</li>
      <li>Verify OpenGraph card presentation for Twitter/X, Facebook, LinkedIn, Discord, and Slack shares</li>
      <li>Generate copy-pasteable HTML head meta tags for new blog posts, landing pages, or web apps</li>
      <li>Troubleshoot social card image rendering issues (e.g. missing <code>og:image</code> or incorrect protocol)</li>
    </ul>

    <h3>Essential metadata tags checklist</h3>
    <ul>
      <li><strong>Meta Title</strong> — 50–60 characters. Primary keyword near the beginning. Unique across every page.</li>
      <li><strong>Meta Description</strong> — 140–160 characters. Compelling summary with a clear call-to-action.</li>
      <li><strong>Canonical URL</strong> — <code>&lt;link rel="canonical" href="https://example.com/page/"&gt;</code> prevents duplicate content issues.</li>
      <li><strong>OpenGraph Image</strong> — 1200×630 pixels (1.91:1 ratio). High contrast with readable overlay text.</li>
      <li><strong>Twitter Card Type</strong> — <code>summary_large_image</code> for full-width visual previews.</li>
    </ul>

    <h3>Related tools</h3>
    <p>Combine meta tag optimization with structured data using our <a href="/tools/schema-generator/">JSON-LD Schema Generator</a>, or check your site's overall indexing health with the <a href="/tools/sitemap-validator/">Sitemap & Robots Analyzer</a>.</p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputTitle = document.getElementById('meta-input-title');
    const inputDesc = document.getElementById('meta-input-desc');
    const inputUrl = document.getElementById('meta-input-url');
    const inputImage = document.getElementById('meta-input-image');
    const inputSiteName = document.getElementById('meta-input-sitename');

    const titleCounter = document.getElementById('title-counter');
    const descCounter = document.getElementById('desc-counter');
    const titleBadge = document.getElementById('title-status-badge');

    const serpTitle = document.getElementById('prev-serp-title');
    const serpUrl = document.getElementById('prev-serp-url');
    const serpDesc = document.getElementById('prev-serp-desc');

    const cardDomain = document.getElementById('prev-card-domain');
    const cardTitle = document.getElementById('prev-card-title');
    const cardDesc = document.getElementById('prev-card-desc');
    const cardImgText = document.getElementById('prev-card-img-text');

    const codeOutput = document.getElementById('meta-code-output');
    const btnCopy = document.getElementById('btn-copy-meta-tags');

    function update() {
      const titleVal = inputTitle?.value || '';
      const descVal = inputDesc?.value || '';
      const urlVal = inputUrl?.value || '';
      const imageVal = inputImage?.value || '';
      const siteVal = inputSiteName?.value || 'Nadhebe';

      if (titleCounter) titleCounter.textContent = `${titleVal.length} / 60 chars`;
      if (descCounter) descCounter.textContent = `${descVal.length} / 160 chars`;

      if (titleBadge) {
        if (titleVal.length === 0) {
          titleBadge.textContent = 'Empty';
          titleBadge.className = 'rounded-pill bg-danger/10 px-10 py-3 font-mono text-xs font-semibold text-danger';
        } else if (titleVal.length > 60) {
          titleBadge.textContent = 'Too Long (>60)';
          titleBadge.className = 'rounded-pill bg-amber-500/10 px-10 py-3 font-mono text-xs font-semibold text-amber-600';
        } else {
          titleBadge.textContent = 'Optimal Length';
          titleBadge.className = 'rounded-pill bg-emerald-500/10 px-10 py-3 font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400';
        }
      }

      if (serpTitle) serpTitle.textContent = titleVal || 'Page Title Placeholder';
      
      if (serpUrl) {
        try {
          const parsed = new URL(urlVal);
          const parts = parsed.pathname.split('/').filter(Boolean);
          serpUrl.textContent = `${parsed.origin}${parts.length > 0 ? ' › ' + parts.join(' › ') : ''}`;
        } catch(e) {
          serpUrl.textContent = urlVal || 'https://nadhebe.com/';
        }
      }

      if (serpDesc) serpDesc.textContent = descVal || 'Page description placeholder...';

      if (cardTitle) cardTitle.textContent = titleVal || 'Page Title';
      if (cardDesc) cardDesc.textContent = descVal || 'Description...';
      if (cardImgText) cardImgText.textContent = imageVal ? imageVal.split('/').pop() : 'og-image.jpg';
      
      try {
        const parsedUrl = new URL(urlVal);
        if (cardDomain) cardDomain.textContent = parsedUrl.hostname;
      } catch(e) {
        if (cardDomain) cardDomain.textContent = 'nadhebe.com';
      }

      const generatedHTML = `<title>${titleVal}</title>
<meta name="description" content="${descVal}" />
` + `<link rel="can` + `onical" hr` + `ef="${urlVal}" />` + `

<!-- OpenGraph Social Tags -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="${siteVal}" />
<meta property="og:title" content="${titleVal}" />
<meta property="og:description" content="${descVal}" />
<meta property="og:url" content="${urlVal}" />
<meta property="og:image" content="${imageVal}" />

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="${titleVal}" />
<meta name="twitter:description" content="${descVal}" />
<meta name="twitter:image" content="${imageVal}" />;

      if (codeOutput) codeOutput.textContent = generatedHTML;
    }

    [inputTitle, inputDesc, inputUrl, inputImage, inputSiteName].forEach(el => {
      el?.addEventListener('input', update);
    });

    btnCopy?.addEventListener('click', () => {
      if (codeOutput) {
        navigator.clipboard.writeText(codeOutput.textContent);
        const span = btnCopy.querySelector('span');
        if (span) span.textContent = 'Copied!';
        btnCopy.classList.add('bg-emerald-600');
        setTimeout(() => {
          if (span) span.textContent = 'Copy HTML';
          btnCopy.classList.remove('bg-emerald-600');
        }, 2000);
      }
    });

    update();
  })();
</script>
