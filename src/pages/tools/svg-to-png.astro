---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'SVG to PNG Converter & Vector Exporter | Nadhebe';
const h1 = 'SVG to PNG Converter & Vector Exporter';
const description = 'Convert SVG vector graphics and code into high-resolution PNG image files client-side. Set custom width, height, and background transparency.';

const faq = [
  {
    question: 'How does the SVG to PNG converter work?',
    answer: 'The converter renders raw SVG code or uploaded `.svg` files onto an HTML5 Canvas element at custom dimensions (1x, 2x, 4x resolution) and exports a PNG image binary.',
  },
  {
    question: 'Can I convert SVG code directly into a PNG image without file upload?',
    answer: 'Yes! Paste your `<svg>...</svg>` markup directly into the editor or upload an `.svg` vector file.',
  },
  {
    question: 'Are my SVG graphics uploaded to external servers?',
    answer: '100% private. All vector rendering and canvas image exports run locally in your web browser.',
  },
  {
    question: 'Can I export PNG images with a transparent background?',
    answer: 'Yes! Toggle the background transparency switch to export PNG images with transparent or solid color backgrounds.',
  },
  {
    question: 'How do I scale up low-res SVG graphics for retina displays?',
    answer: 'Select 2x, 4x, or 8x scale multipliers to render crisp, high-DPI vector rasterizations for 4K displays and print.',
  },
];
---

<ToolLayout
  toolId="svg-to-png"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="s2p-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="SVG CODE OR FILE INPUT">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="s2p-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">SVG Markup / Vector Code</label>
              <button type="button" id="btn-load-sample-s2p" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample SVG</button>
            </div>
            <textarea
              id="s2p-input-raw"
              rows="10"
              placeholder="<svg ...>...</svg>"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <div class="grid grid-cols-2 gap-12">
            <div>
              <label for="s2p-select-scale" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Resolution Scale</label>
              <select
                id="s2p-select-scale"
                class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
              >
                <option value="1">1x Standard (Original Size)</option>
                <option value="2" selected>2x Retina (2x Resolution)</option>
                <option value="4">4x High-DPI (4x Resolution)</option>
              </select>
            </div>

            <div>
              <label for="s2p-select-bg" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Background</label>
              <select
                id="s2p-select-bg"
                class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
              >
                <option value="transparent" selected>Transparent Background</option>
                <option value="#ffffff">White Background (#FFFFFF)</option>
                <option value="#000000">Black Background (#000000)</option>
              </select>
            </div>
          </div>

          <button
            type="button"
            id="btn-render-s2p"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Render PNG Image
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="RASTERIZED PNG PREVIEW & DOWNLOAD">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span id="s2p-dimensions-label" class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">PNG Dimensions: 800 x 800 px</span>
            <button type="button" id="btn-download-s2p" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft">
              Download .PNG File
            </button>
          </div>

          <div class="w-full rounded-12 border border-border bg-surface2/60 p-20 dark:border-border-dark dark:bg-surface2-dark/60 min-h-[300px] flex items-center justify-center overflow-hidden">
            <canvas id="s2p-canvas" class="max-w-full max-h-[320px] rounded-8 shadow-soft border border-border/40 dark:border-border-dark/40 bg-white/10"></canvas>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>SVG Vector Rasterization & PNG Export Specification</h2>
    <p>
      SVG (Scalable Vector Graphics) provides resolution-independent graphics for web interfaces. Converting SVG code into high-DPI PNG raster images is essential for social media sharing, email marketing graphics, and app store icon assets.
    </p>

    <h3>Retina Scaling Comparison</h3>
    <ul>
      <li><strong>1x Standard</strong>: Native SVG viewport size.</li>
      <li><strong>2x Retina</strong>: Double pixel density for crisp rendering on Apple Retina screens.</li>
      <li><strong>4x Ultra-HD</strong>: High-resolution export for print and 4K displays.</li>
    </ul>

    <h3>Related Vector & Image Tools</h3>
    <p>
      Convert SVG to JSX with the <a href="/tools/svg-to-jsx/">SVG to JSX Converter</a>, convert WebP to PNG with the <a href="/tools/webp-to-png/">WebP to PNG Converter</a>, or calculate aspect ratios with the <a href="/tools/aspect-ratio-calculator/">Aspect Ratio Calculator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputRaw = document.getElementById('s2p-input-raw');
    const selectScale = document.getElementById('s2p-select-scale');
    const selectBg = document.getElementById('s2p-select-bg');
    const btnRender = document.getElementById('btn-render-s2p');
    const btnSample = document.getElementById('btn-load-sample-s2p');

    const canvas = document.getElementById('s2p-canvas');
    const labelDim = document.getElementById('s2p-dimensions-label');
    const btnDownload = document.getElementById('btn-download-s2p');

    const defaultSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <rect width="400" height="400" rx="40" fill="#6366f1" />
  <circle cx="200" cy="200" r="120" fill="#ffffff" opacity="0.2" />
  <path d="M140 260 L200 140 L260 260 Z" fill="#ffffff" />
  <text x="200" y="320" font-family="system-ui, sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle">Nadhebe AI</text>
</svg>`;

    function renderSVG() {
      const raw = inputRaw?.value || defaultSvg;
      const scale = parseFloat(selectScale?.value || '2');
      const bg = selectBg?.value || 'transparent';

      if (!canvas) return;

      const blob = new Blob([raw], { type: 'image/svg+xml;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const img = new Image();

      img.onload = function() {
        const w = (img.width || 400) * scale;
        const h = (img.height || 400) * scale;

        canvas.width = w;
        canvas.height = h;

        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, w, h);

        if (bg !== 'transparent') {
          ctx.fillStyle = bg;
          ctx.fillRect(0, 0, w, h);
        }

        ctx.drawImage(img, 0, 0, w, h);
        URL.revokeObjectURL(url);

        if (labelDim) labelDim.textContent = `PNG Dimensions: ${w} x ${h} px (${scale}x)`;
      };

      img.onerror = function() {
        URL.revokeObjectURL(url);
      };

      img.src = url;
    }

    btnRender?.addEventListener('click', renderSVG);
    [selectScale, selectBg, inputRaw].forEach(el => {
      el?.addEventListener('input', renderSVG);
      el?.addEventListener('change', renderSVG);
    });

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = defaultSvg;
      renderSVG();
    });

    btnDownload?.addEventListener('click', () => {
      if (!canvas) return;
      const a = document.createElement('a');
      a.download = 'nadhebe-vector.png';
      a.href = canvas.toDataURL('image/png');
      a.click();
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = defaultSvg;

    renderSVG();
  })();
</script>
