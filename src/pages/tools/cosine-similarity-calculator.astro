---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Vector Embedding Cosine Similarity Calculator | Nadhebe';
const h1 = 'Vector Embedding Cosine Similarity Calculator';
const description = 'Calculate cosine similarity, dot product, and Euclidean distance between 2 vector embeddings client-side. Test OpenAI text-embedding-3 and Voyage AI vectors.';

const faq = [
  {
    question: 'What is Cosine Similarity in AI & RAG systems?',
    answer: 'Cosine similarity measures the cosine of the angle between two multi-dimensional vector embeddings, producing a metric from -1.0 to +1.0 (where 1.0 indicates identical directional orientation).',
  },
  {
    question: 'What is the formula for Cosine Similarity?',
    answer: '`Cosine Similarity = (A · B) / (||A|| * ||B||)` where `A · B` is the dot product and `||A||` is the L2 norm (magnitude) of vector A.',
  },
  {
    question: 'Why is Cosine Similarity preferred over Euclidean distance for text embeddings?',
    answer: 'Cosine similarity measures angle rather than magnitude, making it invariant to text length differences when comparing document embeddings.',
  },
  {
    question: 'What is normalized vector dot product?',
    answer: 'If vector embeddings are normalized to unit length (`||A|| = 1`), cosine similarity equals the dot product (`A · B`), reducing vector database query compute latency.',
  },
  {
    question: 'Is my vector embedding data kept private?',
    answer: '100% private. All dot product and vector math operations run locally in JavaScript in your browser.',
  },
];
---

<ToolLayout
  toolId="cosine-similarity-calculator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="cosine-sim-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="VECTOR EMBEDDING ARRAYS">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="cos-input-v1" class="block text-caption font-semibold text-ink dark:text-ink-dark">Vector A (Comma or Space Separated Numbers)</label>
              <button type="button" id="btn-load-sample-cos" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample Vectors</button>
            </div>
            <textarea
              id="cos-input-v1"
              rows="5"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            >0.12, 0.45, 0.88, 0.34, 0.91, 0.15, 0.62</textarea>
          </div>

          <div>
            <label for="cos-input-v2" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Vector B (Comma or Space Separated Numbers)</label>
            <textarea
              id="cos-input-v2"
              rows="5"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            >0.15, 0.42, 0.85, 0.38, 0.89, 0.18, 0.59</textarea>
          </div>

          <button
            type="button"
            id="btn-calc-cos"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Calculate Similarity Metrics
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="SIMILARITY METRICS REPORT">
        <div class="space-y-20">
          
          <!-- Primary Score Gauge -->
          <div class="rounded-16 border border-emerald-500/30 bg-emerald-500/10 p-20 shadow-soft font-sans text-center">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Cosine Similarity Score</span>
            <div id="stat-cos-score" class="text-h1 font-bold text-emerald-800 dark:text-emerald-300">0.9984</div>
            <p id="stat-cos-label" class="text-caption text-emerald-700 dark:text-emerald-400 mt-2 font-medium">Near Identical Directional Orientation</p>
          </div>

          <!-- Secondary Metrics -->
          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Dot Product (A · B):</span>
              <span id="stat-cos-dot" class="font-bold text-ink dark:text-ink-dark">1.9421</span>
            </div>
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Euclidean Distance (L2):</span>
              <span id="stat-cos-euc" class="font-bold text-accent dark:text-accent-dark">0.0762</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <span>Vector Dimension Count:</span>
              <span id="stat-cos-dims" class="font-bold text-ink dark:text-ink-dark">7 Dimensions</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Vector Embedding Cosine Similarity Guide</h2>
    <p>
      In Retrieval-Augmented Generation (RAG) and semantic search architectures, vector databases (Pinecone, Qdrant, pgvector) use cosine similarity to rank document relevance against user query embeddings.
    </p>

    <h3>Mathematical Formulation</h3>
    <ul>
      <li><strong>Dot Product</strong>: Sum of element-wise products (A · B).</li>
      <li><strong>Cosine Similarity</strong>: Normalized dot product (A · B) / (||A|| * ||B||).</li>
      <li><strong>Metric Range</strong>: +1.0 (identical direction), 0.0 (orthogonal/unrelated), -1.0 (opposite direction).</li>
    </ul>

    <h3>Related AI Developer Tools</h3>
    <p>
      Audit vector retrieval with the <a href="/tools/rag-evaluator/">RAG Retrieval Evaluator</a>, calculate GPU memory needs with the <a href="/tools/gpu-vram-calculator/">GPU VRAM Calculator</a>, or estimate BPE tokens with the <a href="/tools/llm-tokenizer/">LLM BPE Tokenizer</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputV1 = document.getElementById('cos-input-v1');
    const inputV2 = document.getElementById('cos-input-v2');
    const btnCalc = document.getElementById('btn-calc-cos');
    const btnSample = document.getElementById('btn-load-sample-cos');

    const statScore = document.getElementById('stat-cos-score');
    const statLabel = document.getElementById('stat-cos-label');
    const statDot = document.getElementById('stat-cos-dot');
    const statEuc = document.getElementById('stat-cos-euc');
    const statDims = document.getElementById('stat-cos-dims');

    function parseVector(str) {
      return str.split(/[\s,]+/).map(v => parseFloat(v)).filter(v => !isNaN(v));
    }

    function calculate() {
      const v1 = parseVector(inputV1?.value || '');
      const v2 = parseVector(inputV2?.value || '');

      if (v1.length === 0 || v1.length !== v2.length) {
        if (statScore) statScore.textContent = 'Error';
        if (statLabel) statLabel.textContent = 'Vector dimensions must be equal non-empty arrays.';
        return;
      }

      let dot = 0;
      let magA = 0;
      let magB = 0;
      let sumSqDiff = 0;

      for (let i = 0; i < v1.length; i++) {
        dot += v1[i] * v2[i];
        magA += v1[i] * v1[i];
        magB += v2[i] * v2[i];
        sumSqDiff += (v1[i] - v2[i]) * (v1[i] - v2[i]);
      }

      const normA = Math.sqrt(magA);
      const normB = Math.sqrt(magB);
      const sim = (normA && normB) ? (dot / (normA * normB)) : 0;
      const euc = Math.sqrt(sumSqDiff);

      if (statScore) statScore.textContent = sim.toFixed(4);
      if (statDot) statDot.textContent = dot.toFixed(4);
      if (statEuc) statEuc.textContent = euc.toFixed(4);
      if (statDims) statDims.textContent = `${v1.length} Dimensions`;

      if (statLabel) {
        if (sim >= 0.95) statLabel.textContent = 'Near Identical Semantic Meaning ✓';
        else if (sim >= 0.70) statLabel.textContent = 'High Semantic Relevance';
        else if (sim >= 0.40) statLabel.textContent = 'Moderate Topical Overlap';
        else statLabel.textContent = 'Low Similarity / Unrelated';
      }
    }

    btnCalc?.addEventListener('click', calculate);
    [inputV1, inputV2].forEach(el => {
      el?.addEventListener('input', calculate);
    });

    btnSample?.addEventListener('click', () => {
      if (inputV1) inputV1.value = '0.12, 0.45, 0.88, 0.34, 0.91, 0.15, 0.62';
      if (inputV2) inputV2.value = '0.15, 0.42, 0.85, 0.38, 0.89, 0.18, 0.59';
      calculate();
    });

    calculate();
  })();
</script>
