---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'PNG to WebP Converter & Image Compressor | Nadhebe';
const h1 = 'PNG to WebP Converter & Image Compressor';
const description = 'Convert PNG images into lightweight WebP format client-side. Reduce image file size by up to 80% while preserving visual quality and transparency.';

const faq = [
  {
    question: 'How does the PNG to WebP converter work?',
    answer: 'The converter encodes uploaded `.png` images into web-optimized `.webp` files client-side using browser HTML5 canvas WebP image encoding options.',
  },
  {
    question: 'How much file size reduction can I expect?',
    answer: 'WebP format typically reduces PNG file sizes by 50% to 80% without noticeable loss of visual quality.',
  },
  {
    question: 'Are my PNG images uploaded to external servers?',
    answer: '100% private. All image compression and WebP file generation execute locally inside your web browser.',
  },
  {
    question: 'Is PNG transparency supported in WebP files?',
    answer: 'Yes! WebP fully supports alpha transparency channels from PNG source images.',
  },
  {
    question: 'Can I adjust the WebP image compression quality?',
    answer: 'Yes! Choose quality settings between 50% (maximum file savings) and 100% (lossless WebP encoding).',
  },
];
---

<ToolLayout
  toolId="png-to-webp"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="p2w-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="UPLOAD PNG IMAGE FILE">
        <div class="space-y-16">
          <!-- File Drag Drop Zone -->
          <div class="border-2 border-dashed border-border dark:border-border-dark rounded-12 p-24 text-center bg-surface2/40 dark:bg-surface2-dark/40 hover:border-accent transition-colors">
            <label for="p2w-file-input" class="cursor-pointer space-y-8 block">
              <svg class="w-36 h-36 mx-auto text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-caption font-semibold text-ink dark:text-ink-dark block">Click or Drag & Drop PNG File</span>
              <span class="text-xs text-muted dark:text-muted-dark block">Supports .png image format (Client-side)</span>
              <input id="p2w-file-input" type="file" accept="image/png" class="hidden" />
            </label>
          </div>

          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="p2w-quality" class="block text-caption font-semibold text-ink dark:text-ink-dark">WebP Quality Ratio</label>
              <span id="p2w-quality-val" class="font-mono text-xs font-bold text-accent dark:text-accent-dark">85%</span>
            </div>
            <input
              id="p2w-quality"
              type="range"
              min="10"
              max="100"
              value="85"
              class="w-full cursor-pointer accent-accent"
            />
          </div>

          <div class="flex items-center justify-between">
            <button type="button" id="btn-load-sample-p2w" class="rounded-8 bg-accent/15 text-accent dark:text-accent-dark px-16 py-8 text-xs font-semibold hover:bg-accent/25 cursor-pointer">
              Load Sample PNG Graphic
            </button>
            <span id="p2w-file-info" class="text-xs font-mono text-muted dark:text-muted-dark">No file selected</span>
          </div>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="COMPRESSED WEBP PREVIEW & DOWNLOAD">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span id="p2w-dim-info" class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">WebP File Ready</span>
            <button type="button" id="btn-dl-p2w" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft">
              Download .WebP File
            </button>
          </div>

          <div class="w-full rounded-12 border border-border bg-surface2/60 p-20 dark:border-border-dark dark:bg-surface2-dark/60 min-h-[280px] flex items-center justify-center overflow-hidden">
            <canvas id="p2w-canvas" class="max-w-full max-h-[300px] rounded-8 shadow-soft border border-border/40 dark:border-border-dark/40"></canvas>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>PNG to WebP Image Compression Specification</h2>
    <p>
      WebP is modern image format supported by Google Chrome, Apple Safari, and Mozilla Firefox. Converting heavy PNG graphics into WebP improves Core Web Vitals Largest Contentful Paint (LCP) scores and reduces hosting bandwidth costs.
    </p>

    <h3>Benefits of WebP Compression</h3>
    <ul>
      <li><strong>50-80% Smaller File Size</strong>: Reduces page load latency.</li>
      <li><strong>Alpha Transparency</strong>: Full PNG transparency support.</li>
    </ul>

    <h3>Related Image Tools</h3>
    <p>
      Convert WebP to PNG with the <a href="/tools/webp-to-png/">WebP to PNG Converter</a>, convert SVG to PNG with the <a href="/tools/svg-to-png/">SVG to PNG Converter</a>, or calculate aspect ratios with the <a href="/tools/aspect-ratio-calculator/">Aspect Ratio Calculator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const fileInput = document.getElementById('p2w-file-input');
    const qualityInput = document.getElementById('p2w-quality');
    const qualityVal = document.getElementById('p2w-quality-val');
    const btnSample = document.getElementById('btn-load-sample-p2w');
    const fileInfo = document.getElementById('p2w-file-info');

    const canvas = document.getElementById('p2w-canvas');
    const dimInfo = document.getElementById('p2w-dim-info');
    const btnDl = document.getElementById('btn-dl-p2w');

    let currentImg = null;

    function renderWebP() {
      if (!currentImg || !canvas) return;
      canvas.width = currentImg.width;
      canvas.height = currentImg.height;

      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, currentImg.width, currentImg.height);
      ctx.drawImage(currentImg, 0, 0);

      const q = parseInt(qualityInput?.value || '85', 10) / 100;
      if (qualityVal) qualityVal.textContent = `${Math.round(q * 100)}%`;

      if (dimInfo) dimInfo.textContent = `WebP: ${currentImg.width} x ${currentImg.height} px (${Math.round(q * 100)}% Quality)`;
    }

    fileInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (fileInfo) fileInfo.textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;

      const img = new Image();
      img.onload = function() {
        currentImg = img;
        renderWebP();
      };
      const reader = new FileReader();
      reader.onload = function(evt) {
        img.src = evt.target.result;
      };
      reader.readAsDataURL(file);
    });

    qualityInput?.addEventListener('input', renderWebP);

    btnSample?.addEventListener('click', () => {
      const sampleCanvas = document.createElement('canvas');
      sampleCanvas.width = 400;
      sampleCanvas.height = 300;
      const sCtx = sampleCanvas.getContext('2d');

      sCtx.fillStyle = '#6366f1';
      sCtx.fillRect(0, 0, 400, 300);
      sCtx.fillStyle = '#ffffff';
      sCtx.font = 'bold 24px sans-serif';
      sCtx.textAlign = 'center';
      sCtx.fillText('Nadhebe PNG Sample', 200, 150);

      const img = new Image();
      img.onload = function() {
        currentImg = img;
        renderWebP();
      };
      img.src = sampleCanvas.toDataURL('image/png');
      if (fileInfo) fileInfo.textContent = 'Sample PNG Image Loaded';
    });

    btnDl?.addEventListener('click', () => {
      if (!canvas) return;
      const q = parseInt(qualityInput?.value || '85', 10) / 100;
      const a = document.createElement('a');
      a.download = 'nadhebe-compressed.webp';
      a.href = canvas.toDataURL('image/webp', q);
      a.click();
    });

    btnSample?.click();
  })();
</script>
