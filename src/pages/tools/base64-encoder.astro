---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Base64 Text & File Data URL Encoder / Decoder | Nadhebe';
const h1 = 'Base64 Text & File Data URL Encoder / Decoder';
const description = 'Encode and decode text strings or binary files to Base64 and Data URL format client-side. Convert images and text payloads without server uploads.';

const faq = [
  {
    question: 'What is Base64 encoding?',
    answer: 'Base64 is a binary-to-text encoding scheme (RFC 4648) that represents binary data in an ASCII string format using a 64-character alphabet (A-Z, a-z, 0-9, +, /).',
  },
  {
    question: 'Why does Base64 encoding increase data payload size?',
    answer: 'Base64 converts every 3 bytes (24 bits) of raw data into 4 ASCII characters (32 bits), resulting in a ~33% overhead increase in total string size.',
  },
  {
    question: 'What is a Data URL scheme?',
    answer: 'A Data URL (`data:image/png;base64,...`) allows inline embedding of images or CSS fonts directly inside HTML and stylesheet documents without additional HTTP requests.',
  },
  {
    question: 'Is my text or file data secure during encoding?',
    answer: '100% secure. Base64 encoding and decoding execute locally in your browser via `btoa()` and `atob()` JavaScript APIs.',
  },
  {
    question: 'What is the difference between Base64 and Base64URL?',
    answer: 'Base64URL replaces `+` with `-` and `/` with `_`, stripping `=` padding characters to make the encoded string safe for URL query parameters and JWT tokens.',
  },
];
---

<ToolLayout
  toolId="base64-encoder"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="base64-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="TEXT STRING OR FILE PAYLOAD">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="b64-input-mode" class="block text-caption font-semibold text-ink dark:text-ink-dark">Operation Mode</label>
            </div>
            <select
              id="b64-input-mode"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
            >
              <option value="encode">Encode Plaintext → Base64</option>
              <option value="decode">Decode Base64 → Plaintext</option>
            </select>
          </div>

          <div>
            <label for="b64-input-text" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Input Text Payload</label>
            <textarea
              id="b64-input-text"
              rows="10"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
              placeholder="Type or paste text to encode/decode..."
            >Hello, Nadhebe Developer Tools!</textarea>
          </div>

          <button
            type="button"
            id="btn-process-b64"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Process Base64 Output
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="BASE64 PROCESSED OUTPUT">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Output Result</span>
            <button type="button" id="btn-copy-b64" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Result</button>
          </div>

          <pre id="b64-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[260px] leading-relaxed whitespace-pre-wrap break-all"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Base64 Encoding & Data URL Specification Guide</h2>
    <p>
      Base64 encoding is widely used across MIME email attachments, JWT signatures, inline CSS images, and API data payloads to transmit binary data over text-only protocols.
    </p>

    <h3>Common Base64 Standard RFC 4648 Alphabets</h3>
    <ul>
      <li><strong>Standard Base64</strong>: Uses <code>+</code>, <code>/</code>, and <code>=</code> padding.</li>
      <li><strong>Base64URL</strong>: Replaces <code>+</code> with <code>-</code> and <code>/</code> with <code>_</code> for web safety.</li>
    </ul>

    <h3>Related Developer Tools</h3>
    <p>
      Generate JWT tokens with the <a href="/tools/jwt-encoder/">JWT Encoder</a>, format JSON payloads with the <a href="/tools/json-formatter/">JSON Formatter</a>, or repair malformed JSON with the <a href="/tools/json-repair/">JSON Repair Tool</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const selectMode = document.getElementById('b64-input-mode');
    const inputText = document.getElementById('b64-input-text');
    const btnProcess = document.getElementById('btn-process-b64');

    const outputText = document.getElementById('b64-output-text');
    const btnCopy = document.getElementById('btn-copy-b64');

    function process() {
      const mode = selectMode?.value || 'encode';
      const text = inputText?.value || '';

      if (!outputText) return;

      try {
        if (mode === 'encode') {
          outputText.textContent = btoa(unescape(encodeURIComponent(text)));
        } else {
          outputText.textContent = decodeURIComponent(escape(atob(text.trim())));
        }
      } catch(e) {
        outputText.textContent = `Base64 Error: ${e.message}`;
      }
    }

    btnProcess?.addEventListener('click', process);
    [selectMode, inputText].forEach(el => {
      el?.addEventListener('input', process);
      el?.addEventListener('change', process);
    });

    btnCopy?.addEventListener('click', () => {
      if (outputText) {
        navigator.clipboard.writeText(outputText.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy Result'), 2000);
      }
    });

    process();
  })();
</script>
