---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'LLM GPU VRAM Memory Requirement Calculator | Nadhebe';
const h1 = 'LLM GPU VRAM Memory Requirement Calculator';
const description = 'Calculate GPU VRAM memory requirements for running LLMs (Llama 3, DeepSeek, Mistral) locally or in cloud deployments (NVIDIA H100, A100, RTX 4090).';

const faq = [
  {
    question: 'How is LLM GPU VRAM memory calculated?',
    answer: 'Base VRAM requirement = `(Model Parameters in Billions * Precision Bytes per Weight) + KV Cache Overhead + Activation Buffer`.',
  },
  {
    question: 'What are the VRAM bytes per parameter for different quantization levels?',
    answer: 'FP16 = 2 bytes/param, INT8 (Q8) = 1 byte/param, INT4 (Q4_K_M) = 0.5 bytes/param, FP32 = 4 bytes/param.',
  },
  {
    question: 'How much KV Cache VRAM is required for context windows?',
    answer: 'KV cache overhead scales linearly with sequence context length (e.g. 128k context adds ~4GB to 8GB of VRAM depending on model hidden dimensions and layer counts).',
  },
  {
    question: 'Can I run Llama 3 70B on a single RTX 4090 (24GB VRAM)?',
    answer: 'No. Llama 3 70B quantized to Q4 requires ~40GB VRAM. You need 2x RTX 4090 (48GB combined) or an NVIDIA A6000/A100 (80GB).',
  },
  {
    question: 'Why is an additional 20% VRAM buffer overhead recommended?',
    answer: 'CUDA runtime initialization, KV cache growth, and batching activations require safety margins to prevent CUDA Out of Memory (OOM) crashes.',
  },
];
---

<ToolLayout
  toolId="gpu-vram-calculator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="vram-calculator-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="LLM PARAMETERS & QUANTIZATION">
        <div class="space-y-16">
          <div>
            <label for="vram-input-params" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Model Size (Billions of Parameters)</label>
            <input
              id="vram-input-params"
              type="number"
              min="1"
              max="405"
              step="1"
              value="70"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div>
            <label for="vram-select-quant" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Quantization / Precision Format</label>
            <select
              id="vram-select-quant"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
            >
              <option value="0.5">INT4 / Q4_K_M (0.5 Bytes / parameter)</option>
              <option value="1.0">INT8 / Q8_0 (1.0 Byte / parameter)</option>
              <option value="2.0" selected>FP16 / BF16 (2.0 Bytes / parameter)</option>
              <option value="4.0">FP32 Full (4.0 Bytes / parameter)</option>
            </select>
          </div>

          <div>
            <label for="vram-input-ctx" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Max Context Window (Tokens)</label>
            <input
              id="vram-input-ctx"
              type="number"
              min="2048"
              max="131072"
              step="4096"
              value="32768"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <button
            type="button"
            id="btn-calc-vram"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Calculate GPU VRAM Requirement
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="ESTIMATED VRAM & HARDWARE RECOMMENDATION">
        <div class="space-y-20">
          
          <!-- Summary Metrics Grid -->
          <div class="grid grid-cols-2 gap-12 font-mono text-center">
            <div class="rounded-12 border border-emerald-500/30 bg-emerald-500/10 p-16">
              <div id="stat-vram-total" class="text-h2 font-bold text-emerald-800 dark:text-emerald-300">172.8 GB</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Total VRAM Required</div>
            </div>
            <div class="rounded-12 border border-border bg-surface2/60 p-16 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-vram-weights" class="text-h2 font-bold text-accent dark:text-accent-dark">140.0 GB</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Base Model Weights</div>
            </div>
          </div>

          <!-- Hardware Recommendation Banner -->
          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-8 font-mono text-xs">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Recommended GPU Setup</span>
            
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>NVIDIA Enterprise Setup:</span>
              <span id="stat-vram-gpu-enterprise" class="font-bold text-emerald-600 dark:text-emerald-400">2x NVIDIA A100 80GB</span>
            </div>

            <div class="flex items-center justify-between py-4">
              <span>Consumer GPU Setup:</span>
              <span id="stat-vram-gpu-consumer" class="font-bold text-accent dark:text-accent-dark">8x RTX 4090 24GB</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>LLM GPU VRAM Memory Estimation Guide</h2>
    <p>
      Planning GPU hardware infrastructure for local or cloud LLM deployment (vLLM, Ollama, TGI) requires calculating model weights, KV cache context buffers, and CUDA memory overhead.
    </p>

    <h3>GPU VRAM Memory Formula</h3>
    <pre class="rounded-12 border border-border bg-code p-16 font-mono text-xs text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400">VRAM (GB) = (Parameters_Billions * Bytes_per_Param) * 1.20 + (Context_Tokens * 0.001)</pre>

    <h3>Related AI Infrastructure Tools</h3>
    <p>
      Calculate API pricing with the <a href="/tools/ai-api-pricing-calculator/">AI API Pricing Calculator</a>, estimate BPE tokens with the <a href="/tools/llm-tokenizer/">LLM BPE Tokenizer</a>, or audit RAG retrieval with the <a href="/tools/rag-evaluator/">RAG Retrieval Evaluator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputParams = document.getElementById('vram-input-params');
    const selectQuant = document.getElementById('vram-select-quant');
    const inputCtx = document.getElementById('vram-input-ctx');
    const btnCalc = document.getElementById('btn-calc-vram');

    const statTotal = document.getElementById('stat-vram-total');
    const statWeights = document.getElementById('stat-vram-weights');
    const statGpuEnt = document.getElementById('stat-vram-gpu-enterprise');
    const statGpuCons = document.getElementById('stat-vram-gpu-consumer');

    function calculate() {
      const paramsB = parseFloat(inputParams?.value || '70');
      const bytesPerParam = parseFloat(selectQuant?.value || '2.0');
      const ctxTokens = parseInt(inputCtx?.value || '32768', 10);

      const baseWeightsGB = paramsB * bytesPerParam;
      const kvCacheGB = (ctxTokens / 1024) * (paramsB / 70) * 8; // approx scaling
      const totalGB = (baseWeightsGB + kvCacheGB) * 1.20; // 20% overhead

      if (statTotal) statTotal.textContent = `${totalGB.toFixed(1)} GB`;
      if (statWeights) statWeights.textContent = `${baseWeightsGB.toFixed(1)} GB`;

      let entGpu = '1x NVIDIA RTX 4090 24GB';
      if (totalGB > 160) entGpu = '4x NVIDIA H100 80GB';
      else if (totalGB > 80) entGpu = '2x NVIDIA A100 80GB';
      else if (totalGB > 24) entGpu = '1x NVIDIA A100 80GB or 2x RTX 4090';

      let consGpu = '1x RTX 4090 24GB';
      if (totalGB > 96) consGpu = 'Requires Cloud Enterprise GPUs';
      else if (totalGB > 48) consGpu = '4x RTX 4090 24GB';
      else if (totalGB > 24) consGpu = '2x RTX 4090 24GB';

      if (statGpuEnt) statGpuEnt.textContent = entGpu;
      if (statGpuCons) statGpuCons.textContent = consGpu;
    }

    btnCalc?.addEventListener('click', calculate);
    [inputParams, selectQuant, inputCtx].forEach(el => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    calculate();
  })();
</script>
