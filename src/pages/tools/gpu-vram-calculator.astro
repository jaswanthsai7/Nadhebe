---
import ToolLayout from '@/components/tools/ToolLayout.astro';

const title = 'GPU VRAM Calculator for LLMs | Nadhebe';
const h1 = 'GPU VRAM Calculator';
const description = 'Accurately estimate the GPU VRAM required to load and run Large Language Models (LLMs) in production environments like vLLM, considering weights, quantization, and KV cache.';

const faq = [
  {
    question: 'How is the KV Cache size calculated?',
    answer: 'KV Cache size depends on the context length, hidden size, number of attention heads, and the precision (e.g., FP16 vs FP8). This calculator uses standard Llama 3 architectures to approximate the KV cache footprint per token.',
  },
  {
    question: 'Why does 4-bit quantization save so much VRAM?',
    answer: 'Standard weights are stored as 16-bit floats (2 bytes per parameter). 4-bit quantization (like AWQ or GPTQ) compresses this to 0.5 bytes per parameter, effectively reducing the model weight memory footprint by 75%.',
  },
  {
    question: 'What is the "vLLM Reserved" overhead?',
    answer: 'Engines like vLLM pre-allocate a large chunk of VRAM to manage continuous batching efficiently using PagedAttention. By default, vLLM reserves 90% of your total GPU VRAM for the model weights and the KV cache block pool.',
  }
];
---

<ToolLayout
  toolId="gpu-vram-calculator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
      
      <!-- Input Panel -->
      <div class="glass-panel rounded-24 border border-border dark:border-border-dark p-24 bg-surface/50 dark:bg-surface-dark/50 shadow-soft">
        <div class="flex items-center justify-between mb-24 pb-16 border-b border-border dark:border-border-dark">
          <h2 class="text-h4 font-display font-bold text-ink dark:text-ink-dark m-0">Model Configuration</h2>
        </div>

        <div class="space-y-24">
          <!-- Parameters -->
          <div>
            <label class="block text-caption font-bold text-ink dark:text-ink-dark mb-6">Model Parameters (Billions)</label>
            <input type="number" id="params-input" min="1" max="1000" step="0.5" value="8" class="w-full rounded-8 border border-border dark:border-border-dark bg-surface2 dark:bg-surface2-dark px-12 py-8 text-body font-mono text-ink dark:text-ink-dark focus:border-accent outline-none" />
            <p class="text-xs text-muted dark:text-muted-dark mt-4">Example: 8 for Llama 3 8B, 70 for Llama 3 70B</p>
          </div>

          <!-- Precision -->
          <div>
            <label class="block text-caption font-bold text-ink dark:text-ink-dark mb-6">Weight Precision (Quantization)</label>
            <select id="precision-input" class="w-full rounded-8 border border-border dark:border-border-dark bg-surface2 dark:bg-surface2-dark px-12 py-8 text-body font-sans text-ink dark:text-ink-dark focus:border-accent outline-none">
              <option value="16">16-bit (FP16/BF16) - Native</option>
              <option value="8">8-bit (INT8) - SmoothQuant</option>
              <option value="4">4-bit (INT4) - AWQ/GPTQ</option>
            </select>
          </div>

          <!-- Context Length -->
          <div>
            <label class="block text-caption font-bold text-ink dark:text-ink-dark mb-6">Context Length (Tokens)</label>
            <input type="number" id="context-input" min="512" max="128000" step="1024" value="8192" class="w-full rounded-8 border border-border dark:border-border-dark bg-surface2 dark:bg-surface2-dark px-12 py-8 text-body font-mono text-ink dark:text-ink-dark focus:border-accent outline-none" />
          </div>
          
          <!-- Batch Size -->
          <div>
            <label class="block text-caption font-bold text-ink dark:text-ink-dark mb-6">Concurrent Batch Size</label>
            <input type="number" id="batch-input" min="1" max="256" value="16" class="w-full rounded-8 border border-border dark:border-border-dark bg-surface2 dark:bg-surface2-dark px-12 py-8 text-body font-mono text-ink dark:text-ink-dark focus:border-accent outline-none" />
          </div>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="glass-panel rounded-24 border border-border dark:border-border-dark p-24 bg-surface/50 dark:bg-surface-dark/50 shadow-soft flex flex-col">
        <div class="flex items-center justify-between mb-24 pb-16 border-b border-border dark:border-border-dark">
          <h2 class="text-h4 font-display font-bold text-ink dark:text-ink-dark m-0">VRAM Estimation</h2>
        </div>

        <div class="flex-1 flex flex-col justify-center space-y-16">
          
          <div class="relative overflow-hidden rounded-16 border border-accent/30 bg-accent/5 p-24 text-center">
            <div class="text-caption font-bold text-accent dark:text-accent-dark uppercase tracking-wider mb-8">Total Required VRAM</div>
            <div id="result-total" class="text-h1 font-display font-bold text-ink dark:text-ink-dark tabular-nums">0.00 GB</div>
          </div>
          
          <div class="grid grid-cols-2 gap-16">
            <div class="rounded-12 border border-border dark:border-border-dark bg-surface p-16 text-center">
              <div class="text-[10px] font-bold text-muted uppercase tracking-wider mb-4">Model Weights</div>
              <div id="result-weights" class="text-h3 font-display font-bold text-ink tabular-nums">0.00 GB</div>
            </div>
            <div class="rounded-12 border border-border dark:border-border-dark bg-surface p-16 text-center">
              <div class="text-[10px] font-bold text-muted uppercase tracking-wider mb-4">KV Cache (Context)</div>
              <div id="result-kv" class="text-h3 font-display font-bold text-ink tabular-nums">0.00 GB</div>
            </div>
          </div>
          
          <div class="rounded-12 border border-border dark:border-border-dark bg-surface/30 p-16">
            <h3 class="text-caption font-bold text-ink dark:text-ink-dark mb-8">Recommended GPU Options</h3>
            <ul id="gpu-recs" class="text-sm font-sans text-muted dark:text-muted-dark space-y-4 list-disc pl-16">
              <li>Loading...</li>
            </ul>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  <div slot="content">
    <h2>Stop Guessing Your GPU Requirements</h2>
    <p>
      The <strong>GPU VRAM Calculator</strong> is an engineering utility designed to help AI infrastructure teams estimate exactly how much VRAM they need before renting cloud instances or buying hardware.
    </p>

    <h3>Understanding the Metrics</h3>
    <ul>
      <li><strong>Model Weights:</strong> This is the static memory required just to load the neural network into the GPU. It is calculated as <code>Parameters × (Bits/8)</code>.</li>
      <li><strong>KV Cache:</strong> This is the dynamic memory used during inference. The longer the context window and the larger the concurrent batch size, the larger the KV cache grows. If your KV cache exceeds available VRAM, engines like vLLM will trigger an Out-Of-Memory (OOM) exception.</li>
    </ul>
    
    <p>
      To learn more about optimizing your LLM deployments using PagedAttention and continuous batching, read our comprehensive <a href="/tutorials/vllm-guide">Ultimate vLLM Deployment Guide</a>.
    </p>
  </div>
</ToolLayout>

<script>
  function setupCalculator() {
    const paramsInput = document.getElementById('params-input') as HTMLInputElement;
    const precInput = document.getElementById('precision-input') as HTMLSelectElement;
    const ctxInput = document.getElementById('context-input') as HTMLInputElement;
    const batchInput = document.getElementById('batch-input') as HTMLInputElement;
    
    const rTotal = document.getElementById('result-total');
    const rWeights = document.getElementById('result-weights');
    const rKv = document.getElementById('result-kv');
    const rGpu = document.getElementById('gpu-recs');

    if (!paramsInput || !rTotal) return;

    function calculate() {
      const p = parseFloat(paramsInput.value) || 8;
      const bits = parseFloat(precInput.value) || 16;
      const ctx = parseFloat(ctxInput.value) || 8192;
      const batch = parseFloat(batchInput.value) || 16;
      
      // Weight memory: (Params in B) * (bits / 8) -> GB
      const weightGB = p * (bits / 8);
      
      // KV Cache approximation (simplified formula assuming standard attention head ratios)
      // Llama 3 8B has 32 heads, 128 head dim, 4 layers (GQA).
      // Rough heuristic for modern LLMs: ~1MB per 1000 tokens per billion parameters in FP16.
      // So KV cache in GB = (batch * ctx * p * 0.000001) for FP16
      const kvGB = (batch * ctx * p * 0.0000012) * (16 / 16); // Assuming KV cache is in FP16
      
      // Total + 20% overhead for CUDA contexts and activations
      const totalGB = (weightGB + kvGB) * 1.2;
      
      if (rWeights) rWeights.textContent = `${weightGB.toFixed(2)} GB`;
      if (rKv) rKv.textContent = `${kvGB.toFixed(2)} GB`;
      if (rTotal) rTotal.textContent = `${totalGB.toFixed(2)} GB`;
      
      // Recommend GPUs
      let recs = [];
      if (totalGB < 12) {
        recs.push('1x RTX 4090 (24GB) or 1x RTX 3090 (24GB)');
        recs.push('1x L4 (24GB) - Cloud Server');
      } else if (totalGB < 24) {
        recs.push('1x RTX 4090 (24GB) or 1x RTX 3090 (24GB)');
        recs.push('1x A10G (24GB) or 1x L4 (24GB)');
      } else if (totalGB < 48) {
        recs.push('2x RTX 4090 (24GB) or 2x RTX 3090 (24GB)');
        recs.push('1x A6000 (48GB) or 1x A40 (48GB)');
      } else if (totalGB < 80) {
        recs.push('1x H100 (80GB) or 1x A100 (80GB)');
        recs.push('4x RTX 4090 (24GB) via PCIe');
      } else {
        recs.push('2x H100 (80GB) or 2x A100 (80GB)');
        recs.push('8x L40S (48GB) Node');
      }
      
      if (rGpu) {
        rGpu.innerHTML = recs.map(r => `<li>${r}</li>`).join('');
      }
    }

    [paramsInput, precInput, ctxInput, batchInput].forEach(el => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    calculate();
  }

  setupCalculator();
  document.addEventListener('astro:page-load', setupCalculator);
</script>
