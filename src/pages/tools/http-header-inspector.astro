---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'HTTP Request & Response Header Inspector | Nadhebe';
const h1 = 'HTTP Request & Response Header Inspector';
const description = 'Inspect, parse, and analyze HTTP request and response headers client-side. Evaluate security headers (CSP, HSTS, CORS, X-Frame-Options) and cache directives.';

const faq = [
  {
    question: 'How does the HTTP Header Inspector work?',
    answer: 'Paste raw HTTP response headers or request text. The inspector parses header keys and values, categorizing security headers, caching headers, and server signatures.',
  },
  {
    question: 'What key security headers are evaluated?',
    answer: 'Evaluates `Content-Security-Policy`, `Strict-Transport-Security` (HSTS), `X-Frame-Options`, `X-Content-Type-Options`, `Access-Control-Allow-Origin` (CORS), and `Referrer-Policy`.',
  },
  {
    question: 'Are my HTTP headers sent to remote servers?',
    answer: '100% private. Header parsing and security score calculations execute locally in your web browser.',
  },
  {
    question: 'How do cache control headers work?',
    answer: '`Cache-Control: max-age=3600, public` instructs browsers and CDNs (Cloudflare, Fastly) to cache response assets for 1 hour.',
  },
  {
    question: 'How can I generate missing security headers?',
    answer: 'Use our security header generators: <a href="/tools/csp-header-generator/">CSP Header Generator</a>, <a href="/tools/hsts-header-generator/">HSTS Header Generator</a>, and <a href="/tools/cors-header-generator/">CORS Header Generator</a>.',
  },
];
---

<ToolLayout
  toolId="http-header-inspector"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="http-hdr-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="RAW HTTP HEADERS INPUT">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="hhi-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">HTTP Headers Text</label>
              <button type="button" id="btn-load-sample-hhi" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample Response Headers</button>
            </div>
            <textarea
              id="hhi-input-raw"
              rows="12"
              placeholder="HTTP/1.1 200 OK&#10;Content-Type: text/html; charset=utf-8&#10;Strict-Transport-Security: max-age=31536000; includeSubDomains&#10;..."
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <button
            type="button"
            id="btn-inspect-hhi"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Inspect & Score Headers
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="PARSED HEADERS & SECURITY ANALYSIS">
        <div class="space-y-20">
          
          <!-- Score Summary -->
          <div class="grid grid-cols-2 gap-12 text-center font-mono">
            <div class="rounded-12 border border-emerald-500/30 bg-emerald-500/10 p-16">
              <div id="stat-hhi-score" class="text-h2 font-bold text-emerald-800 dark:text-emerald-300">A+</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Security Header Score</div>
            </div>
            <div class="rounded-12 border border-border bg-surface2/60 p-16 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-hhi-count" class="text-h2 font-bold text-accent dark:text-accent-dark">8</div>
              <div class="text-xs text-muted dark:text-muted-dark uppercase mt-4">Total Headers Parsed</div>
            </div>
          </div>

          <!-- Parsed Headers Table -->
          <div class="w-full overflow-x-auto rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark max-h-[260px]">
            <table class="w-full text-left font-mono text-xs border-collapse">
              <thead class="bg-surface2 dark:bg-surface2-dark border-b border-border dark:border-border-dark text-ink dark:text-ink-dark font-bold">
                <tr>
                  <th class="p-8">Header Key</th>
                  <th class="p-8">Value</th>
                  <th class="p-8">Type</th>
                </tr>
              </thead>
              <tbody id="hhi-tbody" class="divide-y divide-border/40 dark:divide-border-dark/40 text-ink dark:text-ink-dark">
                <tr>
                  <td colspan="3" class="p-16 text-center text-muted dark:text-muted-dark">Paste headers above to inspect.</td>
                </tr>
              </tbody>
            </table>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>HTTP Request & Response Header Security Guide</h2>
    <p>
      HTTP headers pass additional metadata between client browsers and web servers. Implementing recommended security headers mitigates Cross-Site Scripting (XSS), Clickjacking, and Man-in-the-Middle (MITM) vulnerabilities.
    </p>

    <h3>Recommended Security Headers</h3>
    <ul>
      <li><strong>Content-Security-Policy (CSP)</strong>: Restricts trusted script sources to prevent XSS attacks.</li>
      <li><strong>Strict-Transport-Security (HSTS)</strong>: Forces browsers to communicate exclusively over HTTPS.</li>
      <li><strong>X-Frame-Options</strong>: Prevents website framing inside malicious iframes.</li>
    </ul>

    <h3>Related Security & Developer Tools</h3>
    <p>
      Generate CSP headers with the <a href="/tools/csp-header-generator/">CSP Header Generator</a>, build HSTS headers with the <a href="/tools/hsts-header-generator/">HSTS Header Generator</a>, or check HTTP status codes with the <a href="/tools/http-status-codes-cheat-sheet/">HTTP Status Codes Cheat Sheet</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputRaw = document.getElementById('hhi-input-raw');
    const btnInspect = document.getElementById('btn-inspect-hhi');
    const btnSample = document.getElementById('btn-load-sample-hhi');

    const statScore = document.getElementById('stat-hhi-score');
    const statCount = document.getElementById('stat-hhi-count');
    const tbody = document.getElementById('hhi-tbody');

    const sampleHeaders = `HTTP/1.1 200 OK
Content-Type: text/html; charset=utf-8
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'
Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
X-Frame-Options: DENY
X-Content-Type-Options: nosniff
Cache-Control: public, max-age=3600
Server: cloudflare`;

    function inspectHeaders() {
      const raw = inputRaw?.value || sampleHeaders;
      const lines = raw.split('\n').filter(l => l.trim());

      const headers = [];
      let secScore = 0;

      lines.forEach(line => {
        if (line.startsWith('HTTP/')) return;
        const idx = line.indexOf(':');
        if (idx === -1) return;

        const key = line.substring(0, idx).trim();
        const val = line.substring(idx + 1).trim();
        const lowerKey = key.toLowerCase();

        let type = 'Standard';
        if (['content-security-policy', 'strict-transport-security', 'x-frame-options', 'x-content-type-options', 'referrer-policy'].includes(lowerKey)) {
          type = 'Security';
          secScore++;
        } else if (['cache-control', 'expires', 'etag'].includes(lowerKey)) {
          type = 'Caching';
        }

        headers.push({ key, val, type });
      });

      if (statCount) statCount.textContent = headers.length;

      if (statScore) {
        if (secScore >= 4) {
          statScore.textContent = 'A+';
          statScore.className = 'text-h2 font-bold text-emerald-800 dark:text-emerald-300';
        } else if (secScore >= 2) {
          statScore.textContent = 'B';
          statScore.className = 'text-h2 font-bold text-amber-600 dark:text-amber-400';
        } else {
          statScore.textContent = 'D';
          statScore.className = 'text-h2 font-bold text-rose-600 dark:text-rose-400';
        }
      }

      if (tbody) {
        if (headers.length === 0) {
          tbody.innerHTML = `<tr><td colspan="3" class="p-16 text-center text-muted dark:text-muted-dark">No valid HTTP headers detected.</td></tr>`;
        } else {
          tbody.innerHTML = headers.map(h => `<tr>
            <td class="p-8 font-bold text-ink dark:text-ink-dark">${h.key}</td>
            <td class="p-8 text-muted dark:text-muted-dark max-w-xs truncate" title="${h.val}">${h.val}</td>
            <td class="p-8 font-bold ${h.type === 'Security' ? 'text-emerald-600 dark:text-emerald-400' : 'text-accent dark:text-accent-dark'}">${h.type}</td>
          </tr>`).join('');
        }
      }
    }

    btnInspect?.addEventListener('click', inspectHeaders);
    inputRaw?.addEventListener('input', inspectHeaders);

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = sampleHeaders;
      inspectHeaders();
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = sampleHeaders;
    inspectHeaders();
  })();
</script>
