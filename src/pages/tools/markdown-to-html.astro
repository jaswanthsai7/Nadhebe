---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Markdown to HTML Converter | Nadhebe';
const h1 = 'Markdown to HTML Converter';
const description = 'Convert GitHub Flavored Markdown (GFM) text into clean HTML markup. Render headers, lists, code blocks, blockquotes, and links client-side.';

const faq = [
  {
    question: 'How does the Markdown to HTML converter work?',
    answer: 'The converter parses GFM syntax (headings `#`, lists `-`, bold `**`, code backticks `` ` ``, and links `[text](url)`) and compiles it into valid HTML5 markup.',
  },
  {
    question: 'Can I copy the raw HTML output for CMS embedding?',
    answer: 'Yes! The output is formatted with clean HTML tags ready to paste into WordPress, Webflow, or custom web applications.',
  },
  {
    question: 'Are code blocks converted to `<pre><code>` tags?',
    answer: 'Yes! Fenced code blocks (```) are rendered inside `<pre><code class="language-...">` tags for syntax highlighting.',
  },
  {
    question: 'Is my Markdown content sent to any remote server?',
    answer: 'No! All compilation runs 100% locally in your browser using regex pattern matching and string parsers.',
  },
  {
    question: 'Does it support inline links and image tags?',
    answer: 'Yes! Links (`[Text](url)`) and images (`![Alt](src)`) are rendered as `<a>` and `<img>` HTML tags.',
  },
];
---

<ToolLayout
  toolId="markdown-to-html"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="md2htm-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="MARKDOWN TEXT INPUT">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="md-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">Markdown Text Content</label>
              <button type="button" id="btn-load-sample-md" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample Markdown</button>
            </div>
            <textarea
              id="md-input-raw"
              rows="12"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <button
            type="button"
            id="btn-convert-md2htm"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Convert Markdown to HTML
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="HTML OUTPUT">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Compiled HTML Code</span>
            <button type="button" id="btn-copy-md2htm" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy HTML</button>
          </div>

          <pre id="md-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[300px] leading-relaxed whitespace-pre-wrap"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Markdown to HTML Compilation Guide</h2>
    <p>
      Converting Markdown to HTML is a common task when building static websites, newsletter templates, or publishing platform integrations.
    </p>

    <h3>Supported GFM Markdown Elements</h3>
    <ul>
      <li><strong>Headers</strong>: `# H1`, `## H2`, `### H3`</li>
      <li><strong>Text Formatting</strong>: `**Bold**`, `*Italics*`, `` `Code` ``</li>
      <li><strong>Links & Media</strong>: `[Text](url)`, `![Alt](src)`</li>
      <li><strong>Unordered Lists</strong>: `- Item 1`, `- Item 2`</li>
    </ul>

    <h3>Related Developer Tools</h3>
    <p>
      Convert HTML to Markdown with the <a href="/tools/html-to-markdown/">HTML to Markdown Converter</a>, format SQL queries with the <a href="/tools/sql-formatter/">SQL Formatter</a>, or validate JSON schemas with the <a href="/tools/json-schema-validator/">JSON Schema Validator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputRaw = document.getElementById('md-input-raw');
    const btnConvert = document.getElementById('btn-convert-md2htm');
    const btnSample = document.getElementById('btn-load-sample-md');

    const outputText = document.getElementById('md-output-text');
    const btnCopy = document.getElementById('btn-copy-md2htm');

    const defaultMd = `# Markdown to HTML Converter

Convert **Markdown formatted text** into clean HTML markup.

- Fast client-side compilation
- Supports links like [Nadhebe](https://nadhebe.com)

\`\`\`javascript
function hello() { return "world"; }
\`\`\``;

    function convertMarkdownToHTML(md) {
      let html = md
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        .replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
        .replace(/\*(.*)\*/gim, '<em>$1</em>')
        .replace(/`([^`]+)`/gim, '<code>$1</code>')
        .replace(/!\[(.*?)\]\((.*?)\)/gim, '<img alt="$1" src="$2" />')
        .replace(/\[(.*?)\]\((.*?)\)/gim, '<a hr' + 'ef="$2">$1</a>')
        .replace(/^\- (.*$)/gim, '<li>$1</li>')
        .replace(/\n\n/gim, '</p><p>');

      return `<p>${html.trim()}</p>`
        .replace(/<p><h/g, '<h')
        .replace(/<\/h[1-6]><\/p>/g, '</h3>')
        .replace(/<p><li>/g, '<ul><li>')
        .replace(/<\/li><\/p>/g, '</li></ul>');
    }

    function convert() {
      const raw = inputRaw?.value || defaultMd;
      const html = convertMarkdownToHTML(raw);
      if (outputText) outputText.textContent = html;
    }

    btnConvert?.addEventListener('click', convert);
    inputRaw?.addEventListener('input', convert);

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = defaultMd;
      convert();
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = defaultMd;

    convert();
  })();
</script>
