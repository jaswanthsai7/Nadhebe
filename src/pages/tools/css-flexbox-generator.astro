---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'CSS Flexbox Layout Generator & Visual Builder | Nadhebe';
const h1 = 'CSS Flexbox Layout Generator & Visual Builder';
const description = 'Build and preview CSS Flexbox layouts interactively. Configure flex-direction, justify-content, align-items, flex-wrap, and export production CSS code.';

const faq = [
  {
    question: 'How does the CSS Flexbox Generator work?',
    answer: 'Configure flexbox container properties (direction, alignment, wrapping, gap) and child item properties. The generator renders a real-time visual preview and generates clean CSS flexbox code.',
  },
  {
    question: 'What is the difference between `justify-content` and `align-items`?',
    answer: '`justify-content` controls alignment along the main axis (horizontal by default for `row`), while `align-items` controls alignment along the cross axis (vertical by default).',
  },
  {
    question: 'Is my CSS code stored on external servers?',
    answer: '100% private. All visual previews and CSS code generation execute locally in your web browser.',
  },
  {
    question: 'Can I copy the generated CSS code into my project?',
    answer: 'Yes! Click "Copy CSS Code" to copy `.container` and `.item` flexbox rules directly into your stylesheet.',
  },
  {
    question: 'How do I build CSS Grid layouts?',
    answer: 'Use our dedicated <a href="/tools/css-grid-generator/">CSS Grid Layout Generator</a> tool.',
  },
];
---

<ToolLayout
  toolId="css-flexbox-generator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="flex-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="FLEXBOX CONTAINER CONTROLS">
        <div class="space-y-16">
          <div class="grid grid-cols-2 gap-12">
            <div>
              <label for="flex-dir" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">flex-direction</label>
              <select id="flex-dir" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono cursor-pointer">
                <option value="row" selected>row (horizontal)</option>
                <option value="row-reverse">row-reverse</option>
                <option value="column">column (vertical)</option>
                <option value="column-reverse">column-reverse</option>
              </select>
            </div>

            <div>
              <label for="flex-justify" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">justify-content</label>
              <select id="flex-justify" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono cursor-pointer">
                <option value="flex-start">flex-start</option>
                <option value="center" selected>center</option>
                <option value="flex-end">flex-end</option>
                <option value="space-between">space-between</option>
                <option value="space-around">space-around</option>
                <option value="space-evenly">space-evenly</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-12">
            <div>
              <label for="flex-align" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">align-items</label>
              <select id="flex-align" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono cursor-pointer">
                <option value="center" selected>center</option>
                <option value="flex-start">flex-start</option>
                <option value="flex-end">flex-end</option>
                <option value="stretch">stretch</option>
              </select>
            </div>

            <div>
              <label for="flex-wrap" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">flex-wrap</label>
              <select id="flex-wrap" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono cursor-pointer">
                <option value="wrap" selected>wrap</option>
                <option value="nowrap">nowrap</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-12">
            <div>
              <label for="flex-gap" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">gap (px)</label>
              <input id="flex-gap" type="number" min="0" max="60" value="16" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono" />
            </div>

            <div>
              <label for="flex-count" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Item Count</label>
              <input id="flex-count" type="number" min="1" max="10" value="4" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono" />
            </div>
          </div>

        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="LIVE VISUAL PREVIEW & CSS CODE">
        <div class="space-y-20">
          
          <!-- Live Preview Box -->
          <div>
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-8">Visual Canvas Preview</span>
            <div id="flex-preview-box" class="w-full min-h-[220px] rounded-12 border border-border bg-surface2 p-16 dark:border-border-dark dark:bg-surface2-dark flex flex-wrap transition-all overflow-hidden">
              <!-- Rendered items -->
            </div>
          </div>

          <!-- CSS Code Box -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Generated CSS</span>
              <button type="button" id="btn-copy-flex" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft">
                Copy CSS Code
              </button>
            </div>
            <pre id="flex-css-code" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 leading-relaxed whitespace-pre-wrap"></pre>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>CSS Flexible Box Layout (Flexbox) Specification</h2>
    <p>
      CSS Flexbox provides a 1-dimensional layout system for aligning UI components, navigation bars, and responsive card grids along rows or columns.
    </p>

    <h3>Flexbox Property Matrix</h3>
    <ul>
      <li><strong>display: flex</strong>: Activates flex layout mode on the container element.</li>
      <li><strong>justify-content</strong>: Aligns flex items along the primary axis.</li>
      <li><strong>align-items</strong>: Aligns flex items along the cross axis.</li>
      <li><strong>gap</strong>: Sets spacing distance between adjacent flex items.</li>
    </ul>

    <h3>Related CSS & Design Tools</h3>
    <p>
      Calculate CSS Clamp responsive typography with the <a href="/tools/css-clamp-calculator/">CSS Clamp Calculator</a>, check color contrast with the <a href="/tools/color-contrast-checker/">Color Contrast Checker</a>, or convert px to rem with the <a href="/tools/px-to-rem/">PX to REM Converter</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const selectDir = document.getElementById('flex-dir');
    const selectJustify = document.getElementById('flex-justify');
    const selectAlign = document.getElementById('flex-align');
    const selectWrap = document.getElementById('flex-wrap');
    const inputGap = document.getElementById('flex-gap');
    const inputCount = document.getElementById('flex-count');

    const previewBox = document.getElementById('flex-preview-box');
    const cssCode = document.getElementById('flex-css-code');
    const btnCopy = document.getElementById('btn-copy-flex');

    function updateFlex() {
      const dir = selectDir?.value || 'row';
      const justify = selectJustify?.value || 'center';
      const align = selectAlign?.value || 'center';
      const wrap = selectWrap?.value || 'wrap';
      const gap = parseInt(inputGap?.value || '16', 10);
      const count = parseInt(inputCount?.value || '4', 10);

      if (previewBox) {
        previewBox.style.flexDirection = dir;
        previewBox.style.justifyContent = justify;
        previewBox.style.alignItems = align;
        previewBox.style.flexWrap = wrap;
        previewBox.style.gap = `${gap}px`;

        previewBox.innerHTML = '';
        for (let i = 1; i <= count; i++) {
          const item = document.createElement('div');
          item.className = 'rounded-8 bg-accent/20 border border-accent/40 text-accent dark:text-accent-dark font-mono text-xs font-bold p-16 min-w-[70px] min-h-[50px] flex items-center justify-center shadow-soft';
          item.textContent = `Item ${i}`;
          previewBox.appendChild(item);
        }
      }

      const css = `.container {
  display: flex;
  flex-direction: ${dir};
  justify-content: ${justify};
  align-items: ${align};
  flex-wrap: ${wrap};
  gap: ${gap}px;
}

.item {
  flex: 0 1 auto;
}`;

      if (cssCode) cssCode.textContent = css;
    }

    [selectDir, selectJustify, selectAlign, selectWrap, inputGap, inputCount].forEach(el => {
      el?.addEventListener('input', updateFlex);
      el?.addEventListener('change', updateFlex);
    });

    btnCopy?.addEventListener('click', () => {
      if (cssCode) {
        navigator.clipboard.writeText(cssCode.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy CSS Code'), 2000);
      }
    });

    updateFlex();
  })();
</script>
