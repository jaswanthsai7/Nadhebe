---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ToolLayout from '@/components/tools/ToolLayout.astro';
import PlatformWorkbench from '@/components/tools/PlatformWorkbench.astro';
import { UNIFIED_TOOLS_REGISTRY, type UnifiedTool } from '@/config/tools-registry';
import type { PlatformTool } from '@/config/platform-tools';
import type { ToolMetadata } from '@/config/tools';

export async function getStaticPaths() {
  const entries = await getCollection('tools');
  const standaloneAstroSlugs = new Set([
    '16-9-dimensions-calculator',
    '9-16-dimensions-calculator',
    'aspect-ratio-calculator',
    'color-contrast-checker',
    'css-clamp-calculator',
    'csv-to-json',
    'dpi-print-size-calculator',
    'json-formatter',
    'json-minifier',
    'json-to-typescript',
    'json-to-xml',
    'json-validator',
    'megapixels-to-resolution-calculator',
    'meta-tag-analyzer',
    'opportunity-radar',
    'percentage-difference-calculator',
    'pixels-to-megapixels-calculator',
    'ppi-calculator',
    'profit-margin-calculator',
    'px-to-rem',
    'resize-dimensions-calculator',
    'schema-generator',
    'sitemap-validator',
    'social-media-image-sizes',
    'svg-to-jsx',
    'xml-formatter',
    'yaml-to-json',
    'youtube-video-size-calculator',
  ]);

  const reservedSlugs = new Set([
    ...entries.map((entry) => entry.slug),
    ...standaloneAstroSlugs,
  ]);

  const articlePaths = entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));

  const platformPaths = UNIFIED_TOOLS_REGISTRY
    .filter((tool) => !reservedSlugs.has(tool.slug))
    .map((platformTool) => ({
      params: { slug: platformTool.slug },
      props: {
        platformTool: {
          id: platformTool.id,
          name: platformTool.name || platformTool.title,
          slug: platformTool.slug,
          href: platformTool.href,
          description: platformTool.description,
          category: platformTool.category,
          categorySlug: platformTool.categorySlug || platformTool.category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
          mode: platformTool.mode || 'transform',
          badge: platformTool.badge,
          tags: platformTool.tags || [],
        } as PlatformTool,
      },
    }));

  return [...articlePaths, ...platformPaths];
}

const { entry, platformTool } = Astro.props as { entry?: Awaited<ReturnType<typeof getCollection>>[number]; platformTool?: PlatformTool };
const platformRelatedTools = platformTool
  ? UNIFIED_TOOLS_REGISTRY
      .filter((tool) => tool.category === platformTool.category || tool.categorySlug === platformTool.categorySlug)
      .slice(0, 6)
      .map((tool) => ({
        id: tool.id,
        name: tool.name || tool.title,
        slug: tool.slug,
        href: tool.href,
        description: tool.description,
        category: tool.category,
        icon: 'code',
        badge: tool.badge,
        tags: tool.tags,
        noApi: true,
      })) as ToolMetadata[]
  : undefined;
---

{entry ? (
  <ArticleLayout post={entry} />
) : platformTool ? (
  <ToolLayout
    toolId={platformTool.slug}
    title={`${platformTool.name} - Free Browser Tool | Nadhebe`}
    h1={platformTool.name}
    description={platformTool.description}
    hideHeader={true}
    relatedCategory={platformTool.category}
    relatedTools={platformRelatedTools}
    faq={[
      {
        question: `Is ${platformTool.name} free to use?`,
        answer: `Yes. ${platformTool.name} is free and runs locally in your browser without an account.`,
      },
      {
        question: 'Does Nadhebe upload my input?',
        answer: 'No. This utility processes your input in the browser so your working data remains on your device.',
      },
    ]}
  >
    <div slot="calculator"><PlatformWorkbench tool={platformTool} /></div>
    <div slot="content">
      <h2>About this {platformTool.category} utility</h2>
      <p>{platformTool.description}</p>
      <p>Use the workspace above to create, transform, calculate, or inspect your input without sending it to a remote service.</p>
    </div>
  </ToolLayout>
) : null}
