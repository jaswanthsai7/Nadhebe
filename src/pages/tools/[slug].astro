---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ToolLayout from '@/components/tools/ToolLayout.astro';
import PlatformWorkbench from '@/components/tools/PlatformWorkbench.astro';
import { UNIFIED_TOOLS_REGISTRY, type UnifiedTool } from '@/config/tools-registry';
import type { PlatformTool } from '@/config/platform-tools';
import type { ToolMetadata } from '@/config/tools';

export async function getStaticPaths() {
  const entries = await getCollection('tools');
  const standaloneAstroSlugs = new Set([
    '16-9-dimensions-calculator',
    '9-16-dimensions-calculator',
    'aspect-ratio-calculator',
    'color-contrast-checker',
    'css-clamp-calculator',
    'csv-to-json',
    'dpi-print-size-calculator',
    'json-formatter',
    'json-minifier',
    'json-to-typescript',
    'json-to-xml',
    'json-validator',
    'megapixels-to-resolution-calculator',
    'meta-tag-analyzer',
    'opportunity-radar',
    'percentage-difference-calculator',
    'pixels-to-megapixels-calculator',
    'ppi-calculator',
    'profit-margin-calculator',
    'px-to-rem',
    'resize-dimensions-calculator',
    'schema-generator',
    'sitemap-validator',
    'social-media-image-sizes',
    'svg-to-jsx',
    'xml-formatter',
    'yaml-to-json',
    'youtube-video-size-calculator',
  ]);

  const reservedSlugs = new Set([
    ...entries.map((entry) => entry.slug),
    ...standaloneAstroSlugs,
  ]);

  const articlePaths = entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));

  const platformPaths = UNIFIED_TOOLS_REGISTRY
    .filter((tool) => !reservedSlugs.has(tool.slug))
    .map((platformTool) => ({
      params: { slug: platformTool.slug },
      props: {
        platformTool: {
          id: platformTool.id,
          name: platformTool.name || platformTool.title,
          slug: platformTool.slug,
          href: platformTool.href,
          description: platformTool.description,
          seoDescription: platformTool.seo?.description || platformTool.description,
          seoTitle: platformTool.seo?.title || `${platformTool.name || platformTool.title} - Free Browser Tool | Nadhebe`,
          category: platformTool.category,
          categorySlug: platformTool.categorySlug || platformTool.category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
          mode: platformTool.mode || 'transform',
          badge: platformTool.badge,
          tags: platformTool.tags || [],
          // Pass status so PlatformWorkbench uses registry as single source of truth
          isImplemented: platformTool.status === 'implemented',
          // Pass corrected relatedTools from registry (not category-matching)
          relatedToolSlugs: platformTool.relatedTools || [],
        } as PlatformTool & { isImplemented: boolean; relatedToolSlugs: string[]; seoDescription: string; seoTitle: string },
      },
    }));

  return [...articlePaths, ...platformPaths];
}

const { entry, platformTool } = Astro.props as {
  entry?: Awaited<ReturnType<typeof getCollection>>[number];
  platformTool?: PlatformTool & { isImplemented: boolean; relatedToolSlugs: string[]; seoDescription: string; seoTitle: string };
};

// Build related tools from the registry's corrected relatedTools list (not naive category filter)
const platformRelatedTools = platformTool
  ? UNIFIED_TOOLS_REGISTRY
      .filter((tool) => (platformTool.relatedToolSlugs ?? []).includes(tool.slug))
      .map((tool) => ({
        id: tool.id,
        name: tool.name || tool.title,
        slug: tool.slug,
        href: tool.href,
        description: tool.description,
        category: tool.category,
        icon: tool.icon || 'code',
        badge: tool.badge,
        tags: tool.tags,
        noApi: true,
      })) as ToolMetadata[]
  : undefined;
---

{entry ? (
  <ArticleLayout post={entry} />
) : platformTool ? (
  <ToolLayout
    toolId={platformTool.slug}
    title={platformTool.seoTitle || `${platformTool.name} - Free Browser Tool | Nadhebe`}
    h1={platformTool.name}
    description={platformTool.seoDescription || platformTool.description}
    hideHeader={true}
    relatedCategory={platformTool.category}
    relatedTools={platformRelatedTools}
    faq={[
      {
        question: `Is ${platformTool.name} free to use?`,
        answer: `Yes. ${platformTool.name} is completely free and runs locally in your browser — no account required.`,
      },
      {
        question: 'Does Nadhebe upload my data?',
        answer: 'No. All processing happens in your browser. Your input data never leaves your device or gets sent to any server.',
      },
    ]}
  >
    <div slot="calculator"><PlatformWorkbench tool={platformTool} isImplemented={platformTool.isImplemented} /></div>
    <div slot="content">
      <h2>About {platformTool.name}</h2>
      <p>{platformTool.seoDescription || platformTool.description}</p>
      <p>Use the workspace above to {platformTool.mode === 'calculator' ? 'calculate' : platformTool.mode === 'generator' ? 'generate' : platformTool.mode === 'analyzer' ? 'analyze' : 'transform'} your input — entirely in your browser with no data uploaded to any server.</p>
    </div>
  </ToolLayout>
) : null}
