---
import fs from 'fs';
import path from 'path';
import ToolLayout from '@/components/tools/ToolLayout.astro';
import PlatformWorkbench from '@/components/tools/PlatformWorkbench.astro';
import { UNIFIED_TOOLS_REGISTRY, type UnifiedTool } from '@/config/tools-registry';
import { TOOL_RICH_CONTENT } from '@/config/tool-content';
import type { PlatformTool } from '@/config/platform-tools';
import type { ToolMetadata } from '@/config/tools';

export async function getStaticPaths() {
  // Dynamically inspect tools directory to find all standalone pages and routers
  const toolsDir = path.resolve('src/pages/tools');
  const existingFiles = fs.readdirSync(toolsDir);
  const reservedSlugs = new Set(
    existingFiles
      .filter((name) => name !== '[slug].astro' && name !== 'index.astro')
      .map((name) => name.replace(/\.astro$/, ''))
  );

  return UNIFIED_TOOLS_REGISTRY
    .filter((tool) => tool.status === 'implemented' && !reservedSlugs.has(tool.slug))
    .map((platformTool) => ({
      params: { slug: platformTool.slug },
      props: {
        platformTool: {
          id: platformTool.id,
          name: platformTool.name || platformTool.title,
          slug: platformTool.slug,
          href: platformTool.href,
          description: platformTool.description,
          seoDescription: platformTool.seo?.description || platformTool.description,
          seoTitle: platformTool.seo?.title || `${platformTool.name || platformTool.title} — Free Online Tool | Nadhebe`,
          category: platformTool.category,
          categorySlug: platformTool.categorySlug || platformTool.category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
          mode: platformTool.mode || 'transform',
          badge: platformTool.badge,
          tags: platformTool.tags || [],
          isImplemented: true,
          relatedToolSlugs: platformTool.relatedTools || [],
        } as PlatformTool & { isImplemented: boolean; relatedToolSlugs: string[]; seoDescription: string; seoTitle: string },
      },
    }));
}

const { platformTool } = Astro.props as {
  platformTool: PlatformTool & { isImplemented: boolean; relatedToolSlugs: string[]; seoDescription: string; seoTitle: string };
};

// Build related tools from the registry
const platformRelatedTools = UNIFIED_TOOLS_REGISTRY
  .filter((tool) => (platformTool.relatedToolSlugs ?? []).includes(tool.slug))
  .slice(0, 4)
  .map((tool) => ({
    id: tool.id,
    name: tool.name || tool.title,
    slug: tool.slug,
    href: tool.href,
    description: tool.description,
    category: tool.category,
    icon: tool.icon || 'code',
    badge: tool.badge,
    tags: tool.tags,
    noApi: true,
  })) as ToolMetadata[];

// Rich per-tool content
const richContent = TOOL_RICH_CONTENT[platformTool.slug];

// Build FAQ
const genericFaq = [
  {
    question: `Is ${platformTool.name} free to use?`,
    answer: `Yes. ${platformTool.name} is completely free and executes locally inside your web browser. No registration, API token, or software installation is required.`,
  },
  {
    question: 'Is my input data uploaded to any server?',
    answer: 'No. Nadhebe utilities execute 100% client-side in your web browser. Your text, payloads, or files never leave your device.',
  },
  {
    question: 'Can I use this tool offline?',
    answer: `Yes. Once the page is loaded in your browser, the JavaScript execution environment runs locally without needing an active internet connection.`,
  },
];
const toolFaq = richContent ? [...richContent.faq, ...genericFaq] : genericFaq;
---

<ToolLayout
  toolId={platformTool.slug}
  title={platformTool.seoTitle || `${platformTool.name} — Free Browser Tool | Nadhebe`}
  h1={platformTool.name}
  description={platformTool.seoDescription || platformTool.description}
  hideHeader={true}
  relatedCategory={platformTool.category}
  relatedTools={platformRelatedTools}
  faq={toolFaq}
>
  <div slot="calculator"><PlatformWorkbench tool={platformTool} isImplemented={true} /></div>

  <div slot="content">
    {richContent ? (
      <>
        <h2>About {platformTool.name}</h2>
        <p>{richContent.intro}</p>

        <h3>When to use {platformTool.name}</h3>
        <ul>
          {richContent.useCases.map((uc) => (
            <li>{uc}</li>
          ))}
        </ul>

        <h3>How it works</h3>
        <p>{richContent.howItWorks}</p>

        {richContent.example && (
          <>
            <h3>Example</h3>
            {richContent.example.label && <p><strong>{richContent.example.label}</strong></p>}
            <p><strong>Input:</strong></p>
            <pre><code>{richContent.example.input}</code></pre>
            <p><strong>Output:</strong></p>
            <pre><code>{richContent.example.output}</code></pre>
          </>
        )}

        <h3>Privacy & Security Guarantee</h3>
        <p>
          {platformTool.name} processes all data locally inside your web browser. No input text, files, credentials, or outputs are ever transmitted to remote servers, logged to analytics databases, or retained across sessions.
        </p>
      </>
    ) : (
      <>
        <h2>About {platformTool.name}</h2>
        <p>{platformTool.seoDescription || platformTool.description}</p>

        <h3>Key Features & Capabilities</h3>
        <ul>
          <li>Fast client-side execution with zero latency or network round-trips.</li>
          <li>Real-time input validation, formatting, and syntax verification.</li>
          <li>One-click clipboard copying and clean output export.</li>
          <li>Mobile-friendly, responsive layout designed for desktop and mobile workflows.</li>
        </ul>

        <h3>Privacy & Security Guarantee</h3>
        <p>
          {platformTool.name} operates entirely within your browser session. Your data never leaves your device and is not saved to any external database or analytics service.
        </p>
      </>
    )}
  </div>
</ToolLayout>
