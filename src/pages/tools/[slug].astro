---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ToolLayout from '@/components/tools/ToolLayout.astro';
import PlatformWorkbench from '@/components/tools/PlatformWorkbench.astro';
import { UNIFIED_TOOLS_REGISTRY, type UnifiedTool } from '@/config/tools-registry';
import { TOOL_RICH_CONTENT } from '@/config/tool-content';
import type { PlatformTool } from '@/config/platform-tools';
import type { ToolMetadata } from '@/config/tools';

export async function getStaticPaths() {
  const entries = await getCollection('tools');
  const standaloneAstroSlugs = new Set([
    '16-9-dimensions-calculator',
    '9-16-dimensions-calculator',
    'ai-api-pricing-calculator',
    'ai-detection-checker',
    'ai-persona-prompt-generator',
    'ai-prompt-generator',
    'aspect-ratio-calculator',
    'base64-encoder',
    'batch-inference-cost-estimator',
    'canonical-checker',
    'cac-payback',
    'case-converter',
    'claude-cost-estimator',
    'claude-desktop-mcp-config-maker',
    'cls-checklist',
    'color-contrast-checker',
    'column-extractor',
    'compound-interest',
    'cors-header-generator',
    'cosine-similarity-calculator',
    'cron-explainer',
    'csp-header-generator',
    'css-clamp-calculator',
    'csv-to-excel',
    'csv-to-json',
    'date-difference',
    'delimiter-converter',
    'dpi-print-size-calculator',
    'excel-to-csv',
    'evtx-to-csv',
    'few-shot-prompt-formatter',
    'gemini-cost-estimator',
    'gpu-vram-calculator',
    'hsts-header-generator',
    'http-status-codes-cheat-sheet',
    'html-to-markdown',
    'json-formatter',
    'json-minifier',
    'json-path-finder',
    'json-repair',
    'json-schema-validator',
    'json-to-csv',
    'json-to-typescript',
    'json-to-xml',
    'json-to-yaml',
    'json-validator',
    'jwt-encoder',
    'llm-model-comparison-matrix',
    'llm-rate-limit-backoff-generator',
    'llm-token-counter-multi-model',
    'llm-tokenizer',
    'markdown-table-generator',
    'markdown-to-html',
    'mcp-json-rpc-payload-tester',
    'mcp-server-manifest-generator',
    'megapixels-to-resolution-calculator',
    'meta-tag-analyzer',
    'openapi-3-yaml-generator',
    'openapi-to-mcp-tool-schema',
    'openai-cost-estimator',
    'opportunity-radar',
    'percentage-difference-calculator',
    'pixels-to-megapixels-calculator',
    'png-to-webp',
    'ppi-calculator',
    'profit-margin-calculator',
    'prompt-improver',
    'prompt-optimizer',
    'prompt-template-variable-tester',
    'px-to-rem',
    'qr-code-generator',
    'rag-chunk-size-calculator',
    'rag-context-window-calculator',
    'rag-evaluator',
    'redirect-chain-checker',
    'regex-tester',
    'resize-dimensions-calculator',
    'rfc-7807-error-json-generator',
    'robots-tester',
    'schema-generator',
    'schema-validator',
    'seo-builder',
    'seo-checker',
    'seo-estimator',
    'seo-inspector',
    'seo-planner',
    'serp-preview',
    'sitemap-validator',
    'slug-generator',
    'social-media-image-sizes',
    'sql-formatter',
    'svg-to-jsx',
    'svg-to-png',
    'uuid-v7-generator',
    'webp-to-png',
    'x-frame-options-generator',
    'xml-to-json',
    'yaml-validator',
    'system-prompt-linter-best-practices',
    'webhook-payload-signature-generator',
    'xml-formatter',
    'yaml-to-json',
    'youtube-video-size-calculator'
  ]);

  const reservedSlugs = new Set([
    ...entries.map((entry) => entry.slug),
    ...standaloneAstroSlugs,
  ]);

  const articlePaths = entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));

  const platformPaths = UNIFIED_TOOLS_REGISTRY
    .filter((tool) => !reservedSlugs.has(tool.slug))
    .map((platformTool) => ({
      params: { slug: platformTool.slug },
      props: {
        platformTool: {
          id: platformTool.id,
          name: platformTool.name || platformTool.title,
          slug: platformTool.slug,
          href: platformTool.href,
          description: platformTool.description,
          seoDescription: platformTool.seo?.description || platformTool.description,
          seoTitle: platformTool.seo?.title || `${platformTool.name || platformTool.title} - Free Browser Tool | Nadhebe`,
          category: platformTool.category,
          categorySlug: platformTool.categorySlug || platformTool.category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
          mode: platformTool.mode || 'transform',
          badge: platformTool.badge,
          tags: platformTool.tags || [],
          // Pass status so PlatformWorkbench uses registry as single source of truth
          isImplemented: platformTool.status === 'implemented',
          // Pass corrected relatedTools from registry (not category-matching)
          relatedToolSlugs: platformTool.relatedTools || [],
        } as PlatformTool & { isImplemented: boolean; relatedToolSlugs: string[]; seoDescription: string; seoTitle: string },
      },
    }));

  return [...articlePaths, ...platformPaths];
}

const { entry, platformTool } = Astro.props as {
  entry?: Awaited<ReturnType<typeof getCollection>>[number];
  platformTool?: PlatformTool & { isImplemented: boolean; relatedToolSlugs: string[]; seoDescription: string; seoTitle: string };
};

// Build related tools from the registry's corrected relatedTools list (not naive category filter)
const platformRelatedTools = platformTool
  ? UNIFIED_TOOLS_REGISTRY
      .filter((tool) => (platformTool.relatedToolSlugs ?? []).includes(tool.slug))
      .map((tool) => ({
        id: tool.id,
        name: tool.name || tool.title,
        slug: tool.slug,
        href: tool.href,
        description: tool.description,
        category: tool.category,
        icon: tool.icon || 'code',
        badge: tool.badge,
        tags: tool.tags,
        noApi: true,
      })) as ToolMetadata[]
  : undefined;

// Rich per-tool content (intro, use cases, how it works, example, faq)
const richContent = platformTool ? TOOL_RICH_CONTENT[platformTool.slug] : undefined;

// Build FAQ: use tool-specific items if available, always append 2 universal items
const genericFaq = [
  {
    question: `Is ${platformTool?.name} free to use?`,
    answer: `Yes. ${platformTool?.name} is completely free and runs locally in your browser — no account required.`,
  },
  {
    question: 'Does Nadhebe upload my data?',
    answer: 'No. All processing happens in your browser. Your input data never leaves your device or gets sent to any server.',
  },
];
const toolFaq = richContent ? [...richContent.faq, ...genericFaq] : genericFaq;

// Verb for the generic fallback paragraph
const modeVerb = platformTool?.mode === 'calculator' ? 'calculate'
  : platformTool?.mode === 'generator' ? 'generate'
  : platformTool?.mode === 'analyzer' ? 'analyze'
  : 'transform';
---

{entry ? (
  <ArticleLayout post={entry} />
) : platformTool ? (
  <ToolLayout
    toolId={platformTool.slug}
    title={platformTool.seoTitle || `${platformTool.name} - Free Browser Tool | Nadhebe`}
    h1={platformTool.name}
    description={platformTool.seoDescription || platformTool.description}
    hideHeader={true}
    relatedCategory={platformTool.category}
    relatedTools={platformRelatedTools}
    faq={toolFaq}
  >
    <div slot="calculator"><PlatformWorkbench tool={platformTool} isImplemented={platformTool.isImplemented} /></div>

    <div slot="content">
      {richContent ? (
        <>
          {/* Intro */}
          <h2>About {platformTool.name}</h2>
          <p>{richContent.intro}</p>

          {/* Use cases */}
          <h3>When to use {platformTool.name}</h3>
          <ul>
            {richContent.useCases.map((uc) => (
              <li>{uc}</li>
            ))}
          </ul>

          {/* How it works */}
          <h3>How it works</h3>
          <p>{richContent.howItWorks}</p>

          {/* Worked example */}
          {richContent.example && (
            <>
              <h3>Example</h3>
              {richContent.example.label && <p><strong>{richContent.example.label}</strong></p>}
              <p><strong>Input:</strong></p>
              <pre><code>{richContent.example.input}</code></pre>
              <p><strong>Output:</strong></p>
              <pre><code>{richContent.example.output}</code></pre>
            </>
          )}

          {/* Privacy note */}
          <h3>Privacy & security</h3>
          <p>
            {platformTool.name} runs entirely in your browser. No input data is uploaded to any server, stored in
            a database, or shared with third parties. You can use it offline once the page has loaded.
          </p>
        </>
      ) : (
        <>
          <h2>About {platformTool.name}</h2>
          <p>{platformTool.seoDescription || platformTool.description}</p>
          <p>
            Use the workspace above to {modeVerb} your input — entirely in your browser with no data uploaded
            to any server.
          </p>
        </>
      )}
    </div>
  </ToolLayout>
) : null}

