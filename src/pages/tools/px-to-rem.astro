---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'PX to REM & REM to PX Converter – CSS Unit Tool | Nadhebe';
const h1 = 'PX to REM Converter';
const description = 'Convert pixels (px) to REM units instantly. Free CSS unit calculator featuring custom base font sizes, REM to PX conversion, and full lookup tables.';

const faq = [
  {
    question: 'What is the default base font size in browsers?',
    answer: 'The standard root font size in virtually all web browsers is 16px (1rem = 16px).',
  },
  {
    question: 'What is the difference between EM and REM in CSS?',
    answer: 'REM (Root EM) scales relative strictly to the root <html> font size, whereas EM scales relative to the parent container font size.',
  },
];
---

<ToolLayout
  toolId="px-to-rem"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="px-rem-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- Input Parameters -->
      <CalculatorCard title="PX / REM CONVERTER">
        <div class="space-y-16">
          <div>
            <label class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Root Base Font Size (px)</label>
            <input id="input-base" type="number" value="16" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono" />
          </div>

          <div class="grid grid-cols-2 gap-12">
            <div>
              <label class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Pixels (px)</label>
              <input id="input-px" type="number" value="24" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono font-bold text-accent" />
            </div>
            <div>
              <label class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">REM (rem)</label>
              <input id="input-rem" type="number" step="0.0625" value="1.5" class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono font-bold text-emerald-600 dark:text-emerald-400" />
            </div>
          </div>
        </div>
      </CalculatorCard>

      <!-- Output Snippet & Lookup Matrix -->
      <ResultCard title="CONVERSION SNIPPET & MATRIX">
        <div class="space-y-16">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-muted dark:text-muted-dark">CSS Custom Property</span>
            <button type="button" id="btn-copy-css" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Snippet</button>
          </div>

          <pre id="output-css-snippet" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 font-bold leading-relaxed whitespace-pre"></pre>

          <!-- Dynamic Lookup Matrix Table -->
          <div>
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-8">Common PX to REM Lookup Table</span>
            <div class="max-h-[160px] overflow-y-auto rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark">
              <table class="w-full text-left font-mono text-xs">
                <thead class="bg-surface2 dark:bg-surface2-dark">
                  <tr>
                    <th class="p-8">PX</th>
                    <th class="p-8">REM</th>
                    <th class="p-8">Tailwind Class</th>
                  </tr>
                </thead>
                <tbody id="matrix-tbody" class="divide-y divide-border/40 dark:divide-border-dark/40">
                  <!-- Generated by JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>PX to REM Conversion Matrix</h2>
    <p>
      Converting fixed pixel measurements to relative <code>rem</code> units improves accessibility by allowing text and layout elements to scale smoothly when users alter their default browser font sizes.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputBase = document.getElementById('input-base');
    const inputPx = document.getElementById('input-px');
    const inputRem = document.getElementById('input-rem');
    const outputCss = document.getElementById('output-css-snippet');
    const btnCopy = document.getElementById('btn-copy-css');
    const tbody = document.getElementById('matrix-tbody');

    function convertPxToRem() {
      const base = parseFloat(inputBase?.value || 16);
      const px = parseFloat(inputPx?.value || 0);
      if (base <= 0) return;

      const rem = (px / base).toFixed(4).replace(/\.?0+$/, '');
      if (inputRem) inputRem.value = rem;

      if (outputCss) outputCss.textContent = `font-size: ${rem}rem; /* ${px}px */`;
      renderMatrix(base);
    }

    function convertRemToPx() {
      const base = parseFloat(inputBase?.value || 16);
      const rem = parseFloat(inputRem?.value || 0);
      if (base <= 0) return;

      const px = (rem * base).toFixed(2).replace(/\.?0+$/, '');
      if (inputPx) inputPx.value = px;

      if (outputCss) outputCss.textContent = `font-size: ${rem}rem; /* ${px}px */`;
      renderMatrix(base);
    }

    function renderMatrix(base) {
      if (!tbody) return;
      const commonPx = [8, 12, 14, 16, 18, 20, 24, 28, 32, 36, 40, 48, 64];
      const twMap = { 8: 'p-2', 12: 'p-3', 16: 'p-4', 20: 'p-5', 24: 'p-6', 32: 'p-8', 40: 'p-10', 48: 'p-12', 64: 'p-16' };

      tbody.innerHTML = '';
      commonPx.forEach(px => {
        const rem = (px / base).toFixed(4).replace(/\.?0+$/, '');
        const tw = twMap[px] || '-';
        const tr = document.createElement('tr');
        tr.innerHTML = `<td class="p-8 font-bold text-accent dark:text-accent-dark">${px}px</td><td class="p-8 text-emerald-600 dark:text-emerald-400">${rem}rem</td><td class="p-8 text-muted dark:text-muted-dark">${tw}</td>`;
        tbody.appendChild(tr);
      });
    }

    inputBase?.addEventListener('input', convertPxToRem);
    inputPx?.addEventListener('input', convertPxToRem);
    inputRem?.addEventListener('input', convertRemToPx);

    btnCopy?.addEventListener('click', () => {
      if (outputCss) {
        navigator.clipboard.writeText(outputCss.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy Snippet'), 2000);
      }
    });

    convertPxToRem();
  })();
</script>
