---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'CSV Table Viewer & Interactive Data Previewer | Nadhebe';
const h1 = 'CSV Table Preview & Viewer';
const description = 'Parse, preview, and search raw CSV data as an interactive HTML table with automatic delimiter detection and instant JSON/CSV export.';

const faq = [
  {
    question: 'What delimiters are supported?',
    answer: 'Our CSV viewer automatically detects commas (,), tabs (\\t), pipes (|), and semicolons (;).'
  },
  {
    question: 'Can I search or filter rows?',
    answer: 'Yes! Type any keyword in the search bar to filter table rows in real-time across all columns.'
  },
  {
    question: 'Is my CSV data uploaded to a server?',
    answer: 'No. 100% of CSV parsing and rendering runs locally inside your browser memory.'
  }
];
---

<ToolLayout
  toolId="csv-preview"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start" id="csv-preview-app">
    <!-- Left Column: Input & Controls -->
    <div class="space-y-24">
      <CalculatorCard title="RAW CSV DATA INPUT">
      <div class="space-y-16">
        <div class="flex flex-wrap items-center justify-between gap-12">
          <div class="flex items-center gap-8">
            <span class="text-xs font-mono font-bold uppercase text-muted dark:text-muted-dark">Delimiter:</span>
            <select id="cp-delimiter" class="rounded-8 border border-border bg-surface px-10 py-4 text-xs font-mono font-bold text-accent dark:border-border-dark dark:bg-surface-dark">
              <option value="auto">Auto-Detect</option>
              <option value=",">Comma (,)</option>
              <option value="&#9;">Tab (\t)</option>
              <option value="|">Pipe (|)</option>
              <option value=";">Semicolon (;)</option>
            </select>
          </div>

          <div class="flex items-center gap-8">
            <button type="button" id="cp-btn-sample" class="rounded-8 border border-border bg-surface2 px-12 py-4 text-xs font-mono font-bold text-accent hover:border-accent dark:border-border-dark dark:bg-surface2-dark transition-all">
              Load Sample CSV
            </button>
            <button type="button" id="cp-btn-clear" class="rounded-8 border border-border bg-surface px-12 py-4 text-xs font-mono font-bold text-muted hover:text-danger dark:border-border-dark dark:bg-surface-dark transition-all">
              Clear
            </button>
          </div>
        </div>

        <textarea
          id="cp-input-csv"
          rows="6"
          class="w-full rounded-12 border border-border bg-surface2 p-12 font-mono text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark leading-relaxed"
          placeholder="Paste CSV text here or click 'Load Sample CSV'..."
          spellcheck="false"
        ></textarea>

        <!-- Stats Bar -->
        <div class="flex flex-wrap items-center gap-16 font-mono text-xs font-bold text-muted dark:text-muted-dark pt-4">
          <div class="flex items-center gap-6">
            <span>Rows:</span>
            <span id="cp-stat-rows" class="text-ink dark:text-ink-dark">0</span>
          </div>
          <div class="flex items-center gap-6">
            <span>Columns:</span>
            <span id="cp-stat-cols" class="text-ink dark:text-ink-dark">0</span>
          </div>
          <div class="flex items-center gap-6">
            <span>Empty Cells:</span>
            <span id="cp-stat-empty" class="text-ink dark:text-ink-dark">0</span>
          </div>
        </div>
      </div>
    </CalculatorCard>
    </div>

    <!-- Right Column: Results & Metrics -->
    <div class="space-y-24">
      <ResultCard title="INTERACTIVE TABLE PREVIEW">
      <div class="space-y-16">
        
        <!-- Controls Bar: Search Filter & Export -->
        <div class="flex flex-wrap items-center justify-between gap-12">
          <div class="relative flex-1 max-w-sm">
            <input
              type="text"
              id="cp-search"
              placeholder="Search table rows..."
              class="w-full rounded-8 border border-border bg-surface px-12 py-6 text-xs font-mono text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark"
            />
          </div>

          <div class="flex items-center gap-8">
            <button type="button" id="cp-btn-export-csv" class="rounded-8 border border-border bg-surface2 px-12 py-6 text-xs font-mono font-bold text-ink hover:border-accent dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark transition-all">
              Export CSV
            </button>
            <button type="button" id="cp-btn-export-json" class="rounded-8 border border-border bg-accent px-12 py-6 text-xs font-mono font-bold text-white shadow-soft hover:opacity-90 transition-all">
              Export JSON
            </button>
          </div>
        </div>

        <!-- Scrollable HTML Table Container -->
        <div class="w-full overflow-x-auto rounded-12 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark max-h-[450px]">
          <table id="cp-table" class="w-full text-left text-xs font-mono border-collapse">
            <thead id="cp-thead" class="sticky top-0 bg-surface2 dark:bg-surface2-dark text-ink dark:text-ink-dark font-bold border-b border-border dark:border-border-dark z-10">
              <tr><th class="p-10 text-muted">#</th><th class="p-10">Paste CSV data to view table</th></tr>
            </thead>
            <tbody id="cp-tbody" class="divide-y divide-border/40 dark:divide-border-dark/40 text-ink dark:text-ink-dark">
              <tr><td colspan="2" class="p-16 text-center text-muted font-mono">No data loaded yet.</td></tr>
            </tbody>
          </table>
        </div>

      </div>
    </ResultCard>
    </div>
  </div>

  <div slot="content">
    <h2>Why Preview CSV Files Before Import?</h2>
    <p>
      CSV (Comma-Separated Values) files are the universal format for data interchange between databases, spreadsheets, and data analytics tools. However, mismatched delimiters, unescaped quotes, or irregular column counts can corrupt data pipelines. Previewing raw CSV text as an interactive table ensures data integrity before importing into database tables.
    </p>
  </div>
</ToolLayout>

<script>
  function initCsvPreview() {
    const inputCsv = document.getElementById('cp-input-csv') as HTMLTextAreaElement;
    const selectDelim = document.getElementById('cp-delimiter') as HTMLSelectElement;
    const searchInput = document.getElementById('cp-search') as HTMLInputElement;
    
    const statRows = document.getElementById('cp-stat-rows');
    const statCols = document.getElementById('cp-stat-cols');
    const statEmpty = document.getElementById('cp-stat-empty');

    const thead = document.getElementById('cp-thead');
    const tbody = document.getElementById('cp-tbody');

    const btnSample = document.getElementById('cp-btn-sample');
    const btnClear = document.getElementById('cp-btn-clear');
    const btnExportCsv = document.getElementById('cp-btn-export-csv');
    const btnExportJson = document.getElementById('cp-btn-export-json');

    const sampleCsv = `id,name,email,role,status,revenue\n1,Alice Chen,alice@example.com,Admin,Active,$12500\n2,Bob Smith,bob@example.com,Developer,Active,$9800\n3,Carol Danvers,carol@example.com,Designer,Pending,$4500\n4,David Lee,david@example.com,Manager,Active,$16200\n5,Eva Green,eva@example.com,Analyst,Inactive,$3100`;

    let currentParsedData: string[][] = [];

    function detectDelimiter(text: string): string {
      const firstLine = text.trim().split(/\r?\n/)[0] || '';
      if (firstLine.includes('\t')) return '\t';
      if (firstLine.includes(';') && !firstLine.includes(',')) return ';';
      if (firstLine.includes('|') && !firstLine.includes(',')) return '|';
      return ',';
    }

    function parseCsvLine(line: string, delimiter: string): string[] {
      const result: string[] = [];
      let cur = '';
      let inQuotes = false;

      for (let i = 0; i < line.length; i++) {
        const c = line[i];
        if (c === '"') {
          inQuotes = !inQuotes;
        } else if (c === delimiter && !inQuotes) {
          result.push(cur.trim());
          cur = '';
        } else {
          cur += c;
        }
      }
      result.push(cur.trim());
      return result;
    }

    function parseData(): string[][] {
      if (!inputCsv) return [];
      const raw = inputCsv.value.trim();
      if (!raw) return [];

      let delim = selectDelim?.value || 'auto';
      if (delim === 'auto') {
        delim = detectDelimiter(raw);
      }

      const lines = raw.split(/\r?\n/).filter(l => l.trim().length > 0);
      return lines.map(line => parseCsvLine(line, delim));
    }

    function renderTable() {
      const data = parseData();
      currentParsedData = data;

      if (data.length === 0) {
        if (statRows) statRows.textContent = '0';
        if (statCols) statCols.textContent = '0';
        if (statEmpty) statEmpty.textContent = '0';
        if (thead) thead.innerHTML = `<tr><th class="p-10 text-muted">#</th><th class="p-10">Paste CSV data to view table</th></tr>`;
        if (tbody) tbody.innerHTML = `<tr><td colspan="2" class="p-16 text-center text-muted">No data loaded yet.</td></tr>`;
        return;
      }

      const headers = data[0];
      const rows = data.slice(1);
      const query = searchInput?.value.toLowerCase().trim() || '';

      let emptyCount = 0;
      data.forEach(r => r.forEach(cell => { if (!cell) emptyCount++; }));

      if (statRows) statRows.textContent = String(rows.length);
      if (statCols) statCols.textContent = String(headers.length);
      if (statEmpty) statEmpty.textContent = String(emptyCount);

      // Render Header
      let headHtml = '<tr><th class="p-10 border-r border-border dark:border-border-dark text-muted w-12 text-center">#</th>';
      headers.forEach(h => {
        headHtml += `<th class="p-10 border-r border-border dark:border-border-dark uppercase tracking-wider">${h || 'Column'}</th>`;
      });
      headHtml += '</tr>';
      if (thead) thead.innerHTML = headHtml;

      // Render Body
      let bodyHtml = '';
      let displayedRows = 0;

      rows.forEach((row, idx) => {
        const matchesQuery = !query || row.some(cell => cell.toLowerCase().includes(query));
        if (!matchesQuery) return;

        displayedRows++;
        bodyHtml += `<tr class="hover:bg-surface2/60 dark:hover:bg-surface2-dark/60 transition-colors">`;
        bodyHtml += `<td class="p-8 border-r border-border/40 dark:border-border-dark/40 font-bold text-muted text-center">${displayedRows}</td>`;
        
        headers.forEach((_, colIdx) => {
          const cellVal = row[colIdx] !== undefined ? row[colIdx] : '';
          bodyHtml += `<td class="p-8 border-r border-border/40 dark:border-border-dark/40">${cellVal}</td>`;
        });
        
        bodyHtml += `</tr>`;
      });

      if (displayedRows === 0 && tbody) {
        tbody.innerHTML = `<tr><td colspan="${headers.length + 1}" class="p-16 text-center text-muted font-mono">No matching rows found for query "${query}".</td></tr>`;
      } else if (tbody) {
        tbody.innerHTML = bodyHtml;
      }
    }

    if (inputCsv) inputCsv.addEventListener('input', renderTable);
    if (selectDelim) selectDelim.addEventListener('change', renderTable);
    if (searchInput) searchInput.addEventListener('input', renderTable);

    btnSample?.addEventListener('click', () => {
      if (inputCsv) {
        inputCsv.value = sampleCsv;
        renderTable();
      }
    });

    btnClear?.addEventListener('click', () => {
      if (inputCsv) {
        inputCsv.value = '';
        renderTable();
      }
    });

    btnExportCsv?.addEventListener('click', () => {
      if (!inputCsv?.value) return;
      const blob = new Blob([inputCsv.value], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'preview_export.csv';
      a.click();
      URL.revokeObjectURL(url);
    });

    btnExportJson?.addEventListener('click', () => {
      if (currentParsedData.length < 2) return;
      const headers = currentParsedData[0];
      const rows = currentParsedData.slice(1);
      const jsonObj = rows.map(r => {
        const item: Record<string, string> = {};
        headers.forEach((h, i) => { item[h] = r[i] || ''; });
        return item;
      });
      const blob = new Blob([JSON.stringify(jsonObj, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'preview_export.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial render
    renderTable();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCsvPreview);
  } else {
    initCsvPreview();
  }
</script>
