---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import DeveloperWorkbench from '@/components/tools/DeveloperWorkbench.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'xpath-tester');
if (!platformTool) throw new Error('Tool not found');

const initialCode = `<?xml version="1.0" encoding="UTF-8"?>
<bookstore>
  <book category="cooking">
    <title lang="en">Everyday Italian</title>
    <author>Giada De Laurentiis</author>
    <year>2005</year>
    <price>30.00</price>
  </book>
  <book category="children">
    <title lang="en">Harry Potter</title>
    <author>J K. Rowling</author>
    <year>2005</year>
    <price>29.99</price>
  </book>
  <book category="web">
    <title lang="en">Learning XML</title>
    <author>Erik T. Ray</author>
    <year>2003</year>
    <price>39.95</price>
  </book>
</bookstore>`;

const faq = [
  {
    question: 'How do I test my XPath?',
    answer: 'Enter your XML document in the left pane, and type your XPath expression in the query box above it. The results will instantly appear on the right.',
  },
  {
    question: 'What XPath version is supported?',
    answer: 'This tool uses your browser\'s native XPath evaluator (DOMParser and document.evaluate), which generally supports XPath 1.0 specifications.',
  },
  {
    question: 'Is my XML sent to a server?',
    answer: 'No. The parsing and XPath evaluation happens entirely locally in your web browser for complete privacy.',
  }
];
---

<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} faq={faq} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="space-y-16">
    <div class="flex flex-col md:flex-row gap-16 items-center justify-between px-8 text-xs font-mono text-muted dark:text-muted-dark">
      <span class="inline-flex items-center gap-6 rounded-pill bg-emerald-500/10 px-12 py-4 font-semibold text-emerald-700 dark:text-emerald-300">
        ✓ Runs locally in your browser
      </span>
      
      <div class="flex-1 w-full md:max-w-2xl">
        <div class="relative flex items-center glass-panel rounded-12 border border-border bg-surface/95 dark:border-border-dark dark:bg-surface-dark/95 shadow-soft focus-within:border-accent dark:focus-within:border-accent-dark focus-within:ring-4 focus-within:ring-accent/10 transition-all">
          <div class="pl-16 pr-8 py-12 text-ink2 dark:text-ink2-dark font-bold font-sans uppercase tracking-wider text-[10px]">
            XPath
          </div>
          <input type="text" id="xpath-query" value="//book[price<35]/title" class="flex-1 w-full py-12 pr-16 bg-transparent border-none outline-none font-mono text-sm text-ink dark:text-ink-dark placeholder:text-muted/50" placeholder="//node/child[@attr='value']" spellcheck="false" />
          <div class="pr-12">
            <span id="match-count" class="text-[10px] font-bold px-8 py-4 rounded bg-surface2 dark:bg-surface2-dark text-muted dark:text-muted-dark hidden">0 matches</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Standard workbench with xpath mode -->
    <DeveloperWorkbench initialCode={initialCode} toolMode="xpath" />
  </div>

  <div slot="content">
    <h2>Test and Evaluate XPath Expressions Instantly</h2>
    <p>XPath (XML Path Language) is a query language used to select nodes from an XML document. Writing complex XPath queries can be difficult without immediate feedback. Our XPath Tester allows you to paste your XML and write queries, seeing the matched nodes or values update in real-time.</p>

    <h3>Common XPath Examples</h3>
    <ul>
      <li><code>//book</code> - Selects all book nodes no matter where they are.</li>
      <li><code>//book[1]</code> - Selects the first book node.</li>
      <li><code>//@lang</code> - Selects all attributes named lang.</li>
      <li><code>//book[price<35]/title</code> - Selects titles of books with a price less than 35.</li>
    </ul>
  </div>
</ToolLayout>

<script>
  function setupXPath() {
    const inputArea = document.getElementById('wb-input-textarea') as HTMLTextAreaElement;
    const outputPre = document.getElementById('wb-output-pre');
    const statusBadge = document.getElementById('wb-status-badge');
    const outputGutter = document.getElementById('wb-output-gutter');
    
    const queryInput = document.getElementById('xpath-query') as HTMLInputElement;
    const matchCount = document.getElementById('match-count');

    const btnFormat = document.getElementById('wb-btn-format');
    const btnMinify = document.getElementById('wb-btn-minify');
    
    // Hide standard JSON buttons
    if (btnFormat) btnFormat.style.display = 'none';
    if (btnMinify) btnMinify.style.display = 'none';

    // Helper to format XML nodes nicely
    function serializeNode(node: Node): string {
      if (node.nodeType === Node.TEXT_NODE) {
        return node.textContent?.trim() || '';
      }
      if (node.nodeType === Node.ATTRIBUTE_NODE) {
        const attr = node as Attr;
        return attr.name + '="' + attr.value + '"';
      }
      const serializer = new XMLSerializer();
      return serializer.serializeToString(node);
    }

    // Basic XML formatter for the output
    function formatXml(xml: string) {
      let formatted = '';
      let reg = new RegExp('(>)(<)(\\\\/*)', 'g');
      xml = xml.replace(reg, '$1\\r\\n$2$3');
      let pad = 0;
      xml.split('\\r\\n').forEach(function(node) {
          let indent = 0;
          if (node.match(new RegExp('.+<\\\\/\\\\w[^>]*>$'))) {
              indent = 0;
          } else if (node.match(new RegExp('^<\\\\/\\\\w'))) {
              if (pad != 0) {
                  pad -= 1;
              }
          } else if (node.match(new RegExp('^<\\\\w[^>]*[^\\\\/]>.*$'))) {
              indent = 1;
          } else {
              indent = 0;
          }

          let padding = '';
          for (let i = 0; i < pad; i++) {
              padding += '  ';
          }
          formatted += padding + node + '\\r\\n';
          pad += indent;
      });
      return formatted.trim();
    }

    function evaluateXPath() {
      if (!inputArea || !outputPre || !queryInput) return;
      const xmlString = inputArea.value;
      const query = queryInput.value;
      
      if (!xmlString || !query) {
        outputPre.textContent = '';
        if (matchCount) matchCount.classList.add('hidden');
        if (outputGutter) outputGutter.innerHTML = '1<br/>';
        if (statusBadge) {
          statusBadge.textContent = 'Waiting for input...';
          statusBadge.className = 'inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-muted bg-surface2 dark:text-muted-dark dark:bg-surface2-dark';
        }
        return;
      }

      try {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlString, "text/xml");

        // Check for parse errors
        const parseError = xmlDoc.getElementsByTagName("parsererror");
        if (parseError.length > 0) {
           throw new Error("Invalid XML document.\\n" + parseError[0].textContent);
        }

        // Evaluate XPath
        // We use ANY_TYPE and let the browser decide
        const result = xmlDoc.evaluate(query, xmlDoc, null, XPathResult.ANY_TYPE, null);
        
        let outputLines = [];
        let count = 0;

        // Determine result type
        switch (result.resultType) {
          case XPathResult.NUMBER_TYPE:
            outputLines.push(String(result.numberValue));
            count = 1;
            break;
          case XPathResult.STRING_TYPE:
            outputLines.push(result.stringValue);
            count = 1;
            break;
          case XPathResult.BOOLEAN_TYPE:
            outputLines.push(String(result.booleanValue));
            count = 1;
            break;
          case XPathResult.UNORDERED_NODE_ITERATOR_TYPE:
          case XPathResult.ORDERED_NODE_ITERATOR_TYPE:
            let node = result.iterateNext();
            while (node) {
              count++;
              let str = serializeNode(node);
              // Prettify if it's an element
              if (node.nodeType === Node.ELEMENT_NODE) {
                str = formatXml(str);
              }
              outputLines.push('<!-- Match ' + count + ' -->\\n' + str);
              node = result.iterateNext();
            }
            break;
        }

        if (count === 0) {
          outputLines.push("No matches found.");
        }

        const finalText = outputLines.join('\\n\\n');
        outputPre.textContent = finalText;
        outputPre.className = 'flex-1 p-12 font-mono text-caption text-emerald-600 dark:text-emerald-400 leading-relaxed whitespace-pre-wrap overflow-y-auto';
        
        if (outputGutter) {
          const outLinesCount = finalText.split(/\r?\n/).length;
          let gutterHTML = '';
          for (let i = 1; i <= outLinesCount; i++) {
            gutterHTML += i + '<br/>';
          }
          outputGutter.innerHTML = gutterHTML;
        }

        if (matchCount) {
          matchCount.textContent = count + ' match' + (count !== 1 ? 'es' : '');
          matchCount.classList.remove('hidden');
          matchCount.className = 'text-[10px] font-bold px-8 py-4 rounded bg-emerald-500/10 text-emerald-700 dark:text-emerald-400';
        }

        if (statusBadge) {
          statusBadge.textContent = '✓ Valid Query';
          statusBadge.className = 'inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-emerald-600 bg-emerald-500/10 dark:text-emerald-400';
        }
      } catch (err: any) {
        outputPre.textContent = err.message;
        outputPre.className = 'flex-1 p-12 font-mono text-caption text-danger dark:text-danger-dark leading-relaxed whitespace-pre-wrap overflow-y-auto';
        
        if (outputGutter) {
          outputGutter.innerHTML = '1<br/>';
        }

        if (matchCount) {
          matchCount.textContent = 'Error';
          matchCount.classList.remove('hidden');
          matchCount.className = 'text-[10px] font-bold px-8 py-4 rounded bg-danger/10 text-danger dark:text-danger-dark';
        }

        if (statusBadge) {
          statusBadge.textContent = 'Invalid Query / XML';
          statusBadge.className = 'inline-flex items-center gap-6 rounded-pill px-8 py-2 font-semibold text-danger bg-danger/10 dark:text-danger-dark';
        }
      }
    }

    if (inputArea) inputArea.addEventListener('input', evaluateXPath);
    if (queryInput) queryInput.addEventListener('input', evaluateXPath);
    
    // Initial run
    setTimeout(evaluateXPath, 50);
  }

  setupXPath();
</script>
