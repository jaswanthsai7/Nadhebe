---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'Dataset Metric & Summary Quantiles Inspector | Nadhebe';
const h1 = 'Dataset Metric Inspector';
const description = 'Inspect numerical dataset distributions, standard deviation, variance, 5-number summary quantiles, and range metrics.';

const faq = [
  {
    question: 'What statistical summary metrics are calculated?',
    answer: 'Sample size, Mean, Median, Min, Max, Range, Variance, Standard Deviation, Q1 (25th percentile), Q3 (75th percentile), and Interquartile Range (IQR).'
  },
  {
    question: 'Is my dataset processed online?',
    answer: 'No, 100% of calculations execute locally in your web browser.'
  }
];
---

<ToolLayout
  toolId="data-analysis-inspector"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="data-analysis-inspector-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- Input Controls -->
      <CalculatorCard title="NUMERICAL DATASET SERIES">
        <div class="space-y-16 font-mono text-caption">
          <div>
            <label class="block font-semibold text-ink dark:text-ink-dark mb-4">Paste Numerical Data Points</label>
            <textarea id="dai-input" rows="14" placeholder="Enter numbers..." class="w-full min-h-[340px] rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-mono focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark">12.5, 14.8, 15.2, 11.9, 14.1, 16.5, 13.7, 14.0, 15.8, 12.1, 14.4, 13.9, 15.0</textarea>
          </div>
        </div>
      </CalculatorCard>

      <!-- Statistical Matrix Output -->
      <ResultCard title="SUMMARY STATISTICS & QUANTILES">
        <div class="space-y-16 font-mono text-caption">
          
          <div class="grid grid-cols-2 gap-12 text-center">
            <div class="p-12 rounded-10 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark">
              <span class="block text-xs text-muted font-bold uppercase mb-4">Sample Mean (&mu;)</span>
              <span id="res-mean" class="text-h3 font-bold text-accent dark:text-accent-dark">14.18</span>
            </div>
            <div class="p-12 rounded-10 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark">
              <span class="block text-xs text-muted font-bold uppercase mb-4">Median (Q2)</span>
              <span id="res-median" class="text-h3 font-bold text-ink dark:text-ink-dark">14.10</span>
            </div>
          </div>

          <div class="p-12 rounded-10 border border-border bg-surface dark:border-border-dark dark:bg-surface-dark space-y-6 text-xs">
            <span class="block font-bold text-ink dark:text-ink-dark uppercase border-b border-border/50 pb-4 dark:border-border-dark/50">5-Number Summary & Variance</span>
            <div class="flex items-center justify-between">
              <span class="text-muted">Sample Size (N):</span>
              <strong id="res-count" class="text-ink dark:text-ink-dark font-bold">13</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">Min / Max Range:</span>
              <strong id="res-min-max" class="text-ink dark:text-ink-dark font-bold">11.90 — 16.50 (Spread: 4.60)</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">Standard Deviation (&sigma;):</span>
              <strong id="res-std" class="text-ink dark:text-ink-dark font-bold">1.25</strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">IQR (Q3 - Q1):</span>
              <strong id="res-iqr" class="text-ink dark:text-ink-dark font-bold">1.90 (13.10 — 15.00)</strong>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>Exploratory Data Analysis & Quantile Summaries</h2>
    <p>
      The 5-number summary (Min, Q1, Median, Q3, Max) provides a robust descriptive overview of numerical distribution shape and dispersion.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputEl = document.getElementById('dai-input');

    const meanEl = document.getElementById('res-mean');
    const medianEl = document.getElementById('res-median');
    const countEl = document.getElementById('res-count');
    const minMaxEl = document.getElementById('res-min-max');
    const stdEl = document.getElementById('res-std');
    const iqrEl = document.getElementById('res-iqr');

    function calculate() {
      const raw = inputEl?.value || '';
      const nums = raw.split(/[\s,]+/).map(Number).filter(n => !isNaN(n));

      if (nums.length === 0) {
        if (meanEl) meanEl.textContent = '0';
        if (medianEl) medianEl.textContent = '0';
        return;
      }

      const n = nums.length;
      const sum = nums.reduce((a, b) => a + b, 0);
      const mean = sum / n;

      const variance = nums.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / n;
      const stdDev = Math.sqrt(variance);

      const sorted = [...nums].sort((a, b) => a - b);
      const min = sorted[0];
      const max = sorted[sorted.length - 1];

      const getPercentile = (p) => {
        const idx = (sorted.length - 1) * p;
        const base = Math.floor(idx);
        const rest = idx - base;
        if (sorted[base + 1] !== undefined) {
          return sorted[base] + rest * (sorted[base + 1] - sorted[base]);
        }
        return sorted[base];
      };

      const q1 = getPercentile(0.25);
      const q2 = getPercentile(0.50);
      const q3 = getPercentile(0.75);
      const iqr = q3 - q1;

      if (meanEl) meanEl.textContent = mean.toFixed(2);
      if (medianEl) medianEl.textContent = q2.toFixed(2);
      if (countEl) countEl.textContent = n.toLocaleString();
      if (minMaxEl) minMaxEl.textContent = `${min.toFixed(2)} — ${max.toFixed(2)} (Spread: ${(max - min).toFixed(2)})`;
      if (stdEl) stdEl.textContent = stdDev.toFixed(2);
      if (iqrEl) iqrEl.textContent = `${iqr.toFixed(2)} (${q1.toFixed(2)} — ${q3.toFixed(2)})`;
    }

    inputEl?.addEventListener('input', calculate);

    calculate();
  })();
</script>
