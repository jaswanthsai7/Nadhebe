---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'OpenAI GPT-4o & O3-Mini API Cost Estimator | Nadhebe';
const h1 = 'OpenAI GPT-4o & O3-Mini API Cost Estimator';
const description = 'Calculate API pricing for OpenAI GPT-4o, GPT-4o-mini, O3-mini, and O1 models. Estimate monthly costs based on input tokens, output tokens, and prompt caching.';

const faq = [
  {
    question: 'What are the current pricing rates for OpenAI GPT-4o?',
    answer: 'GPT-4o costs $2.50 per 1M input tokens ($1.25 per 1M cached input tokens) and $10.00 per 1M output tokens.',
  },
  {
    question: 'How much cheaper is GPT-4o-mini compared to GPT-4o?',
    answer: 'GPT-4o-mini is 16x cheaper for input tokens ($0.15 per 1M input) and 17x cheaper for output tokens ($0.60 per 1M output).',
  },
  {
    question: 'What is Prompt Caching in OpenAI APIs?',
    answer: 'Prompt caching automatically provides a 50% discount on input tokens for prompts longer than 1,024 tokens that reuse identical static prefix contexts.',
  },
  {
    question: 'How do reasoning models (O1, O3-mini) handle output tokens?',
    answer: 'Reasoning models generate internal "reasoning tokens" that count towards output token billing before outputting the final response.',
  },
  {
    question: 'How do batch API discounts work?',
    answer: 'OpenAI Batch API provides a 50% flat discount on input and output tokens for asynchronous workloads completed within 24 hours.',
  },
];
---

<ToolLayout
  toolId="openai-cost-estimator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="openai-cost-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="OPENAI MODEL & TOKEN USAGE">
        <div class="space-y-16">
          <div>
            <label for="oai-select-model" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Select OpenAI Model</label>
            <select
              id="oai-select-model"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption font-medium text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark cursor-pointer font-mono"
            >
              <option value="gpt4o">GPT-4o ($2.50 in / $10.00 out per 1M)</option>
              <option value="gpt4o-mini">GPT-4o-mini ($0.15 in / $0.60 out per 1M)</option>
              <option value="o3-mini">O3-mini Reasoning ($1.10 in / $4.40 out per 1M)</option>
              <option value="o1">O1 Reasoning ($15.00 in / $60.00 out per 1M)</option>
            </select>
          </div>

          <div>
            <label for="oai-input-reqs" class="block text-caption font-semibold text-ink dark:text-ink-dark mb-4">Monthly API Requests</label>
            <input
              id="oai-input-reqs"
              type="number"
              min="100"
              step="1000"
              value="50000"
              class="w-full rounded-8 border border-border bg-surface2 px-12 py-8 text-caption text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono text-sm font-bold"
            />
          </div>

          <div class="grid grid-cols-2 gap-12">
            <div>
              <label for="oai-input-in-tokens" class="block text-xs font-semibold text-ink dark:text-ink-dark mb-4">Input Tokens / Req</label>
              <input id="oai-input-in-tokens" type="number" min="10" step="100" value="1500" class="w-full rounded-8 border border-border bg-surface2 px-8 py-6 text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono" />
            </div>
            <div>
              <label for="oai-input-out-tokens" class="block text-xs font-semibold text-ink dark:text-ink-dark mb-4">Output Tokens / Req</label>
              <input id="oai-input-out-tokens" type="number" min="10" step="100" value="500" class="w-full rounded-8 border border-border bg-surface2 px-8 py-6 text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark font-mono" />
            </div>
          </div>

          <div class="flex items-center gap-8 pt-4">
            <label class="flex items-center gap-8 cursor-pointer text-xs font-sans text-ink dark:text-ink-dark">
              <input id="oai-chk-cached" type="checkbox" checked class="rounded border-border text-accent focus:ring-accent dark:border-border-dark" />
              <span>Enable Prompt Caching (50% discount on cached inputs)</span>
            </label>
          </div>

          <button
            type="button"
            id="btn-calc-oai"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Calculate OpenAI API Cost
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="OPENAI API COST ESTIMATE">
        <div class="space-y-20">
          
          <!-- Summary Metrics Grid -->
          <div class="grid grid-cols-3 gap-8 font-mono text-center">
            <div class="rounded-10 border border-border bg-surface2/60 p-10 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-oai-monthly" class="text-h3 font-bold text-emerald-600 dark:text-emerald-400">$343.75</div>
              <div class="text-[11px] text-muted dark:text-muted-dark uppercase mt-2">Est. Monthly Cost</div>
            </div>
            <div class="rounded-10 border border-border bg-surface2/60 p-10 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-oai-per-req" class="text-h3 font-bold text-accent dark:text-accent-dark">$0.0069</div>
              <div class="text-[11px] text-muted dark:text-muted-dark uppercase mt-2">Cost / Request</div>
            </div>
            <div class="rounded-10 border border-border bg-surface2/60 p-10 dark:border-border-dark dark:bg-surface2-dark/60">
              <div id="stat-oai-tokens-mo" class="text-h3 font-bold text-ink dark:text-ink-dark">100M</div>
              <div class="text-[11px] text-muted dark:text-muted-dark uppercase mt-2">Total Tokens/Mo</div>
            </div>
          </div>

          <!-- Cost Breakdown List -->
          <div class="rounded-12 border border-border bg-surface p-16 shadow-subtle dark:border-border-dark dark:bg-surface-dark space-y-10 font-mono text-xs">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark block mb-4">Cost Distribution</span>
            
            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Input Tokens Cost (75M):</span>
              <span id="stat-oai-incost" class="font-bold text-emerald-600 dark:text-emerald-400">$93.75 / mo</span>
            </div>

            <div class="flex items-center justify-between py-4 border-b border-border/40 dark:border-border-dark/40">
              <span>Output Tokens Cost (25M):</span>
              <span id="stat-oai-outcost" class="font-bold text-accent dark:text-accent-dark">$250.00 / mo</span>
            </div>

            <div class="flex items-center justify-between py-4">
              <span>Annual Equivalent API Spend:</span>
              <span id="stat-oai-annual" class="font-bold text-emerald-600 dark:text-emerald-400">$4,125.00 / yr</span>
            </div>
          </div>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>OpenAI API Pricing & Cost Optimization Guide</h2>
    <p>
      Estimating API costs for OpenAI models is critical when deploying AI features at scale. Rates vary dramatically depending on whether you use flagship models (GPT-4o), lightweight models (GPT-4o-mini), or reasoning models (O1 / O3-mini).
    </p>

    <h3>OpenAI Official Pricing Rates (per 1,000,000 Tokens)</h3>
    <ul>
      <li><strong>GPT-4o</strong>: $2.50 Input / $1.25 Cached Input / $10.00 Output</li>
      <li><strong>GPT-4o-mini</strong>: $0.15 Input / $0.075 Cached Input / $0.60 Output</li>
      <li><strong>O3-mini</strong>: $1.10 Input / $0.55 Cached Input / $4.40 Output</li>
      <li><strong>O1</strong>: $15.00 Input / $7.50 Cached Input / $60.00 Output</li>
    </ul>

    <h3>Related AI Developer Tools</h3>
    <p>
      Compare AI provider pricing with our <a href="/tools/ai-api-pricing-calculator/">AI API Pricing Calculator</a>, count BPE tokens with the <a href="/tools/llm-tokenizer/">LLM BPE Tokenizer</a>, or calculate batch inference discounts with the <a href="/tools/batch-inference-cost-estimator/">Batch Inference Estimator</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const selectModel = document.getElementById('oai-select-model');
    const inputReqs = document.getElementById('oai-input-reqs');
    const inputIn = document.getElementById('oai-input-in-tokens');
    const inputOut = document.getElementById('oai-input-out-tokens');
    const chkCached = document.getElementById('oai-chk-cached');
    const btnCalc = document.getElementById('btn-calc-oai');

    const pricing = {
      'gpt4o': { in: 2.50, out: 10.00 },
      'gpt4o-mini': { in: 0.15, out: 0.60 },
      'o3-mini': { in: 1.10, out: 4.40 },
      'o1': { in: 15.00, out: 60.00 }
    };

    const statMonthly = document.getElementById('stat-oai-monthly');
    const statPerReq = document.getElementById('stat-oai-per-req');
    const statTotalTok = document.getElementById('stat-oai-tokens-mo');
    const statInCost = document.getElementById('stat-oai-incost');
    const statOutCost = document.getElementById('stat-oai-outcost');
    const statAnnual = document.getElementById('stat-oai-annual');

    function calculate() {
      const model = selectModel?.value || 'gpt4o';
      const reqs = parseInt(inputReqs?.value || '50000', 10);
      const inToks = parseInt(inputIn?.value || '1500', 10);
      const outToks = parseInt(inputOut?.value || '500', 10);
      const isCached = chkCached?.checked ?? true;

      const rates = pricing[model] || pricing['gpt4o'];
      const effectiveInRate = isCached ? rates.in * 0.5 : rates.in;

      const totalInM = (reqs * inToks) / 1000000;
      const totalOutM = (reqs * outToks) / 1000000;

      const monthlyInCost = totalInM * effectiveInRate;
      const monthlyOutCost = totalOutM * rates.out;
      const totalMonthly = monthlyInCost + monthlyOutCost;

      const costPerReq = reqs > 0 ? (totalMonthly / reqs) : 0;
      const totalToksM = totalInM + totalOutM;

      if (statMonthly) statMonthly.textContent = `$${totalMonthly.toFixed(2)}`;
      if (statPerReq) statPerReq.textContent = `$${costPerReq.toFixed(4)}`;
      if (statTotalTok) statTotalTok.textContent = `${totalToksM.toFixed(1)}M`;

      if (statInCost) statInCost.textContent = `$${monthlyInCost.toFixed(2)} / mo`;
      if (statOutCost) statOutCost.textContent = `$${monthlyOutCost.toFixed(2)} / mo`;
      if (statAnnual) statAnnual.textContent = `$${(totalMonthly * 12).toFixed(2)} / yr`;
    }

    btnCalc?.addEventListener('click', calculate);
    [selectModel, inputReqs, inputIn, inputOut, chkCached].forEach(el => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    calculate();
  })();
</script>
