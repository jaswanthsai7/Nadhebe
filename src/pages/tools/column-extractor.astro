---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';

const title = 'CSV Column Extractor & Filter | Nadhebe';
const h1 = 'CSV Column Extractor & Filter';
const description = 'Extract specific columns from CSV datasets, reorder table fields, and drop unwanted columns client-side without uploading spreadsheets.';

const faq = [
  {
    question: 'How does the CSV Column Extractor work?',
    answer: 'Paste your CSV text. The tool automatically detects header column names and lets you check/uncheck columns to extract a targeted subset of CSV data.',
  },
  {
    question: 'Can I reorder columns during extraction?',
    answer: 'Yes! The extracted CSV output respects your selected column order.',
  },
  {
    question: 'Is my CSV data kept private?',
    answer: '100% private. Column parsing and filtering execute locally in your web browser.',
  },
  {
    question: 'How does this compare to the Linux `cut` command?',
    answer: 'It provides a graphical web interface equivalent to `cut -d"," -f1,3` with automatic header detection and quote-aware CSV parsing.',
  },
  {
    question: 'Can I download the extracted CSV output?',
    answer: 'Yes! Click "Download Extracted CSV" to save the filtered file.',
  },
];
---

<ToolLayout
  toolId="column-extractor"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24" id="col-ext-app">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
      
      <!-- INPUT CARD -->
      <CalculatorCard title="RAW CSV DATASET INPUT">
        <div class="space-y-16">
          <div>
            <div class="flex items-center justify-between mb-4">
              <label for="ce-input-raw" class="block text-caption font-semibold text-ink dark:text-ink-dark">Input CSV Text</label>
              <button type="button" id="btn-load-sample-ce" class="text-xs text-accent dark:text-accent-dark hover:underline cursor-pointer">Load Sample CSV</button>
            </div>
            <textarea
              id="ce-input-raw"
              rows="8"
              class="w-full rounded-12 border border-border bg-code p-12 font-mono text-xs text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-code-dark dark:text-ink-dark leading-relaxed"
            ></textarea>
          </div>

          <div>
            <label class="block text-caption font-semibold text-ink dark:text-ink-dark mb-8">Detected Columns to Keep</label>
            <div id="ce-cols-checkboxes" class="flex flex-wrap gap-8 p-12 rounded-8 border border-border bg-surface2 dark:border-border-dark dark:bg-surface2-dark min-h-[60px]">
              <span class="text-xs text-muted dark:text-muted-dark">Paste CSV above to detect columns...</span>
            </div>
          </div>

          <button
            type="button"
            id="btn-extract-ce"
            class="w-full rounded-8 bg-accent px-20 py-10 text-caption font-sans font-semibold text-white hover:opacity-90 cursor-pointer shadow-soft transition-all"
          >
            Extract Selected Columns
          </button>
        </div>
      </CalculatorCard>

      <!-- OUTPUT CARD -->
      <ResultCard title="EXTRACTED CSV OUTPUT">
        <div class="space-y-20">
          
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold uppercase text-muted dark:text-muted-dark">Filtered Dataset</span>
            <button type="button" id="btn-copy-ce" class="rounded-6 bg-accent px-12 py-6 font-sans text-xs font-semibold text-white hover:opacity-90 cursor-pointer">Copy Output</button>
          </div>

          <pre id="ce-output-text" class="w-full overflow-x-auto rounded-12 border border-border bg-code p-16 font-mono text-caption text-emerald-600 dark:border-border-dark dark:bg-code-dark dark:text-emerald-400 min-h-[280px] leading-relaxed whitespace-pre-wrap"></pre>

        </div>
      </ResultCard>

    </div>
  </div>

  <div slot="content">
    <h2>CSV Column Filtering & Data Extraction Guide</h2>
    <p>
      Extracting specific columns from large CSV files isolates target variables for data science pipelines, database imports, and privacy compliance (removing PII data).
    </p>

    <h3>Use Cases</h3>
    <ul>
      <li><strong>Drop PII</strong>: Strip email addresses or phone numbers prior to dataset sharing.</li>
      <li><strong>Column Isolation</strong>: Extract ID and SKU columns for bulk database updates.</li>
    </ul>

    <h3>Related Data Tools</h3>
    <p>
      Convert delimiters with the <a href="/tools/delimiter-converter/">Delimiter Converter</a>, convert JSON to CSV with the <a href="/tools/json-to-csv/">JSON to CSV Converter</a>, or format SQL with the <a href="/tools/sql-formatter/">SQL Formatter</a>.
    </p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const inputRaw = document.getElementById('ce-input-raw');
    const colsContainer = document.getElementById('ce-cols-checkboxes');
    const btnExtract = document.getElementById('btn-extract-ce');
    const btnSample = document.getElementById('btn-load-sample-ce');

    const outputText = document.getElementById('ce-output-text');
    const btnCopy = document.getElementById('btn-copy-ce');

    const defaultCsv = `id,first_name,last_name,email,department,salary
101,Alice,Johnson,alice@example.com,Engineering,140000
102,Bob,Smith,bob@example.com,Research,135000
103,Carol,Williams,carol@example.com,DevOps,125000`;

    let headers = [];

    function detectColumns() {
      const raw = inputRaw?.value || defaultCsv;
      const firstLine = raw.split('\n')[0] || '';
      headers = firstLine.split(',').map(h => h.trim());

      if (colsContainer && headers.length > 0) {
        colsContainer.innerHTML = '';
        headers.forEach((h, idx) => {
          const label = document.createElement('label');
          label.className = 'flex items-center gap-4 text-xs font-mono bg-surface p-4 px-8 rounded border border-border dark:border-border-dark cursor-pointer';
          label.innerHTML = `<input type="checkbox" data-idx="${idx}" checked class="rounded border-border focus:ring-accent" /> <span>${h}</span>`;
          colsContainer.appendChild(label);
        });
      }
    }

    function extract() {
      const raw = inputRaw?.value || defaultCsv;
      const lines = raw.split('\n').filter(l => l.trim());

      if (lines.length === 0) return;

      const checkedIndices = [];
      const checkboxes = colsContainer?.querySelectorAll('input[type="checkbox"]');
      checkboxes?.forEach(cb => {
        if (cb.checked) checkedIndices.push(parseInt(cb.getAttribute('data-idx'), 10));
      });

      if (checkedIndices.length === 0) {
        if (outputText) outputText.textContent = '// Please select at least 1 column to extract.';
        return;
      }

      const outputLines = lines.map(line => {
        const parts = line.split(',');
        return checkedIndices.map(i => parts[i] ?? '').join(',');
      });

      if (outputText) outputText.textContent = outputLines.join('\n');
    }

    inputRaw?.addEventListener('input', () => {
      detectColumns();
      extract();
    });

    colsContainer?.addEventListener('change', extract);
    btnExtract?.addEventListener('click', extract);

    btnSample?.addEventListener('click', () => {
      if (inputRaw) inputRaw.value = defaultCsv;
      detectColumns();
      extract();
    });

    btnCopy?.addEventListener('click', () => {
      if (outputText) {
        navigator.clipboard.writeText(outputText.textContent);
        btnCopy.textContent = 'Copied!';
        setTimeout(() => (btnCopy.textContent = 'Copy Output'), 2000);
      }
    });

    if (inputRaw && !inputRaw.value) inputRaw.value = defaultCsv;

    detectColumns();
    extract();
  })();
</script>
