---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import { UNIFIED_TOOLS_REGISTRY } from '@/config/tools-registry';

const platformTool = UNIFIED_TOOLS_REGISTRY.find(t => t.slug === 'cron-next-run-viewer');
if (!platformTool) throw new Error('Tool not found');

const faq = [
  {
    question: 'How do cron expressions work?',
    answer: 'A cron expression is a string consisting of five or six fields separated by white space that represents a set of times, normally as a schedule to execute some routine. The standard five fields are: Minute (0-59), Hour (0-23), Day of Month (1-31), Month (1-12), and Day of Week (0-6).',
  },
  {
    question: 'What do the special characters mean?',
    answer: 'The asterisk (*) means "every", the slash (/) specifies increments (e.g. */5 for every 5 minutes), the comma (,) separates items in a list, and the hyphen (-) specifies a range.',
  },
  {
    question: 'Is my cron string sent to a server?',
    answer: 'No. The cron expression is parsed entirely in your browser using JavaScript. We do not upload your data.',
  }
];
---

<ToolLayout toolId={platformTool.slug} title={platformTool.seo?.title || platformTool.title} h1={platformTool.name} description={platformTool.seo?.description || platformTool.description} faq={faq} relatedCategory={platformTool.category} relatedTools={[]}>
  <div slot="calculator" class="max-w-3xl mx-auto space-y-16 py-16">
    <div class="flex items-center justify-center text-xs font-mono text-muted dark:text-muted-dark mb-16">
      <span class="inline-flex items-center gap-6 rounded-pill bg-emerald-500/10 px-12 py-4 font-semibold text-emerald-700 dark:text-emerald-300">
        ✓ Runs locally in your browser
      </span>
    </div>

    <!-- Main Input Box -->
    <div class="glass-panel p-24 md:p-32 rounded-24 border border-border bg-surface/95 dark:border-border-dark dark:bg-surface-dark/95 shadow-large relative z-20 overflow-hidden group transition-all focus-within:border-accent dark:focus-within:border-accent-dark focus-within:ring-4 focus-within:ring-accent/10">
       <label class="block text-sm font-sans font-semibold text-ink2 dark:text-ink2-dark mb-12 uppercase tracking-wider text-center">Cron Expression</label>
       <div class="flex items-center justify-center">
         <input type="text" id="cron-input" value="*/15 * * * *" class="w-full max-w-lg p-16 text-center border-b-2 border-border bg-transparent focus:border-accent dark:border-border-dark dark:bg-transparent text-2xl md:text-4xl font-mono text-ink dark:text-ink-dark transition-all outline-none tracking-widest placeholder:text-muted/40" placeholder="* * * * *" />
       </div>
    </div>

    <!-- Output Box -->
    <div class="glass-panel p-24 md:p-32 rounded-24 border border-border bg-surface/95 dark:border-border-dark dark:bg-surface-dark/95 shadow-medium relative z-20">
       <div class="text-center space-y-24">
         <div class="space-y-8">
           <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Human Readable</h3>
           <p id="cron-human" class="text-xl md:text-2xl font-semibold text-accent dark:text-accent-dark">Every 15 minutes</p>
         </div>
         
         <div class="h-px w-full bg-border/50 dark:bg-border-dark/50 my-16"></div>
         
         <div class="space-y-12">
           <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-ink2 dark:text-ink2-dark">Next Scheduled Runs</h3>
           <ul id="cron-next" class="font-mono text-sm md:text-base text-ink dark:text-ink-dark space-y-8 inline-block text-left">
             <li>Loading...</li>
           </ul>
         </div>
       </div>
    </div>
  </div>

  <div slot="content">
    <h2>Understand and Test Cron Expressions</h2>
    <p>A Cron expression is a powerful way to define recurring schedules for automated tasks, backups, and deployments. However, the syntax can be tricky to read and verify. Our Cron Explainer translates standard cron strings into plain English and computes the next scheduled execution times instantly.</p>

    <h3>Supported Cron Formats</h3>
    <ul>
      <li>Standard 5-field cron (minute, hour, day of month, month, day of week)</li>
      <li>Second-level precision (6 fields)</li>
      <li>Lists (<code>1,15,30</code>)</li>
      <li>Ranges (<code>1-5</code>)</li>
      <li>Step values (<code>*/10</code>)</li>
    </ul>
  </div>
</ToolLayout>

<script>
  import cronstrue from 'cronstrue';
  import { CronExpressionParser } from "cron-parser";

  function setupCron() {
    const input = document.getElementById('cron-input') as HTMLInputElement;
    const outHuman = document.getElementById('cron-human');
    const outNext = document.getElementById('cron-next');
    
    function update() {
      if (!input || !outHuman || !outNext) return;
      const val = input.value.trim();
      
      if (!val) {
        outHuman.textContent = 'Waiting for expression...';
        outHuman.className = 'text-xl md:text-2xl font-semibold text-muted dark:text-muted-dark';
        outNext.innerHTML = '<li class="text-muted dark:text-muted-dark">No next runs to display</li>';
        return;
      }
      
      try {
        // 1. Get Human Readable
        const human = cronstrue.toString(val, { throwExceptionOnParseError: true });
        outHuman.textContent = `"${human}"`;
        outHuman.className = 'text-xl md:text-2xl font-semibold text-emerald-600 dark:text-emerald-400';
        
        // 2. Get Next Runs
        const interval = CronExpressionParser.parse(val);
        let nextHtml = '';
        for (let i = 0; i < 5; i++) {
          const nextDate = interval.next();
          // Format elegantly
          const d = nextDate.toDate();
          const str = d.toLocaleString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
          nextHtml += `<li class="flex items-center gap-12 py-4"><span class="w-24 text-right text-xs font-bold text-accent dark:text-accent-dark opacity-80">${i+1}.</span> <span>${str}</span></li>`;
        }
        outNext.innerHTML = nextHtml;
        
      } catch (err: any) {
        outHuman.textContent = 'Invalid Cron Expression';
        outHuman.className = 'text-xl md:text-2xl font-semibold text-danger dark:text-danger-dark';
        outNext.innerHTML = `<li class="text-danger dark:text-danger-dark text-xs">${err.toString()}</li>`;
      }
    }
    
    if (input) input.addEventListener('input', update);
    update();
  }
  
  setupCron();
</script>
