---
import ToolLayout from '@/components/tools/ToolLayout.astro';
import CalculatorCard from '@/components/tools/CalculatorCard.astro';
import ResultCard from '@/components/tools/ResultCard.astro';
import VisualizerCanvas from '@/components/tools/VisualizerCanvas.astro';
import CodeSnippet from '@/components/tools/CodeSnippet.astro';

const title = '16:9 Dimensions Calculator – Widescreen Video Resolutions | Nadhebe';
const h1 = '16:9 Dimensions Calculator';
const description = 'Calculate exact 16:9 widescreen dimensions for videos, monitors, and digital displays by entering width or height.';

const faq = [
  {
    question: 'What are standard 16:9 resolutions?',
    answer: 'Standard 16:9 resolutions include 1280×720 (720p HD), 1920×1080 (1080p Full HD), 2560×1440 (1440p 2K), 3840×2160 (4K UHD), and 7680×4320 (8K UHD). These are the primary tiers used by YouTube, broadcast TV, PC gaming, and streaming platforms.',
  },
  {
    question: 'How do you calculate 16:9 height from a custom width?',
    answer: 'Multiply width by 9, then divide by 16. For example, for width 1920: (1920 × 9) / 16 = 1080 px. Round to the nearest integer for non-standard widths.',
  },
  {
    question: 'Why is 16:9 the standard for video?',
    answer: '16:9 became the global standard through the ITU-R BT.709 specification for HDTV in the 1990s. It offers a wider field of view than 4:3 for natural scenes and cinema, while still fitting comfortably on rectangular screens. All modern monitors, TVs, YouTube, and streaming platforms use 16:9.',
  },
  {
    question: 'What happens if I upload a non-16:9 video to YouTube?',
    answer: 'YouTube automatically adds black bars (letterboxing or pillarboxing) to fill the 16:9 player frame. The video itself is not cropped. To avoid black bars on standard uploads, ensure your video dimensions are exactly 16:9.',
  },
  {
    question: 'What is the difference between 16:9 and 16:10?',
    answer: '16:10 (1.6:1) was popular for widescreen laptops in the 2000s and is still used in some professional monitors. It is slightly taller than 16:9 (1.778:1), providing more vertical working space. 16:10 monitors (like 2560×1600) display 16:9 video with small letterbox bars.',
  },
];
---

<ToolLayout
  toolId="16-9-dimensions-calculator"
  title={title}
  h1={h1}
  description={description}
  faq={faq}
>
  <div slot="calculator" class="space-y-24">
    <!-- Presets -->
    <div class="flex flex-wrap items-center gap-8 rounded-16 border border-border/80 bg-surface/80 p-16 dark:border-border-dark/80 dark:bg-surface-dark/80" data-reveal>
      <span class="text-caption font-mono uppercase text-muted dark:text-muted-dark mr-8">Widescreen Presets:</span>
      <button type="button" data-w169="1280" class="btn-169 rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">720p (1280×720)</button>
      <button type="button" data-w169="1920" class="btn-169 rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">1080p (1920×1080)</button>
      <button type="button" data-w169="2560" class="btn-169 rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">1440p (2560×1440)</button>
      <button type="button" data-w169="3840" class="btn-169 rounded-8 border border-border bg-surface2 px-12 py-6 text-caption font-mono font-medium hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:hover:border-accent-dark cursor-pointer transition-all">4K UHD (3840×2160)</button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-24 items-start">
      <!-- Calculator Inputs & Code Snippet (Left Column) -->
      <div class="lg:col-span-6 space-y-24">
        <CalculatorCard title="Enter Width or Height">
          <div class="space-y-20">
            <div>
              <label for="w169-input" class="block text-caption font-sans font-medium text-ink dark:text-ink-dark mb-6">Width (px)</label>
              <input type="number" id="w169-input" value="1920" min="1" max="100000" class="w-full rounded-12 border border-border bg-surface px-16 py-12 text-h2 font-mono font-bold text-accent focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-accent-dark dark:focus:border-accent-dark transition-all" />
            </div>

            <div class="text-center font-mono text-caption text-muted dark:text-muted-dark font-semibold">OR</div>

            <div>
              <label for="h169-input" class="block text-caption font-sans font-medium text-ink dark:text-ink-dark mb-6">Height (px)</label>
              <input type="number" id="h169-input" value="1080" min="1" max="100000" class="w-full rounded-12 border border-border bg-surface px-16 py-12 text-h2 font-mono font-bold text-ink focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-ink-dark dark:focus:border-accent-dark transition-all" />
            </div>
          </div>
        </CalculatorCard>

        <CodeSnippet
          title="Developer & Creator Code Snippets"
          cssSnippet="aspect-ratio: 16 / 9;"
          tailwindSnippet="aspect-video"
          htmlSnippet='<iframe width="1920" height="1080" style="aspect-ratio: 16 / 9;"></iframe>'
          id="code-169"
        />
      </div>

      <!-- Visualizer & Results (Right Column) -->
      <div class="lg:col-span-6 space-y-24">
        <VisualizerCanvas width={16} height={9} ratioLabel="16:9 Widescreen" id="viz-169" />

        <CalculatorCard title="16:9 Calculated Dimensions">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-16 mb-20">
            <ResultCard label="16:9 Resolution" value="1920 × 1080" id="res-169-dim" accent copyable />
            <ResultCard label="Decimal Ratio" value="1.7778" id="res-169-dec" copyable={false} />
            <ResultCard label="Total Pixels" value="2,073,600" id="res-169-total" copyable />
            <ResultCard label="Megapixels" value="2.07 MP" id="res-169-mp" copyable />
          </div>
        </CalculatorCard>
      </div>
    </div>
  </div>

  <div slot="content">
    <h2>16:9 Aspect Ratio — Standard, Formula & Use Cases</h2>
    <p>
      16:9 is the universal standard aspect ratio for video production, broadcasting, YouTube uploads, and computer displays. It replaced 4:3 as the global TV and monitor standard after HDTV adoption in the early 2000s.
    </p>

    <p class="my-16">
      To view the complete widescreen resolution chart from 360p through 8K with total pixel counts and display standards, check our <a href="/tools/reference/16-9-resolution-chart/">16:9 Widescreen Resolution Reference Chart</a>.
    </p>

    <h3>When to use this calculator</h3>
    <ul>
      <li>Find the correct height for a custom video width before exporting from Premiere, DaVinci Resolve, or Final Cut</li>
      <li>Verify YouTube upload dimensions (1080p = 1920×1080, 4K = 3840×2160)</li>
      <li>Set canvas dimensions in Figma, Canva, or Photoshop for a video thumbnail template</li>
      <li>Calculate correct embed dimensions for a responsive 16:9 iframe or video player</li>
      <li>Convert a non-standard width to the nearest valid 16:9 height for a display or projector</li>
    </ul>

    <h3>Mathematical formula</h3>
    <pre><code>Height = (Width × 9) / 16
Width  = (Height × 16) / 9</code></pre>

    <h3>Standard 16:9 resolution tiers</h3>
    <ul>
      <li><strong>720p HD</strong> — 1280×720 — Minimum for YouTube monetization</li>
      <li><strong>1080p FHD</strong> — 1920×1080 — Standard broadcast and streaming quality</li>
      <li><strong>1440p 2K</strong> — 2560×1440 — High-end gaming monitors and YouTube HDR</li>
      <li><strong>4K UHD</strong> — 3840×2160 — Maximum YouTube quality, 4K TVs</li>
      <li><strong>8K UHD</strong> — 7680×4320 — Future-proof archival and cinema production</li>
    </ul>

    <h3>Related tools</h3>
    <p>For vertical video (TikTok, Reels, Shorts), use the <a href="/tools/9-16-dimensions-calculator/">9:16 Dimensions Calculator</a>. To check your video’s aspect ratio from any resolution, use the <a href="/tools/aspect-ratio-calculator/">Aspect Ratio Calculator</a>.</p>
  </div>
</ToolLayout>

<script is:inline>
  (function() {
    const wInput = document.getElementById('w169-input');
    const hInput = document.getElementById('h169-input');
    const btns = document.querySelectorAll('.btn-169');

    const resDim = document.getElementById('res-169-dim');
    const resDec = document.getElementById('res-169-dec');
    const resTotal = document.getElementById('res-169-total');
    const resMp = document.getElementById('res-169-mp');

    function calculate(source) {
      let w = Math.min(Math.abs(parseFloat(wInput?.value || '0')), 100000);
      let h = Math.min(Math.abs(parseFloat(hInput?.value || '0')), 100000);

      if (source === 'w' && w > 0) {
        h = Math.round((w * 9) / 16);
        if (hInput) hInput.value = String(h);
      } else if (source === 'h' && h > 0) {
        w = Math.round((h * 16) / 9);
        if (wInput) wInput.value = String(w);
      }

      if (w <= 0 || h <= 0) return;

      const total = w * h;
      const mp = (total / 1000000).toFixed(2);

      if (resDim) resDim.textContent = `${w} × ${h}`;
      if (resDec) resDec.textContent = (w / h).toFixed(4);
      if (resTotal) resTotal.textContent = total.toLocaleString('en-US');
      if (resMp) resMp.textContent = `${mp} MP`;

      // Update right visualizer canvas labels & box shape
      const vizDims = document.getElementById('viz-169-dims-label');
      const vizBadge = document.getElementById('viz-169-badge');
      const vizText = document.getElementById('viz-169-text');
      const vizRect = document.getElementById('viz-169-rect');

      if (vizDims) vizDims.textContent = `${w} × ${h}`;
      if (vizBadge) vizBadge.textContent = `16:9 (${w}×${h})`;
      if (vizText) vizText.textContent = `16:9 (${w}×${h})`;

      if (vizRect) {
        const maxW = 260;
        const maxH = 200;
        const scale = Math.min(maxW / w, maxH / h);
        const boxW = Math.max(50, Math.round(w * scale));
        const boxH = Math.max(50, Math.round(h * scale));
        vizRect.style.width = `${boxW}px`;
        vizRect.style.height = `${boxH}px`;
      }
    }

    wInput?.addEventListener('input', () => calculate('w'));
    hInput?.addEventListener('input', () => calculate('h'));

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-w169') || '1920';
        if (wInput) wInput.value = val;
        calculate('w');
      });
    });

    calculate('w');
  })();
</script>
