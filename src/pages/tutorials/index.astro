---
import { getAllArticles } from '../../utils/content';
import CategoryLayout from '../../layouts/CategoryLayout.astro';

const allArticles = await getAllArticles();
const posts = allArticles.filter(p => p.collection === 'tutorials' || p.data.category?.toLowerCase() === 'tutorials');
---

<CategoryLayout categoryName="Tutorials" posts={posts} allPosts={allArticles} />
