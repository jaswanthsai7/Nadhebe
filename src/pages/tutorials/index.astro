---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';

const posts = await getCollection('tutorials');
const sorted = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Tutorials - Nadhebe"
  description="Browse our in-depth guides and tutorials on AI and development."
>
  <div class="mx-auto max-w-6xl px-24 py-48 sm:py-64" data-reveal>
    <div class="border-b border-border dark:border-border-dark pb-16 mb-24">
      <p class="text-meta font-sans font-semibold text-accent dark:text-accent-dark uppercase tracking-wider mb-8">Category Feed</p>
      <h1 class="font-display text-h1 sm:text-display font-bold text-ink dark:text-ink-dark leading-tight">AI Tutorials</h1>
    </div>

    <FeedList posts={sorted} />
  </div>
</BaseLayout>
