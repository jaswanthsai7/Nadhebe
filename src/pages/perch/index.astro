<!-- Client Hydration & Interactive Logic -->
<script is:inline>
  function initPerchPage() {
    // 1. Highlight Video Play/Pause & Mute Controls
    var video = document.getElementById('perch-highlight-video');
    var playBtn = document.getElementById('perch-video-play-btn');
    var playIcon = document.getElementById('play-btn-icon');
    var playText = document.getElementById('play-btn-text');
    var muteBtn = document.getElementById('perch-video-mute-btn');
    var muteIcon = document.getElementById('mute-btn-icon');
    var muteText = document.getElementById('mute-btn-text');

    if (video && playBtn && playIcon && playText && !playBtn.dataset.hasListener) {
      playBtn.dataset.hasListener = 'true';
      playBtn.addEventListener('click', function() {
        if (video.paused) {
          video.play();
          playIcon.textContent = '⏸';
          playText.textContent = 'Pause';
        } else {
          video.pause();
          playIcon.textContent = '▶';
          playText.textContent = 'Play';
        }
      });
    }

    if (video && muteBtn && muteIcon && muteText && !muteBtn.dataset.hasListener) {
      muteBtn.dataset.hasListener = 'true';
      muteBtn.addEventListener('click', function() {
        video.muted = !video.muted;
        if (video.muted) {
          muteIcon.textContent = '🔇';
          muteText.textContent = 'Unmute';
        } else {
          muteIcon.textContent = '🔊';
          muteText.textContent = 'Mute';
        }
      });
    }

    // 2. Full-Screen Transparent ASCII Sharks on Main Screen (Zero Black Background)
    var mainOceanCanvas = document.getElementById('main-screen-ascii-ocean');
    if (mainOceanCanvas && typeof window.OceanEngine === 'function') {
      if (window.__mainOceanEngine) {
        window.__mainOceanEngine.destroy();
      }
      var cfg = typeof window.defaultConfig === 'function' ? window.defaultConfig() : {};
      cfg.transparent = true;
      cfg.background = 'transparent';
      cfg.showGrid = false;
      cfg.wakeRGB = [2, 132, 199];      // Perchboard cyan wake ripples
      cfg.speed = 1.1;
      cfg.interactive = true;

      // Exactly 2 sharks: 1 Hammerhead, 1 Classic
      var sharks = [
        { kind: 'hammerhead', size: 1.2 },
        { kind: 'classic', size: 1.0 }
      ];

      // fishCount = 0 (removes all fish dashes completely)
      window.__mainOceanEngine = new window.OceanEngine(mainOceanCanvas, sharks, 0, cfg);
    }

    // 3. Waitlist Popup Modal Trigger & Accessible Controls
    var modal = document.getElementById('waitlist-modal');
    var modalCloseBtn = document.getElementById('close-waitlist-modal-btn');
    var modalEmailInput = modal ? modal.querySelector('input[type="email"]') : null;

    function openWaitlistModal(platform) {
      if (!modal) return;
      if (platform && modal) {
        var modalForm = modal.querySelector('form');
        if (modalForm) modalForm.setAttribute('data-platform', platform);
      }
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      setTimeout(function() {
        if (modalEmailInput) modalEmailInput.focus();
      }, 60);
    }

    function closeWaitlistModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Attach click triggers to all buttons with .open-waitlist-modal
    var openBtns = document.querySelectorAll('.open-waitlist-modal');
    openBtns.forEach(function(btn) {
      if (btn.dataset.hasModalListener) return;
      btn.dataset.hasModalListener = 'true';
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var platform = btn.getAttribute('data-platform') || 'windows';
        openWaitlistModal(platform);
      });
    });

    if (modalCloseBtn && !modalCloseBtn.dataset.hasCloseListener) {
      modalCloseBtn.dataset.hasCloseListener = 'true';
      modalCloseBtn.addEventListener('click', closeWaitlistModal);
    }

    if (modal && !modal.dataset.hasBackdropListener) {
      modal.dataset.hasBackdropListener = 'true';
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeWaitlistModal();
      });
    }

    if (!window.__perchKeydownAttached) {
      window.__perchKeydownAttached = true;
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          var curModal = document.getElementById('waitlist-modal');
          if (curModal && !curModal.classList.contains('hidden')) {
            closeWaitlistModal();
          }
        }
      });
    }

    // Auto-dismiss modal after 2.5s on successful submission
    window.addEventListener('nadhebe:subscribed', function() {
      setTimeout(function() {
        closeWaitlistModal();
      }, 2500);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPerchPage);
  } else {
    initPerchPage();
  }
  document.addEventListener('astro:page-load', initPerchPage);
</script>
