---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Subscribe from '@/components/Subscribe.astro';
import { SITE } from '@/config';
import { buildSeo } from '@/utils/seo';

const canonicalUrl = `${SITE.url}/perch/`;

const seo = buildSeo({
  title: 'Perchboard: Floating Windows Clipboard Panel & Shelf | Nadhebe',
  description: 'Perchboard is a compact Windows desktop utility with a floating clipboard panel along the screen edge for instant access to copied text, links, images, and files.',
  slug: '/perch/',
  siteUrl: SITE.url,
  siteName: SITE.name,
  image: '/perch/perch-desktop-hero.png',
  keywords: [
    'Perchboard',
    'Windows clipboard manager',
    'floating clipboard shelf',
    'screen edge clipboard',
    'desktop clipboard utility',
    'local first clipboard',
    'Windows 11 clipboard app',
    'clipboard history search',
    'Nadhebe Lab'
  ],
});

// JSON-LD Structured Data: WebApplication, WebPage, FAQPage, BreadcrumbList, VideoObject
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Perchboard',
  operatingSystem: 'Windows 10, Windows 11',
  applicationCategory: 'UtilitiesApplication',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/PreOrder'
  },
  author: {
    '@type': 'Organization',
    name: 'Nadhebe',
    url: SITE.url
  },
  description: 'Compact Windows desktop utility that keeps your clipboard content close at hand, featuring a floating screen-edge panel for revisiting text, links, images, and files.',
  screenshot: `${SITE.url}/perch/perch-desktop-hero.png`
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Lab',
      item: `${SITE.url}/lab/`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Perchboard',
      item: canonicalUrl
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Perchboard?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Perchboard is a compact Windows desktop utility created by Nadhebe. It keeps your clipboard history accessible from a floating panel anchored to the edge of your desktop screen, avoiding full-screen window clutter while preserving fast access to copied content.'
      }
    },
    {
      '@type': 'Question',
      name: 'How does the floating clipboard panel work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Perchboard anchors a slim, unobtrusive clipboard shelf directly against your chosen screen edge (right edge, left edge, or top). It remains readily accessible while you work across other applications, allowing you to quickly inspect, copy, and reuse recently captured items.'
      }
    },
    {
      '@type': 'Question',
      name: 'What types of content does it show?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Perchboard captures and organizes multiple clipboard formats into dedicated filter tabs: All, Text snippets, Links and URLs, Images with high-resolution visual previews, and Files.'
      }
    },
    {
      '@type': 'Question',
      name: 'When will the Windows version launch?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Windows build is currently in active development and early testing. Sign up for the waitlist to receive private beta invitations and launch notification emails as soon as the initial release is ready.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is an iOS version planned?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. While Windows is the initial launch platform, an iOS companion is in planning. You can select iOS or Both when submitting the waitlist form to be notified when iOS testing begins.'
      }
    },
    {
      '@type': 'Question',
      name: 'How do I join the waitlist?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Enter your email address in the waitlist section on this page, choose your preferred platform (Windows, iOS, or Both), and click "Get early access". You will receive an immediate confirmation and priority access upon launch.'
      }
    },
    {
      '@type': 'Question',
      name: 'What will Perchboard cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pricing details and licensing tiers will be formally confirmed prior to public launch. Early waitlist subscribers will receive complimentary access to the introductory releases and community beta builds.'
      }
    }
  ]
};

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Perchboard in Action: Live Windows Desktop Screen Recording',
  description: 'Authentic 17-second live Windows 11 desktop screen recording demonstrating the Perchboard floating clipboard panel sliding out from the right screen edge.',
  thumbnailUrl: [`${SITE.url}/perch/perch-desktop-hero.png`],
  uploadDate: '2026-10-23T00:00:00Z',
  contentUrl: `${SITE.url}/perch/perch-highlight.mp4`
};

const jsonLd = [softwareSchema, breadcrumbSchema, faqSchema, videoSchema];
---

<BaseLayout
  seo={seo}
  jsonLd={jsonLd}
  hideHeader={true}
  hideFooter={true}
  hideNatureBg={true}
>
  <!-- Google Fonts: Caveat for authentic handwritten stationery notes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --paper-cream: #FBF9F4;
      --paper-warm: #F4EFE6;
      --paper-border: #E8E2D5;
      --paper-card: #FFFFFF;
      --ink-graphite: #18191B;
      --ink-subtle: #565961;
      --ink-muted: #848792;
      --brand-cyan: #0284C7;
      --brand-cyan-light: #38BDF8;
      --brand-cyan-glow: rgba(2, 132, 199, 0.15);
      --font-hand: 'Caveat', cursive, sans-serif;
      --font-serif-editorial: 'Newsreader', Georgia, serif;
    }

    .dark {
      --paper-cream: #121316;
      --paper-warm: #18191E;
      --paper-border: #262830;
      --paper-card: #1D1F25;
      --ink-graphite: #F4F4F6;
      --ink-subtle: #A3A6B2;
      --ink-muted: #6C707E;
      --brand-cyan-glow: rgba(56, 189, 248, 0.2);
    }

    /* Tactile Paper Texture Pattern */
    .perch-page-wrapper {
      background-color: var(--paper-cream);
      background-image: radial-gradient(rgba(0, 0, 0, 0.038) 1px, transparent 0);
      background-size: 24px 24px;
      color: var(--ink-graphite);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    .dark .perch-page-wrapper {
      background-image: radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 0);
    }

    .font-handwriting {
      font-family: var(--font-hand);
    }

    .font-editorial {
      font-family: var(--font-serif-editorial);
    }

    /* Tactile Paper Card & Shadow tokens */
    .paper-sheet {
      background: var(--paper-card);
      border: 1px solid var(--paper-border);
      box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.03),
        0 8px 24px -4px rgba(0, 0, 0, 0.05),
        0 20px 48px -8px rgba(0, 0, 0, 0.04);
    }

    .paper-sheet-subtle {
      background: var(--paper-card);
      border: 1px solid var(--paper-border);
      box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.04);
    }

    .paper-stamp {
      border: 1px dashed var(--brand-cyan);
      background: rgba(2, 132, 199, 0.04);
    }

    /* Hand-drawn SVG thread path styling */
    .journey-thread {
      stroke: #0284C7;
      stroke-opacity: 0.35;
      stroke-dasharray: 6 6;
      fill: none;
      pointer-events: none;
    }

    /* Smooth focus & interactive styles */
    .btn-perch-primary {
      background: #0284C7;
      color: #FFFFFF;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    }
    .btn-perch-primary:hover {
      background: #0369A1;
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
    }

    /* Desktop Showcase Frame */
    .desktop-frame {
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid rgba(0, 0, 0, 0.12);
      box-shadow:
        0 25px 60px -15px rgba(0, 0, 0, 0.22),
        0 10px 24px -8px rgba(0, 0, 0, 0.12);
    }
    .dark .desktop-frame {
      border-color: rgba(255, 255, 255, 0.1);
      box-shadow:
        0 30px 70px -15px rgba(0, 0, 0, 0.6),
        0 12px 28px -8px rgba(0, 0, 0, 0.35);
    }
  </style>

  <!-- Official Stackedlol / Framer ASCII Ocean Engine -->
  <script is:inline src="/perch/ascii-ocean-engine.js?v=3"></script>

  <div class="perch-page-wrapper">
    <!-- FULL-SCREEN TRANSPARENT ASCII SHARKS ON MAIN SCREEN (ZERO BLACK BACKGROUND) -->
    <canvas
      id="main-screen-ascii-ocean"
      class="fixed inset-0 w-full h-full pointer-events-none select-none z-0"
      style="display: block; width: 100vw; height: 100vh; position: fixed; top: 0; left: 0; pointer-events: none; z-index: 0;"
      aria-hidden="true"
    ></canvas>

    <!-- SVG Background Journey Thread Path -->
    <svg
      class="journey-thread absolute inset-0 w-full h-full z-0 hidden lg:block"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="none"
      viewBox="0 0 1440 6800"
    >
      <path
        d="M 720,100
           C 720,380 950,550 1150,700
           C 1300,800 1320,1100 1240,1400
           C 1180,1650 400,1850 320,2150
           C 250,2450 1150,2650 1200,2950
           C 1250,3250 350,3450 300,3750
           C 250,4050 1100,4250 1150,4550
           C 1200,4850 720,5100 720,5350
           L 720,6600"
        stroke-width="2"
      />
    </svg>

    <!-- 3. HEADER: Floating Product Navigation Pill -->
    <header class="fixed top-16 sm:top-24 inset-x-0 z-50 flex justify-center px-12 sm:px-20 pointer-events-none">
      <nav
        aria-label="Perchboard Navigation"
        class="pointer-events-auto flex items-center justify-between gap-12 sm:gap-20 px-14 py-8 sm:py-10 rounded-full paper-sheet-subtle bg-white/90 dark:bg-[#18191D]/90 backdrop-blur-md max-w-4xl w-full border border-paper-border"
      >
        <!-- Left: Bird Icon & Wordmark -->
        <a
          href="/perch"
          aria-label="Perchboard Home"
          class="flex items-center gap-10 group shrink-0"
        >
          <img
            src="/perch/app-icon.png"
            alt="Perchboard Logo Icon"
            width="30"
            height="30"
            class="w-30 h-30 rounded-8 shadow-sm transition-transform duration-200 group-hover:scale-105"
            loading="eager"
          />
          <div class="flex items-baseline gap-6">
            <span class="font-display font-extrabold text-sm sm:text-base tracking-tight text-ink-graphite">
              Perchboard
            </span>
            <span class="hidden sm:inline-block font-mono text-[9px] uppercase tracking-widest text-brand-cyan font-bold">
              v1.0
            </span>
          </div>
        </a>

        <!-- Center: Editorial Navigation Links -->
        <div class="hidden md:flex items-center gap-20 text-xs font-medium text-ink-subtle">
          <a href="#features" class="hover:text-ink-graphite transition-colors py-4">Features</a>
          <a href="#how-it-works" class="hover:text-ink-graphite transition-colors py-4">How it works</a>
          <a href="#platforms" class="hover:text-ink-graphite transition-colors py-4">Platforms</a>
          <a href="#faq" class="hover:text-ink-graphite transition-colors py-4">FAQ</a>
        </div>

        <!-- Right: Studio Tag & Waitlist CTA -->
        <div class="flex items-center gap-8 sm:gap-14 shrink-0">
          <a
            href="/lab"
            class="hidden sm:inline-flex items-center gap-4 font-mono text-[10px] text-ink-muted hover:text-ink-subtle transition-colors uppercase tracking-wider"
            title="Explore other builds from Nadhebe Lab"
          >
            <span>by Nadhebe</span>
            <span>↗</span>
          </a>
          <button
            type="button"
            id="nav-waitlist-btn"
            class="btn-perch-primary rounded-full px-14 py-6 sm:py-7 text-xs font-semibold whitespace-nowrap inline-flex items-center gap-4 cursor-pointer open-waitlist-modal"
          >
            <span>Join waitlist</span>
            <span class="font-sans">↗</span>
          </button>
        </div>
      </nav>
    </header>

    <!-- Spacer for floating header -->
    <div class="h-80 sm:h-96"></div>

    <!-- 4. HERO SECTION: Make the real product the visual centerpiece -->
    <section class="relative z-10 pt-16 sm:pt-28 pb-40 px-16 sm:px-24 max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-32 sm:mb-48" data-reveal>
        <!-- Platform Status Stamp Badge -->
        <div class="inline-flex items-center gap-8 px-12 py-4 rounded-full paper-stamp mb-20 text-brand-cyan">
          <span class="w-6 h-6 rounded-full bg-brand-cyan animate-pulse"></span>
          <span class="font-mono text-[11px] font-bold tracking-[0.18em] uppercase">
            WINDOWS FIRST · iOS COMING SOON
          </span>
        </div>

        <!-- Primary H1 Headline: Single Line -->
        <h1 class="font-display text-[clamp(1.75rem,5.2vw,4.5rem)] font-extrabold tracking-tight text-ink-graphite leading-tight mb-16 whitespace-nowrap">
          Copy it. Keep it. Find it.
        </h1>

        <!-- Supporting Statement & Copy -->
        <p class="font-editorial text-xl sm:text-2xl text-ink-subtle italic mb-12">
          Your clipboard, always within reach.
        </p>

        <p class="text-sm sm:text-base text-ink-subtle leading-relaxed max-w-2xl mx-auto mb-28">
          Perchboard keeps your copied content close at hand, with a floating desktop panel for revisiting text, links, images, and files without the friction of window switching.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-12 sm:gap-16">
          <button
            type="button"
            id="hero-waitlist-btn"
            class="btn-perch-primary px-24 py-12 rounded-full font-bold text-sm inline-flex items-center gap-8 shadow-md cursor-pointer open-waitlist-modal"
          >
            <span>Join the waitlist</span>
            <span>↗</span>
          </button>
          <a
            href="#how-it-works"
            class="px-20 py-11 rounded-full font-medium text-xs sm:text-sm text-ink-subtle hover:text-ink-graphite hover:bg-black/5 dark:hover:bg-white/5 transition-all inline-flex items-center gap-6"
          >
            <span>Explore how it works</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Real Windows Desktop Scene with Floating Perchboard Panel & Live Video -->
      <div class="relative max-w-5xl mx-auto pt-8 pb-16" data-reveal>
        <!-- Handwritten Sticky Annotation (Top Left) -->
        <div class="absolute -top-14 left-4 sm:left-12 z-20 hidden md:block">
          <div class="bg-[#FFFCE8] text-[#785E16] dark:bg-[#2A291A] dark:text-[#E8DC96] px-14 py-8 rounded-8 shadow-sm border border-[#F2E59E] dark:border-[#4A472E] -rotate-3">
            <span class="font-handwriting text-xl font-bold tracking-wide">
              Right where you need it ↗
            </span>
          </div>
        </div>

        <!-- Handwritten Sticky Annotation (Right Side near Floating Shelf) -->
        <div class="absolute -bottom-8 right-6 sm:right-16 z-20 hidden sm:block">
          <div class="bg-[#FFFCE8] text-[#785E16] dark:bg-[#2A291A] dark:text-[#E8DC96] px-14 py-8 rounded-8 shadow-sm border border-[#F2E59E] dark:border-[#4A472E] rotate-2">
            <span class="font-handwriting text-xl font-bold tracking-wide">
              Your clipboard, at the edge ↖
            </span>
          </div>
        </div>

        <!-- Authentic Windows Desktop Video Showcase Container with Control Buttons -->
        <div class="desktop-frame paper-sheet relative bg-[#0F172A] group">
          <div class="relative overflow-hidden aspect-[16/9] sm:aspect-[1822/1013]">
            <video
              id="perch-highlight-video"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              poster="/perch/perch-desktop-hero.png"
              class="w-full h-full object-cover object-top block"
            >
              <source src="/perch/perch-highlight.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>

            <!-- Video Playback & Mute Buttons on Top Video Frame -->
            <div class="absolute bottom-12 right-12 sm:bottom-16 sm:right-16 z-20 flex items-center gap-8">
              <button
                type="button"
                id="perch-video-play-btn"
                aria-label="Pause or play highlight demonstration video"
                class="px-14 py-6 rounded-full paper-sheet-subtle bg-white/95 dark:bg-[#18191D]/95 backdrop-blur-md text-xs font-mono font-semibold text-ink-graphite hover:bg-white dark:hover:bg-[#22242B] transition-all inline-flex items-center gap-6 cursor-pointer shadow-md"
              >
                <span id="play-btn-icon">⏸</span>
                <span id="play-btn-text">Pause</span>
              </button>
              <button
                type="button"
                id="perch-video-mute-btn"
                aria-label="Mute or unmute highlight demonstration video"
                class="px-14 py-6 rounded-full paper-sheet-subtle bg-white/95 dark:bg-[#18191D]/95 backdrop-blur-md text-xs font-mono font-semibold text-ink-graphite hover:bg-white dark:hover:bg-[#22242B] transition-all inline-flex items-center gap-6 cursor-pointer shadow-md"
              >
                <span id="mute-btn-icon">🔇</span>
                <span id="mute-btn-text">Unmute</span>
              </button>
            </div>
          </div>
        </div>

        <div class="mt-14 text-center">
          <span class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">
            AUTHENTIC WINDOWS 11 DESKTOP CAPTURE · FLOATING EDGE PANEL POSITIONING
          </span>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHT SECTION: Live Product Screen Recording Showcase -->
    <section class="relative z-10 py-32 px-16 sm:px-24 bg-white/60 dark:bg-black/20 border-y border-paper-border">
      <div class="max-w-5xl mx-auto" data-reveal>
        <div class="mb-24">
          <div class="inline-flex items-center gap-6 px-10 py-3 rounded-full bg-brand-cyan/10 text-brand-cyan font-mono text-[10px] font-bold tracking-wider uppercase mb-8">
            <span class="w-6 h-6 rounded-full bg-brand-cyan animate-pulse"></span>
            HIGH-RESOLUTION ARCHITECTURE
          </div>
          <h2 class="font-display text-2xl sm:text-4xl font-extrabold tracking-tight text-ink-graphite">
            Precision Desktop Ergonomics
          </h2>
          <p class="font-editorial text-lg text-ink-subtle italic mt-4">
            Full Windows 11 capture showing Perchboard floating alongside active workspaces.
          </p>
        </div>

        <!-- Desktop Showcase Frame (without duplicate buttons) -->
        <div class="desktop-frame paper-sheet relative bg-[#0F172A] overflow-hidden shadow-2xl">
          <img
            src="/perch/perch-desktop-hero.png"
            alt="Perchboard floating clipboard panel positioned along the right edge of a Windows desktop"
            class="w-full h-auto block rounded-16"
            loading="lazy"
            width="1822"
            height="1013"
          />
        </div>

        <div class="mt-16 flex items-center justify-between text-caption font-mono text-ink-muted text-[11px] flex-wrap gap-8">
          <div class="flex items-center gap-6">
            <svg class="w-12 h-12 text-brand-cyan" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Continuous background clipboard listener</span>
          </div>
          <div class="flex items-center gap-6">
            <svg class="w-12 h-12 text-brand-cyan" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Instant slide-out shelf at the desktop perimeter</span>
          </div>
          <div class="flex items-center gap-6">
            <svg class="w-12 h-12 text-brand-cyan" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>100% on-device memory</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. THE SCROLL NARRATIVE: Show the product in action -->
    <div id="how-it-works" class="relative z-10 pt-28 pb-48">
      
      <!-- SECTION 01 — Always within reach -->
      <section id="features" class="py-24 sm:py-36 px-16 sm:px-24 max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-24 sm:gap-36 items-center" data-reveal>
          <!-- Left: Narrative Text Block -->
          <div class="lg:col-span-5 space-y-16">
            <div class="flex items-center gap-8">
              <span class="font-mono text-xs font-bold px-8 py-2 rounded-6 bg-brand-cyan/10 text-brand-cyan">
                01
              </span>
              <span class="font-mono text-xs uppercase tracking-widest text-ink-muted">
                EDGE ARCHITECTURE
              </span>
            </div>

            <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-ink-graphite tracking-tight leading-tight">
              Not another window. Just within reach.
            </h2>

            <!-- Direct 2-3 sentence answer block for AI extractability -->
            <p class="text-sm sm:text-base text-ink-subtle leading-relaxed">
              Perchboard is designed as an anchored, floating clipboard panel that resides directly on your Windows desktop edge. Rather than burying copied snippets in a full-screen dashboard or separate browser tab, Perchboard slides in smoothly when needed and stays out of your way while you work.
            </p>

            <div class="pt-12 border-t border-paper-border space-y-8">
              <div class="flex items-start gap-10 text-xs text-ink-subtle">
                <span class="font-bold text-brand-cyan font-mono">✦</span>
                <span>Configurable screen edge placement: right, left, or top perimeter.</span>
              </div>
              <div class="flex items-start gap-10 text-xs text-ink-subtle">
                <span class="font-bold text-brand-cyan font-mono">✦</span>
                <span>Adjustable vertical alignment percentage along your display.</span>
              </div>
            </div>
          </div>

          <!-- Right: Authentic Desktop Landscape Visual -->
          <div class="lg:col-span-7 relative">
            <div class="desktop-frame paper-sheet relative bg-[#0F172A]">
              <img
