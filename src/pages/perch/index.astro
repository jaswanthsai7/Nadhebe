<!-- Client Hydration & Interactive Logic -->
<script is:inline>
  // Journey line: a smooth path through the [data-thread] anchors (x = fraction of page width,
  // y = point inside the element), ending at the top of the pricing card. A faint track shows
  // the whole route; the gradient line draws itself as you scroll and lights each stop.
  function initPerchThread() {
    var wrap = document.querySelector('.perch-page-wrapper');
    var svg = document.getElementById('perch-thread');
    if (!wrap || !svg || svg.dataset.ready) return;
    svg.dataset.ready = 'true';
    var NS = 'http://www.w3.org/2000/svg';
    var track = svg.querySelector('.perch-thread-track');
    var glow = svg.querySelector('.perch-thread-glow');
    var draw = svg.querySelector('.perch-thread-draw');
    var head = svg.querySelector('.perch-thread-head');
    var halo = svg.querySelector('.perch-thread-halo');
    var nodesGroup = svg.querySelector('.perch-thread-nodes');
    var grad = document.getElementById('perch-thread-gradient');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var total = 0, samples = [], nodes = [], ticking = false;

    function layout() {
      if (getComputedStyle(svg).display === 'none') return;
      var wr = wrap.getBoundingClientRect();
      var W = wrap.clientWidth;
      var H = wrap.scrollHeight;
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      svg.style.height = H + 'px';

      var pts = Array.prototype.map.call(wrap.querySelectorAll('[data-thread]'), function (el) {
        var r = el.getBoundingClientRect();
        var fy = parseFloat(el.getAttribute('data-thread-y'));
        return [W * parseFloat(el.getAttribute('data-thread')), r.top - wr.top + r.height * (isNaN(fy) ? 0.5 : fy)];
      });
      var pricing = document.getElementById('pricing');
      if (pricing) {
        var pr = pricing.getBoundingClientRect();
        pts.push([W / 2, pr.top - wr.top + 40]);
      }
      if (pts.length < 2) return;

      // Vertical tangents at every stop give soft S-curves that never double back.
      var d = 'M ' + pts[0][0].toFixed(1) + ' ' + pts[0][1].toFixed(1);
      for (var i = 1; i < pts.length; i++) {
        var a = pts[i - 1], b = pts[i], dy = (b[1] - a[1]) * 0.5;
        d += ' C ' + a[0].toFixed(1) + ' ' + (a[1] + dy).toFixed(1) + ', ' + b[0].toFixed(1) + ' ' + (b[1] - dy).toFixed(1) + ', ' + b[0].toFixed(1) + ' ' + b[1].toFixed(1);
      }
      track.setAttribute('d', d);
      glow.setAttribute('d', d);
      draw.setAttribute('d', d);
      grad.setAttribute('y1', pts[0][1]);
      grad.setAttribute('y2', pts[pts.length - 1][1]);

      total = draw.getTotalLength();
      draw.style.strokeDasharray = total + ' ' + total;
      glow.style.strokeDasharray = total + ' ' + total;
      samples = [];
      for (var k = 0; k <= 240; k++) {
        var len = (total * k) / 240;
        samples.push([len, draw.getPointAtLength(len).y]);
      }

      nodesGroup.innerHTML = '';
      nodes = pts.map(function (p) {
        var c = document.createElementNS(NS, 'circle');
        c.setAttribute('class', 'perch-thread-node');
        c.setAttribute('cx', p[0]);
        c.setAttribute('cy', p[1]);
        c.setAttribute('r', 4.5);
        nodesGroup.appendChild(c);
        return { el: c, y: p[1] };
      });
      update();
    }

    // Length along the path whose point sits at page-y (the path only moves downward).
    function lengthAtY(y) {
      if (!samples.length || y <= samples[0][1]) return 0;
      for (var i = 1; i < samples.length; i++) {
        if (samples[i][1] >= y) {
          var a = samples[i - 1], b = samples[i];
          var t = (y - a[1]) / Math.max(0.001, b[1] - a[1]);
          return a[0] + (b[0] - a[0]) * t;
        }
      }
      return total;
    }

    function update() {
      ticking = false;
      if (!total) return;
      var wr = wrap.getBoundingClientRect();
      var targetY = reduce ? Infinity : -wr.top + window.innerHeight * 0.62;
      var len = lengthAtY(targetY);
      draw.style.strokeDashoffset = total - len;
      glow.style.strokeDashoffset = total - len;
      var showHead = len > 0 && len < total - 1;
      var p = draw.getPointAtLength(len);
      head.setAttribute('cx', showHead ? p.x : -50);
      head.setAttribute('cy', showHead ? p.y : -50);
      halo.setAttribute('cx', showHead ? p.x : -50);
      halo.setAttribute('cy', showHead ? p.y : -50);
      for (var i = 0; i < nodes.length; i++) nodes[i].el.classList.toggle('is-lit', nodes[i].y <= p.y + 1);
    }

    function requestUpdate() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    var relayout = (function () {
      var t;
      return function () {
        clearTimeout(t);
        t = setTimeout(layout, 120);
      };
    })();

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', relayout);
    if ('ResizeObserver' in window) new ResizeObserver(relayout).observe(wrap);
    window.addEventListener('load', layout);
    layout();
  }


  function initDemoCarousel() {
    var root = document.querySelector('[data-demo-carousel]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var track = root.querySelector('[data-demo-track]');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-demo-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-demo-dot]'));
    var active = -1;
    var inView = false;

    function go(i, smooth) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      var s = slides[i];
      var left = s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2;
      track.scrollTo({ left: left, behavior: smooth === false ? 'auto' : 'smooth' });
    }

    function setActive(i) {
      if (i === active) return;
      active = i;
      slides.forEach(function (s, j) {
        var v = s.querySelector('video');
        s.classList.toggle('is-active', j === i);
        if (j === i) {
          v.controls = true;
          if (inView) v.play().catch(function () {});
        } else {
          v.controls = false;
          v.pause();
        }
      });
      dots.forEach(function (d, j) { d.classList.toggle('is-active', j === i); d.setAttribute('aria-selected', String(j === i)); });
    }

    function nearest() {
      var mid = track.scrollLeft + track.clientWidth / 2;
      var best = 0, bestD = Infinity;
      slides.forEach(function (s, j) {
        var d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
        if (d < bestD) { bestD = d; best = j; }
      });
      return best;
    }

    var raf = 0;
    track.addEventListener('scroll', function () {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () { setActive(nearest()); });
    }, { passive: true });
    slides.forEach(function (s, j) { s.querySelector('.demo-cover').addEventListener('click', function () { go(j); }); });
    dots.forEach(function (d, j) { d.addEventListener('click', function () { go(j); }); });
    root.querySelector('[data-demo-prev]').addEventListener('click', function () { go(active - 1); });
    root.querySelector('[data-demo-next]').addEventListener('click', function () { go(active + 1); });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(active - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(active + 1); }
    });

    // Play the featured demo only while the section is on screen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
        var v = slides[active] && slides[active].querySelector('video');
        if (!v) return;
        if (inView) v.play().catch(function () {}); else v.pause();
      }, { threshold: 0.35 }).observe(track);
    }

    var featured = +root.dataset.featured || 0;
    go(featured, false);
    setActive(featured);
    window.addEventListener('resize', function () { go(active, false); });
  }

  function initPerchPage() {
    // 1. Highlight Video Play/Pause & Mute Controls
    var video = document.getElementById('perch-highlight-video');
    var playBtn = document.getElementById('perch-video-play-btn');
    var playIcon = document.getElementById('play-btn-icon');
    var playText = document.getElementById('play-btn-text');
    var muteBtn = document.getElementById('perch-video-mute-btn');
    var muteIcon = document.getElementById('mute-btn-icon');
    var muteText = document.getElementById('mute-btn-text');

    if (video && playBtn && playIcon && playText && !playBtn.dataset.hasListener) {
      playBtn.dataset.hasListener = 'true';
      playBtn.addEventListener('click', function() {
        if (video.paused) {
          video.play();
          playIcon.textContent = '⏸';
          playText.textContent = 'Pause';
        } else {
          video.pause();
          playIcon.textContent = '▶';
          playText.textContent = 'Play';
        }
      });
    }

    if (video && muteBtn && muteIcon && muteText && !muteBtn.dataset.hasListener) {
      muteBtn.dataset.hasListener = 'true';
      muteBtn.addEventListener('click', function() {
        video.muted = !video.muted;
        if (video.muted) {
          muteIcon.textContent = '🔇';
          muteText.textContent = 'Unmute';
        } else {
          muteIcon.textContent = '🔊';
          muteText.textContent = 'Mute';
        }
      });
    }

    // 2. Full-Screen Transparent ASCII Sharks on Main Screen (Zero Black Background)
    var mainOceanCanvas = document.getElementById('main-screen-ascii-ocean');
    if (mainOceanCanvas && typeof window.OceanEngine === 'function') {
      if (window.__mainOceanEngine) {
        window.__mainOceanEngine.destroy();
      }
      var cfg = typeof window.defaultConfig === 'function' ? window.defaultConfig() : {};
      cfg.transparent = true;
      cfg.background = 'transparent';
      cfg.showGrid = false;
      cfg.wakeRGB = [2, 132, 199];      // Perchboard cyan wake ripples
      cfg.speed = 1.1;
      cfg.interactive = true;
      cfg.cellSize = 7;                 // finer grid so the silhouette, fins and tail read clearly
      cfg.ramp = '.:-=+*#%@';           // clean light→dense symbols instead of letters

      // Exactly 2 sharks: 1 Hammerhead, 1 Classic
      var sharks = [
        { kind: 'hammerhead', size: 1.2 },
        { kind: 'classic', size: 1.0 }
      ];

      // fishCount = 0 (removes all fish dashes completely)
      window.__mainOceanEngine = new window.OceanEngine(mainOceanCanvas, sharks, 0, cfg);
    }

    // 2b. Journey line
    initPerchThread();
    initDemoCarousel();

    // 3. Smooth scroll to macOS Waitlist Section
    function scrollToWaitlist() {
      var waitlistSec = document.getElementById('waitlist');
      if (waitlistSec) {
        waitlistSec.scrollIntoView({ behavior: 'smooth' });
        var emailInput = waitlistSec.querySelector('input[type="email"]');
        if (emailInput) {
          setTimeout(function() {
            emailInput.focus({ preventScroll: true });
          }, 450);
        }
      }
    }

    var waitlistBtns = document.querySelectorAll('#hero-waitlist-btn, #platform-cta-macos, #footer-waitlist-btn, a[href="#waitlist"]');
    waitlistBtns.forEach(function(btn) {
      if (btn.dataset.hasWaitlistListener) return;
      btn.dataset.hasWaitlistListener = 'true';
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        scrollToWaitlist();
      });
    });

    // 4. Header "Download" triggers the Paddle checkout payment portal directly
    var navBuyBtn = document.getElementById('nav-buy-pro-btn');
    if (navBuyBtn && !navBuyBtn.dataset.hasDirectBuyListener) {
      navBuyBtn.dataset.hasDirectBuyListener = 'true';
      navBuyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openPerchCheckout === 'function') {
          window.openPerchCheckout(navBuyBtn);
        } else {
          var pricingSec = document.getElementById('pricing');
          if (pricingSec) {
            pricingSec.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }

    // Nav center "Pricing" link scrolls to pricing section
    var navPricingLink = document.querySelector('nav a[href="#pricing"]:not(#nav-buy-pro-btn)');
    if (navPricingLink && !navPricingLink.dataset.hasScrollListener) {
      navPricingLink.dataset.hasScrollListener = 'true';
      navPricingLink.addEventListener('click', function(e) {
        e.preventDefault();
        var pricingSec = document.getElementById('pricing');
        if (pricingSec) {
          pricingSec.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Handle successful subscription
    window.addEventListener('nadhebe:subscribed', function() {
      console.log('[Nadhebe] Waitlist subscription confirmed');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPerchPage);
  } else {
    initPerchPage();
  }
  document.addEventListener('astro:page-load', initPerchPage);
</script>
