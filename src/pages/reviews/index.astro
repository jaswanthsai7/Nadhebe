---
import { getAllArticles } from '../../utils/content';
import CategoryLayout from '../../layouts/CategoryLayout.astro';

const allArticles = await getAllArticles();
const posts = allArticles.filter(p => p.collection === 'tool-reviews' || p.data.category?.toLowerCase() === 'reviews' || p.data.category?.toLowerCase() === 'tool reviews');
---

<CategoryLayout categoryName="Tool Reviews" posts={posts} allPosts={allArticles} />
