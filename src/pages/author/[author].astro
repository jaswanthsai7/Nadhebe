---
import { getCollection } from 'astro:content';
import AuthorLayout from '../../layouts/AuthorLayout.astro';
import { getAllArticles } from '../../utils/content';

export async function getStaticPaths() {
  const authorEntries = await getCollection('authors');
  const allArticles = await getAllArticles();

  return authorEntries.map(author => {
    const cleanSlug = author.slug || author.id.replace(/\.mdx?$/, '');
    // Filter posts written by this author
    const authorPosts = allArticles.filter(post => {
      const authorObj = post.data.author as any;
      const postAuthorId = typeof authorObj === 'string'
        ? authorObj.replace(/\.mdx?$/, '')
        : String(authorObj?.id || authorObj?.slug || '').replace(/\.mdx?$/, '');
      return postAuthorId === cleanSlug || postAuthorId === 'nadhebe-team';
    });

    return {
      params: { author: cleanSlug },
      props: { author: author.data, posts: authorPosts },
    };
  });
}

const { author, posts } = Astro.props;
---

<AuthorLayout author={author} posts={posts} />
