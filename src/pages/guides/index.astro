---
import { getAllArticles } from '../../utils/content';
import CategoryLayout from '../../layouts/CategoryLayout.astro';

const allArticles = await getAllArticles();
const posts = allArticles.filter(p => p.collection === 'guides' || p.data.category?.toLowerCase() === 'guides');
---

<CategoryLayout categoryName="Guides" posts={posts} allPosts={allArticles} />
