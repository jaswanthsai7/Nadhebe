---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '@/config';

const title = 'Write for Nadhebe — Contributor Guidelines & Editorial Standards';
const description = 'Guidelines for software engineers, technical writers, and researchers interested in contributing tutorials or articles to Nadhebe.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`${SITE.url}/contribute/`}
>
  <div class="mx-auto max-w-4xl px-16 sm:px-24 py-48 sm:py-64" data-reveal>
    <div class="glass-panel rounded-24 border border-border bg-surface/90 p-24 sm:p-48 shadow-medium dark:border-border-dark dark:bg-surface-dark/90 space-y-32">
      
      <!-- HERO -->
      <div>
        <div class="inline-flex items-center gap-8 px-12 py-6 rounded-full bg-accent/10 border border-accent/20 text-caption font-mono font-bold text-accent dark:text-accent-dark mb-16 uppercase tracking-wider">
          <span>Community & Editorial Submissions</span>
        </div>
        <h1 class="font-display text-h1 font-bold tracking-tight text-ink dark:text-ink-dark">
          Write for Nadhebe: Contributor Guidelines
        </h1>
        <p class="mt-12 text-h3 text-ink2 dark:text-ink2-dark font-sans leading-relaxed">
          We welcome technical contributions, tutorial pitches, and engineering walkthroughs from software developers, AI practitioners, and open-source contributors.
        </p>
      </div>

      <div class="border-t border-border/60 dark:border-border-dark/60 pt-24 prose-article">
        
        <h2>What We Publish</h2>
        <p>
          Nadhebe publishes practical, high-value technical content aimed at developers building with modern AI tools, open-weights models, and software infrastructure. Topics of primary interest include:
        </p>
        <ul>
          <li><strong>Agentic Frameworks & Protocols:</strong> Model Context Protocol (MCP) server implementations, tool-calling architectures, and agentic workflows.</li>
          <li><strong>Local Model Serving & Inference:</strong> Running and quantizing open-weights models locally with Ollama, vLLM, SGLang, and consumer GPU setups.</li>
          <li><strong>Developer Tooling & Workflows:</strong> CLI tools (such as Claude Code and Gemini CLI), AI-assisted IDEs, and automation pipelines.</li>
          <li><strong>Practical API Integrations:</strong> Real-world integration tutorials for Anthropic Claude, OpenAI, Google Gemini, and open-source AI APIs.</li>
          <li><strong>Client-Side Utilities:</strong> Creative applications of browser-native web APIs, WebAssembly, and privacy-respecting client tools.</li>
        </ul>

        <h2>Content Quality Requirements</h2>
        <p>
          To maintain high technical standards for our readers, all submissions must satisfy the following criteria:
        </p>
        <ul>
          <li><strong>Originality:</strong> Submissions must be original work written by you. We do not accept AI-generated filler, spun articles, or content syndicated from other publications without explicit permission.</li>
          <li><strong>Reproducible Code:</strong> Every tutorial must include complete, functional code examples tested against current software versions. Readers should be able to follow your steps and achieve the exact same outcome.</li>
          <li><strong>Prerequisites & Environment:</strong> Clearly state required dependencies, software versions (Node.js, Python, OS), and API credentials at the start of your article.</li>
          <li><strong>No Promotional Spin:</strong> Articles should focus on solving technical problems. We do not publish promotional advertorials or product pitches disguised as tutorials.</li>
        </ul>

        <h2>Formatting & Structure</h2>
        <ul>
          <li><strong>Format:</strong> Submissions should be provided in clean GitHub Flavored Markdown (`.md`).</li>
          <li><strong>Headings:</strong> Use clear, logical heading hierarchy (`##` for main sections, `###` for sub-steps).</li>
          <li><strong>Code Blocks:</strong> Specify the language identifier on all fenced code blocks (e.g., ```` ```typescript ````, ```` ```python ````, ```` ```bash ````).</li>
          <li><strong>Images & Diagrams:</strong> Include descriptive alt text for all screenshots, architecture diagrams, or flowcharts.</li>
        </ul>

        <h2>How to Pitch an Article</h2>
        <p>
          Before writing a complete draft, we strongly recommend sending an outline or pitch to our editorial desk:
        </p>
        <ol>
          <li><strong>Working Title:</strong> A clear, descriptive headline for your proposed article.</li>
          <li><strong>Target Audience:</strong> Who the article is for (e.g., frontend engineers, backend developers, ML practitioners).</li>
          <li><strong>Outline:</strong> 3–5 bullet points outlining the core sections, code examples, and key takeaways.</li>
          <li><strong>Your Background:</strong> A brief sentence about your background and experience with the topic.</li>
        </ol>

        <div class="not-prose my-32 p-24 rounded-16 border border-accent/30 bg-accent/5 dark:bg-accent-dark/5 space-y-12">
          <h3 class="font-sans font-bold text-h4 text-ink dark:text-ink-dark">Send Your Pitch</h3>
          <p class="text-caption text-ink2 dark:text-ink2-dark">
            Email your proposed topic and brief outline to our editorial desk:
          </p>
          <a href="mailto:contact@nadhebe.com?subject=Article%20Pitch%20-%20Nadhebe" class="inline-flex items-center gap-8 rounded-8 bg-accent px-16 py-8 text-caption font-semibold text-white shadow-soft transition-all hover:opacity-95">
            <span>Email Pitch to contact@nadhebe.com</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="text-xs text-muted dark:text-muted-dark">We review all incoming pitches and respond within 3–5 business days.</p>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
