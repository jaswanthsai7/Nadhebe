---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '@/config';

const title = 'Contact Us — Nadhebe Editorial & Engineering Desk';
const description = 'Get in touch with the Nadhebe editorial team, submit technical inquiries, report corrections, or request benchmark datasets.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`${SITE.url}/contact/`}
>
  <div class="mx-auto max-w-4xl px-16 sm:px-24 py-48 sm:py-64" data-reveal>
    <div class="glass-panel rounded-24 border border-border bg-surface/90 p-24 sm:p-48 shadow-medium dark:border-border-dark dark:bg-surface-dark/90 space-y-32">
      
      <!-- HEADER -->
      <div>
        <div class="inline-flex items-center gap-8 px-12 py-6 rounded-full bg-accent/10 border border-accent/20 text-caption font-mono font-bold text-accent dark:text-accent-dark mb-16 uppercase tracking-wider">
          <span>Direct Editorial Communication</span>
        </div>
        <h1 class="font-display text-h1 font-bold tracking-tight text-ink dark:text-ink-dark">
          Contact Nadhebe
        </h1>
        <p class="mt-12 text-h3 text-ink2 dark:text-ink2-dark font-sans leading-relaxed">
          We welcome feedback from software engineers, AI researchers, and readers. Reach out for editorial inquiries, technical corrections, or benchmark collaborations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-20 not-prose">
        
        <!-- CARD 1: EDITORIAL & CORRECTIONS -->
        <div class="p-24 rounded-16 border border-border dark:border-border-dark bg-surface2/50 dark:bg-surface2-dark/50 space-y-16">
          <div class="w-40 h-40 rounded-12 bg-accent/10 text-accent flex items-center justify-center">
            <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-sans font-bold text-h4 text-ink dark:text-ink-dark">General & Editorial Desk</h3>
            <p class="text-caption text-muted dark:text-muted-dark mt-4">
              For questions regarding tutorials, code implementations, model benchmarks, or reporting factual corrections.
            </p>
          </div>
          <div class="pt-8 border-t border-border/40 dark:border-border-dark/40">
            <a href="mailto:hello@nadhebe.com" class="text-body font-mono font-bold text-accent hover:underline">
              hello@nadhebe.com
            </a>
            <p class="text-xs text-muted dark:text-muted-dark mt-4">Typical response time: Within 24–48 business hours.</p>
          </div>
        </div>

        <!-- CARD 2: VERIFIED CHANNELS -->
        <div class="p-24 rounded-16 border border-border dark:border-border-dark bg-surface2/50 dark:bg-surface2-dark/50 space-y-16">
          <div class="w-40 h-40 rounded-12 bg-accent/10 text-accent flex items-center justify-center">
            <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <div>
            <h3 class="font-sans font-bold text-h4 text-ink dark:text-ink-dark">Official Publisher Channels</h3>
            <p class="text-caption text-muted dark:text-muted-dark mt-4">
              Connect with our live video releases, weekly newsletter dispatches, and engineering updates.
            </p>
          </div>
          <div class="pt-8 border-t border-border/40 dark:border-border-dark/40 space-y-8">
            <div>
              <a href="https://www.youtube.com/@Nadhebe" target="_blank" rel="noopener noreferrer" class="text-caption font-semibold text-ink dark:text-ink-dark hover:text-accent flex items-center gap-6">
                <span>📺 YouTube Channel</span>
                <span class="text-xs text-muted font-mono">@Nadhebe →</span>
              </a>
            </div>
            <div>
              <a href="https://substack.com/@nadhebeai" target="_blank" rel="noopener noreferrer" class="text-caption font-semibold text-ink dark:text-ink-dark hover:text-accent flex items-center gap-6">
                <span>📰 Substack Publication</span>
                <span class="text-xs text-muted font-mono">@nadhebeai →</span>
              </a>
            </div>
            <div>
              <a href="https://www.linkedin.com/company/nadhebe/" target="_blank" rel="noopener noreferrer" class="text-caption font-semibold text-ink dark:text-ink-dark hover:text-accent flex items-center gap-6">
                <span>💼 LinkedIn Company</span>
                <span class="text-xs text-muted font-mono">/company/nadhebe →</span>
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- EDITORIAL COMMITMENT -->
      <div class="p-20 rounded-16 bg-surface2/30 dark:bg-surface2-dark/30 border border-border/60 dark:border-border-dark/60 text-caption text-ink2 dark:text-ink2-dark space-y-8">
        <p class="font-bold text-ink dark:text-ink-dark">Editorial Fact-Checking Policy:</p>
        <p>
          If you discover a broken command, outdated API parameter, or factual inconsistency in any of our technical guides, please include the article URL and your reproduction environment details in your email. Our engineers test and verify correction requests within 2 business days.
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
