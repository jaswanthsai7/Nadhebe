---
import { getAllArticles } from '../../utils/content';
import CategoryLayout from '../../layouts/CategoryLayout.astro';

const allArticles = await getAllArticles();
const posts = allArticles.filter(p => p.collection === 'comparisons' || p.data.category?.toLowerCase() === 'comparisons');
---

<CategoryLayout categoryName="Comparisons" posts={posts} allPosts={allArticles} />
