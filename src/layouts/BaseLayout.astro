---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/search/SearchDialog.astro';
import PageLoader from '@/components/PageLoader.astro';
import OrganizationSchema from '@/components/seo/OrganizationSchema.astro';
import WebSiteSchema from '@/components/seo/WebSiteSchema.astro';
import '@/styles/global.css';
import { buildSeo } from '@/utils/seo';
import { SITE } from '@/config';
import type { SeoMeta } from '@/utils/seo';

interface Props {
  seo?: SeoMeta;
  title?: string;
  description?: string;
  heroImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { seo: propSeo, title, description, heroImage, canonicalUrl, noindex, jsonLd = [] } = Astro.props;

const seo = propSeo || buildSeo({
  title: title || SITE.name,
  description: description || SITE.description,
  slug: Astro.url.pathname,
  siteUrl: SITE.url,
  siteName: SITE.name,
  image: heroImage,
  noindex,
});

if (canonicalUrl) {
  seo.canonical = canonicalUrl;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#D97706" />
    <!-- Google AdSense (publisher ca-pub-3435887725966321) -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3435887725966321" crossorigin="anonymous"></script>

    <!-- RSS & JSON Feed Alternate Links -->
    <link rel="alternate" type="application/rss+xml" title="Nadhebe Global RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="application/json" title="Nadhebe JSON Feed" href="/feed.json" />

    <!-- Resource Preconnects to eliminate critical request chain delays -->
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <!-- Deferred Google Analytics 4 (gtag.js) -->
    <script is:inline>
      (function() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;

        function loadGA() {
          if (window.__ga_loaded) return;
          window.__ga_loaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RFF3QRZNF9';
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', 'G-RFF3QRZNF9');
        }

        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA, { timeout: 3000 });
        } else {
          window.addEventListener('load', function() { setTimeout(loadGA, 1500); });
        }
      })();
    </script>

    <!-- Zero-delay 4K nature background loader executed before first paint -->
    <script is:inline>
      (function () {
        const photos = [
          'photo-1507525428034-b723cf961d3e',
          'photo-1441974231531-c6227db76b6e',
          'photo-1505118380757-91f5f5632de0',
          'photo-1534067783941-51c9c23ecefd',
          'photo-1470071459604-3b5ec3a7fe05',
          'photo-1500382017468-9049fed747ef',
          'photo-1439066615861-d1af74d74000',
          'photo-1518495973542-4542c06a5843',
          'photo-1448375240586-882707db888b',
          'photo-1506973035872-a4ec16b8e8d9',
          'photo-1544551763-46a013bb70d5',
          'photo-1476514525535-07fb3b4ae5f1',
          'photo-1502082553048-f009c37129b9',
          'photo-1519046904884-53103b34b206',
          'photo-1470240731273-7821a6eeb6bd',
          'photo-1506744038136-46273834b3fb',
          'photo-1511884642898-4c92249e20b6',
          'photo-1469474968028-56623f02e42e',
          'photo-1501785888041-af3ef285b470',
          'photo-1426604966848-d7adac402bff',
          'photo-1472214103451-9374bd1c798e',
          'photo-1510784722466-be2aa9c52ffa',
          'photo-1497436072909-60f360e1d4b1',
          'photo-1433086966358-54859d0ed716',
          'photo-1501854140801-50d01698950b',
          'photo-1464822759023-fed622ff2c3b',
          'photo-1519681393784-d120267933ba',
          'photo-1470770841072-f978cf4d019e',
          'photo-1532274402911-5a369e4c4bb5'
        ];

        let idx = parseInt(sessionStorage.getItem('nb_bg_idx') || '-1', 10);
        if (isNaN(idx) || idx < 0 || idx >= photos.length - 1) {
          idx = Math.floor(Math.random() * photos.length);
        } else {
          idx = idx + 1;
        }
        const bgId = photos[idx];
        try { sessionStorage.setItem('nb_bg_idx', String(idx)); } catch(e){}

        const screenWidth = typeof window !== 'undefined' ? Math.max(window.innerWidth || 0, window.screen?.width || 0) : 2560;
        const targetWidth = screenWidth > 2000 ? 3840 : screenWidth > 1200 ? 2560 : 1920;
        const bgUrl = 'https://images.unsplash.com/' + bgId + '?auto=format&fit=crop&w=' + targetWidth + '&q=85&fm=webp';

        document.documentElement.style.setProperty('--nature-bg-url', "url('" + bgUrl + "')");
      })();
    </script>

    <!-- Prevent flash: apply stored theme or default light before paint -->
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
    </script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    {seo.keywords && <meta name="keywords" content={seo.keywords} />}
    {seo.author && <meta name="author" content={seo.author} />}
    <link rel="canonical" href={seo.canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.ogUrl} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content={seo.locale} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={seo.twitterTitle} />
    <meta name="twitter:description" content={seo.twitterDescription} />
    <meta name="twitter:image" content={seo.twitterImage} />

    <!-- Structured data -->
    <OrganizationSchema />
    <WebSiteSchema />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Analytics & SEO Verification Verification -->
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
    )}



    <!-- Microsoft Clarity -->
    {import.meta.env.PUBLIC_CLARITY_ID && (
      <script is:inline define:vars={{ clarityId: import.meta.env.PUBLIC_CLARITY_ID }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+clarityId;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window,document,"clarity","script");
      </script>
    )}



    <!-- Frosted Nature Background Styles -->
    <style>
      #nature-bg {
        position: fixed;
        inset: 0;
        z-index: -20;
        width: 100vw;
        height: 100vh;
        background-image: var(--nature-bg-url);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 1;
        background-color: #f8fafc;
        transform: translateZ(0);
        will-change: transform;
      }
      .dark #nature-bg {
        background-color: #090d16;
      }
      #nature-overlay {
        position: fixed;
        inset: 0;
        z-index: -10;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.0) 0%,
          rgba(255, 255, 255, 0.08) 100%
        );
        pointer-events: none;
        transform: translateZ(0);
      }
      .dark #nature-overlay {
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.25) 0%,
          rgba(0, 0, 0, 0.45) 100%
        );
      }
    </style>

    <!-- WebMCP Agent Tools Registration -->
    <script is:inline>
      if (navigator.modelContext && typeof navigator.modelContext.provideContext === 'function') {
        navigator.modelContext.provideContext({
          tools: [
            {
              name: "search_articles",
              description: "Search all articles, system prompts, comparisons, and tool reviews on the platform.",
              inputSchema: {
                type: "object",
                properties: {
                  query: { type: "string", description: "Search query string" }
                },
                required: ["query"]
              },
              execute: async ({ query }) => {
                window.location.href = `/search?q=${encodeURIComponent(query)}`;
                return { success: true, message: `Navigated to search for: ${query}` };
              }
            }
          ]
        });
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col text-ink dark:text-ink-dark" style="background: transparent;">
    <PageLoader />
    <!-- Full-screen Dynamic Nature Background -->
    <div id="nature-bg" role="presentation" aria-hidden="true"></div>
    <div id="nature-overlay" aria-hidden="true"></div>

    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-grow pb-64">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <!-- Scroll-reveal animations with immediate fold check & fallback -->
    <script is:inline>
      (function() {
        function initReveal() {
          var els = document.querySelectorAll('[data-reveal]');
          if (!els.length) return;

          // Immediate check for elements in/near viewport
          els.forEach(function(el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < (window.innerHeight || 800) + 150) {
              el.classList.add('revealed');
            }
          });

          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function(entries) {
              entries.forEach(function(e) {
                if (e.isIntersecting) {
                  e.target.classList.add('revealed');
                  io.unobserve(e.target);
                }
              });
            }, { threshold: 0.01, rootMargin: '150px 0px 150px 0px' });

            els.forEach(function(el) {
              if (!el.classList.contains('revealed')) {
                io.observe(el);
              }
            });
          } else {
            els.forEach(function(el) { el.classList.add('revealed'); });
          }

          // Safety fallback: ensure nothing stays invisible
          setTimeout(function() {
            els.forEach(function(el) { el.classList.add('revealed'); });
          }, 250);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal);
        } else {
          initReveal();
        }
        document.addEventListener('astro:page-load', initReveal);
      })();
    </script>
  </body>
</html>
