---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/search/SearchDialog.astro';
import PageLoader from '@/components/PageLoader.astro';
import OrganizationSchema from '@/components/seo/OrganizationSchema.astro';
import WebSiteSchema from '@/components/seo/WebSiteSchema.astro';
import '@/styles/global.css';
import { buildSeo } from '@/utils/seo';
import { SITE } from '@/config';
import type { SeoMeta } from '@/utils/seo';

interface Props {
  seo?: SeoMeta;
  title?: string;
  description?: string;
  heroImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { seo: propSeo, title, description, heroImage, canonicalUrl, noindex, jsonLd = [] } = Astro.props;

const seo = propSeo || buildSeo({
  title: title || SITE.name,
  description: description || SITE.description,
  slug: Astro.url.pathname,
  siteUrl: SITE.url,
  siteName: SITE.name,
  image: heroImage,
  noindex,
});

if (canonicalUrl) {
  seo.canonical = canonicalUrl;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#D97706" />

    <!-- Google Fonts Preconnect (Reduces DNS & TLS setup time by 100-300ms) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Non-blocking Google Fonts stylesheet -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" /></noscript>

    <!-- Post-load Google AdSense (loaded on window load to prevent blocking FCP / Speed Index) -->
    <script is:inline>
      window.addEventListener('load', function() {
        var runAdSense = function() {
          if (window.__adsense_loaded) return;
          window.__adsense_loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3435887725966321';
          s.setAttribute('crossorigin', 'anonymous');
          document.head.appendChild(s);
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(runAdSense, { timeout: 2000 });
        } else {
          setTimeout(runAdSense, 1000);
        }
      }, { once: true });
    </script>

    <!-- RSS & JSON Feed Alternate Links -->
    <link rel="alternate" type="application/rss+xml" title="Nadhebe Global RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="application/json" title="Nadhebe JSON Feed" href="/feed.json" />

    <!-- Deferred Google Analytics 4 — Loaded on interaction for 0ms initial JS overhead -->
    <script is:inline>
      (function() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;

        function loadGA() {
          if (window.__ga_loaded) return;
          window.__ga_loaded = true;
          ['pointerdown','touchstart','scroll','keydown'].forEach(function(e){ window.removeEventListener(e, loadGA); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RFF3QRZNF9';
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', 'G-RFF3QRZNF9');
        }

        ['pointerdown','touchstart','scroll','keydown'].forEach(function(e){
          window.addEventListener(e, loadGA, { passive: true, once: true });
        });
        setTimeout(loadGA, 6000);
      })();
    </script>

    <!-- Ultra-fast 0ms mobile-aware local nature background loader -->
    <script is:inline>
      (function () {
        var TOTAL_BGS = 20;
        var stored = '-1';
        try { stored = sessionStorage.getItem('nb_bg_idx') || '-1'; } catch(e){}
        var idx = parseInt(stored, 10);
        if (isNaN(idx) || idx < 0 || idx >= TOTAL_BGS) {
          idx = Math.floor(Math.random() * TOTAL_BGS);
        } else {
          idx = (idx + 1) % TOTAL_BGS;
        }
        try { sessionStorage.setItem('nb_bg_idx', String(idx)); } catch(e){}

        var isMobile = typeof window !== 'undefined' && (window.innerWidth || 0) < 768;
        var bgUrl = (isMobile ? '/images/bg/mobile/bg-' : '/images/bg/bg-') + (idx + 1) + '.webp';

        // 1. Immediately set CSS variable on document root
        document.documentElement.style.setProperty('--nature-bg-url', "url('" + bgUrl + "')");
        // Start hidden to allow smooth fade-in once loaded
        document.documentElement.style.setProperty('--nature-bg-opacity', "0");

        // 2. Inject high-priority preload link into head immediately
        var l = document.createElement('link');
        l.rel = 'preload';
        l.as = 'image';
        l.href = bgUrl;
        l.fetchPriority = 'high';
        document.head.appendChild(l);

        // 3. Pre-decode image in memory and dispatch nb-bg-ready when 100% loaded
        var img = new Image();
        function markReady() {
          window.__nb_bg_ready = true;
          document.documentElement.style.setProperty('--nature-bg-opacity', "1");
          try { window.dispatchEvent(new CustomEvent('nb-bg-ready')); } catch(e){}
        }
        img.onload = markReady;
        img.onerror = markReady;
        img.src = bgUrl;
        if (img.complete) markReady();

        // Store state globally for SPA page transitions
        window.__nb_bg_idx = idx;
        window.__nb_total_bgs = TOTAL_BGS;
      })();
    </script>

    <!-- Prevent flash: apply stored theme or default light before paint -->
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
    </script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    {seo.keywords && <meta name="keywords" content={seo.keywords} />}
    {seo.author && <meta name="author" content={seo.author} />}
    <link rel="canonical" href={seo.canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.ogUrl} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content={seo.locale} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={seo.twitterTitle} />
    <meta name="twitter:description" content={seo.twitterDescription} />
    <meta name="twitter:image" content={seo.twitterImage} />

    <!-- Structured data -->
    <OrganizationSchema />
    <WebSiteSchema />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Analytics & SEO Verification Verification -->
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
    )}



    <!-- Microsoft Clarity -->
    {import.meta.env.PUBLIC_CLARITY_ID && (
      <script is:inline define:vars={{ clarityId: import.meta.env.PUBLIC_CLARITY_ID }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+clarityId;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window,document,"clarity","script");
      </script>
    )}



    <!-- Frosted Nature Background Styles -->
    <style>
      #nature-bg {
        position: fixed;
        inset: 0;
        z-index: -20;
        width: 100vw;
        height: 100vh;
        background-color: #e8f0e8;
        transform: translateZ(0);
        will-change: transform;
      }
      
      #nature-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-image: var(--nature-bg-url);
        opacity: var(--nature-bg-opacity, 0);
        transition: opacity 0.8s ease-in-out;
        z-index: -1;
      }
      
      /* In dark mode fallback color */
      html.dark #nature-bg {
        background-color: #090d16;
      }
      #nature-overlay {
        position: fixed;
        inset: 0;
        z-index: -10;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.0) 0%,
          rgba(255, 255, 255, 0.08) 100%
        );
        pointer-events: none;
        transform: translateZ(0);
      }
      .dark #nature-overlay {
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.25) 0%,
          rgba(0, 0, 0, 0.45) 100%
        );
      }
    </style>

    <!-- WebMCP Agent Tools Registration -->
    <script is:inline>
      if (navigator.modelContext && typeof navigator.modelContext.provideContext === 'function') {
        navigator.modelContext.provideContext({
          tools: [
            {
              name: "search_articles",
              description: "Search all articles, system prompts, comparisons, and tool reviews on the platform.",
              inputSchema: {
                type: "object",
                properties: {
                  query: { type: "string", description: "Search query string" }
                },
                required: ["query"]
              },
              execute: async ({ query }) => {
                window.location.href = `/search?q=${encodeURIComponent(query)}`;
                return { success: true, message: `Navigated to search for: ${query}` };
              }
            }
          ]
        });
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col text-ink dark:text-ink-dark" style="background: transparent;">
    <PageLoader />
    <!-- Full-screen Dynamic Nature Background -->
    <div id="nature-bg" role="presentation" aria-hidden="true"></div>
    <div id="nature-overlay" aria-hidden="true"></div>

    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-grow pb-64">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <!-- Scroll-reveal animations with immediate fold check & fallback -->
    <script is:inline>
      (function() {
        function initReveal() {
          var els = document.querySelectorAll('[data-reveal]');
          if (!els.length) return;

          // Immediate check for elements in/near viewport
          els.forEach(function(el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < (window.innerHeight || 800) + 150) {
              el.classList.add('revealed');
            }
          });

          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function(entries) {
              entries.forEach(function(e) {
                if (e.isIntersecting) {
                  e.target.classList.add('revealed');
                  io.unobserve(e.target);
                }
              });
            }, { threshold: 0.01, rootMargin: '150px 0px 150px 0px' });

            els.forEach(function(el) {
              if (!el.classList.contains('revealed')) {
                io.observe(el);
              }
            });
          } else {
            els.forEach(function(el) { el.classList.add('revealed'); });
          }

          // Safety fallback: ensure nothing stays invisible
          setTimeout(function() {
            els.forEach(function(el) { el.classList.add('revealed'); });
          }, 250);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal);
        } else {
          initReveal();
        }
        document.addEventListener('astro:page-load', initReveal);
      })();
    </script>

    <!-- Re-apply background image on Astro soft-navigation (page transitions) -->
    <script is:inline>
      (function() {
        function reloadBg() {
          var total = window.__nb_total_bgs || 20;
          var idx = (window.__nb_bg_idx + 1) % total;
          window.__nb_bg_idx = idx;

          var isMobile = typeof window !== 'undefined' && (window.innerWidth || 0) < 768;
          var url = (isMobile ? '/images/bg/mobile/bg-' : '/images/bg/bg-') + (idx + 1) + '.webp';
          
          // Fade out old background
          document.documentElement.style.setProperty('--nature-bg-opacity', '0');
          
          // Wait for fade out, then swap image and fade in after it loads
          setTimeout(() => {
            var img = new Image();
            img.onload = function() {
              document.documentElement.style.setProperty('--nature-bg-url', "url('" + url + "')");
              // Use a tiny delay to ensure the browser paints the new url before fading in
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  document.documentElement.style.setProperty('--nature-bg-opacity', '1');
                });
              });
            };
            img.src = url;
          }, 800); // 800ms matches the CSS transition time
        }

        document.addEventListener('astro:page-load', reloadBg);
      })();
    </script>
  </body>
</html>
