---
import {
  ADSENSE_PUBLISHER_ID,
  getAdSlotConfig,
  type AdType,
  type AdPosition,
} from '@/config/ads';

interface Props {
  type?: AdType;
  position?: AdPosition;
  slotId?: string;
  label?: string;
  noAds?: boolean;
  class?: string;
}

const {
  type = 'article',
  position = 'middle',
  slotId: overrideSlotId,
  label: overrideLabel,
  noAds = false,
  class: className = '',
} = Astro.props;

// Lookup slot configuration from single source of truth (src/config/ads.ts)
const resolvedConfig = getAdSlotConfig(type, position);

const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || ADSENSE_PUBLISHER_ID;
const slotId = overrideSlotId || resolvedConfig.slotId;
const label = overrideLabel || resolvedConfig.label;
const format = resolvedConfig.format;
const minHeightClass = resolvedConfig.minHeightClass;

/**
 * AdSense Approval Gating:
 * When Approval = No (default): Only the BaseLayout <head> verification script loads for site review.
 * When Approval = Yes (PUBLIC_ENABLE_ADSENSE=true or PUBLIC_ADSENSE_APPROVED=true): AdSlot components render and push ad units.
 */
const isApproved = import.meta.env.PUBLIC_ENABLE_ADSENSE === 'true' || import.meta.env.PUBLIC_ADSENSE_APPROVED === 'true';

// Only render ad units when account is approved, page does not opt out via noAds, and clientId is set
const shouldRender = isApproved && !noAds && !!clientId;
---

{shouldRender && (
  <aside
    class={`not-prose my-32 flex w-full flex-col items-center justify-center rounded-12 border border-border/60 bg-surface2/40 p-12 dark:border-border-dark/60 dark:bg-surface2-dark/40 ${minHeightClass} ${className}`}
    aria-label={label}
    data-ad-type={type}
    data-ad-position={position}
  >
    <div class="mb-6 w-full text-center text-[0.65rem] font-sans font-medium uppercase tracking-wider text-muted/70 dark:text-muted-dark/70">
      {label}
    </div>

    <ins
      class="adsbygoogle w-full"
      style="display:block"
      data-ad-client={clientId}
      {...(slotId ? { 'data-ad-slot': slotId } : {})}
      data-ad-format={format}
      data-full-width-responsive="true"
    />

    {/* Self-contained slot initialization */}
    <script is:inline>
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {
        console.warn('AdSense slot init error:', e);
      }
    </script>
  </aside>
)}
