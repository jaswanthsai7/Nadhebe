---
interface Props {
  slug: string;
  size?: number;
  class?: string;
}

const { slug, size = 32, class: className = '' } = Astro.props;
---

<div
  class={`inline-flex items-center justify-center shrink-0 rounded-12 bg-surface2 dark:bg-surface2-dark border border-border dark:border-border-dark shadow-sm text-ink dark:text-ink-dark p-8 ${className}`}
  style={`width:${size + 16}px;height:${size + 16}px;`}
>
  {slug === 'runpod' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent dark:text-accent-dark">
      <rect x="2" y="2" width="20" height="8" rx="2"></rect>
      <rect x="2" y="14" width="20" height="8" rx="2"></rect>
      <line x1="6" y1="6" x2="6.01" y2="6"></line>
      <line x1="6" y1="18" x2="6.01" y2="18"></line>
      <path d="M10 6h8"></path>
      <path d="M10 18h8"></path>
    </svg>
  )}

  {slug === 'vast-ai' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success dark:text-success-dark">
      <rect x="4" y="4" width="16" height="16" rx="2"></rect>
      <rect x="9" y="9" width="6" height="6"></rect>
      <line x1="9" y1="1" x2="9" y2="4"></line>
      <line x1="15" y1="1" x2="15" y2="4"></line>
      <line x1="9" y1="20" x2="9" y2="23"></line>
      <line x1="15" y1="20" x2="15" y2="23"></line>
      <line x1="20" y1="9" x2="23" y2="9"></line>
      <line x1="20" y1="15" x2="23" y2="15"></line>
      <line x1="1" y1="9" x2="4" y2="9"></line>
      <line x1="1" y1="15" x2="4" y2="15"></line>
    </svg>
  )}

  {slug === 'lambda' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent dark:text-accent-dark">
      <path d="M4 20l7-14 3.5 7"></path>
      <path d="M20 20l-9-18"></path>
    </svg>
  )}

  {slug === 'modal' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500">
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
    </svg>
  )}

  {slug === 'replicate' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-500">
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
      <line x1="12" y1="22.08" x2="12" y2="12"></line>
    </svg>
  )}

  {slug === 'cloudflare' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500">
      <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
    </svg>
  )}

  {slug === 'vercel' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 1L24 22H0L12 1Z"></path>
    </svg>
  )}

  {slug === 'anthropic' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.47 3H14.1l-6.8 18h3.33l1.41-3.82h6.86l1.41 3.82H23.6L17.47 3zm-4.32 11.45l2.42-6.55 2.42 6.55h-4.84zM6.53 3H.4L6.53 21h3.34L3.74 3h2.79z"></path>
    </svg>
  )}

  {slug === 'openrouter' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  )}

  {slug === 'elevenlabs' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class="text-purple-500">
      <rect x="4" y="4" width="4" height="16" rx="2"></rect>
      <rect x="16" y="4" width="4" height="16" rx="2"></rect>
    </svg>
  )}

  {slug === 'semrush' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600">
      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
    </svg>
  )}

  {slug === 'descript' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500">
      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
      <line x1="12" y1="19" x2="12" y2="22"></line>
    </svg>
  )}

  {slug === 'synthesia' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-500">
      <polygon points="23 7 16 12 23 17 23 7"></polygon>
      <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
    </svg>
  )}

  {slug === 'cursor' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-400">
      <path d="m3 3 7.07 16.97 2.51-7.39 7.39-2.51L3 3z"></path>
      <path d="m13 13 6 6"></path>
    </svg>
  )}

  {slug === 'digitalocean' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class="text-blue-500">
      <path d="M12 0C5.37 0 0 5.37 0 12c0 3.31 1.34 6.31 3.51 8.49l2.42-2.42C4.42 16.56 3.43 14.4 3.43 12c0-4.73 3.84-8.57 8.57-8.57 4.73 0 8.57 3.84 8.57 8.57 0 4.73-3.84 8.57-8.57 8.57v3.43C18.63 24 24 18.63 24 12 24 5.37 18.63 0 12 0zm-5.14 18.86h3.43v3.43H6.86v-3.43zm-3.43-3.43h3.43v3.43H3.43v-3.43z"></path>
    </svg>
  )}

  {slug === 'vultr' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class="text-blue-600">
      <path d="M12 1.5L0 22.5h6l6-10.5 6 10.5h6L12 1.5z"></path>
    </svg>
  )}
</div>
