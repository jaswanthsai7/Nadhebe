---
import { SITE } from '@/config';

interface Props {
  breadcrumbs: {
    label: string;
    url: string;
  }[];
}

const { breadcrumbs } = Astro.props;
const baseUrl = SITE.url.endsWith('/') ? SITE.url : `${SITE.url}/`;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs ? breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": item.url.startsWith('http') ? item.url : new URL(item.url.replace(/^\//, ''), baseUrl).toString()
  })) : []
};
---

{breadcrumbs && breadcrumbs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
