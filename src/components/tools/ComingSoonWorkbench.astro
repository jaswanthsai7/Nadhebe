---
import type { PlatformTool } from '@/config/platform-tools';

interface Props {
  tool: PlatformTool;
}

const { tool } = Astro.props;
---

<div class="coming-soon-workbench space-y-24">
  <div class="relative overflow-hidden rounded-24 border border-border bg-surface/95 p-24 sm:p-36 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/95">
    <div class="pointer-events-none absolute -right-40 -top-40 h-80 w-80 rounded-full bg-accent/10 blur-3xl dark:bg-accent-dark/10"></div>
    
    <div class="flex flex-wrap items-center justify-between gap-12 border-b border-border/80 pb-20 dark:border-border-dark/80">
      <div class="flex items-center gap-12">
        <a
          href="/tools/"
          class="inline-flex items-center gap-6 rounded-8 border border-border bg-surface2 px-16 py-8 text-caption font-sans font-semibold text-ink shadow-subtle transition-all hover:border-accent hover:bg-surface dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-16 w-16 shrink-0 text-accent dark:text-accent-dark"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          <span>Back to All Tools</span>
        </a>

        <button
          type="button"
          data-platform-goback
          class="inline-flex items-center gap-6 rounded-8 border border-border bg-surface2 px-16 py-8 text-caption font-sans font-semibold text-ink2 transition-all hover:text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink2-dark dark:hover:text-ink-dark"
        >
          Go Back
        </button>
      </div>

      <div class="flex items-center gap-8">
        <span class="inline-flex items-center gap-6 rounded-pill bg-amber-500/10 px-12 py-4 font-mono text-xs font-semibold text-amber-600 dark:text-amber-400">
          <span class="h-6 w-6 rounded-full bg-amber-500 animate-pulse"></span>
          Status: In Development • Planned Release
        </span>
      </div>
    </div>

    <div class="mt-24 space-y-24">
      <div class="space-y-8">
        <div class="flex flex-wrap items-center gap-8">
          <span class="rounded-6 bg-accent/10 px-8 py-2 font-mono text-xs font-bold uppercase text-accent dark:bg-accent-dark/10 dark:text-accent-dark">{tool.category}</span>
          <span class="font-mono text-xs text-muted dark:text-muted-dark">Category: {tool.categorySlug}</span>
        </div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl dark:text-ink-dark">{tool.name}</h1>
        <p class="max-w-3xl font-sans text-base leading-relaxed text-ink2 dark:text-ink2-dark">{tool.description}</p>
      </div>

      <div class="rounded-16 border border-border/80 bg-surface2/50 p-20 dark:border-border-dark/80 dark:bg-surface2-dark/50 space-y-12">
        <h2 class="font-sans text-sm font-bold uppercase tracking-wider text-ink dark:text-ink-dark">Planned Functionality</h2>
        <ul class="grid gap-12 sm:grid-cols-2 font-sans text-sm text-ink2 dark:text-ink2-dark">
          <li class="flex items-start gap-10">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-16 w-16 shrink-0 text-emerald-500 mt-2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>100% Client-side local execution with zero data server uploads</span>
          </li>
          <li class="flex items-start gap-10">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-16 w-16 shrink-0 text-emerald-500 mt-2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Domain-specific parsing, strict validation, and instant formatting</span>
          </li>
          <li class="flex items-start gap-10">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-16 w-16 shrink-0 text-emerald-500 mt-2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>One-click output copy, text download, and drag-and-drop file support</span>
          </li>
          <li class="flex items-start gap-10">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-16 w-16 shrink-0 text-emerald-500 mt-2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Responsive keyboard-accessible interface and instant preview</span>
          </li>
        </ul>
      </div>

      <div class="space-y-12 pt-12">
        <h2 class="font-sans text-sm font-bold uppercase tracking-wider text-ink dark:text-ink-dark">Explore Working Tools Available Now</h2>
        <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
          <a href="/tools/json-formatter/" class="group rounded-12 border border-border bg-surface p-16 shadow-subtle transition-all hover:border-accent hover:shadow-medium dark:border-border-dark dark:bg-surface-dark">
            <div class="font-sans text-sm font-bold text-ink group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">JSON Formatter</div>
            <div class="font-sans text-xs text-muted line-clamp-1 dark:text-muted-dark">Beautify & validate JSON</div>
          </a>
          <a href="/tools/csv-to-json/" class="group rounded-12 border border-border bg-surface p-16 shadow-subtle transition-all hover:border-accent hover:shadow-medium dark:border-border-dark dark:bg-surface-dark">
            <div class="font-sans text-sm font-bold text-ink group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">CSV to JSON</div>
            <div class="font-sans text-xs text-muted line-clamp-1 dark:text-muted-dark">Convert tabular data</div>
          </a>
          <a href="/tools/uuid-generator/" class="group rounded-12 border border-border bg-surface p-16 shadow-subtle transition-all hover:border-accent hover:shadow-medium dark:border-border-dark dark:bg-surface-dark">
            <div class="font-sans text-sm font-bold text-ink group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">UUID Generator</div>
            <div class="font-sans text-xs text-muted line-clamp-1 dark:text-muted-dark">Generate v4 UUIDs</div>
          </a>
          <a href="/tools/aspect-ratio-calculator/" class="group rounded-12 border border-border bg-surface p-16 shadow-subtle transition-all hover:border-accent hover:shadow-medium dark:border-border-dark dark:bg-surface-dark">
            <div class="font-sans text-sm font-bold text-ink group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">Aspect Ratio Calculator</div>
            <div class="font-sans text-xs text-muted line-clamp-1 dark:text-muted-dark">Calculate dimensions</div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
