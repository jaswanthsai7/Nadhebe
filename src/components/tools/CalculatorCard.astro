---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<div class={`glass-panel relative rounded-20 border border-border bg-surface/95 p-24 sm:p-36 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/95 ${className}`} data-reveal>
  {title && (
    <div class="mb-24 pb-16 border-b border-border dark:border-border-dark">
      <h2 class="font-display text-h3 font-bold text-ink dark:text-ink-dark tracking-tight">{title}</h2>
      {description && <p class="mt-6 text-body text-ink2 dark:text-ink2-dark leading-relaxed">{description}</p>}
    </div>
  )}
  <slot />
</div>
