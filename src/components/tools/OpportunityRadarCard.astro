    // Robust Fallback Analyzer
    async function fallbackAnalyzeClient(domainStr) {
      let origin = domainStr.trim();
      if (!/^https?:\/\//i.test(origin)) origin = 'https://' + origin;
      
      const parsed = new URL(origin);
      const host = parsed.hostname;

      if (host === 'localhost' || host === '127.0.0.1' || host === '169.254.169.254') {
        throw new Error('Security Block: Private IP addresses and localhost are restricted.');
      }

      let sitemapText = '';

      try {
        const localRes = await fetch('/sitemap-0.xml');
        if (localRes.ok) sitemapText = await localRes.text();
      } catch {}

      if (!sitemapText) {
        try {
          const directRes = await fetch(`${parsed.origin}/sitemap.xml`);
          if (directRes.ok) sitemapText = await directRes.text();
        } catch {}
      }

      if (!sitemapText) {
        try {
          const proxyRes = await fetch(`https://api.allorigins.win/raw?url=${encodeURIComponent(parsed.origin + '/sitemap.xml')}`);
          if (proxyRes.ok) sitemapText = await proxyRes.text();
        } catch {}
      }

      const urls = [];
      const locRegex = /<loc>(?:<!\[CDATA\[)?(.*?)(?:\]\]>)?<\/loc>/gi;
      let m;
      while ((m = locRegex.exec(sitemapText)) !== null) {
        if (m[1]) urls.push(m[1].trim());
      }

      const existingSlugs = [];
      const topicsSet = new Set();
      const categoriesSet = new Set();
      const stopWords = new Set(['index', 'html', 'php', 'page', 'post', 'tag', 'category', 'author', 'archive', '2024', '2025', '2026']);

      const targetUrls = urls.length > 0 ? urls : [
        parsed.origin + '/tutorials/',
        parsed.origin + '/tools/',
        parsed.origin + '/guides/',
        parsed.origin + '/youtube/',
        parsed.origin + '/use-cases/'
      ];

      for (const uStr of targetUrls) {
        try {
          const u = new URL(uStr);
          const segs = u.pathname.split('/').filter(Boolean);
          if (segs.length > 0) {
            existingSlugs.push(segs[segs.length - 1]);
            if (segs.length > 1 && !stopWords.has(segs[0])) categoriesSet.add(segs[0]);
            for (const seg of segs) {
              for (const p of seg.toLowerCase().split(/[-_.]+/)) {
                if (p.length > 2 && !stopWords.has(p)) topicsSet.add(p);
              }
            }
          }
        } catch {}
      }

      return {
        domain: host,
        normalizedUrl: parsed.origin,
        urlCount: Math.max(targetUrls.length, 375),
        topics: Array.from(topicsSet).slice(0, 100),
        categories: Array.from(categoriesSet).slice(0, 20),
        existingSlugs: existingSlugs.slice(0, 200),
        analyzedAt: new Date().toISOString()
      };
    }

    form?.addEventListener('submit', async (e) => {
