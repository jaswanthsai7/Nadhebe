---
// Nadhebe Opportunity Radar Interactive Calculator & Results Card
---

<div class="space-y-32">
  <!-- Clean Prominent Domain Input & Form Card -->
  <div class="rounded-24 border border-border/80 bg-surface/95 p-28 sm:p-36 shadow-soft backdrop-blur-xl dark:border-border-dark/80 dark:bg-surface-dark/95 no-print max-w-840 mx-auto" data-reveal>
    <form id="radar-form" class="space-y-20">
      <div class="text-center space-y-16">
        <label for="domain-input" class="block text-h2 font-sans font-bold text-ink dark:text-ink-dark tracking-tight">
          Analyze Website Domain
        </label>
        <div class="relative flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-12 sm:gap-16 w-full max-w-760 mx-auto">
          <input
            type="text"
            id="domain-input"
            placeholder="e.g. nadhebe.com or stripe.com"
            value="nadhebe.com"
            required
            class="w-full sm:flex-1 min-w-0 rounded-16 border border-border bg-surface px-24 py-18 sm:px-28 sm:py-22 text-[22px] sm:text-[30px] font-sans font-bold text-ink placeholder:text-muted focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark dark:placeholder:text-muted-dark dark:focus:border-accent-dark transition-all shadow-soft"
          />
          <button
            type="submit"
            id="radar-submit"
            class="w-full sm:w-auto shrink-0 rounded-16 bg-accent px-32 py-18 sm:px-40 sm:py-22 text-[20px] sm:text-[26px] font-sans font-extrabold text-white shadow-soft hover:bg-accent/90 focus:outline-none transition-all cursor-pointer inline-flex items-center justify-center gap-10 whitespace-nowrap dark:bg-accent-dark dark:hover:bg-accent-dark/90"
          >
            <span>Analyze</span>
            <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </div>
      </div>
    </form>

    <!-- Brief Visual Explanatory Steps (Clean Flex Inline Alignment) -->
    <div class="mt-24 pt-20 border-t border-border/60 dark:border-border-dark/60 grid grid-cols-2 sm:grid-cols-4 gap-12 text-body-small">
      <div class="flex items-center justify-center gap-8 text-ink dark:text-ink-dark font-medium">
        <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-accent/15 font-mono text-caption font-bold text-accent dark:bg-accent-dark/25 dark:text-accent-dark">1</span>
        <span>Analyze site</span>
      </div>
      <div class="flex items-center justify-center gap-8 text-ink dark:text-ink-dark font-medium">
        <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-accent/15 font-mono text-caption font-bold text-accent dark:bg-accent-dark/25 dark:text-accent-dark">2</span>
        <span>Extract topics</span>
      </div>
      <div class="flex items-center justify-center gap-8 text-ink dark:text-ink-dark font-medium">
        <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-accent/15 font-mono text-caption font-bold text-accent dark:bg-accent-dark/25 dark:text-accent-dark">3</span>
        <span>Compare trends</span>
      </div>
      <div class="flex items-center justify-center gap-8 text-ink dark:text-ink-dark font-medium">
        <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-accent/15 font-mono text-caption font-bold text-accent dark:bg-accent-dark/25 dark:text-accent-dark">4</span>
        <span>Surface gaps</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div id="radar-loading" class="hidden rounded-24 border border-border/80 bg-surface/90 p-32 text-center shadow-soft backdrop-blur-xl dark:border-border-dark/80 dark:bg-surface-dark/90 no-print max-w-840 mx-auto">
    <div class="inline-flex items-center justify-center p-16 rounded-full bg-accent/10 mb-16 dark:bg-accent-dark/20">
      <svg style="width: 32px; height: 32px;" class="animate-spin text-accent dark:text-accent-dark" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>
    <h3 class="text-h3 font-sans font-bold text-ink dark:text-ink-dark mb-8" id="loading-title">Scanning Website Sitemap</h3>
    <p class="text-body-small text-muted dark:text-muted-dark" id="loading-step">Discovering public sitemap and extracting content coverage...</p>
  </div>

  <!-- Error State -->
  <div id="radar-error" class="hidden rounded-20 border border-red-500/30 bg-red-500/5 p-24 text-red-600 dark:border-red-400/30 dark:bg-red-500/10 dark:text-red-400 no-print max-w-840 mx-auto">
    <div class="flex items-start gap-12">
      <svg style="width: 24px; height: 24px;" class="shrink-0 mt-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <h4 class="font-sans font-bold text-body" id="error-title">Analysis Failure</h4>
        <p class="text-body-small mt-4 opacity-90" id="error-message">We couldn't locate a public sitemap for this website.</p>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div id="radar-results" class="hidden space-y-32">
    <!-- Analysis Summary Banner -->
    <div class="rounded-24 border border-border/80 bg-surface/90 p-24 sm:p-32 shadow-soft backdrop-blur-xl dark:border-border-dark/80 dark:bg-surface-dark/90 space-y-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-16 pb-16 border-b border-border/60 dark:border-border-dark/60">
        <div>
          <span class="rounded-pill bg-accent/10 px-12 py-4 font-mono text-caption font-bold text-accent dark:bg-accent-dark/20 dark:text-accent-dark uppercase tracking-wider">
            Analysis Complete
          </span>
          <h2 class="text-h2 font-sans font-extrabold text-ink dark:text-ink-dark mt-8" id="results-headline">
            5 Content Opportunities Worth Exploring
          </h2>
          <p class="text-body-small text-muted dark:text-muted-dark mt-4" id="results-subtitle">
            We analyzed 375 pages on nadhebe.com and found 5 high-impact content gaps.
          </p>
        </div>

        <!-- Export Actions (Clean Standard Sizing) -->
        <div class="flex items-center gap-10 flex-wrap shrink-0 no-print">
          <button
            type="button"
            id="btn-export-pdf"
            class="rounded-12 border border-border bg-surface px-16 py-10 text-body-small font-sans font-bold text-ink hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark dark:hover:border-accent-dark cursor-pointer transition-all inline-flex items-center gap-8 shadow-soft shrink-0 whitespace-nowrap"
          >
            <svg style="width: 16px; height: 16px;" class="text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Export PDF / Print</span>
          </button>
          <button
            type="button"
            id="btn-copy-md"
            class="rounded-12 border border-border bg-surface px-16 py-10 text-body-small font-sans font-bold text-ink hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark dark:hover:border-accent-dark cursor-pointer transition-all inline-flex items-center gap-8 shadow-soft shrink-0 whitespace-nowrap"
          >
            <svg style="width: 16px; height: 16px;" class="text-ink dark:text-ink-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span>Copy Markdown Report</span>
          </button>
        </div>
      </div>

      <div class="flex items-center gap-12 flex-wrap">
        <span class="rounded-pill bg-accent/10 px-12 py-6 font-mono text-caption font-bold text-accent dark:bg-accent-dark/20 dark:text-accent-dark" id="pill-opp-count">
          5 Opportunities
        </span>
        <span class="rounded-pill border border-border bg-surface2 px-12 py-6 font-mono text-caption text-muted dark:border-border-dark dark:bg-surface2-dark dark:text-muted-dark" id="pill-url-count">
          375 Pages Analyzed
        </span>
        <button
          type="button"
          id="btn-view-saved"
          class="rounded-pill border border-accent/40 bg-accent/10 px-14 py-8 font-mono text-body-small font-bold text-accent hover:bg-accent hover:text-white dark:border-accent-dark/40 dark:bg-accent-dark/20 dark:text-accent-dark dark:hover:bg-accent-dark dark:hover:text-white cursor-pointer transition-all inline-flex items-center gap-8 shrink-0 whitespace-nowrap"
        >
          <span>Saved Opportunities</span>
          <span id="saved-badge" class="inline-flex items-center justify-center rounded-full bg-accent px-8 py-2 text-caption font-mono font-bold text-white dark:bg-accent-dark leading-none">0</span>
        </button>
      </div>
    </div>

    <!-- Saved Opportunities Drawer -->
    <div id="saved-queue-drawer" class="hidden rounded-24 border border-accent/40 bg-accent/5 p-24 space-y-16 dark:border-accent-dark/40 dark:bg-accent-dark/5 no-print">
      <div class="flex items-center justify-between gap-12 pb-12 border-b border-accent/20 dark:border-accent-dark/20">
        <h3 class="text-h3 font-sans font-bold text-ink dark:text-ink-dark flex items-center gap-8">
          <span>Saved Research Queue</span>
          <span class="text-caption font-mono font-normal text-muted dark:text-muted-dark">(Saved to LocalStorage)</span>
        </h3>
        <div class="flex items-center gap-8">
          <button type="button" id="btn-clear-saved" class="text-caption font-mono text-muted hover:text-red-500 dark:text-muted-dark dark:hover:text-red-400 cursor-pointer">
            Clear Queue
          </button>
        </div>
      </div>
      <div id="saved-items-container" class="space-y-8"></div>
    </div>

    <!-- Featured #1 Hero Card ("YOUR BEST OPPORTUNITY") -->
    <div id="hero-opportunity-card"></div>

    <!-- Secondary Opportunities ("MORE OPPORTUNITIES") -->
    <div class="mt-32 space-y-16">
      <h3 class="text-body-small font-mono font-bold uppercase tracking-wider text-muted dark:text-muted-dark py-4">
        More Content Opportunities
      </h3>
      <div id="secondary-opportunities-list" class="space-y-12"></div>
    </div>
  </div>
</div>

<!-- Native UI Glassmorphism Research Brief Modal -->
<div id="research-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/60 p-16 backdrop-blur-md no-print">
  <div class="relative w-full max-w-640 rounded-24 border border-border/80 bg-surface p-24 sm:p-32 shadow-medium dark:border-border-dark/80 dark:bg-surface-dark space-y-20 max-h-[90vh] overflow-y-auto">
    <button
      type="button"
      id="modal-close"
      class="absolute top-20 right-20 rounded-full p-8 text-muted hover:bg-surface2 hover:text-ink dark:text-muted-dark dark:hover:bg-surface2-dark dark:hover:text-ink-dark cursor-pointer transition-all"
    >
      <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div>
      <span class="rounded-pill bg-accent/10 px-10 py-4 font-mono text-caption font-bold text-accent dark:bg-accent-dark/20 dark:text-accent-dark">
        Topic Research Brief
      </span>
      <h3 class="text-h3 font-sans font-bold text-ink dark:text-ink-dark pt-8" id="modal-title">
        Claude Code MCP Servers
      </h3>
    </div>

    <!-- Metrics Summary -->
    <div class="grid grid-cols-3 gap-8 rounded-12 bg-surface2/60 p-12 text-center dark:bg-surface2-dark/60 border border-border/60 dark:border-border-dark/60">
      <div>
        <span class="block text-caption font-mono text-muted dark:text-muted-dark">Opportunity Score</span>
        <span class="text-h3 font-mono font-extrabold text-accent dark:text-accent-dark" id="modal-score">94/100</span>
      </div>
      <div>
        <span class="block text-caption font-mono text-muted dark:text-muted-dark">Relevance</span>
        <span class="text-h3 font-mono font-bold text-ink dark:text-ink-dark" id="modal-relevance">97%</span>
      </div>
      <div>
        <span class="block text-caption font-mono text-muted dark:text-muted-dark">Content Gap</span>
        <span class="text-h3 font-mono font-bold text-accent dark:text-accent-dark" id="modal-gap">High</span>
      </div>
    </div>

    <!-- Suggested Outline -->
    <div class="space-y-12">
      <h4 class="text-caption font-mono font-bold uppercase text-muted dark:text-muted-dark">Recommended Article Outline</h4>
      <div class="rounded-12 border border-border bg-surface2/40 p-16 space-y-10 text-body-small text-ink dark:border-border-dark dark:bg-surface2-dark/40 dark:text-ink-dark" id="modal-outline">
        <p><strong>H1:</strong> Complete Guide to Claude Code MCP Servers</p>
        <p><strong>Key Focus:</strong> How developers can integrate Model Context Protocol (MCP) plugins to give Claude Code CLI contextual filesystem and API access.</p>
        <p><strong>Target Audience:</strong> AI engineers, full-stack developers, and automated workflow creators.</p>
      </div>
    </div>

    <!-- Modal Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-12 pt-16 border-t border-border/60 dark:border-border-dark/60">
      <button
        type="button"
        id="modal-copy-outline"
        class="w-full sm:w-auto rounded-12 bg-accent px-20 py-12 text-body-small font-sans font-bold text-white shadow-soft hover:bg-accent/90 dark:bg-accent-dark dark:hover:bg-accent-dark/90 cursor-pointer transition-all inline-flex items-center justify-center gap-6 whitespace-nowrap"
      >
        <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span>Copy Outline (Markdown)</span>
      </button>
      <button
        type="button"
        id="modal-pdf"
        class="w-full sm:w-auto rounded-12 border border-border bg-surface2 px-20 py-12 text-body-small font-sans font-bold text-ink hover:border-accent hover:text-accent dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark dark:hover:border-accent-dark cursor-pointer transition-all inline-flex items-center justify-center gap-6 whitespace-nowrap"
      >
        <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span>Print / PDF</span>
      </button>
    </div>
  </div>
</div>

<!-- Floating Native UI Toast Notification -->
<div id="radar-toast" class="fixed bottom-24 right-24 z-50 hidden rounded-16 border border-accent/40 bg-surface/95 px-20 py-14 shadow-medium text-body-small font-sans font-semibold text-ink backdrop-blur-xl dark:border-accent-dark/40 dark:bg-surface-dark/95 dark:text-ink-dark transition-all transform duration-300 translate-y-8 opacity-0">
  <div class="flex items-center gap-8">
    <span class="flex h-20 w-20 items-center justify-center rounded-full bg-accent/20 text-accent dark:bg-accent-dark/20 dark:text-accent-dark">✓</span>
    <span id="toast-message">Opportunity saved to research queue</span>
  </div>
</div>

<style>
  @media print {
    .no-print, header, footer, nav, button {
      display: none !important;
    }
    body {
      background: white !important;
      color: black !important;
    }
    #radar-results {
      display: block !important;
    }
    .rounded-24, .rounded-20 {
      border: 1px solid #ccc !important;
      box-shadow: none !important;
      page-break-inside: avoid;
      margin-bottom: 20px !important;
    }
  }
</style>

<script is:inline>
  (function() {
    const form = document.getElementById('radar-form');
    const domainInput = document.getElementById('domain-input');
    const loadingState = document.getElementById('radar-loading');
    const loadingStep = document.getElementById('loading-step');
    const errorState = document.getElementById('radar-error');
    const errorMessage = document.getElementById('error-message');
    const resultsSection = document.getElementById('radar-results');
    const resultsHeadline = document.getElementById('results-headline');
    const resultsSubtitle = document.getElementById('results-subtitle');
    const pillOppCount = document.getElementById('pill-opp-count');
    const pillUrlCount = document.getElementById('pill-url-count');
    const heroCardContainer = document.getElementById('hero-opportunity-card');
    const secondaryListContainer = document.getElementById('secondary-opportunities-list');

    const btnExportPdf = document.getElementById('btn-export-pdf');
    const btnCopyMd = document.getElementById('btn-copy-md');
    const btnViewSaved = document.getElementById('btn-view-saved');
    const savedBadge = document.getElementById('saved-badge');
    const savedQueueDrawer = document.getElementById('saved-queue-drawer');
    const savedItemsContainer = document.getElementById('saved-items-container');
    const btnClearSaved = document.getElementById('btn-clear-saved');

    const researchModal = document.getElementById('research-modal');
    const modalClose = document.getElementById('modal-close');
    const modalTitle = document.getElementById('modal-title');
    const modalScore = document.getElementById('modal-score');
    const modalRelevance = document.getElementById('modal-relevance');
    const modalGap = document.getElementById('modal-gap');
    const modalOutline = document.getElementById('modal-outline');
    const modalCopyOutline = document.getElementById('modal-copy-outline');
    const modalPdf = document.getElementById('modal-pdf');

    const toast = document.getElementById('radar-toast');
    const toastMsg = document.getElementById('toast-message');

    let currentOpportunities = [];
    let currentDomain = '';

    const STORAGE_KEY = 'nadhebe_saved_opportunities';

    function getSavedOpportunities() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveOpportunityItem(opp) {
      const saved = getSavedOpportunities();
      if (!saved.some(item => item.topic === opp.topic)) {
        saved.push(opp);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
        updateSavedUI();
        showToast(`✓ "${opp.topic}" saved to your research queue`);
      } else {
        showToast(`"${opp.topic}" is already in your saved queue`);
      }
    }

    function removeSavedOpportunity(topic) {
      let saved = getSavedOpportunities();
      saved = saved.filter(item => item.topic !== topic);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      updateSavedUI();
      showToast('Removed topic from saved queue');
    }

    function updateSavedUI() {
      const saved = getSavedOpportunities();
      if (savedBadge) savedBadge.textContent = String(saved.length);

      if (savedItemsContainer) {
        if (saved.length === 0) {
          savedItemsContainer.innerHTML = '<p class="text-body-small text-muted dark:text-muted-dark">No saved opportunities yet. Click "Save Opportunity" on any topic card to bookmark it.</p>';
        } else {
          savedItemsContainer.innerHTML = saved.map(item => `
            <div class="flex items-center justify-between gap-12 rounded-12 border border-border bg-surface p-12 dark:border-border-dark dark:bg-surface-dark">
              <div>
                <span class="text-body font-sans font-bold text-ink dark:text-ink-dark">${item.topic}</span>
                <span class="text-caption font-mono text-accent dark:text-accent-dark ml-8">(Score: ${item.totalScore}/100)</span>
                <p class="text-caption font-mono text-muted dark:text-muted-dark mt-2">→ ${item.suggestedWriteTitle}</p>
              </div>
              <button type="button" data-remove-topic="${item.topic}" class="btn-remove-saved rounded-6 border border-border px-8 py-4 text-caption font-mono text-muted hover:text-red-500 dark:border-border-dark cursor-pointer">
                Remove
              </button>
            </div>
          `).join('');

          document.querySelectorAll('.btn-remove-saved').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const topic = e.currentTarget.getAttribute('data-remove-topic');
              if (topic) removeSavedOpportunity(topic);
            });
          });
        }
      }
    }

    btnViewSaved?.addEventListener('click', () => {
      savedQueueDrawer?.classList.toggle('hidden');
    });

    btnClearSaved?.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      updateSavedUI();
      showToast('Saved research queue cleared');
    });

    function showToast(msg) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.remove('translate-y-8', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
      }, 10);

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-8', 'opacity-0');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    }

    function extractKeywords(text) {
      const stop = new Set(['how', 'to', 'for', 'the', 'and', 'in', 'of', 'a', 'an', 'with', 'on', 'at', 'by', 'is', 'are', 'guide', 'tutorial']);
      return text.toLowerCase().split(/[\s/_\-:,.\s]+/).filter(t => t.length > 1 && !stop.has(t));
    }

    const CURATED_TRENDS = [
      {
        id: 'claude-code-mcp',
        topic: 'Claude Code MCP Servers',
        aliases: ['claude code mcp', 'mcp servers claude', 'model context protocol claude', 'claude code skills'],
        category: 'AI Developer Tools',
        sourceType: 'curated',
        source: 'Nadhebe Developer Radar',
        relatedQueries: [
          'How to Connect MCP Servers to Claude Code CLI',
          'Best MCP servers for developer workflows',
          'Building custom MCP plugins for Claude Code'
        ]
      },
      {
