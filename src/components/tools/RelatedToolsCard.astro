---
import { getRelatedTools } from '@/config/tools';
import type { ToolMetadata } from '@/config/tools';

interface Props {
  currentToolId: string;
  title?: string;
  limit?: number;
}

const { currentToolId, title = 'Related Free Utilities', limit = 4 } = Astro.props;
const relatedTools: ToolMetadata[] = getRelatedTools(currentToolId, limit);
---

<section class="mt-48 pt-32 border-t border-border/60 dark:border-border-dark/60" data-reveal>
  <div class="flex items-center justify-between mb-20">
    <h2 class="font-display text-h3 font-semibold text-ink dark:text-ink-dark">{title}</h2>
    <a href="/tools/" class="text-caption font-sans font-medium text-accent hover:underline dark:text-accent-dark">View all tools &rarr;</a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-16">
    {relatedTools.map((tool) => (
      <a
        href={tool.href}
        class="glass-panel group relative flex flex-col justify-between rounded-16 border border-border/80 p-16 shadow-soft hover:border-accent/50 hover:shadow-medium transition-all duration-200 dark:border-border-dark/80 dark:hover:border-accent-dark/50"
      >
        <div>
          <div class="flex items-center justify-between gap-8 mb-8">
            <span class="rounded-6 bg-surface2 px-8 py-2 font-mono text-xs font-semibold text-muted dark:bg-surface2-dark dark:text-muted-dark">
              {tool.category}
            </span>
            {tool.badge && (
              <span class="rounded-pill bg-accent/10 px-8 py-2 font-mono text-xs text-accent dark:bg-accent-dark/20 dark:text-accent-dark font-medium">
                {tool.badge}
              </span>
            )}
          </div>

          <h3 class="font-display text-h4 font-semibold text-ink group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark transition-colors duration-150">
            {tool.name}
          </h3>
          <p class="mt-6 text-xs text-ink2 dark:text-ink2-dark line-clamp-2 leading-relaxed">
            {tool.description}
          </p>
        </div>

        <div class="mt-12 pt-12 border-t border-border/40 dark:border-border-dark/40 flex items-center justify-end text-xs font-semibold text-accent dark:text-accent-dark group-hover:translate-x-1 transition-transform duration-150">
          Open tool &rarr;
        </div>
      </a>
    ))}
  </div>
</section>
