---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RelatedToolsCard from '@/components/tools/RelatedToolsCard.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  targetKeyword: string;
  slug: string;
  ratio: string;
  dimensions?: string;
  orientation?: string;
}

const {
  title,
  description,
  h1,
  targetKeyword,
  slug,
  ratio,
  dimensions = '',
  orientation = 'Portrait',
} = Astro.props;

const currentUrl = `https://nadhebe.com/tools/aspect-ratio/${slug}/`;

const jsonLdBlocks = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${currentUrl}#webpage`,
    url: currentUrl,
    name: title,
    description: description,
    publisher: {
      '@type': 'Organization',
      name: 'Nadhebe',
      url: 'https://nadhebe.com/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nadhebe.com/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nadhebe.com/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Aspect Ratio Calculator', item: 'https://nadhebe.com/tools/aspect-ratio-calculator/' },
      { '@type': 'ListItem', position: 4, name: h1, item: currentUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalUrl={currentUrl} jsonLd={jsonLdBlocks}>
  <div class="mx-auto max-w-content px-16 sm:px-24 py-32 sm:py-48">
    <Breadcrumb
      items={[
        { name: 'Home', href: '/' },
        { name: 'Tools', href: '/tools/' },
        { name: 'Aspect Ratio', href: '/tools/aspect-ratio-calculator/' },
        { name: h1, href: currentUrl },
      ]}
    />

    <!-- Header Section -->
    <header class="glass-panel mb-32 rounded-24 border border-border bg-surface/90 p-24 sm:p-40 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/90" data-reveal>
      <div class="flex flex-wrap items-center gap-12 mb-16">
        <span class="inline-flex items-center gap-6 rounded-pill border border-accent/40 bg-accent/15 px-12 py-6 font-mono text-xs font-semibold text-accent dark:text-accent-dark">
          Ratio Preset Resource
        </span>
        <span class="rounded-pill border border-border bg-surface2 px-12 py-6 font-mono text-xs font-semibold text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark">
          Ratio: {ratio}
        </span>
        {dimensions && (
          <span class="rounded-pill border border-border bg-surface2 px-12 py-6 font-mono text-xs font-semibold text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark">
            {dimensions}
          </span>
        )}
      </div>

      <h1 class="font-display text-h1 sm:text-display font-bold text-ink dark:text-ink-dark leading-tight tracking-tight">
        {h1}
      </h1>
      <p class="mt-12 text-body-large text-ink2 dark:text-ink2-dark max-w-3xl leading-relaxed">
        {description}
      </p>
    </header>

    <div class="space-y-48">
      <slot />
    </div>

    <!-- Related Tools Interlinking -->
    <div class="mt-64">
      <RelatedToolsCard currentToolId="aspect-ratio-calculator" />
    </div>
  </div>
</BaseLayout>
