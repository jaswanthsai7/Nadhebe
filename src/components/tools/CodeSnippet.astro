---
interface Props {
  title?: string;
  cssSnippet: string;
  tailwindSnippet?: string;
  htmlSnippet?: string;
  id?: string;
}

const {
  title = 'Copyable Developer Snippets',
  cssSnippet,
  tailwindSnippet,
  htmlSnippet,
  id = 'code-snippet-box',
} = Astro.props;
---

<div class="glass-panel rounded-20 border border-border/80 bg-surface/90 p-20 shadow-medium backdrop-blur-xl dark:border-border-dark/80 dark:bg-surface-dark/90" id={id}>
  <div class="flex items-center justify-between gap-12 mb-16">
    <h3 class="font-display text-h4 font-semibold text-ink dark:text-ink-dark">{title}</h3>
    <span class="rounded-pill bg-surface2 px-10 py-4 font-mono text-xs font-medium text-muted dark:bg-surface2-dark dark:text-muted-dark">CSS / Tailwind / HTML</span>
  </div>

  <div class="space-y-16">
    <!-- CSS Standard -->
    <div>
      <div class="flex items-center justify-between gap-8 mb-6 text-xs font-mono text-muted dark:text-muted-dark">
        <span class="font-medium">CSS Property</span>
        <button
          type="button"
          data-copy-trigger
          data-copy-val={cssSnippet}
          class="inline-flex items-center gap-4 text-xs font-semibold text-accent hover:underline dark:text-accent-dark cursor-pointer transition-colors"
        >
          Copy CSS
        </button>
      </div>
      <pre class="rounded-12 bg-surface2/70 p-12 font-mono text-xs text-ink dark:bg-surface2-dark/70 dark:text-ink-dark border border-border/60 dark:border-border-dark/60 whitespace-pre-wrap break-all [overflow-wrap:anywhere]"><code>{cssSnippet}</code></pre>
    </div>

    <!-- Tailwind Equivalent -->
    {tailwindSnippet && (
      <div>
        <div class="flex items-center justify-between gap-8 mb-6 text-xs font-mono text-muted dark:text-muted-dark">
          <span class="font-medium">Tailwind CSS Utility</span>
          <button
            type="button"
            data-copy-trigger
            data-copy-val={tailwindSnippet}
            class="inline-flex items-center gap-4 text-xs font-semibold text-accent hover:underline dark:text-accent-dark cursor-pointer transition-colors"
          >
            Copy Tailwind
          </button>
        </div>
        <pre class="rounded-12 bg-surface2/70 p-12 font-mono text-xs text-ink dark:bg-surface2-dark/70 dark:text-ink-dark border border-border/60 dark:border-border-dark/60 whitespace-pre-wrap break-all [overflow-wrap:anywhere]"><code>{tailwindSnippet}</code></pre>
      </div>
    )}

    <!-- HTML Snippet -->
    {htmlSnippet && (
      <div>
        <div class="flex items-center justify-between gap-8 mb-6 text-xs font-mono text-muted dark:text-muted-dark">
          <span class="font-medium">HTML Attribute</span>
          <button
            type="button"
            data-copy-trigger
            data-copy-val={htmlSnippet}
            class="inline-flex items-center gap-4 text-xs font-semibold text-accent hover:underline dark:text-accent-dark cursor-pointer transition-colors"
          >
            Copy HTML
          </button>
        </div>
        <pre class="rounded-12 bg-surface2/70 p-12 font-mono text-xs text-ink dark:bg-surface2-dark/70 dark:text-ink-dark border border-border/60 dark:border-border-dark/60 whitespace-pre-wrap break-all [overflow-wrap:anywhere]"><code>{htmlSnippet}</code></pre>
      </div>
    )}
  </div>
</div>
