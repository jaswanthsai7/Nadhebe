---
import { getRelatedToolsForComponent } from '@/config/tools';
import type { ToolMetadata } from '@/config/tools';

interface Props {
  currentToolId?: string;
  category?: string;
  tools?: ToolMetadata[];
  limit?: number;
  class?: string;
}

const {
  currentToolId = '',
  category: customCategory,
  tools: customTools,
  limit = 6,
  class: className = '',
} = Astro.props;

const { categoryName, items } = getRelatedToolsForComponent(currentToolId, {
  customCategory,
  customTools,
  limit,
});
---

<nav
  aria-label="Related tools"
  class={`rounded-16 border border-border/80 bg-surface/80 p-12 sm:p-16 shadow-soft dark:border-border-dark/80 dark:bg-surface-dark/80 mb-24 sm:mb-32 ${className}`}
  data-reveal
>
  <div class="flex items-center justify-between gap-12 mb-10 sm:mb-12 px-4">
    <span class="font-display text-caption font-semibold text-ink dark:text-ink-dark tracking-tight">
      {categoryName}
    </span>
    <a
      href="/tools/"
      class="text-caption font-sans font-medium text-accent hover:underline dark:text-accent-dark shrink-0 transition-colors"
    >
      View all tools &rarr;
    </a>
  </div>

  <div class="grid grid-cols-2 sm:flex sm:flex-wrap sm:items-center gap-8">
    {items.map((tool) => {
      const isCurrent = tool.id === currentToolId || tool.slug === currentToolId;
      return (
        <a
          href={tool.href}
          aria-current={isCurrent ? 'page' : undefined}
          class={`inline-flex items-center justify-center rounded-8 px-12 py-8 text-caption font-sans transition-all duration-150 text-center ${
            isCurrent
              ? 'bg-accent/15 border border-accent text-accent font-semibold dark:bg-accent-dark/20 dark:border-accent-dark dark:text-accent-dark shadow-subtle pointer-events-none'
              : 'border border-border bg-surface2/80 text-ink2 hover:border-accent/50 hover:text-ink dark:border-border-dark dark:bg-surface2-dark/80 dark:text-ink2-dark dark:hover:border-accent-dark/50 dark:hover:text-ink-dark font-medium'
          }`}
        >
          {tool.name}
        </a>
      );
    })}
  </div>
</nav>
