---
import { getRelatedToolsForComponent } from '@/config/tools';
import type { ToolMetadata } from '@/config/tools';

interface Props {
  currentToolId?: string;
  category?: string;
  tools?: ToolMetadata[];
  limit?: number;
  class?: string;
  singleColumn?: boolean;
}

const {
  currentToolId = '',
  category: customCategory,
  tools: customTools,
  limit = 6,
  class: className = '',
  singleColumn = false,
} = Astro.props;

const { categoryName, items } = getRelatedToolsForComponent(currentToolId, {
  customCategory,
  customTools,
  limit,
});
---

{singleColumn ? (
  <div class="flex flex-col gap-12">
    {items.map((tool) => {
      const isCurrent = tool.id === currentToolId || tool.slug === currentToolId;
      return (
        <a
          href={tool.href}
          aria-current={isCurrent ? 'page' : undefined}
          class={`group flex items-center justify-between rounded-12 border px-20 py-12 backdrop-blur-md transition-all duration-200 shadow-sm ${
            isCurrent
              ? 'border-accent bg-accent/20 text-accent font-bold dark:border-accent-dark dark:bg-accent-dark/25 dark:text-accent-dark pointer-events-none'
              : 'border-border/60 bg-surface/90 hover:border-accent/60 hover:bg-surface dark:border-border-dark/60 dark:bg-surface-dark/90 dark:hover:border-accent-dark/60 dark:hover:bg-surface-dark'
          }`}
        >
          <div class="flex items-center justify-between gap-8">
            <div class="flex items-center gap-6 min-w-0">
              <span class={`font-display text-xs font-bold truncate ${isCurrent ? 'text-accent dark:text-accent-dark' : 'text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark'}`}>
                {tool.name}
              </span>
              {tool.category && (
                <span class="rounded-pill border border-border/50 bg-surface2/80 px-6 py-1 font-mono text-[9px] font-semibold text-muted dark:border-border-dark/50 dark:bg-surface2-dark/80 dark:text-muted-dark uppercase shrink-0">
                  {tool.category}
                </span>
              )}
            </div>
            <span class="text-xs font-bold text-accent dark:text-accent-dark shrink-0 group-hover:translate-x-1 transition-transform">
              &rarr;
            </span>
          </div>
        </a>
      );
    })}
  </div>
) : (
  <nav
    aria-label="Related tools"
    class={`rounded-16 border border-border/80 bg-white/95 px-12 py-8 sm:px-16 shadow-subtle dark:border-border-dark/80 dark:bg-[#141414]/95 mb-24 sm:mb-32 flex items-center justify-between gap-12 ${className}`}
    data-reveal
  >
    <div class="flex items-center gap-10 shrink-0">
      <span class="font-display text-caption font-semibold text-ink dark:text-ink-dark tracking-tight">
        {categoryName}
      </span>
      <span class="hidden sm:inline-block h-14 w-1 bg-border/80 dark:bg-border-dark/80"></span>
    </div>

    <div class="flex items-center gap-8 overflow-x-auto no-scrollbar py-2 flex-1 min-w-0">
      {items.map((tool) => {
        const isCurrent = tool.id === currentToolId || tool.slug === currentToolId;
        return (
          <a
            href={tool.href}
            aria-current={isCurrent ? 'page' : undefined}
            class={`inline-flex items-center justify-center whitespace-nowrap rounded-8 px-12 py-6 text-caption font-sans transition-all duration-150 text-center shrink-0 ${
              isCurrent
                ? 'bg-accent/15 border border-accent text-accent font-semibold dark:bg-accent-dark/20 dark:border-accent-dark dark:text-accent-dark shadow-subtle pointer-events-none'
                : 'border border-border bg-surface2/80 text-ink2 hover:border-accent/50 hover:text-ink dark:border-border-dark dark:bg-surface2-dark/80 dark:text-ink2-dark dark:hover:border-accent-dark/50 dark:hover:text-ink-dark font-medium'
            }`}
          >
            {tool.name}
          </a>
        );
      })}
    </div>

    <a
      href="/tools/"
      class="inline-flex items-center shrink-0 min-h-[36px] px-10 py-6 rounded-8 bg-surface2/60 hover:bg-surface2 text-caption font-sans font-medium text-accent hover:underline dark:bg-surface2-dark/60 dark:hover:bg-surface2-dark dark:text-accent-dark whitespace-nowrap transition-all"
    >
      View all tools &rarr;
    </a>
  </nav>
)}
