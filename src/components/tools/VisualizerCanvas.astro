---
interface Props {
  width?: number;
  height?: number;
  ratioLabel?: string;
  showSafeZones?: boolean;
  activePlatform?: 'none' | 'youtube-shorts' | 'instagram-reels' | 'tiktok-video';
  id?: string;
}

const {
  width = 16,
  height = 9,
  ratioLabel = '16:9',
  showSafeZones = false,
  activePlatform = 'none',
  id = 'aspect-visualizer',
} = Astro.props;

// Calculate SVG viewBox aspect ratio
const maxDim = 320;
const scale = Math.min(maxDim / width, maxDim / height);
const svgW = Math.round(width * scale);
const svgH = Math.round(height * scale);
---

<div class="relative w-full overflow-hidden rounded-16 border border-border bg-surface2/40 p-16 sm:p-24 dark:border-border-dark dark:bg-surface2-dark/40" id={id}>
  <div class="flex items-center justify-between gap-12 mb-16">
    <div class="flex items-center gap-8">
      <span class="inline-block h-8 w-8 rounded-full bg-accent dark:bg-accent-dark"></span>
      <span class="font-mono text-xs font-semibold text-ink dark:text-ink-dark uppercase tracking-wider">Visual Aspect Preview</span>
    </div>
    <span class="rounded-pill border border-border bg-surface px-10 py-2 font-mono text-xs font-bold text-accent dark:border-border-dark dark:bg-surface-dark dark:text-accent-dark" id={`${id}-badge`}>
      {ratioLabel}
    </span>
  </div>

  <div class="relative flex min-h-[220px] sm:min-h-[280px] w-full items-center justify-center rounded-12 border border-dashed border-border/80 bg-surface/60 p-12 dark:border-border-dark/80 dark:bg-surface-dark/60">
    <!-- SVG Preview Rectangle -->
    <div
      id={`${id}-rect`}
      class="relative flex items-center justify-center rounded-8 border-2 border-accent bg-accent/10 shadow-medium transition-all duration-300 dark:border-accent-dark dark:bg-accent-dark/15 overflow-hidden"
      style={`width: ${svgW}px; height: ${svgH}px; max-width: 100%; max-height: 260px;`}
    >
      <!-- Background Grid Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none"></div>

      <!-- Center Ratio Watermark Text -->
      <span id={`${id}-text`} class="relative z-10 font-display text-h3 sm:text-h2 font-extrabold text-accent dark:text-accent-dark tracking-tight drop-shadow-sm select-none">
        {ratioLabel}
      </span>

      <!-- Safe Zone Overlay Lines (if vertical 9:16 content) -->
      {showSafeZones && (
        <div id={`${id}-safe-zones`} class="absolute inset-0 pointer-events-none flex flex-col justify-between p-2 text-[10px] font-mono">
          <!-- Top Excluded Header Zone -->
          <div class="w-full bg-red-500/20 border-b border-red-500/40 py-2 text-center text-red-600 dark:text-red-400 font-semibold">
            Top UI Header Excluded
          </div>
          <!-- Bottom Excluded Caption Zone -->
          <div class="w-full bg-red-500/20 border-t border-red-500/40 py-4 text-center text-red-600 dark:text-red-400 font-semibold">
            Caption & Sound Link Excluded
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="mt-12 flex items-center justify-between text-caption font-mono text-muted dark:text-muted-dark">
    <span>Scale: Relative Proportions</span>
    <span id={`${id}-dims-label`}>{width} × {height}</span>
  </div>
</div>
