---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RelatedTools from '@/components/tools/RelatedTools.astro';
import RelatedToolsCard from '@/components/tools/RelatedToolsCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import { SITE } from '@/config';
import { getToolBySlug, type ToolMetadata } from '@/config/tools';
import type { ToolDefinition } from '@/config/tool-schema';
import { generateToolJsonLd } from '@/utils/seo';

interface Props {
  tool: ToolDefinition;
  hideHeader?: boolean;
}

const { tool, hideHeader = true } = Astro.props;

const currentUrl = `${SITE.url}/tools/${tool.slug}/`;

const jsonLdBlocks = generateToolJsonLd(tool, SITE.url);
const relatedToolsMeta = tool.content.relatedTools 
  ? tool.content.relatedTools.map(slug => getToolBySlug(slug)).filter(Boolean) as ToolMetadata[]
  : [];
---

<BaseLayout
  title={tool.seo.title || `${tool.name} | ${SITE.name}`}
  description={tool.seo.description || tool.content.intro}
  canonicalUrl={currentUrl}
  jsonLd={jsonLdBlocks}
>
  <div class="mx-auto max-w-content px-16 sm:px-24 py-32 sm:py-48">
    <Breadcrumb
      items={[
        { name: 'Home', href: '/' },
        { name: 'Tools', href: '/tools/' },
        { name: tool.name, href: `/tools/${tool.slug}/` },
      ]}
    />

    <header class={`glass-panel mb-32 rounded-24 border border-border bg-surface/90 p-24 sm:p-40 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/90 ${hideHeader ? 'hidden' : ''}`} data-reveal>
      <div class="flex flex-wrap items-center gap-12 mb-16">
        <span class="inline-flex items-center gap-6 rounded-pill border border-emerald-500/40 bg-emerald-500/15 px-12 py-6 font-mono text-xs font-semibold text-emerald-700 dark:text-emerald-300">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-12 w-12"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          100% Client-Side — Your data stays in your browser
        </span>
        <span class="rounded-pill border border-border bg-surface2 px-12 py-6 font-mono text-xs font-semibold text-ink dark:border-border-dark dark:bg-surface2-dark dark:text-ink-dark">
          {tool.category}
        </span>
      </div>

      <h1 class="font-display text-h1 sm:text-display font-bold text-ink dark:text-ink-dark leading-tight tracking-tight">
        {tool.name}
      </h1>
      <p class="mt-12 text-body-large text-ink2 dark:text-ink2-dark max-w-3xl leading-relaxed">
        {tool.content.intro}
      </p>
    </header>

    <h1 class={`sr-only ${!hideHeader ? 'hidden' : ''}`}>{tool.name}</h1>

    <!-- Compact Related Tools Bar -->
    <RelatedTools currentToolId={tool.slug} category={tool.seo.cluster} tools={relatedToolsMeta} />

    <!-- Main Tool Workspace -->
    <div class="mb-48" id="tool-workspace">
      <slot name="calculator" />
    </div>

    <!-- Ad Placement after Tool Results -->
    <AdSlot slotId="tools-mid-banner" format="horizontal" label="Advertisement" />

    <!-- AI Generated Why Nadhebe Block -->
    <div class="glass-panel my-48 rounded-24 border border-border bg-surface/90 p-24 sm:p-40 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/90 flex flex-wrap gap-16 items-center justify-center font-mono text-xs text-ink dark:text-ink-dark font-medium" data-reveal>
      <span class="flex items-center gap-6"><span class="text-emerald-500">✓</span> Runs locally</span>
      <span class="flex items-center gap-6"><span class="text-emerald-500">✓</span> No uploads</span>
      <span class="flex items-center gap-6"><span class="text-emerald-500">✓</span> Free forever</span>
      <span class="flex items-center gap-6"><span class="text-emerald-500">✓</span> Open standards</span>
      <span class="flex items-center gap-6"><span class="text-emerald-500">✓</span> Fast</span>
      <span class="flex items-center gap-6"><span class="text-emerald-500">✓</span> Privacy first</span>
    </div>

    <!-- Educational & Explanatory SEO Content Slot -->
    <div class="glass-panel my-48 rounded-24 border border-border bg-surface/90 p-24 sm:p-40 shadow-medium backdrop-blur-xl dark:border-border-dark dark:bg-surface-dark/90 prose prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-accent dark:prose-a:text-accent-dark" data-reveal>
      <slot name="content" />

      <h2>What is a {tool.name}?</h2>
      <p>{tool.ai.llmDescription}</p>

      {tool.content.examples && tool.content.examples.length > 0 && (
        <>
          <h2>Examples</h2>
          {tool.content.examples.map((ex, i) => (
            <div class="mb-24 rounded-16 border border-border/60 bg-surface2/40 p-16 dark:border-border-dark/60 dark:bg-surface2-dark/40">
              <h3 class="mt-0 text-lg">Example {i + 1}</h3>
              <div class="font-mono text-sm text-ink2 dark:text-ink2-dark bg-surface p-12 rounded mt-8 overflow-auto">
                <div><strong class="text-ink dark:text-ink-dark">Input:</strong> {ex.input}</div>
                <div class="mt-8"><strong class="text-ink dark:text-ink-dark">Output:</strong> {ex.output}</div>
              </div>
              <p class="mt-12 text-sm">{ex.explanation}</p>
            </div>
          ))}
        </>
      )}

      {tool.content.useCases && tool.content.useCases.length > 0 && (
        <>
          <h2>When to use {tool.name}</h2>
          <ul>
            {tool.content.useCases.map(uc => <li>{uc}</li>)}
          </ul>
        </>
      )}

      {tool.content.mistakes && tool.content.mistakes.length > 0 && (
        <>
          <h2>Common Mistakes</h2>
          {tool.content.mistakes.map(m => (
            <div class="mb-16">
              <strong>Mistake:</strong> {m.mistake}<br/>
              <strong>Fix:</strong> {m.fix}
            </div>
          ))}
        </>
      )}
    </div>

    <!-- FAQ Accordion Section (if present) -->
    {tool.content.faq && tool.content.faq.length > 0 && (
      <section class="my-48 rounded-24 border border-border bg-surface/80 p-24 sm:p-32 shadow-medium dark:border-border-dark dark:bg-surface-dark/80" data-reveal>
        <div class="border-b border-border/60 pb-16 mb-24 dark:border-border-dark/60">
          <h2 class="font-display text-h2 font-semibold text-ink dark:text-ink-dark">Frequently Asked Questions</h2>
          <p class="mt-4 text-body-small text-ink2 dark:text-ink2-dark">Common questions about this tool.</p>
        </div>
        <div class="space-y-16">
          {tool.content.faq.map((item) => (
            <details class="group rounded-16 border border-border/60 bg-surface2/40 p-16 dark:border-border-dark/60 dark:bg-surface2-dark/40 transition-all duration-150">
              <summary class="flex items-center justify-between font-display text-h4 font-semibold text-ink dark:text-ink-dark cursor-pointer list-none">
                <span>{item.question}</span>
                <span class="ml-12 transition-transform duration-200 group-open:rotate-180 text-muted dark:text-muted-dark">▼</span>
              </summary>
              <div class="mt-12 text-body-small text-ink2 dark:text-ink2-dark leading-relaxed">
                <p>{item.answer}</p>
                {item.example && (
                  <pre class="mt-8 p-12 bg-surface border border-border dark:bg-surface-dark dark:border-border-dark rounded-8 font-mono text-xs overflow-auto"><code>{item.example}</code></pre>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- People Also Ask -->
    {tool.content.peopleAlsoAsk && tool.content.peopleAlsoAsk.length > 0 && (
      <section class="my-48" data-reveal>
        <h3 class="font-display text-h3 mb-16 text-ink dark:text-ink-dark">People Also Ask</h3>
        <ul class="flex flex-wrap gap-8">
          {tool.content.peopleAlsoAsk.map(q => (
            <li class="rounded-pill border border-border bg-surface px-12 py-6 text-sm text-ink2 dark:border-border-dark dark:bg-surface-dark dark:text-ink2-dark">{q}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- Related Tools Cross-Linking Section -->
    <RelatedToolsCard currentToolId={tool.slug} tools={relatedToolsMeta} />
  </div>
</BaseLayout>

<!-- Copy-to-Clipboard Client Helper -->
<script is:inline>
  (function() {
    function setupCopyButtons() {
      document.querySelectorAll('[data-copy-trigger]').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-copy-val') || '';
          if (!val) return;

          navigator.clipboard.writeText(val).then(() => {
            const copyIcon = btn.querySelector('.copy-icon');
            const checkIcon = btn.querySelector('.check-icon');

            if (copyIcon && checkIcon) {
              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              setTimeout(() => {
                copyIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
              }, 2000);
            }

            // Track GA Analytics Event if gtag is defined
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'tool_copy_result', {
                tool_name: window.location.pathname,
              });
            }
          }).catch(err => {
            console.error('Copy failed', err);
          });
        });
      });
    }

    setupCopyButtons();
    document.addEventListener('astro:page-load', setupCopyButtons);
  })();
</script>
