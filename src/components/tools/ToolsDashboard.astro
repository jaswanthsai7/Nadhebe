---
import { getCollection } from 'astro:content';
import { getArticleUrl } from '@/utils/content';

const toolsPosts = await getCollection('tools');
const sortedTools = toolsPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Categorize tools for pill tabs
const categories = [
  { id: 'all', label: 'All Tools' },
  { id: 'cms', label: 'CMS & Importers' },
  { id: 'agents', label: 'Multi-Agent Systems' },
  { id: 'pre-production', label: 'Pre-Production' },
];

function getToolCategory(post: typeof sortedTools[0]): string {
  const title = post.data.title.toLowerCase();
  const tags = (post.data.tags || []).map(t => t.toLowerCase());
  
  if (title.includes('importer') || title.includes('import') || title.includes('cms')) return 'cms';
  if (title.includes('agent') || title.includes('multi-agent') || tags.includes('youtube-automation')) return 'agents';
  if (title.includes('storyboard') || title.includes('google flow') || tags.includes('film-tech')) return 'pre-production';
  return 'cms';
}
---

<div class="space-y-32">
  <!-- Glassmorphism Hero & Stats Dashboard Header -->
  <div class="glass-panel relative overflow-hidden rounded-24 border border-border p-24 sm:p-40 shadow-medium dark:border-border-dark" data-reveal>
    <!-- Background Gradient Glow -->
    <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent/15 blur-3xl dark:bg-accent-dark/15"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"></div>

    <div class="relative z-10 grid grid-cols-1 gap-24 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-8 rounded-pill border border-accent/20 bg-accent/10 px-12 py-4 text-meta font-mono font-medium text-accent dark:border-accent-dark/30 dark:bg-accent-dark/10 dark:text-accent-dark">
          <span class="relative flex h-8 w-8">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75 dark:bg-accent-dark"></span>
            <span class="relative inline-flex h-8 w-8 rounded-full bg-accent dark:bg-accent-dark"></span>
          </span>
          Developer Tools Directory
        </div>
        <h1 class="mt-16 font-display text-h1 font-bold leading-tight text-ink dark:text-ink-dark sm:text-display">
          AI Engineering & Builder Utilities Dashboard
        </h1>
        <p class="mt-12 text-body-large text-ink2 dark:text-ink2-dark max-w-2xl leading-relaxed">
          Production-grade tools, static content importers, multi-agent execution frameworks, and visual pre-production engines.
        </p>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-12">
        <div class="rounded-16 border border-border/60 bg-surface/60 p-16 backdrop-blur-md dark:border-border-dark/60 dark:bg-surface-dark/60">
          <p class="text-meta font-mono uppercase tracking-wider text-muted dark:text-muted-dark">Active Tools</p>
          <p class="mt-4 font-display text-h2 font-bold text-ink dark:text-ink-dark">{sortedTools.length}</p>
          <p class="mt-4 text-xs text-accent dark:text-accent-dark">Verified & Audited</p>
        </div>
        <div class="rounded-16 border border-border/60 bg-surface/60 p-16 backdrop-blur-md dark:border-border-dark/60 dark:bg-surface-dark/60">
          <p class="text-meta font-mono uppercase tracking-wider text-muted dark:text-muted-dark">License</p>
          <p class="mt-4 font-display text-h2 font-bold text-ink dark:text-ink-dark">MIT / Open</p>
          <p class="mt-4 text-xs text-muted dark:text-muted-dark">Community Driven</p>
        </div>
        <div class="rounded-16 border border-border/60 bg-surface/60 p-16 backdrop-blur-md dark:border-border-dark/60 dark:bg-surface-dark/60">
          <p class="text-meta font-mono uppercase tracking-wider text-muted dark:text-muted-dark">Architecture</p>
          <p class="mt-4 font-display text-h3 font-semibold text-ink dark:text-ink-dark">Bun & SQLite</p>
          <p class="mt-4 text-xs text-muted dark:text-muted-dark">Zero Heavy Locks</p>
        </div>
        <div class="rounded-16 border border-border/60 bg-surface/60 p-16 backdrop-blur-md dark:border-border-dark/60 dark:bg-surface-dark/60">
          <p class="text-meta font-mono uppercase tracking-wider text-muted dark:text-muted-dark">Health</p>
          <p class="mt-4 font-display text-h3 font-semibold text-emerald-600 dark:text-emerald-400">100% Operational</p>
          <p class="mt-4 text-xs text-muted dark:text-muted-dark">Checked Daily</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Control Bar: Search & Pill Tabs -->
  <div class="glass-panel sticky top-72 z-30 flex flex-col gap-16 rounded-16 border border-border p-16 shadow-soft backdrop-blur-xl dark:border-border-dark sm:flex-row sm:items-center sm:justify-between" data-reveal>
    <!-- Pill Tabs -->
    <nav class="flex flex-wrap items-center gap-8" aria-label="Tool Categories" id="tools-pill-tabs">
      {categories.map((cat, i) => (
        <button
          type="button"
          data-category={cat.id}
          class={`tool-pill-btn rounded-pill px-16 py-8 text-caption font-sans font-medium transition-all duration-200 cursor-pointer ${
            i === 0
              ? 'bg-ink text-white shadow-soft dark:bg-ink-dark dark:text-ink'
              : 'border border-border/60 bg-surface/50 text-ink2 hover:border-ink2/30 hover:text-ink dark:border-border-dark/60 dark:bg-surface-dark/50 dark:text-ink2-dark dark:hover:text-ink-dark'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </nav>

    <!-- Search Box Trigger -->
    <button type="button" class="tool-search-trigger relative min-w-[160px] sm:w-48 text-left group">
      <div class="w-full rounded-12 border border-border/80 bg-surface/80 pl-12 pr-40 py-8 text-caption text-muted group-hover:border-accent/50 dark:border-border-dark/80 dark:bg-surface-dark/80 dark:text-muted-dark dark:group-hover:border-accent-dark/50 transition-all duration-150">
        Search tools...
      </div>
    </button>
  </div>

  <!-- Tools Grid with Glassmorphism Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-24" id="tools-grid" data-reveal-stagger>
    {sortedTools.map((post) => {
      const catKey = getToolCategory(post);
      const url = getArticleUrl({ ...post, collection: 'tools' });
      return (
        <article
          data-tool-item
          data-category-key={catKey}
          data-search-text={`${post.data.title} ${post.data.description} ${post.data.topic || ''} ${(post.data.tags || []).join(' ')}`.toLowerCase()}
          class="glass-panel group relative flex flex-col overflow-hidden rounded-20 border border-border/70 p-0 shadow-medium hover:border-accent/40 hover:shadow-large transition-all duration-300 dark:border-border-dark/70 dark:hover:border-accent-dark/40"
          data-reveal
        >
          <!-- Hero Banner & Badge -->
          <div class="relative aspect-[16/9] w-full overflow-hidden bg-surface2 dark:bg-surface2-dark border-b border-border/40 dark:border-border-dark/40">
            <img
              src={post.data.heroImage}
              alt={post.data.heroAlt || post.data.title}
              width="600"
              height="337"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-bg/90 via-transparent to-transparent dark:from-bg-dark/90"></div>
            
            <!-- Category Badge -->
            <div class="absolute top-16 left-16 flex items-center gap-8">
              <span class="rounded-8 bg-bg/85 backdrop-blur-md border border-border/50 px-10 py-4 font-mono text-xs font-semibold text-ink dark:bg-bg-dark/85 dark:border-border-dark/50 dark:text-ink-dark">
                {post.data.topic || post.data.category}
              </span>
            </div>

            <div class="absolute bottom-16 left-16 right-16 flex items-center justify-between text-meta text-white/90">
              <span class="flex items-center gap-4 rounded-pill bg-black/40 px-8 py-2 font-mono text-xs backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-12 w-12 text-emerald-400"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                {post.data.difficulty || 'verified'}
              </span>
              <span class="font-mono text-xs">{post.data.estimatedReadingTime} min read</span>
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-24 flex-1 flex flex-col justify-between">
            <div>
              <h2 class="font-display text-h3 font-semibold leading-snug text-ink group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark transition-colors duration-150">
                <a href={url} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-12 text-body-small text-ink2 dark:text-ink2-dark line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <!-- Tags & Action Footer -->
            <div class="mt-20 pt-16 border-t border-border/40 dark:border-border-dark/40 flex items-center justify-between">
              <div class="flex flex-wrap gap-6">
                {(post.data.tags || []).slice(0, 3).map(tag => (
                  <span class="rounded-4 bg-surface2/60 px-6 py-2 font-mono text-xs text-muted dark:bg-surface2-dark/60 dark:text-muted-dark">
                    #{tag}
                  </span>
                ))}
              </div>
              
              <span class="inline-flex items-center gap-4 font-sans text-caption font-semibold text-accent group-hover:translate-x-1 dark:text-accent-dark transition-transform duration-200">
                Explore Tool
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-14 w-14"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Empty Search Results Placeholder -->
  <div id="no-results" class="hidden rounded-24 border border-dashed border-border p-48 text-center dark:border-border-dark glass-panel">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto h-36 w-36 text-muted dark:text-muted-dark mb-12"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <h3 class="font-display text-h3 font-semibold text-ink dark:text-ink-dark">No matching tools found</h3>
    <p class="mt-4 text-body-small text-ink2 dark:text-ink2-dark">Try searching with a different keyword or select "All Tools".</p>
  </div>
</div>

<!-- Lightweight Client JS for Real-time Pill Tab & Keyword Filtering -->
<script is:inline>
  (function() {
    const pillBtns = document.querySelectorAll('.tool-pill-btn');
    const searchInput = document.getElementById('tool-search-input');
    const toolItems = document.querySelectorAll('[data-tool-item]');
    const noResults = document.getElementById('no-results');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterTools() {
      let visibleCount = 0;

      toolItems.forEach(item => {
        const itemCat = item.getAttribute('data-category-key') || '';
        const itemText = item.getAttribute('data-search-text') || '';

        const matchesCat = (activeCategory === 'all' || itemCat === activeCategory);
        const matchesSearch = (!searchQuery || itemText.includes(searchQuery));

        if (matchesCat && matchesSearch) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    pillBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        pillBtns.forEach(b => {
          b.className = 'tool-pill-btn rounded-pill px-16 py-8 text-caption font-sans font-medium transition-all duration-200 cursor-pointer border border-border/60 bg-surface/50 text-ink2 hover:border-ink2/30 hover:text-ink dark:border-border-dark/60 dark:bg-surface-dark/50 dark:text-ink2-dark dark:hover:text-ink-dark';
        });

        btn.className = 'tool-pill-btn rounded-pill px-16 py-8 text-caption font-sans font-medium transition-all duration-200 cursor-pointer bg-ink text-white shadow-soft dark:bg-ink-dark dark:text-ink';
        
        activeCategory = btn.getAttribute('data-category') || 'all';
        filterTools();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target.value || '').toLowerCase().trim();
      filterTools();
    });
  })();
</script>
