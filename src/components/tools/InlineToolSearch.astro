---
import { PLATFORM_TOOLS } from '@/config/platform-tools';

// Serialize tools for client-side live inline dropdown search
const toolsData = PLATFORM_TOOLS.map(t => ({
  id: t.id,
  name: t.name,
  description: t.description,
  href: t.href,
  category: t.category,
  tags: t.tags || []
}));
---

<div class="relative w-full max-w-xl mx-auto inline-tool-search-container" id="inline-tool-search">
  <!-- Search Input Container -->
  <div class="relative flex items-center w-full rounded-16 border border-border/80 bg-surface/90 px-16 py-12 shadow-sm backdrop-blur-md transition-all duration-200 focus-within:border-accent/60 focus-within:ring-2 focus-within:ring-accent/20 dark:border-border-dark/80 dark:bg-surface-dark/90">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-muted dark:text-muted-dark shrink-0 mr-12" style="width:20px; height:20px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    
    <input
      type="text"
      id="inline-search-input"
      placeholder="Search tools by name, category, or keyword..."
      autocomplete="off"
      class="flex-1 bg-transparent border-0 outline-none text-body text-ink placeholder:text-muted dark:text-ink-dark dark:placeholder:text-muted-dark focus:ring-0 focus:outline-none"
    />

    <div class="flex items-center gap-8 shrink-0 ml-12">
      <button
        type="button"
        id="inline-search-clear"
        class="hidden text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark p-4 rounded-full transition-colors cursor-pointer"
        aria-label="Clear search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" style="width:14px; height:14px;"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <kbd class="hidden sm:inline-block rounded-6 bg-surface2 px-8 py-3 font-mono text-xs font-semibold text-muted dark:bg-surface2-dark dark:text-muted-dark border border-border/60 dark:border-border-dark/60 select-none">⌘K</kbd>
    </div>
  </div>

  <!-- Inline Dropdown Results Menu -->
  <div
    id="inline-search-dropdown"
    class="absolute left-0 right-0 top-[calc(100%+8px)] z-50 hidden rounded-20 border border-border/90 bg-surface/98 backdrop-blur-2xl shadow-2xl p-8 max-h-[380px] overflow-y-auto [&::-webkit-scrollbar]:hidden dark:border-border-dark/90 dark:bg-surface-dark/98"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    <div id="inline-dropdown-results" class="flex flex-col gap-4">
      <!-- Dynamically populated by JS -->
    </div>

    <!-- Empty State -->
    <div id="inline-dropdown-empty" class="hidden flex-col items-center justify-center py-32 px-16 text-center">
      <p class="text-caption font-sans font-medium text-ink dark:text-ink-dark">No tools found</p>
      <p class="text-xs font-sans text-muted dark:text-muted-dark mt-4">Try searching with a different keyword</p>
    </div>
  </div>
</div>

<script define:vars={{ toolsData }}>
  (function() {
    function initInlineSearch() {
      const container = document.getElementById('inline-tool-search');
      const input = document.getElementById('inline-search-input');
      const clearBtn = document.getElementById('inline-search-clear');
      const dropdown = document.getElementById('inline-search-dropdown');
      const resultsContainer = document.getElementById('inline-dropdown-results');
      const emptyState = document.getElementById('inline-dropdown-empty');

      if (!input || !dropdown || !resultsContainer) return;

      let selectedIndex = -1;
      let currentMatches = [];

      function renderResults(query) {
        const q = query.trim().toLowerCase();
        
        if (!q) {
          currentMatches = toolsData.slice(0, 8); // show top popular when blank on focus
        } else {
          currentMatches = toolsData.filter(t => 
            t.name.toLowerCase().includes(q) ||
            t.description.toLowerCase().includes(q) ||
            t.category.toLowerCase().includes(q) ||
            (t.tags && t.tags.some(tag => tag.toLowerCase().includes(q)))
          );
        }

        selectedIndex = -1;
        resultsContainer.innerHTML = '';

        if (currentMatches.length === 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');

          currentMatches.forEach((t, idx) => {
            const item = document.createElement('a');
            item.href = t.href;
            item.className = `inline-search-item flex items-center justify-between p-12 rounded-12 transition-all duration-150 group text-left ${idx === selectedIndex ? 'bg-accent/10 dark:bg-accent-dark/20 text-accent dark:text-accent-dark' : 'hover:bg-surface2/80 dark:hover:bg-surface2-dark/80'}`;
            item.setAttribute('data-index', idx);
            
            item.innerHTML = `
              <div class="flex-1 min-w-0 pr-12">
                <div class="flex items-center gap-8">
                  <span class="font-display font-semibold text-body-small text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark truncate">${t.name}</span>
                  <span class="rounded-pill bg-surface2 px-8 py-2 text-[10px] font-mono text-muted dark:bg-surface2-dark dark:text-muted-dark uppercase tracking-wider shrink-0">${t.category}</span>
                </div>
                <p class="text-xs text-ink2 dark:text-ink2-dark truncate mt-2 font-sans">${t.description}</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-muted dark:text-muted-dark group-hover:text-accent group-hover:translate-x-2 transition-all shrink-0" style="width:16px; height:16px;"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            `;
            resultsContainer.appendChild(item);
          });
        }

        dropdown.classList.remove('hidden');
      }

      function updateActiveItem() {
        const items = resultsContainer.querySelectorAll('.inline-search-item');
        items.forEach((el, idx) => {
          if (idx === selectedIndex) {
            el.classList.add('bg-accent/10', 'dark:bg-accent-dark/20', '!text-accent', 'dark:!text-accent-dark');
            el.scrollIntoView({ block: 'nearest' });
          } else {
            el.classList.remove('bg-accent/10', 'dark:bg-accent-dark/20', '!text-accent', 'dark:!text-accent-dark');
          }
        });
      }

      function openDropdown() {
        renderResults(input.value);
      }

      function closeDropdown() {
        dropdown.classList.add('hidden');
        selectedIndex = -1;
      }

      // Input Event Listeners
      input.addEventListener('input', (e) => {
        const val = e.target.value;
        clearBtn.classList.toggle('hidden', val.length === 0);
        renderResults(val);
      });

      input.addEventListener('focus', openDropdown);

      clearBtn.addEventListener('click', () => {
        input.value = '';
        clearBtn.classList.add('hidden');
        renderResults('');
        input.focus();
      });

      // Keyboard Navigation
      input.addEventListener('keydown', (e) => {
        if (dropdown.classList.contains('hidden')) {
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') openDropdown();
          return;
        }

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentMatches.length > 0) {
            selectedIndex = (selectedIndex + 1) % currentMatches.length;
            updateActiveItem();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentMatches.length > 0) {
            selectedIndex = (selectedIndex - 1 + currentMatches.length) % currentMatches.length;
            updateActiveItem();
          }
        } else if (e.key === 'Enter') {
          if (selectedIndex >= 0 && currentMatches[selectedIndex]) {
            e.preventDefault();
            window.location.href = currentMatches[selectedIndex].href;
          }
        } else if (e.key === 'Escape') {
          closeDropdown();
          input.blur();
        }
      });

      // Global click listener to close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (container && !container.contains(e.target)) {
          closeDropdown();
        }
      });

      // Global shortcut Cmd+K or Ctrl+K to focus search input
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          input.focus();
          openDropdown();
        }
      });
    }

    initInlineSearch();
    document.addEventListener('astro:page-load', initInlineSearch);
  })();
</script>
