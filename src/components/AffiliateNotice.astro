---
interface Props {
  programName?: string;
}

const { programName } = Astro.props;
---

<aside class="not-prose my-16 rounded-12 border border-accent/20 bg-accent/5 px-16 py-12 text-xs font-sans text-ink2 dark:border-accent-dark/20 dark:bg-accent-dark/5 dark:text-ink2-dark shadow-sm">
  <p class="flex items-center gap-10">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16 shrink-0 text-accent dark:text-accent-dark" style="width:16px;height:16px;">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="16" x2="12" y2="12"/>
      <line x1="12" y1="8" x2="12.01" y2="8"/>
    </svg>
    <span>
      <strong>Editorial Transparency:</strong> Nadhebe is independent and reader-supported.{' '}
      {programName
        ? `Links to ${programName} on this page are partner links that may earn us a commission at no cost to you.`
        : 'Some links on this page may earn us an affiliate commission if you sign up.'}
    </span>
  </p>
</aside>
