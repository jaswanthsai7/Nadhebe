---
interface Props {
  type: 'mcp' | 'gemini' | 'vllm' | 'claude' | 'vector' | 'default';
  title?: string;
}

const { type, title } = Astro.props;
---

<div class="relative w-full overflow-hidden rounded-2xl border border-slate-200/50 dark:border-slate-800/50 bg-slate-50 dark:bg-slate-900/50 shadow-sm transition-all hover:shadow-md">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 z-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: radial-gradient(var(--tw-colors-slate-500) 1px, transparent 1px); background-size: 24px 24px;"></div>

  <!-- Content Container -->
  <div class="relative z-10 flex min-h-[320px] w-full flex-col items-center justify-center p-8 sm:p-12">
    
    {type === 'mcp' && (
      <svg class="w-full max-w-2xl drop-shadow-sm" viewBox="0 0 800 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Title -->
        <text x="400" y="40" font-family="system-ui, sans-serif" font-size="20" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">{title || "MCP Architecture"}</text>
        
        <!-- Nodes -->
        <!-- Claude Desktop -->
        <rect x="50" y="100" width="180" height="80" rx="12" fill="var(--tw-colors-blue-50)" stroke="var(--tw-colors-blue-500)" stroke-width="2" class="dark:fill-blue-950/30" />
        <path d="M140 130 h-20 v20 h20 z" fill="var(--tw-colors-blue-500)" />
        <text x="140" y="160" font-family="system-ui, sans-serif" font-size="16" font-weight="500" fill="currentColor" text-anchor="middle" class="text-blue-900 dark:text-blue-100">Claude Desktop</text>
        
        <!-- MCP Server -->
        <rect x="310" y="100" width="180" height="80" rx="12" fill="var(--tw-colors-purple-50)" stroke="var(--tw-colors-purple-500)" stroke-width="2" class="dark:fill-purple-950/30" />
        <circle cx="400" cy="130" r="10" fill="var(--tw-colors-purple-500)" />
        <text x="400" y="160" font-family="system-ui, sans-serif" font-size="16" font-weight="500" fill="currentColor" text-anchor="middle" class="text-purple-900 dark:text-purple-100">MCP Server</text>

        <!-- Tools / Filesystem -->
        <rect x="570" y="100" width="180" height="80" rx="12" fill="var(--tw-colors-emerald-50)" stroke="var(--tw-colors-emerald-500)" stroke-width="2" class="dark:fill-emerald-950/30" />
        <path d="M660 120 l-10 20 h20 z" fill="var(--tw-colors-emerald-500)" />
        <text x="660" y="160" font-family="system-ui, sans-serif" font-size="16" font-weight="500" fill="currentColor" text-anchor="middle" class="text-emerald-900 dark:text-emerald-100">Local Resources</text>

        <!-- Connectors -->
        <path d="M230 140 H310" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" class="text-slate-400 dark:text-slate-600" />
        <polygon points="310,140 300,135 300,145" fill="currentColor" class="text-slate-400 dark:text-slate-600" />
        
        <path d="M490 140 H570" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" class="text-slate-400 dark:text-slate-600" />
        <polygon points="570,140 560,135 560,145" fill="currentColor" class="text-slate-400 dark:text-slate-600" />
        
        <!-- Protocol Labels -->
        <rect x="235" y="115" width="70" height="24" rx="4" fill="var(--tw-colors-slate-100)" class="dark:fill-slate-800" />
        <text x="270" y="132" font-family="system-ui, sans-serif" font-size="12" font-weight="500" fill="currentColor" text-anchor="middle" class="text-slate-600 dark:text-slate-300">JSON-RPC</text>

        <rect x="495" y="115" width="70" height="24" rx="4" fill="var(--tw-colors-slate-100)" class="dark:fill-slate-800" />
        <text x="530" y="132" font-family="system-ui, sans-serif" font-size="12" font-weight="500" fill="currentColor" text-anchor="middle" class="text-slate-600 dark:text-slate-300">Exec/Read</text>
      </svg>
    )}

    {type === 'gemini' && (
      <svg class="w-full max-w-2xl drop-shadow-sm" viewBox="0 0 800 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <text x="400" y="40" font-family="system-ui, sans-serif" font-size="20" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">{title || "Gemini Multimodal Processing"}</text>
        
        <!-- Inputs -->
        <rect x="80" y="80" width="120" height="40" rx="8" fill="var(--tw-colors-blue-50)" stroke="var(--tw-colors-blue-500)" stroke-width="2" class="dark:fill-blue-950/30" />
        <text x="140" y="105" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" text-anchor="middle" class="text-blue-900 dark:text-blue-100">Text Prompt</text>
        
        <rect x="80" y="140" width="120" height="40" rx="8" fill="var(--tw-colors-orange-50)" stroke="var(--tw-colors-orange-500)" stroke-width="2" class="dark:fill-orange-950/30" />
        <text x="140" y="165" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" text-anchor="middle" class="text-orange-900 dark:text-orange-100">Image Data</text>

        <rect x="80" y="200" width="120" height="40" rx="8" fill="var(--tw-colors-emerald-50)" stroke="var(--tw-colors-emerald-500)" stroke-width="2" class="dark:fill-emerald-950/30" />
        <text x="140" y="225" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" text-anchor="middle" class="text-emerald-900 dark:text-emerald-100">Video / Audio</text>

        <!-- Core Model -->
        <rect x="300" y="80" width="200" height="160" rx="16" fill="var(--tw-colors-slate-900)" stroke="var(--tw-colors-slate-700)" stroke-width="2" class="dark:fill-slate-800" />
        <path d="M400 120 l20 20 l-10 10 l-20 -20 z" fill="var(--tw-colors-blue-400)" />
        <path d="M400 120 l-20 20 l10 10 l20 -20 z" fill="var(--tw-colors-indigo-400)" />
        <text x="400" y="180" font-family="system-ui, sans-serif" font-size="24" font-weight="700" fill="#fff" text-anchor="middle">Gemini 1.5</text>
        <text x="400" y="210" font-family="system-ui, sans-serif" font-size="14" fill="var(--tw-colors-slate-400)" text-anchor="middle">1M+ Token Context</text>

        <!-- Output -->
        <rect x="600" y="120" width="140" height="80" rx="12" fill="var(--tw-colors-purple-50)" stroke="var(--tw-colors-purple-500)" stroke-width="2" class="dark:fill-purple-950/30" />
        <text x="670" y="160" font-family="system-ui, sans-serif" font-size="16" font-weight="500" fill="currentColor" text-anchor="middle" class="text-purple-900 dark:text-purple-100">Structured</text>
        <text x="670" y="180" font-family="system-ui, sans-serif" font-size="16" font-weight="500" fill="currentColor" text-anchor="middle" class="text-purple-900 dark:text-purple-100">JSON Output</text>

        <!-- Connecting Lines -->
        <path d="M200 100 Q250 100 250 160 T300 160" stroke="currentColor" stroke-width="2" fill="none" class="text-slate-300 dark:text-slate-600" />
        <path d="M200 160 H300" stroke="currentColor" stroke-width="2" fill="none" class="text-slate-300 dark:text-slate-600" />
        <path d="M200 220 Q250 220 250 160 T300 160" stroke="currentColor" stroke-width="2" fill="none" class="text-slate-300 dark:text-slate-600" />
        
        <path d="M500 160 H600" stroke="currentColor" stroke-width="3" fill="none" class="text-purple-400" />
        <polygon points="600,160 590,155 590,165" fill="currentColor" class="text-purple-400" />
      </svg>
    )}

    {type === 'vllm' && (
      <svg class="w-full max-w-2xl drop-shadow-sm" viewBox="0 0 800 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <text x="400" y="40" font-family="system-ui, sans-serif" font-size="20" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">{title || "vLLM PagedAttention"}</text>
        
        <!-- Standard KV Cache -->
        <rect x="100" y="80" width="250" height="180" rx="8" fill="var(--tw-colors-red-50)" stroke="var(--tw-colors-red-200)" stroke-width="2" stroke-dasharray="4" class="dark:fill-red-950/20 dark:stroke-red-900/50" />
        <text x="225" y="110" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="currentColor" text-anchor="middle" class="text-red-800 dark:text-red-400">Standard KV Cache (Fragmented)</text>
        
        <!-- Fragmented blocks -->
        <rect x="120" y="130" width="60" height="30" rx="4" fill="var(--tw-colors-red-400)" />
        <rect x="190" y="130" width="60" height="30" rx="4" fill="var(--tw-colors-slate-200)" class="dark:fill-slate-800" />
        <rect x="260" y="130" width="60" height="30" rx="4" fill="var(--tw-colors-red-400)" />
        <rect x="120" y="170" width="60" height="30" rx="4" fill="var(--tw-colors-slate-200)" class="dark:fill-slate-800" />
        <rect x="190" y="170" width="60" height="30" rx="4" fill="var(--tw-colors-red-400)" />
        <rect x="260" y="170" width="60" height="30" rx="4" fill="var(--tw-colors-slate-200)" class="dark:fill-slate-800" />
        <rect x="120" y="210" width="60" height="30" rx="4" fill="var(--tw-colors-slate-200)" class="dark:fill-slate-800" />
        <rect x="190" y="210" width="60" height="30" rx="4" fill="var(--tw-colors-red-400)" />
        <rect x="260" y="210" width="60" height="30" rx="4" fill="var(--tw-colors-red-400)" />
        
        <!-- VS -->
        <text x="400" y="180" font-family="system-ui, sans-serif" font-size="16" font-weight="700" fill="currentColor" text-anchor="middle" class="text-slate-400">VS</text>

        <!-- vLLM KV Cache -->
        <rect x="450" y="80" width="250" height="180" rx="8" fill="var(--tw-colors-emerald-50)" stroke="var(--tw-colors-emerald-400)" stroke-width="2" class="dark:fill-emerald-950/20 dark:stroke-emerald-700" />
        <text x="575" y="110" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="currentColor" text-anchor="middle" class="text-emerald-800 dark:text-emerald-400">vLLM (PagedAttention)</text>
        
        <!-- Contiguous Blocks -->
        <rect x="470" y="130" width="60" height="30" rx="4" fill="var(--tw-colors-emerald-500)" />
        <rect x="540" y="130" width="60" height="30" rx="4" fill="var(--tw-colors-emerald-500)" />
        <rect x="610" y="130" width="60" height="30" rx="4" fill="var(--tw-colors-emerald-500)" />
        <rect x="470" y="170" width="60" height="30" rx="4" fill="var(--tw-colors-emerald-500)" />
        <rect x="540" y="170" width="60" height="30" rx="4" fill="var(--tw-colors-emerald-500)" />
        <rect x="610" y="170" width="60" height="30" rx="4" fill="var(--tw-colors-emerald-500)" />
        
        <!-- Memory Saved -->
        <rect x="470" y="210" width="200" height="30" rx="4" fill="var(--tw-colors-emerald-100)" stroke="var(--tw-colors-emerald-500)" stroke-dasharray="4" class="dark:fill-emerald-900/50" />
        <text x="570" y="230" font-family="system-ui, sans-serif" font-size="12" font-weight="600" fill="currentColor" text-anchor="middle" class="text-emerald-700 dark:text-emerald-300">Freed / Available for Batching</text>
      </svg>
    )}
    
    <!-- Fallback / Default -->
    {['default', 'claude', 'vector'].includes(type) && (
      <svg class="w-full max-w-xl opacity-20 dark:opacity-30" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="10" y="10" width="380" height="180" rx="16" stroke="currentColor" stroke-width="2" stroke-dasharray="8 8" class="text-slate-400" />
        <path d="M180 90 L200 70 L220 90 M200 70 V130" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400" />
        <text x="200" y="160" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" text-anchor="middle" class="text-slate-400">{title || "Architecture Diagram Placeholder"}</text>
      </svg>
    )}
  </div>
</div>
