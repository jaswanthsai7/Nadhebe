---
interface Props {
  type: 'mcp' | 'gemini' | 'vllm' | 'claude' | 'vector' | 'default';
  title?: string;
}

const { type, title } = Astro.props;
---

<div class="relative w-full overflow-hidden rounded-2xl border border-slate-200/60 dark:border-slate-700/50 bg-white dark:bg-slate-900 shadow-xl transition-all hover:shadow-2xl group">
  
  <!-- Subtle Animated Glow Backgrounds -->
  <div class="absolute -left-32 -top-32 h-64 w-64 rounded-full bg-blue-500/10 dark:bg-blue-500/20 blur-3xl transition-opacity duration-700 group-hover:opacity-70 opacity-50"></div>
  <div class="absolute -right-32 -bottom-32 h-64 w-64 rounded-full bg-purple-500/10 dark:bg-purple-500/20 blur-3xl transition-opacity duration-700 group-hover:opacity-70 opacity-50"></div>
  
  <!-- Premium Dot Grid -->
  <div class="absolute inset-0 z-0 opacity-[0.15] dark:opacity-[0.2]" style="background-image: radial-gradient(#94a3b8 1px, transparent 1px); background-size: 20px 20px;"></div>

  <!-- Content Container -->
  <div class="relative z-10 flex min-h-[360px] w-full flex-col items-center justify-center p-8 sm:p-12">
    
    {type === 'mcp' && (
      <svg class="w-full max-w-3xl drop-shadow-sm" viewBox="0 0 800 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="4" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
          <linearGradient id="grad-blue" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3b82f6" />
            <stop offset="100%" stop-color="#2563eb" />
          </linearGradient>
          <linearGradient id="grad-purple" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#a855f7" />
            <stop offset="100%" stop-color="#7e22ce" />
          </linearGradient>
          <linearGradient id="grad-emerald" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#10b981" />
            <stop offset="100%" stop-color="#059669" />
          </linearGradient>
          <!-- Animated gradient for connectors -->
          <linearGradient id="line-glow" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#94a3b8" stop-opacity="0.2" />
            <stop offset="50%" stop-color="#8b5cf6" stop-opacity="1">
              <animate attributeName="offset" values="-0.5; 1.5" dur="3s" repeatCount="indefinite" />
            </stop>
            <stop offset="100%" stop-color="#94a3b8" stop-opacity="0.2" />
          </linearGradient>
        </defs>

        <!-- Title -->
        <text x="400" y="40" font-family="system-ui, sans-serif" font-size="22" font-weight="700" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-100 tracking-tight">{title || "MCP Architecture"}</text>
        <text x="400" y="60" font-family="system-ui, sans-serif" font-size="14" font-weight="400" fill="currentColor" text-anchor="middle" class="text-slate-500 dark:text-slate-400">Context-aware integration via JSON-RPC</text>
        
        <!-- Smooth Bezier Connectors -->
        <!-- Claude to MCP -->
        <path d="M 230 180 C 270 180, 270 180, 310 180" stroke="url(#line-glow)" stroke-width="3" stroke-dasharray="6 6" fill="none" />
        <circle cx="270" cy="180" r="3" fill="#8b5cf6" filter="url(#glow)">
          <animate attributeName="cx" values="230; 310" dur="2s" repeatCount="indefinite" />
        </circle>
        
        <!-- MCP to Local -->
        <path d="M 490 180 C 530 180, 530 180, 570 180" stroke="url(#line-glow)" stroke-width="3" stroke-dasharray="6 6" fill="none" />
        <circle cx="530" cy="180" r="3" fill="#10b981" filter="url(#glow)">
          <animate attributeName="cx" values="490; 570" dur="2s" repeatCount="indefinite" />
        </circle>
        
        <!-- Nodes -->
        
        <!-- 1. Claude Desktop -->
        <g transform="translate(50, 130)">
          <!-- Glass Panel -->
          <rect width="180" height="100" rx="16" class="fill-white/80 stroke-slate-200 dark:fill-slate-800/80 dark:stroke-slate-700 backdrop-blur-md" stroke-width="1.5" />
          <rect width="180" height="100" rx="16" stroke="url(#grad-blue)" stroke-width="1.5" opacity="0.3" filter="url(#glow)" />
          
          <!-- Icon -->
          <rect x="70" y="20" width="40" height="40" rx="10" fill="url(#grad-blue)" fill-opacity="0.1" />
          <path d="M78 40 h24 M82 32 l-4 8 l4 8 M98 32 l4 8 l-4 8" stroke="url(#grad-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          
          <text x="90" y="80" font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">Claude Desktop</text>
        </g>

        <!-- Protocol Labels -->
        <g transform="translate(240, 140)">
          <rect width="60" height="22" rx="11" class="fill-slate-100 dark:fill-slate-800 border border-slate-200 dark:border-slate-700" stroke-width="1" />
          <text x="30" y="15" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-500 dark:text-slate-400">JSON-RPC</text>
        </g>
        
        <!-- 2. MCP Server -->
        <g transform="translate(310, 130)">
          <rect width="180" height="100" rx="16" class="fill-white/80 stroke-slate-200 dark:fill-slate-800/80 dark:stroke-slate-700 backdrop-blur-md" stroke-width="1.5" />
          <rect width="180" height="100" rx="16" stroke="url(#grad-purple)" stroke-width="2" opacity="0.5" filter="url(#glow)" />
          
          <!-- Icon -->
          <rect x="70" y="20" width="40" height="40" rx="10" fill="url(#grad-purple)" fill-opacity="0.1" />
          <path d="M78 30 h24 M78 40 h24 M78 50 h24 M82 30 h2 M82 40 h2 M82 50 h2" stroke="url(#grad-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          
          <text x="90" y="80" font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">MCP Server</text>
        </g>

        <!-- Protocol Labels -->
        <g transform="translate(500, 140)">
          <rect width="60" height="22" rx="11" class="fill-slate-100 dark:fill-slate-800 border border-slate-200 dark:border-slate-700" stroke-width="1" />
          <text x="30" y="15" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-500 dark:text-slate-400">Exec/Read</text>
        </g>

        <!-- 3. Local Resources -->
        <g transform="translate(570, 130)">
          <rect width="180" height="100" rx="16" class="fill-white/80 stroke-slate-200 dark:fill-slate-800/80 dark:stroke-slate-700 backdrop-blur-md" stroke-width="1.5" />
          <rect width="180" height="100" rx="16" stroke="url(#grad-emerald)" stroke-width="1.5" opacity="0.3" filter="url(#glow)" />
          
          <!-- Icon -->
          <rect x="70" y="20" width="40" height="40" rx="10" fill="url(#grad-emerald)" fill-opacity="0.1" />
          <path d="M78 32 a4 4 0 0 1 4 -4 h6 l4 4 h6 a4 4 0 0 1 4 4 v12 a4 4 0 0 1 -4 4 h-20 a4 4 0 0 1 -4 -4 z" stroke="url(#grad-emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          
          <text x="90" y="80" font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">Local Resources</text>
        </g>
      </svg>
    )}

    {type === 'gemini' && (
      <svg class="w-full max-w-3xl drop-shadow-sm" viewBox="0 0 800 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="glow2" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
          <linearGradient id="grad-gemini" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3b82f6" />
            <stop offset="50%" stop-color="#8b5cf6" />
            <stop offset="100%" stop-color="#f43f5e" />
          </linearGradient>
        </defs>

        <text x="400" y="40" font-family="system-ui, sans-serif" font-size="22" font-weight="700" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-100 tracking-tight">{title || "Gemini Multimodal Processing"}</text>
        <text x="400" y="60" font-family="system-ui, sans-serif" font-size="14" font-weight="400" fill="currentColor" text-anchor="middle" class="text-slate-500 dark:text-slate-400">Native processing of text, vision, and audio</text>
        
        <!-- Connecting Paths -->
        <path d="M220 120 C 270 120, 270 180, 310 180" stroke="currentColor" class="text-slate-300 dark:text-slate-600" stroke-width="2" fill="none" stroke-dasharray="4 4" />
        <path d="M220 180 C 270 180, 270 180, 310 180" stroke="currentColor" class="text-slate-300 dark:text-slate-600" stroke-width="2" fill="none" stroke-dasharray="4 4" />
        <path d="M220 240 C 270 240, 270 180, 310 180" stroke="currentColor" class="text-slate-300 dark:text-slate-600" stroke-width="2" fill="none" stroke-dasharray="4 4" />
        
        <path d="M 490 180 L 590 180" stroke="url(#grad-gemini)" stroke-width="4" fill="none" filter="url(#glow2)" />
        <polygon points="590,180 580,174 580,186" fill="#f43f5e" />

        <!-- Inputs -->
        <g transform="translate(60, 100)">
          <rect width="160" height="40" rx="8" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.5" />
          <circle cx="20" cy="20" r="4" class="fill-blue-500" />
          <text x="40" y="25" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" class="text-slate-700 dark:text-slate-300">Text Prompt</text>
        </g>
        
        <g transform="translate(60, 160)">
          <rect width="160" height="40" rx="8" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.5" />
          <circle cx="20" cy="20" r="4" class="fill-orange-500" />
          <text x="40" y="25" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" class="text-slate-700 dark:text-slate-300">Image Data</text>
        </g>

        <g transform="translate(60, 220)">
          <rect width="160" height="40" rx="8" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.5" />
          <circle cx="20" cy="20" r="4" class="fill-emerald-500" />
          <text x="40" y="25" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" class="text-slate-700 dark:text-slate-300">Video / Audio</text>
        </g>

        <!-- Core Model -->
        <g transform="translate(310, 100)">
          <rect width="180" height="160" rx="24" class="fill-slate-900 dark:fill-slate-950 stroke-slate-700 dark:stroke-slate-800" stroke-width="2" />
          <rect width="180" height="160" rx="24" stroke="url(#grad-gemini)" stroke-width="2" opacity="0.4" filter="url(#glow2)" />
          
          <path d="M90 40 l20 20 l-10 10 l-20 -20 z" fill="#3b82f6" />
          <path d="M90 40 l-20 20 l10 10 l20 -20 z" fill="#8b5cf6" />
          <circle cx="90" cy="50" r="3" fill="#fff" filter="url(#glow2)" />
          
          <text x="90" y="110" font-family="system-ui, sans-serif" font-size="24" font-weight="800" fill="#fff" text-anchor="middle" tracking="tight">Gemini 1.5</text>
          <text x="90" y="135" font-family="system-ui, sans-serif" font-size="13" font-weight="500" fill="#94a3b8" text-anchor="middle">1M+ Token Context</text>
        </g>

        <!-- Output -->
        <g transform="translate(600, 140)">
          <rect width="140" height="80" rx="16" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.5" />
          <rect width="140" height="80" rx="16" stroke="#f43f5e" stroke-width="1.5" opacity="0.3" filter="url(#glow2)" />
          <text x="70" y="35" font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">Structured</text>
          <text x="70" y="55" font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-200">JSON Output</text>
        </g>
      </svg>
    )}

    {type === 'vllm' && (
      <svg class="w-full max-w-3xl drop-shadow-sm" viewBox="0 0 800 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <text x="400" y="40" font-family="system-ui, sans-serif" font-size="22" font-weight="700" fill="currentColor" text-anchor="middle" class="text-slate-800 dark:text-slate-100 tracking-tight">{title || "vLLM PagedAttention"}</text>
        <text x="400" y="60" font-family="system-ui, sans-serif" font-size="14" font-weight="400" fill="currentColor" text-anchor="middle" class="text-slate-500 dark:text-slate-400">Memory fragmentation vs contiguous block allocation</text>
        
        <!-- Standard KV Cache -->
        <g transform="translate(80, 100)">
          <rect width="260" height="180" rx="12" class="fill-white dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="1.5" stroke-dasharray="6 6" />
          <text x="130" y="30" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-700 dark:text-slate-300">Standard KV Cache</text>
          <text x="130" y="48" font-family="system-ui, sans-serif" font-size="12" fill="#ef4444" text-anchor="middle" font-weight="500">High Fragmentation</text>
          
          <!-- Blocks -->
          <rect x="20" y="70" width="65" height="24" rx="4" class="fill-red-400 dark:fill-red-500/80" />
          <rect x="95" y="70" width="65" height="24" rx="4" class="fill-slate-100 dark:fill-slate-900" />
          <rect x="170" y="70" width="65" height="24" rx="4" class="fill-red-400 dark:fill-red-500/80" />
          
          <rect x="20" y="104" width="65" height="24" rx="4" class="fill-slate-100 dark:fill-slate-900" />
          <rect x="95" y="104" width="65" height="24" rx="4" class="fill-red-400 dark:fill-red-500/80" />
          <rect x="170" y="104" width="65" height="24" rx="4" class="fill-slate-100 dark:fill-slate-900" />
          
          <rect x="20" y="138" width="65" height="24" rx="4" class="fill-slate-100 dark:fill-slate-900" />
          <rect x="95" y="138" width="65" height="24" rx="4" class="fill-red-400 dark:fill-red-500/80" />
          <rect x="170" y="138" width="65" height="24" rx="4" class="fill-red-400 dark:fill-red-500/80" />
        </g>
        
        <!-- VS Badge -->
        <g transform="translate(380, 175)">
          <circle cx="20" cy="15" r="20" class="fill-slate-100 dark:fill-slate-800 stroke-slate-200 dark:stroke-slate-700" stroke-width="2" />
          <text x="20" y="20" font-family="system-ui, sans-serif" font-size="14" font-weight="700" fill="currentColor" text-anchor="middle" class="text-slate-500 dark:text-slate-400">VS</text>
        </g>

        <!-- vLLM KV Cache -->
        <g transform="translate(460, 100)">
          <rect width="260" height="180" rx="12" class="fill-emerald-50 dark:fill-emerald-950/20 stroke-emerald-500 dark:stroke-emerald-600" stroke-width="2" />
          <text x="130" y="30" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="currentColor" text-anchor="middle" class="text-slate-700 dark:text-slate-300">vLLM (PagedAttention)</text>
          <text x="130" y="48" font-family="system-ui, sans-serif" font-size="12" fill="#10b981" text-anchor="middle" font-weight="500">Zero Fragmentation</text>
          
          <!-- Contiguous Blocks -->
          <rect x="20" y="70" width="65" height="24" rx="4" class="fill-emerald-500 dark:fill-emerald-500/90" />
          <rect x="95" y="70" width="65" height="24" rx="4" class="fill-emerald-500 dark:fill-emerald-500/90" />
          <rect x="170" y="70" width="65" height="24" rx="4" class="fill-emerald-500 dark:fill-emerald-500/90" />
          
          <rect x="20" y="104" width="65" height="24" rx="4" class="fill-emerald-500 dark:fill-emerald-500/90" />
          <rect x="95" y="104" width="65" height="24" rx="4" class="fill-emerald-500 dark:fill-emerald-500/90" />
          <rect x="170" y="104" width="65" height="24" rx="4" class="fill-emerald-500 dark:fill-emerald-500/90" />
          
          <!-- Memory Saved -->
          <rect x="20" y="138" width="220" height="24" rx="4" class="fill-emerald-100 dark:fill-emerald-900/40 stroke-emerald-500 dark:stroke-emerald-600" stroke-dasharray="4 4" stroke-width="1.5" />
          <text x="130" y="154" font-family="system-ui, sans-serif" font-size="12" font-weight="600" fill="currentColor" text-anchor="middle" class="text-emerald-700 dark:text-emerald-400">Available for Batching</text>
        </g>
      </svg>
    )}
    
    <!-- Fallback / Default -->
    {['default', 'claude', 'vector'].includes(type) && (
      <svg class="w-full max-w-xl opacity-20 dark:opacity-30" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="10" y="10" width="380" height="180" rx="16" stroke="currentColor" stroke-width="2" stroke-dasharray="8 8" class="text-slate-400" />
        <path d="M180 90 L200 70 L220 90 M200 70 V130" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400" />
        <text x="200" y="160" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="currentColor" text-anchor="middle" class="text-slate-400">{title || "Architecture Diagram Placeholder"}</text>
      </svg>
    )}
  </div>
</div>
