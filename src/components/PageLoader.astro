---
/* Nadhebe Animated Futuristic Page Loader Component */
---

<div id="page-loader" class="page-loader-overlay" aria-hidden="true">
  <!-- Ambient Gradient Background Mesh Orbs -->
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>
  <div class="ambient-orb orb-3"></div>

  <div class="loader-content">
    <!-- Glowing Animated Ring Container -->
    <div class="logo-ring-wrapper">
      <div class="glowing-ring"></div>
      <div class="glowing-ring-inner"></div>
      <div class="logo-box">
        <img src="/logo.webp" alt="Nadhebe Logo" class="loader-logo" width="72" height="72" />
      </div>
    </div>

    <!-- Futuristic Brand Typography & Progress Indicator -->
    <div class="loader-text-group">
      <span class="loader-brand">NADHEBE</span>
      <div class="shimmer-bar">
        <div class="shimmer-progress"></div>
      </div>
      <span class="loader-subtext">Initializing Agent Context</span>
    </div>
  </div>
</div>

<style>
  /* Orbitron font loaded via BaseLayout preload link for FOUT prevention */

  .page-loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Hardware accelerated fixed backdrop — only promote transform on GPU */
    transform: translateZ(0);
    will-change: transform;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    overflow: hidden;
    transition: opacity 0.3s ease-out, visibility 0.3s ease-out;
  }

  :global(html.dark) .page-loader-overlay {
    background: rgba(10, 14, 24, 0.94);
  }

  .page-loader-overlay.loaded {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Ambient Pulsing Background Orbs — GPU-accelerated via transform only */
  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
    pointer-events: none;
    will-change: transform;
    contain: strict;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    top: 20%;
    left: 25%;
    background: radial-gradient(circle, rgba(224, 122, 95, 0.45) 0%, rgba(244, 162, 97, 0) 70%);
    animation: floatOrb1 6s ease-in-out infinite alternate;
  }

  .orb-2 {
    width: 450px;
    height: 450px;
    bottom: 15%;
    right: 20%;
    background: radial-gradient(circle, rgba(135, 169, 135, 0.45) 0%, rgba(183, 228, 199, 0) 70%);
    animation: floatOrb2 7s ease-in-out infinite alternate;
  }

  .orb-3 {
    width: 350px;
    height: 350px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(216, 180, 248, 0.35) 0%, rgba(216, 180, 248, 0) 70%);
    animation: pulseOrb 4s ease-in-out infinite alternate;
  }

  .loader-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    transform: translateZ(0);
  }

  .logo-ring-wrapper {
    position: relative;
    width: 112px;
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Conic Rotating Glowing Outer Ring */
  .glowing-ring {
    position: absolute;
    inset: -6px;
    border-radius: 26px;
    background: conic-gradient(from 0deg, #e07a5f, #f4a261, #87a987, #d8b4f8, #e07a5f);
    animation: spinRing 2.2s linear infinite;
    filter: blur(10px);
    opacity: 0.85;
  }

  .glowing-ring-inner {
    position: absolute;
    inset: -2px;
    border-radius: 22px;
    background: conic-gradient(from 0deg, #e07a5f, #f4a261, #87a987, #d8b4f8, #e07a5f);
    animation: spinRing 2.2s linear infinite;
  }

  .logo-box {
    position: relative;
    z-index: 2;
    width: 100px;
    height: 100px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08), inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    animation: pulseLogo 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  :global(html.dark) .logo-box {
    background: #090d16;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .loader-logo {
    width: 66px;
    height: 66px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(224, 122, 95, 0.3));
    animation: breatheLogo 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* Futuristic Brand Typography */
  .loader-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .loader-brand {
    font-family: 'Orbitron', 'Syne', system-ui, -apple-system, sans-serif;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.45em;
    padding-left: 0.45em;
    background: linear-gradient(135deg, #1e293b 0%, #e07a5f 60%, #f4a261 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 20px rgba(224, 122, 95, 0.2);
    text-transform: uppercase;
  }

  :global(html.dark) .loader-brand {
    background: linear-gradient(135deg, #ffffff 0%, #f4a261 50%, #e07a5f 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 24px rgba(244, 162, 97, 0.35);
  }

  .shimmer-bar {
    width: 140px;
    height: 3px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.08);
    overflow: hidden;
    position: relative;
  }

  :global(html.dark) .shimmer-bar {
    background: rgba(255, 255, 255, 0.12);
  }

  .shimmer-progress {
    width: 45%;
    height: 100%;
    background: linear-gradient(90deg, #e07a5f, #f4a261, #87a987);
    border-radius: 9999px;
    animation: shimmerSlide 1.3s ease-in-out infinite;
  }

  .loader-subtext {
    font-family: 'Orbitron', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #475569;
    text-transform: uppercase;
  }

  :global(html.dark) .loader-subtext {
    color: rgba(255, 255, 255, 0.5);
  }

  /* Keyframe Animations */
  @keyframes spinRing {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes pulseLogo {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(0.97); }
  }

  @keyframes breatheLogo {
    0%, 100% { opacity: 0.92; filter: drop-shadow(0 4px 12px rgba(224, 122, 95, 0.3)); }
    50% { opacity: 1; filter: drop-shadow(0 6px 20px rgba(244, 162, 97, 0.65)); }
  }

  @keyframes shimmerSlide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(260%); }
  }

  @keyframes floatOrb1 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(40px, 30px); }
  }

  @keyframes floatOrb2 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-40px, -20px); }
  }

  @keyframes pulseOrb {
    0% { opacity: 0.25; transform: translate(-50%, -50%) scale(0.95); }
    100% { opacity: 0.55; transform: translate(-50%, -50%) scale(1.1); }
  }
</style>

<script is:inline>
  (function () {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    const subtexts = [
      "Loading MCP Registry...",
      "Indexing project graph...",
      "Synchronizing vector index...",
      "Loading inference pipeline...",
      "Initializing agent runtime..."
    ];

    function pickRandomSubtext() {
      const el = loader.querySelector('.loader-subtext');
      if (el) {
        const msg = subtexts[Math.floor(Math.random() * subtexts.length)];
        el.textContent = msg;
      }
    }

    pickRandomSubtext();

    function hideLoader() {
      if (loader.classList.contains('loaded')) return;
      loader.classList.add('loaded');
    }

    // Dismiss when DOM is ready or fully loaded
    if (document.readyState === 'complete') {
      hideLoader();
    } else {
      window.addEventListener('load', hideLoader);
      document.addEventListener('DOMContentLoaded', hideLoader);
    }

    // Safety timeout: dismiss smoothly after 450ms max
    setTimeout(hideLoader, 450);

    // Astro page load integration
    document.addEventListener('astro:page-load', hideLoader);
  })();
</script>
